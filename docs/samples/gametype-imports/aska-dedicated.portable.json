            }
          },
          {
            "settingKey": "ASKA_STEAM_QUERY_PORT",
            "defaultValue": "27015",
            "description": "Steam query UDP port written to server properties.txt.",
            "displayOrder": 13,
            "metadata": {
              "dataType": "port",
              "category": "Networking",
              "isRequired": true,
              "portMappings": [
                {
                  "mappingRole": "Primary",
                  "relationType": "Direct",
                  "targetContainerPort": 27015,
                  "targetProtocol": "udp",
                  "isRequired": true,
                  "displayOrder": 0
                }
              ]
            }
          },
          {
            "settingKey": "ASKA_DAY_LENGTH",
            "defaultValue": "default",
            "description": "Custom-mode day length.",
            "displayOrder": 14,
            "metadata": {
              "dataType": "enum",
              "category": "Custom World",
              "isRequired": false,
              "allowedValuesJson": "[{\"value\":\"minimum\",\"label\":\"Minimum\"},{\"value\":\"reduced\",\"label\":\"Reduced\"},{\"value\":\"default\",\"label\":\"Default\"},{\"value\":\"extended\",\"label\":\"Extended\"},{\"value\":\"maximum\",\"label\":\"Maximum\"}]"
            }
