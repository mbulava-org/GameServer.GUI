# Game Server Port Configuration Examples

This file contains real-world port configuration examples for popular game servers.

## Counter-Strike: Source / CS:GO

```json
{
  "GameTypeKey": "csgo",
  "SettingsMetadata": {
    "SERVER_PORT": {
      "Key": "SERVER_PORT",
      "Description": "Game server port (UDP)",
      "DataType": "port",
      "IsRequired": true,
      "MapsToContainerPort": true,
      "LinkedContainerPort": 27015,
      "PortProtocol": "udp",
      "Placeholder": "27015",
      "Category": "Network",
      "DisplayOrder": 1,
      "PortValidation": {
        "MinPort": 27000,
        "MaxPort": 27100,
        "CheckAvailability": true,
        "SuggestedPorts": [27015, 27016, 27017, 27018],
        "ValidationMessage": "Port must be between 27000-27100 and available"
      },
      "PortRelationships": [
        {
          "RelationType": "Offset",
          "TargetContainerPort": 27016,
          "TargetProtocol": "udp",
          "Offset": 1,
          "Description": "Steam Query Port (Server Browser)",
          "IsRequired": true
        },
        {
          "RelationType": "Offset",
          "TargetContainerPort": 27015,
          "TargetProtocol": "tcp",
          "Offset": 0,
          "Description": "RCON Port",
          "IsRequired": false
        }
      ],
      "ValidateRelatedPortsAvailability": true
    }
  }
}
```

