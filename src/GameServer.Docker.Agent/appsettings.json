{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GameServer.Docker.Agent.Services.ContainerService": "Debug",
      "GameServer.Docker.Agent.Hubs.NodeAgentHub": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "AgentRegistration": {
    "PrimaryServiceUrl": "http://gameserver-docker:8080",
    "HeartbeatIntervalSeconds": 30,
    "Enabled": true,
    "Capabilities": [ "logs", "exec", "stats", "attach", "services" ],
    "ConnectionTimeoutSeconds": 30,
    "ReconnectDelaySeconds": [ 0, 2, 10, 30 ]
  },
  "UdpAgentAnnouncement": {
    "Enabled": true,
    "MulticastGroup": "239.1.1.1",
    "Port": 19090,
    "AnnouncementIntervalSeconds": 15,
    "TimeToLive": 1
  }
}
