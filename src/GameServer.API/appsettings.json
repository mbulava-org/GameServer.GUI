{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GameServerV2Db": "Data Source=./data/gameserver-v2.db",
    "GameServerV2MySqlDb": "Server=localhost;Database=",
    "GameServerV2PostgresDb": "Host=localhost;Database=gameserver-v2;Username=postgres;Password=postgres"

  },
  "V2Database": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "GameServerV2PostgresDb"
  },
  "PortAllocation": {
    "StartPort": 2000,
    "EndPort": 65535
  },
  "NetworkOptions": {
    "LoadBalancerNetwork": "traefik-public",
    "LoadBalancerProvider": "traefik"
  },
  "NodeAgentOptions": {
    "EnableBackgroundDiscovery": false,
    "ServiceName": "gameserver-agent",
    "NetworkName": "gameserver-network",
    "Port": 8080,
    "TimeoutSeconds": 45
  },
  "UdpAgentDiscovery": {
    "Enabled": true,
    "BindAddress": "0.0.0.0",
    "MulticastGroup": "239.1.1.1",
    "Port": 19090,
    "AnnouncementTtlSeconds": 90,
    "CleanupIntervalSeconds": 30
  }
}
