<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.7" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="XtermBlazor" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameServer.Docker.Client\GameServer.Docker.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Server\Wizards\Steps\" />
  </ItemGroup>

  <!-- Workaround for .NET 10 static web assets issue -->
  <!-- Manually copy Radzen and XtermBlazor assets to wwwroot/_content -->
  <Target Name="CopyStaticWebAssets" AfterTargets="Build">
    <ItemGroup>
      <RadzenAssets Include="$(NuGetPackageRoot)radzen.blazor\9.0.4\staticwebassets\**\*.*" />
      <XtermAssets Include="$(NuGetPackageRoot)xtermblazor\2.3.0\staticwebassets\**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(RadzenAssets)" DestinationFolder="$(OutputPath)wwwroot\_content\Radzen.Blazor\%(RecursiveDir)" SkipUnchangedFiles="true" />
    
    <Copy SourceFiles="@(XtermAssets)" DestinationFolder="$(OutputPath)wwwroot\_content\XtermBlazor\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
