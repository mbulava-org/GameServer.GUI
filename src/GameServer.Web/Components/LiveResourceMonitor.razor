@using GameServer.Docker.Client.Interfaces
@using GameServer.Docker.Client.Services
@using GameServer.Docker.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable
@inject NotificationService NotificationService
@inject IConfiguration Configuration
@inject ILoggerFactory LoggerFactory

<RadzenCard class="resource-monitor">
    <div class="monitor-header">
        <h4>Live Resources</h4>
        <RadzenBadge BadgeStyle='@GetConnectionBadgeStyle()' 
                     Text="@GetConnectionStatusText()" />
    </div>

    @if (currentUsage != null)
    {
        <div class="resource-stats">
            <div class="stat-group">
                <div class="stat-label">CPU Usage</div>
                <RadzenProgressBar Value="@currentUsage.CpuUsagePercent" Max="100" ShowValue="true" 
                                   ProgressBarStyle='@GetProgressBarStyle(currentUsage.CpuUsagePercent)' />
                <div class="stat-value">@($"{currentUsage.CpuUsagePercent:F1}%")</div>
            </div>

            <div class="stat-group">
                <div class="stat-label">Memory Usage</div>
                <RadzenProgressBar Value="@currentUsage.MemoryUsagePercent" Max="100" ShowValue="true" 
                                   ProgressBarStyle='@GetProgressBarStyle(currentUsage.MemoryUsagePercent)' />
                <div class="stat-value">@FormatBytes((long)currentUsage.MemoryUsageBytes) / @FormatBytes((long)currentUsage.MemoryLimitBytes)</div>
            </div>

            <div class="stat-row">
                <div class="stat-item">
                    <div class="stat-label">Network RX</div>
                    <div class="stat-value">@FormatBytes((long)currentUsage.NetworkRxBytes)</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Network TX</div>
                    <div class="stat-value">@FormatBytes((long)currentUsage.NetworkTxBytes)</div>
                </div>
            </div>

            <div class="stat-row">
                <div class="stat-item">
                    <div class="stat-label">Disk Read</div>
                    <div class="stat-value">@FormatBytes((long)currentUsage.BlockReadBytes)</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Disk Write</div>
                    <div class="stat-value">@FormatBytes((long)currentUsage.BlockWriteBytes)</div>
                </div>
            </div>

            <div class="last-update">
                Last updated: @currentUsage.Timestamp.ToLocalTime().ToString("HH:mm:ss")
            </div>
        </div>
    }
    else if (isMonitoring)
    {
        <div class="no-data">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <p>Waiting for resource data...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-data">
            <RadzenIcon Icon="error" />
            <p>@errorMessage</p>
            <RadzenButton Text="Retry" Click="StartMonitoring" Size="ButtonSize.Small" />
        </div>
    }
    else
    {
        <div class="no-data">
            <p>Resource monitoring not active</p>
            @if (!string.IsNullOrEmpty(ServerId))
            {
                <RadzenButton Text="Start Monitoring" Click="StartMonitoring" Size="ButtonSize.Small" />
            }
        </div>
    }
</RadzenCard>

<style>
    .resource-monitor {
        margin-top: 1rem;
    }

    .monitor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .monitor-header h4 {
        margin: 0;
    }

    .resource-stats {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .stat-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .stat-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .stat-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--rz-text-secondary-color);
    }

    .stat-value {
        font-size: 1rem;
        font-weight: 500;
    }

    .stat-rate {
        font-size: 0.75rem;
        color: var(--rz-text-secondary-color);
    }

    .last-update {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--rz-text-secondary-color);
        text-align: right;
    }

    .no-data, .error-data {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem;
        color: var(--rz-text-secondary-color);
    }

    .error-data {
        color: var(--rz-danger);
    }
</style>

    @code {
    [Parameter] public string? ServerId { get; set; }
    [Parameter] public bool AutoStart { get; set; } = true;

    private ServerResourceUsage? currentUsage;
    private bool isMonitoring = false;
    private string? errorMessage;

    private IServerResourceClient ResourceClient;

    protected override async Task OnInitializedAsync()
    {
        if (ResourceClient == null) return;
        // Subscribe to events
        ResourceClient.ResourceUpdate += OnResourceUpdate;
        ResourceClient.MonitoringError += OnMonitoringError;
        ResourceClient.MonitoringStarted += OnMonitoringStarted;
        ResourceClient.MonitoringEnded += OnMonitoringEnded;
        ResourceClient.MonitoringStopped += OnMonitoringStopped;
        ResourceClient.StateChanged += OnStateChanged;

        // Connect if not already connected
        if (ResourceClient.State == ConnectionState.Disconnected)
        {
            try
            {
                await ResourceClient.ConnectAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to connect: {ex.Message}";
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Connection Error",
                    Detail = errorMessage,
                    Duration = 5000
                });
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var apiBaseUrl = Configuration["GameServerDockerApi:BaseUri"]?.TrimEnd('/') ?? "http://localhost:5164";
        var hubUrl = $"{apiBaseUrl}/hubs/resources";

        ResourceClient = new ServerResourceClient(
          hubUrl,
          builder => builder
            .WithAutomaticReconnect(new[]
            {
              TimeSpan.Zero,
              TimeSpan.FromSeconds(2),
              TimeSpan.FromSeconds(5),
              TimeSpan.FromSeconds(10)
            }),
            LoggerFactory.CreateLogger<ServerResourceClient>()
        );
        await OnInitializedAsync();
        // Auto-start monitoring if enabled and we have a server ID
        if (AutoStart && !string.IsNullOrEmpty(ServerId) && 
            ResourceClient.State == ConnectionState.Connected && 
            !isMonitoring &&
            ResourceClient.CurrentServerId != ServerId)
        {
            await StartMonitoring();
        }
    }

    private async Task StartMonitoring()
    {
        if (string.IsNullOrEmpty(ServerId)) return;

        errorMessage = null;

        try
        {
            // Stop any existing monitoring
            if (ResourceClient.CurrentServerId != null && ResourceClient.CurrentServerId != ServerId)
            {
                await ResourceClient.StopMonitoringAsync();
            }

            // Start new monitoring
            await ResourceClient.StartMonitoringAsync(ServerId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to start monitoring: {ex.Message}";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Monitoring Error",
                Detail = errorMessage,
                Duration = 5000
            });
        }
    }

    private void OnResourceUpdate(object? sender, ServerResourceUsage usage)
    {
        currentUsage = usage;
        InvokeAsync(StateHasChanged);
    }

    private void OnMonitoringError(object? sender, string error)
    {
        errorMessage = error;
        isMonitoring = false;
        InvokeAsync(() =>
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Monitoring Error",
                Detail = error,
                Duration = 5000
            });
            StateHasChanged();
        });
    }

    private void OnMonitoringStarted(object? sender, string serverId)
    {
        isMonitoring = true;
        errorMessage = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnMonitoringEnded(object? sender, EventArgs e)
    {
        isMonitoring = false;
        currentUsage = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnMonitoringStopped(object? sender, EventArgs e)
    {
        isMonitoring = false;
        currentUsage = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged(object? sender, ConnectionState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private BadgeStyle GetConnectionBadgeStyle()
    {
        return ResourceClient.State switch
        {
            ConnectionState.Connected => isMonitoring ? BadgeStyle.Success : BadgeStyle.Info,
            ConnectionState.Connecting => BadgeStyle.Warning,
            ConnectionState.Reconnecting => BadgeStyle.Warning,
            ConnectionState.Disconnected => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private string GetConnectionStatusText()
    {
        if (ResourceClient.State == ConnectionState.Connected && isMonitoring)
            return "Monitoring";

        return ResourceClient.State switch
        {
            ConnectionState.Connected => "Connected",
            ConnectionState.Connecting => "Connecting",
            ConnectionState.Reconnecting => "Reconnecting",
            ConnectionState.Disconnected => "Disconnected",
            _ => "Unknown"
        };
    }

    private ProgressBarStyle GetProgressBarStyle(double percentage)
    {
        return percentage switch
        {
            >= 90 => ProgressBarStyle.Danger,
            >= 70 => ProgressBarStyle.Warning,
            _ => ProgressBarStyle.Success
        };
    }

    private string FormatBytes(long bytes)
    {
        if (bytes == 0) return "0 B";

        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string FormatBytesPerSecond(double bytesPerSecond)
    {
        if (bytesPerSecond == 0) return "0 B/s";

        string[] sizes = { "B/s", "KB/s", "MB/s", "GB/s" };
        double rate = bytesPerSecond;
        int order = 0;
        while (rate >= 1024 && order < sizes.Length - 1)
        {
            order++;
            rate /= 1024;
        }
        return $"{rate:0.##} {sizes[order]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (ResourceClient == null) return;
        // Unsubscribe from events
        ResourceClient.ResourceUpdate -= OnResourceUpdate;
        ResourceClient.MonitoringError -= OnMonitoringError;
        ResourceClient.MonitoringStarted -= OnMonitoringStarted;
        ResourceClient.MonitoringEnded -= OnMonitoringEnded;
        ResourceClient.MonitoringStopped -= OnMonitoringStopped;
        ResourceClient.StateChanged -= OnStateChanged;

        // Stop monitoring if this component started it
        if (isMonitoring && !string.IsNullOrEmpty(ServerId) && 
            ResourceClient.CurrentServerId == ServerId)
        {
            try
            {
                await ResourceClient.StopMonitoringAsync();
            }
            catch
            {
                // Ignore errors during disposal
            }
        }
    }
}