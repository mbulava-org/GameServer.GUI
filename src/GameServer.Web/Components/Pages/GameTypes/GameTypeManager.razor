@page "/gametypes"
@rendermode InteractiveServer
@using global::GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject IGameTypeApi GameTypeApi
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Game Type Manager</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Game Types</h2>
            <p class="text-muted mb-0">Manage game server templates and configurations</p>
        </div>
        <RadzenButton Text="Add Game Type" 
                      Icon="add" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@CreateNewGameType" />
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading game types...</p>
        </div>
    }
    else if (!gameTypes.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="sports_esports" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Game Types Found</h4>
                <p class="text-muted">Create your first game type to get started.</p>
                <RadzenButton Text="Add Game Type" 
                              Icon="add" 
                              ButtonStyle="ButtonStyle.Primary" 
                              Click="@CreateNewGameType" 
                              class="mt-3" />
            </div>
        </RadzenCard>
    }
    else
    {
        <div class="row">
            @foreach (var gameType in gameTypes)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <RadzenCard class="gametype-card h-100" Style="cursor: pointer;" @onclick="@(() => NavigateToGameType(gameType.Key))">
                        @if (!string.IsNullOrWhiteSpace(gameType.ThumbnailUrl))
                        {
                            <div class="gametype-thumbnail">
                                <img src="@gameType.ThumbnailUrl" 
                                     alt="@gameType.DisplayName"
                                     class="thumbnail-image"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="thumbnail-fallback" style="display: none;">
                                    <RadzenIcon Icon="sports_esports" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="gametype-thumbnail">
                                <div class="thumbnail-fallback">
                                    <RadzenIcon Icon="sports_esports" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                                </div>
                            </div>
                        }
                        
                        <div class="gametype-card-header">
                            <div class="d-flex align-items-start justify-content-between">
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">@gameType.DisplayName</h5>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                                                     Text="@gameType.Key" 
                                                     Variant="Variant.Outlined" />
                                    </div>
                                </div>
                                <RadzenIcon Icon="chevron_right" Style="font-size: 1.5rem; color: var(--rz-text-disabled-color);" />
                            </div>
                        </div>

                        <div class="gametype-card-body mt-3">
                            @if (!string.IsNullOrWhiteSpace(gameType.Description))
                            {
                                <p class="text-muted mb-3 description-text">@gameType.Description</p>
                            }

                            <div class="gametype-info">
                                <div class="info-item">
                                    <RadzenIcon Icon="code" class="info-icon" />
                                    <div>
                                        <small class="text-muted d-block">Docker Image</small>
                                        <span class="fw-semibold text-truncate d-block" title="@gameType.Image">@gameType.Image</span>
                                    </div>
                                </div>

                                <div class="info-stats">
                                    <div class="stat-badge">
                                        <RadzenIcon Icon="settings_ethernet" Style="font-size: 1rem;" />
                                        <span>@gameType.Ports.Count Port@(gameType.Ports.Count != 1 ? "s" : "")</span>
                                    </div>
                                    <div class="stat-badge">
                                        <RadzenIcon Icon="folder" Style="font-size: 1rem;" />
                                        <span>@gameType.Volumes.Count Volume@(gameType.Volumes.Count != 1 ? "s" : "")</span>
                                    </div>
                                    <div class="stat-badge">
                                        <RadzenIcon Icon="settings" Style="font-size: 1rem;" />
                                        <span>@(gameType.DefaultSettings?.Count ?? 0) Setting@((gameType.DefaultSettings?.Count ?? 0) != 1 ? "s" : "")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="gametype-card-footer mt-auto pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <RadzenIcon Icon="touch_app" Style="font-size: 0.9rem;" />
                                    Click to edit
                                </small>
                                <div class="card-actions" @onclick:stopPropagation="true">
                                    <RadzenButton Icon="content_copy" 
                                                  Size="ButtonSize.Small" 
                                                  ButtonStyle="ButtonStyle.Light" 
                                                  Click="@(() => DuplicateGameType(gameType))"
                                                  title="Duplicate"
                                                  class="me-2" />
                                    <RadzenButton Icon="delete" 
                                                  Size="ButtonSize.Small" 
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Click="@(() => DeleteGameType(gameType))"
                                                  title="Delete" />
                                </div>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            }
        </div>
    }
</div>

<style>
    .gametype-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid var(--rz-border-color);
        display: flex;
        flex-direction: column;
    }

    .gametype-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        border-color: var(--rz-primary);
    }

    .gametype-thumbnail {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
        border-radius: 8px;
        margin-bottom: 1rem;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .thumbnail-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .thumbnail-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .gametype-card-header h5 {
        color: var(--rz-text-color);
        margin-bottom: 0;
        font-weight: 600;
    }

    .gametype-card-body {
        flex: 1;
    }

    .description-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        min-height: 3em;
    }

    .gametype-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .info-item {
        display: flex;
        gap: 0.75rem;
        align-items: start;
    }

    .info-icon {
        font-size: 1.25rem;
        color: var(--rz-primary);
        flex-shrink: 0;
        margin-top: 0.25rem;
    }

    .info-item small {
        font-size: 0.75rem;
    }

    .info-item span {
        font-size: 0.875rem;
    }

    .info-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .stat-badge {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        background: var(--rz-base-100);
        border-radius: 20px;
        font-size: 0.8rem;
        color: var(--rz-text-secondary-color);
    }

    .gametype-card-footer {
        margin-top: auto;
    }

    .card-actions {
        display: flex;
        gap: 0.5rem;
    }

    @@media (max-width: 768px) {
        .gametype-card-footer {
            flex-direction: column;
            gap: 0.5rem;
        }

        .card-actions {
            justify-content: flex-end;
        }
    }
</style>

@code {
    private List<GameTypeDefinition> gameTypes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadGameTypesAsync();
    }

    private async Task LoadGameTypesAsync()
    {
        isLoading = true;
        StateHasChanged(); // Force UI update
        
        try
        {
            var data = await GameTypeApi.GetAllAsync();
            gameTypes = data?.ToList() ?? new List<GameTypeDefinition>();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Loading Game Types",
                Detail = $"Failed to load game types: {ex.Message}",
                Duration = 5000,
                CloseOnClick = true
            });
            gameTypes = new List<GameTypeDefinition>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Force UI update
        }
    }

    private void CreateNewGameType()
    {
        Navigation.NavigateTo("/gametypes/new");
    }

    private void NavigateToGameType(string key)
    {
        // URL encode the key to handle special characters
        var encodedKey = Uri.EscapeDataString(key);
        Navigation.NavigateTo($"/gametypes/{encodedKey}");
    }

    private async Task DuplicateGameType(GameTypeDefinition gameType)
    {
        try
        {
            // Create a duplicate with a new key
            var duplicate = new GameTypeDefinition
            {
                Key = $"{gameType.Key}_copy_{DateTime.Now.Ticks}",
                DisplayName = $"{gameType.DisplayName} (Copy)",
                Description = gameType.Description,
                Image = gameType.Image,
                ThumbnailUrl = gameType.ThumbnailUrl,
                DocumentationUrl = gameType.DocumentationUrl,
                Ports = new List<PortDefinition>(gameType.Ports ?? new List<PortDefinition>()),
                Volumes = new List<VolumeDefinition>(gameType.Volumes ?? new List<VolumeDefinition>()),
                DefaultSettings = new Dictionary<string, string>(gameType.DefaultSettings ?? new Dictionary<string, string>())
            };

            await GameTypeApi.CreateAsync(duplicate);
            
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Game Type Duplicated",
                Detail = $"'{gameType.DisplayName}' has been duplicated successfully.",
                Duration = 3000,
                CloseOnClick = true
            });

            // Reload to show the new duplicate
            await LoadGameTypesAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Duplicate Failed",
                Detail = $"Failed to duplicate game type: {ex.Message}",
                Duration = 5000,
                CloseOnClick = true
            });
        }
    }

    private async Task DeleteGameType(GameTypeDefinition gameType)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{gameType.DisplayName}'? This action cannot be undone.",
            "Delete Game Type",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await GameTypeApi.DeleteAsync(gameType.Key);
                
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Deleted",
                    Detail = $"'{gameType.DisplayName}' has been deleted successfully.",
                    Duration = 3000,
                    CloseOnClick = true
                });

                // Reload the list after deletion
                await LoadGameTypesAsync();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Delete Failed",
                    Detail = $"Failed to delete game type: {ex.Message}",
                    Duration = 5000,
                    CloseOnClick = true
                });
            }
        }
    }
}