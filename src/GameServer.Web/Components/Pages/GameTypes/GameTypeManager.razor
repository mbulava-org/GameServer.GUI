    }

    .card-actions {
        display: flex;
        gap: 0.5rem;
    }

    @@media (max-width: 768px) {
        .gametype-card-footer {
            flex-direction: column;
            gap: 0.5rem;
        }

        .card-actions {
            justify-content: flex-end;
        }
    }
</style>

@code {
    private List<GameTypeDefinition> gameTypes = new();
    private readonly Dictionary<string, string> cachedThumbnailUrls = new(StringComparer.Ordinal);
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadGameTypesAsync();
    }

    private async Task LoadGameTypesAsync()
    {
        isLoading = true;
        StateHasChanged(); // Force UI update
        
        try
        {
            var data = await GameTypeApi.GetAllAsync();
            gameTypes = data?.ToList() ?? new List<GameTypeDefinition>();
            await CacheThumbnailUrlsAsync(gameTypes.Select(static gt => gt.ThumbnailUrl));
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Loading Game Types",
                Detail = $"Failed to load game types: {ex.Message}",
                Duration = 5000,
                CloseOnClick = true
            });
            gameTypes = new List<GameTypeDefinition>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Force UI update
        }
    }

    private string? GetThumbnailUrl(string? sourceUrl)
    {
        if (string.IsNullOrWhiteSpace(sourceUrl))
        {
            return null;
        }

        return cachedThumbnailUrls.TryGetValue(sourceUrl, out var cachedUrl) ? cachedUrl : sourceUrl;
    }

    private async Task CacheThumbnailUrlsAsync(IEnumerable<string?> thumbnailUrls)
    {
        var sourceUrls = thumbnailUrls
            .Where(static url => !string.IsNullOrWhiteSpace(url))
            .Select(static url => url!)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        cachedThumbnailUrls.Clear();
        if (sourceUrls.Count == 0)
        {
            return;
        }

        var cacheEntries = await Task.WhenAll(sourceUrls.Select(async url =>
            new KeyValuePair<string, string>(url, (await ThumbnailCacheService.GetCachedThumbnailUrlAsync(url)) ?? url)));

        foreach (var cacheEntry in cacheEntries)
        {
            cachedThumbnailUrls[cacheEntry.Key] = cacheEntry.Value;
        }
    }

    private void CreateNewGameType()
    {
        Navigation.NavigateTo("/gametypes/new");
    }

    private void NavigateToGameType(string key)
    {
        // URL encode the key to handle special characters
        var encodedKey = Uri.EscapeDataString(key);
        Navigation.NavigateTo($"/gametypes/{encodedKey}");
    }

    private void EditExtendedMetadata(string key)
    {
        // URL encode the key to handle special characters
        var encodedKey = Uri.EscapeDataString(key);
        Navigation.NavigateTo($"/gametypes/{encodedKey}/metadata");
    }

    private void OnRowDoubleClick(DataGridRowMouseEventArgs<GameTypeDefinition> args)
    {
        NavigateToGameType(args.Data.Key);
    }

    private async Task DuplicateGameType(GameTypeDefinition gameType)
    {
        try
        {
            // Create a duplicate with a new key
            var duplicate = new GameTypeDefinition
            {
                Key = $"{gameType.Key}_copy_{DateTime.Now.Ticks}",
                DisplayName = $"{gameType.DisplayName} (Copy)",
                Description = gameType.Description,
                Image = gameType.Image,
                ThumbnailUrl = gameType.ThumbnailUrl,
                DocumentationUrl = gameType.DocumentationUrl,
                Ports = new List<PortDefinition>(gameType.Ports ?? new List<PortDefinition>()),
                Volumes = new List<VolumeDefinition>(gameType.Volumes ?? new List<VolumeDefinition>()),
                DefaultSettings = new Dictionary<string, string>(gameType.DefaultSettings ?? new Dictionary<string, string>())
            };

            await GameTypeApi.CreateAsync(duplicate);
            
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Game Type Duplicated",
                Detail = $"'{gameType.DisplayName}' has been duplicated successfully.",
                Duration = 3000,
                CloseOnClick = true
            });

            // Reload to show the new duplicate
            await LoadGameTypesAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Duplicate Failed",
                Detail = $"Failed to duplicate game type: {ex.Message}",
                Duration = 5000,
                CloseOnClick = true
            });
        }
    }

    private async Task DeleteGameType(GameTypeDefinition gameType)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{gameType.DisplayName}'? This action cannot be undone.",
            "Delete Game Type",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await GameTypeApi.DeleteAsync(gameType.Key);
                
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Deleted",
                    Detail = $"'{gameType.DisplayName}' has been deleted successfully.",
                    Duration = 3000,
                    CloseOnClick = true
                });

                // Reload the list after deletion
                await LoadGameTypesAsync();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Delete Failed",
                    Detail = $"Failed to delete game type: {ex.Message}",
                    Duration = 5000,
                    CloseOnClick = true
                });
            }
        }
    }
}