@page "/gametypes"
@rendermode InteractiveServer
@attribute [Obsolete("Legacy pre-V2 game type manager page. Use `/gametypes-v2` before removing the old repository chain.")]
@using global::GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject IGameTypeApi GameTypeApi
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject Services.IThumbnailCacheService ThumbnailCacheService

<PageTitle>Game Type Manager</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Game Types</h2>
            <p class="text-muted mb-0">Manage game server templates and configurations</p>
        </div>
        <RadzenButton Text="Add Game Type" 
                      Icon="add" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@CreateNewGameType" />
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading game types...</p>
        </div>
    }
    else if (!gameTypes.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="sports_esports" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Game Types Found</h4>
                <p class="text-muted">Create your first game type to get started.</p>
                <RadzenButton Text="Add Game Type" 
                              Icon="add" 
                              ButtonStyle="ButtonStyle.Primary" 
                              Click="@CreateNewGameType" 
                              class="mt-3" />
            </div>
        </RadzenCard>
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid Data="@gameTypes" 
                           TItem="GameTypeDefinition" 
                           AllowSorting="true"
                           AllowFiltering="true"
                           FilterMode="FilterMode.Advanced"
                           AllowColumnResize="true"
                           RowDoubleClick="@OnRowDoubleClick">
                <Columns>
                    <RadzenDataGridColumn TItem="GameTypeDefinition" 
                                         Property="ThumbnailUrl" 
                                         Title="" 
                                         Width="80px"
                                         Sortable="false"
                                         Filterable="false">
                        <Template Context="gameType">
                            @if (!string.IsNullOrWhiteSpace(gameType.ThumbnailUrl))
                            {
                                <img src="@GetThumbnailUrl(gameType.ThumbnailUrl)" 
                                     alt="@gameType.DisplayName"
                                     class="gametype-list-thumbnail"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="gametype-list-thumbnail-fallback" style="display: none;">
                                    <RadzenIcon Icon="sports_esports" Style="font-size: 1.5rem;" />
                                </div>
                            }
                            else
                            {
                                <div class="gametype-list-thumbnail-fallback">
                                    <RadzenIcon Icon="sports_esports" Style="font-size: 1.5rem;" />
                                </div>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeDefinition" 
                                         Property="DisplayName" 
                                         Title="Name" 
                                         Width="200px">
                        <Template Context="gameType">
                            <div class="gametype-list-name">
                                <strong>@gameType.DisplayName</strong>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeDefinition" 
                                         Property="Description" 
                                         Title="Description"
                                         Width="300px">
                        <Template Context="gameType">
                            <span class="text-muted gametype-list-description">
                                @(string.IsNullOrWhiteSpace(gameType.Description) ? "No description" : gameType.Description)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeDefinition" 
                                         Property="Image" 
                                         Title="Docker Image"
                                         Width="250px">
                        <Template Context="gameType">
                            <code class="gametype-list-image">@gameType.Image</code>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeDefinition" 
                                         Title="Configuration" 
                                         Width="200px"
                                         Sortable="false"
                                         Filterable="false">
                        <Template Context="gameType">
                            <div class="gametype-list-stats">
                                <div class="stat-item">
                                    <RadzenIcon Icon="settings_ethernet" Style="font-size: 0.875rem;" />
                                    <span>@gameType.Ports.Count Port@(gameType.Ports.Count != 1 ? "s" : "")</span>
                                </div>
                                <div class="stat-item">
                                    <RadzenIcon Icon="folder" Style="font-size: 0.875rem;" />
                                    <span>@gameType.Volumes.Count Volume@(gameType.Volumes.Count != 1 ? "s" : "")</span>
                                </div>
                                <div class="stat-item">
                                    <RadzenIcon Icon="settings" Style="font-size: 0.875rem;" />
                                    <span>@(gameType.DefaultSettings?.Count ?? 0) Setting@((gameType.DefaultSettings?.Count ?? 0) != 1 ? "s" : "")</span>
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeDefinition" 
                                         Title="Actions" 
                                         Width="180px"
                                         Sortable="false"
                                         Filterable="false"
                                         TextAlign="TextAlign.Center">
                        <Template Context="gameType">
                            <div class="gametype-list-actions">
                                <RadzenButton Icon="edit" 
                                            Size="ButtonSize.Small" 
                                            ButtonStyle="ButtonStyle.Light" 
                                            Click="@(() => NavigateToGameType(gameType.Key))"
                                            title="Edit"
                                            Variant="Variant.Flat" />
                                <RadzenButton Icon="extension" 
                                            Size="ButtonSize.Small" 
                                            ButtonStyle="ButtonStyle.Info" 
                                            Click="@(() => EditExtendedMetadata(gameType.Key))"
                                            title="Edit Extended Metadata"
                                            Variant="Variant.Flat" />
                                <RadzenButton Icon="content_copy" 
                                            Size="ButtonSize.Small" 
                                            ButtonStyle="ButtonStyle.Light" 
                                            Click="@(() => DuplicateGameType(gameType))"
                                            title="Duplicate"
                                            Variant="Variant.Flat" />
                                <RadzenButton Icon="delete" 
                                            Size="ButtonSize.Small" 
                                            ButtonStyle="ButtonStyle.Danger" 
                                            Click="@(() => DeleteGameType(gameType))"
                                            title="Delete"
                                            Variant="Variant.Flat" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</div>

<style>
    /* List View Styles */
    .gametype-list-thumbnail,
    .gametype-list-thumbnail-fallback {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
        background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
    }

    .gametype-list-thumbnail-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--rz-text-disabled-color);
    }

    .gametype-list-name {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .gametype-list-name strong {
        font-weight: 600;
        color: var(--rz-text-color);
    }

    .gametype-list-description {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.875rem;
        line-height: 1.4;
    }

    .gametype-list-image {
        font-size: 0.8rem;
        background: var(--rz-base-100);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        color: var(--rz-primary);
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .gametype-list-stats {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        font-size: 0.8rem;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--rz-text-secondary-color);
    }

    .gametype-list-actions {
        display: flex;
        gap: 0.25rem;
        justify-content: center;
    }

    /* DataGrid row hover effect */
    .rz-datatable-data tr:hover {
        background-color: var(--rz-base-50);
        cursor: pointer;
    }

    /* Legacy card styles kept for reference if needed */
    .gametype-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid var(--rz-border-color);
        display: flex;
        flex-direction: column;
    }

    .gametype-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        border-color: var(--rz-primary);
    }

    .gametype-thumbnail {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
        border-radius: 8px;
        margin-bottom: 1rem;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .thumbnail-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .thumbnail-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .gametype-card-header h5 {
        color: var(--rz-text-color);
        margin-bottom: 0;
        font-weight: 600;
    }

    .gametype-card-body {
        flex: 1;
    }

    .description-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        min-height: 3em;
    }

    .gametype-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .info-item {
        display: flex;
        gap: 0.75rem;
        align-items: start;
    }

    .info-icon {
        font-size: 1.25rem;
        color: var(--rz-primary);
        flex-shrink: 0;
        margin-top: 0.25rem;
    }

    .info-item small {
        font-size: 0.75rem;
    }

    .info-item span {
        font-size: 0.875rem;
    }

    .info-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .stat-badge {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        background: var(--rz-base-100);
        border-radius: 20px;
        font-size: 0.8rem;
        color: var(--rz-text-secondary-color);
    }

    .gametype-card-footer {
