@page "/gametypes"
@rendermode InteractiveServer
@using GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject IGameTypeApi GameTypeApi
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Game Type Manager</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Game Type Manager</h2>
        <RadzenButton Text="Add Game Type" 
                      Icon="add" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@(() => ShowGameTypeDialog(null))" />
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading game types...</p>
        </div>
    }
    else if (!gameTypes.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="sports_esports" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Game Types Found</h4>
                <p class="text-muted">Create your first game type to get started.</p>
                <RadzenButton Text="Add Game Type" 
                              Icon="add" 
                              ButtonStyle="ButtonStyle.Primary" 
                              Click="@(() => ShowGameTypeDialog(null))" 
                              class="mt-3" />
            </div>
        </RadzenCard>
    }
    else
    {
        <RadzenDataGrid Data="@gameTypes" 
                        TItem="GameTypeDefinition" 
                        AllowFiltering="true" 
                        AllowSorting="true" 
                        AllowPaging="true"
                        PageSize="10"
                        class="game-types-grid">
            <Columns>
                <RadzenDataGridColumn TItem="GameTypeDefinition" Title="Thumbnail" Width="80px" Sortable="false" Filterable="false">
                    <Template Context="gameType">
                        @if (!string.IsNullOrWhiteSpace(gameType.ThumbnailUrl))
                        {
                            <img src="@gameType.ThumbnailUrl" alt="@gameType.DisplayName" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" />
                        }
                        else
                        {
                            <RadzenIcon Icon="sports_esports" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GameTypeDefinition" Property="Key" Title="Key" Width="120px" />
                <RadzenDataGridColumn TItem="GameTypeDefinition" Property="DisplayName" Title="Display Name" Width="180px" />
                <RadzenDataGridColumn TItem="GameTypeDefinition" Property="Image" Title="Docker Image" Width="250px" />
                <RadzenDataGridColumn TItem="GameTypeDefinition" Title="Links" Width="100px" Sortable="false" Filterable="false">
                    <Template Context="gameType">
                        @if (!string.IsNullOrWhiteSpace(gameType.DocumentationUrl))
                        {
                            <a href="@gameType.DocumentationUrl" target="_blank" title="Documentation">
                                <RadzenIcon Icon="description" />
                            </a>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GameTypeDefinition" Title="Ports" Width="120px" Sortable="false" Filterable="false">
                    <Template Context="gameType">
                        <RadzenBadge Text="@gameType.Ports.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                        @if (gameType.Ports.Any())
                        {
                            <span class="ms-2 text-muted">@string.Join(", ", gameType.Ports.Select(p => p.Port))</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GameTypeDefinition" Title="Volumes" Width="80px" Sortable="false" Filterable="false">
                    <Template Context="gameType">
                        <RadzenBadge Text="@gameType.Volumes.Count.ToString()" BadgeStyle="BadgeStyle.Secondary" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GameTypeDefinition" Title="Actions" Width="150px" Sortable="false" Filterable="false">
                    <Template Context="gameType">
                        <div class="d-flex gap-2">
                            <RadzenButton Icon="edit" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Light" 
                                          Click="@(() => ShowGameTypeDialog(gameType))"
                                          title="Edit" />
                            <RadzenButton Icon="content_copy" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Light" 
                                          Click="@(() => DuplicateGameType(gameType))"
                                          title="Duplicate" />
                            <RadzenButton Icon="delete" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Danger" 
                                          Click="@(() => DeleteGameType(gameType))"
                                          title="Delete" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>

@code {
    private List<GameTypeDefinition> gameTypes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadGameTypesAsync();
    }

    private async Task LoadGameTypesAsync()
    {
        isLoading = true;
        try
        {
            var data = await GameTypeApi.GetAllAsync();
            gameTypes = data.ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Loading Game Types",
                Detail = $"Failed to load game types: {ex.Message}",
                Duration = 5000
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowGameTypeDialog(GameTypeDefinition? gameType)
    {
        var isNew = gameType == null;
        var dialogTitle = isNew ? "Add Game Type" : $"Edit Game Type: {gameType!.DisplayName}";
        
        var result = await DialogService.OpenAsync<GameTypeEditorDialog>(
            dialogTitle,
            new Dictionary<string, object>
            {
                { "GameType", gameType ?? new GameTypeDefinition() },
                { "IsNew", isNew }
            },
            new DialogOptions
            {
                Width = "900px",
                Height = "85vh",
                Resizable = true,
                Draggable = true
            });

        if (result is bool success && success)
        {
            await LoadGameTypesAsync();
        }
    }

    private async Task DuplicateGameType(GameTypeDefinition gameType)
    {
        var duplicate = new GameTypeDefinition
        {
            Key = $"{gameType.Key}_copy",
            DisplayName = $"{gameType.DisplayName} (Copy)",
            Description = gameType.Description,
            Image = gameType.Image,
            ThumbnailUrl = gameType.ThumbnailUrl,
            DocumentationUrl = gameType.DocumentationUrl,
            Ports = new List<PortDefinition>(gameType.Ports),
            Volumes = new List<VolumeDefinition>(gameType.Volumes),
            DefaultSettings = new Dictionary<string, string>(gameType.DefaultSettings ?? new Dictionary<string,string>())
        };

        await ShowGameTypeDialog(duplicate);
    }

    private async Task DeleteGameType(GameTypeDefinition gameType)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{gameType.DisplayName}'? This action cannot be undone.",
            "Delete Game Type",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await GameTypeApi.DeleteAsync(gameType.Key);
                
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Deleted",
                    Detail = $"'{gameType.DisplayName}' has been deleted successfully.",
                    Duration = 3000
                });

                await LoadGameTypesAsync();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Delete Failed",
                    Detail = $"Failed to delete game type: {ex.Message}",
                    Duration = 5000
                });
            }
        }
    }
}