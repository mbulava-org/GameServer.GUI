@page "/gametypes-v2"
@rendermode InteractiveServer
@using GameServer.Web.Models.V2
@using Radzen
@using Radzen.Blazor
@inject Services.V2.GameTypeV2ApiService GameTypeApiV2
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Game Types V2</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Game Types V2</h2>
            <p class="text-muted mb-0">Normalized GameType catalog built on the V2 persistence model.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <RadzenCheckBox @bind-Value="includeInactive" TValue="bool" Change="@(_ => LoadAsync())" />
            <span>Include inactive</span>
            <RadzenButton Text="Add Game Type"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@CreateNewGameType" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading V2 game types...</p>
        </div>
    }
    else if (!gameTypes.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="sports_esports" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No V2 Game Types Found</h4>
                <p class="text-muted">Create the first V2 game type to start defining revisions.</p>
                <RadzenButton Text="Add Game Type"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@CreateNewGameType"
                              class="mt-3" />
            </div>
        </RadzenCard>
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid Data="@gameTypes"
                            TItem="GameTypeListItem"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Advanced"
                            AllowColumnResize="true"
                            RowDoubleClick="@OnRowDoubleClick">
                <Columns>
                    <RadzenDataGridColumn TItem="GameTypeListItem"
                                          Property="ThumbnailUrl"
                                          Title=""
                                          Width="80px"
                                          Sortable="false"
                                          Filterable="false">
                        <Template Context="gameType">
                            @if (!string.IsNullOrWhiteSpace(gameType.ThumbnailUrl))
                            {
                                <img src="@gameType.ThumbnailUrl"
                                     alt="@gameType.DisplayName"
                                     class="gametype-list-thumbnail"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="gametype-list-thumbnail-fallback" style="display: none;">
                                    <RadzenIcon Icon="sports_esports" Style="font-size: 1.5rem;" />
                                </div>
                            }
                            else
                            {
                                <div class="gametype-list-thumbnail-fallback">
                                    <RadzenIcon Icon="sports_esports" Style="font-size: 1.5rem;" />
                                </div>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeListItem" Property="DisplayName" Title="Name" Width="220px">
                        <Template Context="gameType">
                            <div class="gametype-list-name">
                                <strong>@gameType.DisplayName</strong>
                                <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                             Text="@gameType.Key"
                                             Variant="Variant.Outlined"
                                             Size="BadgeSize.ExtraSmall"
                                             class="ms-2" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeListItem" Property="ImageReference" Title="Docker Image" Width="240px">
                        <Template Context="gameType">
                            <code class="gametype-list-image">@gameType.ImageReference</code>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeListItem" Title="Current Revision" Width="150px" Sortable="false" Filterable="false">
                        <Template Context="gameType">
                            @if (!string.IsNullOrWhiteSpace(gameType.CurrentVersionTag))
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@gameType.CurrentVersionTag" />
                            }
                            else
                            {
                                <span class="text-muted">No current revision</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeListItem" Title="Revisions" Width="120px" Sortable="false" Filterable="false">
                        <Template Context="gameType">
                            <span>@gameType.RevisionCount total / @gameType.PublishedRevisionCount published</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeListItem" Property="IsActive" Title="Active" Width="90px">
                        <Template Context="gameType">
                            <RadzenBadge BadgeStyle="@(gameType.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)"
                                         Text="@(gameType.IsActive ? "Yes" : "No")" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameTypeListItem" Property="UpdatedAt" Title="Updated" Width="160px">
                        <Template Context="gameType">
                            <span>@gameType.UpdatedAt.ToLocalTime().ToString("g")</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</div>

<style>
    .gametype-list-thumbnail,
    .gametype-list-thumbnail-fallback {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
        background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
    }

    .gametype-list-thumbnail-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--rz-text-disabled-color);
    }

    .gametype-list-name {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .gametype-list-image {
        font-size: 0.8rem;
        word-break: break-word;
    }
</style>

@code {
    private readonly List<GameTypeListItem> gameTypes = [];
    private bool includeInactive;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            gameTypes.Clear();
            gameTypes.AddRange(await GameTypeApiV2.GetListAsync(includeInactive));
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Load failed", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CreateNewGameType()
    {
        Navigation.NavigateTo("/gametypes-v2/new");
    }

    private void OnRowDoubleClick(DataGridRowMouseEventArgs<GameTypeListItem> args)
    {
        Navigation.NavigateTo($"/gametypes-v2/{Uri.EscapeDataString(args.Data.Key)}");
    }
}
