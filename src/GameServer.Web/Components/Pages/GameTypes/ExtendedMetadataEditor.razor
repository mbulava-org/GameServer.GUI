@attribute [Obsolete("Legacy pre-V2 extended metadata editor. Migrate to V2 revision metadata before removing the old repository chain.")]
@using global::GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject IGameTypeExtendedMetadataApi MetadataApi
@inject IGameTypeApi GameTypeApi
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenCard>
  <ChildContent>
    <div class="mb-4">
      <h4><RadzenIcon Icon="extension" /> Extended Metadata</h4>
      <p class="text-muted mb-0">Configure advanced settings metadata, TTY support, and custom properties</p>
    </div>

    @if (loading)
    {
      <div class="text-center py-4">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        <p class="text-muted">Loading metadata...</p>
      </div>
    }
    else if (metadata == null)
    {
      <div class="text-center py-4">
        <RadzenIcon Icon="note_add" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
        <p class="text-muted mt-2">No extended metadata defined yet.</p>
        <RadzenButton Text="Initialize Metadata" 
                      Icon="add" 
                      ButtonStyle="ButtonStyle.Primary"
                      Click="InitializeMetadata" />
      </div>
    }
    else
    {
      <RadzenTabs>
        <Tabs>
          <RadzenTabsItem Text="General Settings">
            <div class="p-3">
              <RadzenCard>
                <div class="mb-3">
                  <RadzenLabel Text="Enable TTY (Pseudo-Terminal)" class="d-flex align-items-center gap-2" />
                  <RadzenCheckBox @bind-Value="metadata.EnableTTY" />
                  <small class="text-muted d-block mt-1">
                    Enable for interactive console-based game servers that require terminal emulation
                  </small>
                </div>
              </RadzenCard>
            </div>
          </RadzenTabsItem>

          <RadzenTabsItem Text="Settings Metadata">
            <div class="p-3">
              <RadzenCard>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div>
                    <h5 class="mb-1">Environment Variable Metadata</h5>
                    <small class="text-muted">Define validation, display info, and behavior for settings</small>
                  </div>
                  <RadzenButton Text="Add Setting" 
                                Icon="add" 
                                Size="ButtonSize.Small"
                                Click="AddNewSettingMetadata" />
                </div>

                @if (!metadata.SettingsMetadata.Any())
                {
                  <p class="text-center text-muted py-4">No setting metadata defined. Click "Add Setting" to start.</p>
                }
                else
                {
                  <div class="settings-list">
                    @foreach (var kvp in metadata.SettingsMetadata.OrderBy(x => x.Value.DisplayOrder))
                    {
                      var setting = kvp.Value;
                      var isExpanded = expandedSettings.Contains(kvp.Key);
                      
                      <RadzenCard class="setting-card mb-3">
                        <div class="setting-header" @onclick="@(() => ToggleSettingExpansion(kvp.Key))">
                          <div class="setting-header-left">
                            <RadzenIcon Icon="@(isExpanded ? "expand_less" : "expand_more")" 
                                        class="expand-icon" />
                            <div class="setting-info">
                              <div class="setting-title">
                                <code class="setting-key">@kvp.Key</code>
                                @if (setting.IsRequired)
                                {
                                  <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Required" Size="BadgeSize.Small" />
                                }
                                @if (!string.IsNullOrWhiteSpace(setting.DataType))
                                {
                                  <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                                               Text="@setting.DataType" 
                                               Variant="Variant.Outlined"
                                               Size="BadgeSize.Small" />
                                }
                                @if (setting.MapsToContainerPort)
                                {
                                  <RadzenBadge BadgeStyle="BadgeStyle.Warning" 
                                               Text="Port" 
                                               Size="BadgeSize.Small" />
                                }
                              </div>
                              @if (!string.IsNullOrWhiteSpace(setting.Description))
                              {
                                <div class="setting-description">@setting.Description</div>
                              }
                            </div>
                          </div>
                          <div class="setting-header-right" @onclick:stopPropagation="true">
                            <RadzenButton Icon="delete" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => DeleteSettingMetadata(kvp.Key))"
                                          title="Delete" />
                          </div>
                        </div>

                        @if (isExpanded)
                        {
                          <div class="setting-editor">
                            <RadzenStack Gap="1rem">
                              <div class="row g-3">
                                <div class="col-md-6">
                                  <RadzenFormField Text="Key" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="@setting.Key" 
                                                   Disabled="true"
                                                   class="w-100" />
                                  </RadzenFormField>
                                  <small class="text-muted">Environment variable name (cannot be changed)</small>
                                </div>

                                <div class="col-md-6">
                                  <RadzenFormField Text="Data Type" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenDropDown @bind-Value="@setting.DataType"
                                                    Data="@dataTypes"
                                                    AllowClear="false"
                                                    Placeholder="Select type..."
                                                    class="w-100" />
                                  </RadzenFormField>
                                  <small class="text-muted">Default: string</small>
                                </div>

                                <div class="col-12">
                                  <RadzenFormField Text="Description" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextArea @bind-Value="@setting.Description" 
                                                    Rows="2"
                                                    Placeholder="User-friendly description"
                                                    class="w-100" />
                                  </RadzenFormField>
                                </div>

                                <div class="col-md-4">
                                  <RadzenFormField Text="Category" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="@setting.Category" 
                                                   Placeholder="General"
                                                   class="w-100" />
                                  </RadzenFormField>
                                </div>

                                <div class="col-md-4">
                                  <RadzenFormField Text="Display Order" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenNumeric @bind-Value="@setting.DisplayOrder" 
                                                   Min="0"
                                                   class="w-100" />
                                  </RadzenFormField>
                                </div>

                                <div class="col-md-4">
                                  <RadzenFormField Text="Placeholder" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="@setting.Placeholder" 
                                                   Placeholder="Default hint"
                                                   class="w-100" />
                                  </RadzenFormField>
                                </div>

                                <div class="col-md-6">
                                  <div class="checkbox-group">
                                    <RadzenCheckBox @bind-Value="@setting.IsRequired" />
                                    <RadzenLabel Text="Required" class="ms-2" />
                                  </div>
                                  <small class="text-muted">User must provide a value</small>
                                </div>

                                <div class="col-md-6">
                                  <div class="checkbox-group">
                                    <RadzenCheckBox @bind-Value="@setting.CannotBeEmpty" />
                                    <RadzenLabel Text="Cannot Be Empty" class="ms-2" />
                                  </div>
                                  <small class="text-muted">Value cannot be blank</small>
                                </div>

                                @if (setting.DataType == "enum")
                                {
                                  <div class="col-12">
                                    <RadzenFormField Text="Allowed Values (comma-separated)" Variant="@Variant.Outlined" class="w-100">
                                      <RadzenTextBox Value="@GetAllowedValuesString(setting)" 
                                                     ValueChanged="@((string value) => SetAllowedValues(setting, value))"
                                                     Placeholder="easy,normal,hard"
                                                     class="w-100" />
                                    </RadzenFormField>
                                    <small class="text-muted">Dropdown options for this setting</small>
                                  </div>

                                  <div class="col-12">
                                    <RadzenFormField Text="Value Mappings (JSON format)" Variant="@Variant.Outlined" class="w-100">
                                      <RadzenTextArea Value="@GetValueMappingsJson(setting)"
                                                      ValueChanged="@((string value) => SetValueMappings(setting, value))"
                                                      Rows="3"
                                                      Placeholder='{"easy": "Easy - Reduced difficulty", "normal": "Normal - Standard", "hard": "Hard - Challenging"}'
                                                      class="w-100" />
                                    </RadzenFormField>
                                    <small class="text-muted">Display descriptions for each value</small>
                                  </div>
                                }

                                @if (setting.DataType == "port")
                                {
                                  <div class="col-md-6">
                                    <div class="checkbox-group">
                                      <RadzenCheckBox @bind-Value="@setting.MapsToContainerPort" />
                                      <RadzenLabel Text="Maps to Container Port" class="ms-2" />
                                    </div>
                                    <small class="text-muted">This setting controls a port mapping</small>
                                  </div>

                                  @if (setting.MapsToContainerPort)
                                  {
                                    <div class="col-md-3">
                                      <RadzenFormField Text="Linked Container Port" Variant="@Variant.Outlined" class="w-100">
                                        <RadzenNumeric @bind-Value="@setting.LinkedContainerPort" 
                                                       Min="1" Max="65535"
                                                       class="w-100" />
                                      </RadzenFormField>
                                    </div>

                                    <div class="col-md-3">
                                      <RadzenFormField Text="Protocol" Variant="@Variant.Outlined" class="w-100">
                                        <RadzenDropDown @bind-Value="@setting.PortProtocol"
                                                        Data="@(new[] { "tcp", "udp" })"
                                                        class="w-100" />
                                      </RadzenFormField>
                                    </div>
                                  }
                                }

                                @* Web Hosts Section - For configuring web-accessible endpoints *@
                                @if (setting.DataType == "port")
                                {
                                  <div class="col-12 mt-3">
                                    <RadzenCard Style="background: var(--rz-base-50); padding: 1rem;">
                                      <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                          <h6 class="mb-1">
                                            <RadzenIcon Icon="public" /> Web Hosts
                                          </h6>
                                          <small class="text-muted">Configure web-accessible endpoints (HTTP/HTTPS) for this port</small>
                                        </div>
                                        <RadzenButton Text="Add Web Host" 
                                                      Icon="add" 
                                                      Size="ButtonSize.ExtraSmall"
                                                      ButtonStyle="ButtonStyle.Success"
                                                      Click="@(() => AddWebHost(setting))" />
                                      </div>

                                      @if (setting.WebHosts == null || !setting.WebHosts.Any())
                                      {
                                        <p class="text-center text-muted mb-0">
                                          <small>No web hosts configured. This port won't be accessible via load balancer.</small>
                                        </p>
                                      }
                                      else
                                      {
                                        <RadzenStack Gap="0.5rem">
                                          @foreach (var webHost in setting.WebHosts.ToList())
                                          {
                                            var webHostIndex = setting.WebHosts.ToList().IndexOf(webHost);
                                            <RadzenCard Style="padding: 0.75rem;">
                                              <div class="row g-2">
                                                <div class="col-md-3">
                                                  <RadzenFormField Text="Protocol *" Variant="@Variant.Outlined" class="w-100">
                                                    <RadzenDropDown @bind-Value="@webHost.Protocol"
                                                                    Data="@(new[] { "http", "https", "tcp", "udp" })"
                                                                    AllowClear="false"
                                                                    class="w-100" />
                                                  </RadzenFormField>
                                                </div>

                                                <div class="col-md-4">
                                                  <RadzenFormField Text="Subdomain Pattern *" Variant="@Variant.Outlined" class="w-100">
                                                    <RadzenTextBox @bind-Value="@webHost.SubdomainPattern"
                                                                   Placeholder="{serverName}"
                                                                   class="w-100" />
                                                  </RadzenFormField>
                                                  <small class="text-muted">Variables: {serverName}, {serverId}</small>
                                                  @if (string.IsNullOrWhiteSpace(webHost.SubdomainPattern))
                                                  {
                                                    <small class="text-danger">⚠️ Subdomain pattern is required</small>
                                                  }
                                                </div>

                                                <div class="col-md-2">
                                                  <RadzenFormField Text="Port Source *" Variant="@Variant.Outlined" class="w-100">
                                                    <RadzenDropDown TValue="string"
                                                                    Value="@webHost.PortSource"
                                                                    ValueChanged="@((string value) => OnPortSourceChanged(webHost, value))"
                                                                    Data="@(new[] { "Setting", "ContainerPort" })"
                                                                    AllowClear="false"
                                                                    class="w-100" />
                                                  </RadzenFormField>
                                                </div>

                                                @if (webHost.PortSource == "Setting")
                                                {
                                                  <div class="col-md-2">
                                                    <RadzenFormField Text="Setting Key *" Variant="@Variant.Outlined" class="w-100">
                                                      <RadzenTextBox @bind-Value="@webHost.PortSettingKey"
                                                                     Placeholder="@setting.Key"
                                                                     class="w-100" />
                                                    </RadzenFormField>
                                                    @if (string.IsNullOrWhiteSpace(webHost.PortSettingKey))
                                                    {
                                                      <small class="text-danger">⚠️ Setting key is required</small>
                                                    }
                                                  </div>
                                                }
                                                else
                                                {
                                                  <div class="col-md-2">
                                                    <RadzenFormField Text="Container Port *" Variant="@Variant.Outlined" class="w-100">
                                                      <RadzenNumeric TValue="int?" 
                                                                     Value="@webHost.PortContainerPort"
                                                                     ValueChanged="@((int? value) => webHost.PortContainerPort = value)"
                                                                     Min="1" 
                                                                     Max="65535"
                                                                     ShowUpDown="false"
                                                                     class="w-100" />
                                                    </RadzenFormField>
                                                    @if (!webHost.PortContainerPort.HasValue || webHost.PortContainerPort.Value < 1)
                                                    {
                                                      <small class="text-danger">⚠️ Port is required (1-65535)</small>
                                                    }
                                                  </div>
                                                }

                                                <div class="col-md-1 d-flex align-items-end">
                                                  <RadzenButton Icon="delete"
                                                                Size="ButtonSize.Small"
                                                                ButtonStyle="ButtonStyle.Danger"
                                                                Click="@(() => RemoveWebHost(setting, webHostIndex))"
                                                                title="Remove" />
                                                </div>

                                                <div class="col-12">
                                                  <div class="d-flex gap-3">
                                                    <div class="checkbox-group">
                                                      <RadzenCheckBox @bind-Value="@webHost.EnableLoadBalancer" />
                                                      <RadzenLabel Text="Enable Load Balancer" class="ms-2" />
                                                    </div>
                                                    <small class="text-muted">Priority: @webHost.Priority</small>
                                                  </div>
                                                </div>
                                              </div>
                                            </RadzenCard>
                                          }
                                        </RadzenStack>
                                      }
                                    </RadzenCard>
                                  </div>
                                }

                                <div class="col-md-6">
                                  <RadzenFormField Text="Validation Pattern (Regex)" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="@setting.ValidationPattern" 
                                                   Placeholder="^[0-9]+$"
                                                   class="w-100" />
                                  </RadzenFormField>
                                </div>

                                <div class="col-md-6">
                                  <RadzenFormField Text="Validation Message" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="@setting.ValidationMessage" 
                                                   Placeholder="Error message"
                                                   class="w-100" />
                                  </RadzenFormField>
                                </div>
                              </div>
                            </RadzenStack>
                          </div>
                        }
                      </RadzenCard>
                    }
                  </div>
                }
              </RadzenCard>
            </div>
          </RadzenTabsItem>

          <RadzenTabsItem Text="Custom Properties">
            <div class="p-3">
              <RadzenCard>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div>
                    <h5 class="mb-1">Custom Properties</h5>
                    <small class="text-muted">Key-value pairs for extensibility</small>
                  </div>
                  <RadzenButton Text="Add Property" 
                                Icon="add" 
                                Size="ButtonSize.Small"
                                Click="ShowAddCustomProperty" />
                </div>

                @if (!metadata.CustomProperties.Any())
                {
                  <p class="text-center text-muted py-4">No custom properties defined.</p>
                }
                else
                {
                  <div class="custom-properties-list">
                    @foreach (var prop in metadata.CustomProperties)
                    {
                      <div class="custom-property-item">
                        <div class="property-key">
                          <RadzenIcon Icon="key" Style="font-size: 1rem;" />
                          <code>@prop.Key</code>
                        </div>
                        <div class="property-value">
                          <code>@prop.Value</code>
                        </div>
                        <div class="property-actions">
                          <RadzenButton Icon="delete" 
                                        Size="ButtonSize.Small" 
                                        ButtonStyle="ButtonStyle.Danger"
                                        Click="@(() => DeleteCustomProperty(prop.Key))" />
                        </div>
                      </div>
                    }
                  </div>
                }
              </RadzenCard>
            </div>
          </RadzenTabsItem>

          <RadzenTabsItem Text="Web Hosts">
            <div class="p-3">
                            <WebHostsEditor WebHosts="@(metadata.WebHosts?.ToList() ?? new List<global::GameServer.Docker.Client.WebHostDefinition>())"
                              AvailableSettings="@GetAvailableSettings()" />
            </div>
          </RadzenTabsItem>
        </Tabs>
      </RadzenTabs>

      <div class="d-flex justify-content-end gap-2 mt-3">
        <RadzenButton Text="Save All Changes" 
                      Icon="save" 
                      ButtonStyle="ButtonStyle.Success"
                      Click="SaveMetadata" />
      </div>
    }
  </ChildContent>
</RadzenCard>

<style>
  .custom-properties-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .custom-property-item {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--rz-border-color);
    border-radius: 6px;
    align-items: center;
  }

  .property-key {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .property-key code,
  .property-value code {
    background: var(--rz-base-100);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }

  .settings-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .setting-card {
    border: 1px solid var(--rz-border-color);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .setting-card:hover {
    border-color: var(--rz-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .setting-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
    padding: 0.5rem;
    margin: -0.75rem;
    margin-bottom: 0;
    border-radius: 6px;
    transition: background-color 0.2s;
  }

  .setting-header:hover {
    background-color: var(--rz-base-50);
  }

  .setting-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
  }

  .setting-header-right {
    display: flex;
    gap: 0.5rem;
  }

  .expand-icon {
    font-size: 1.5rem;
    color: var(--rz-text-secondary-color);
    transition: transform 0.2s;
  }

  .setting-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .setting-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .setting-key {
    font-size: 1rem;
    font-weight: 600;
    font-family: 'Courier New', monospace;
    color: var(--rz-primary);
    background: var(--rz-base-100);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .setting-description {
    font-size: 0.875rem;
    color: var(--rz-text-secondary-color);
    line-height: 1.4;
  }

  .setting-editor {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--rz-border-color);
  }

  .checkbox-group {
    display: flex;
    align-items: center;
  }

  @@media (max-width: 768px) {
    .setting-header-left {
      flex-direction: column;
      align-items: flex-start;
    }

    .custom-property-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>

@code {
[Parameter] public string GameTypeKey { get; set; } = "";

private GameTypeExtendedMetadata? metadata;
private GameTypeDefinition? gameTypeDefinition;
private bool loading = false;
private HashSet<string> expandedSettings = new();
private List<string> dataTypes = new() { "string", "number", "boolean", "enum", "list", "port", "timezone" };

protected override async Task OnInitializedAsync()
{
  await LoadMetadataAsync();
}

protected override async Task OnParametersSetAsync()
{
  if (!string.IsNullOrEmpty(GameTypeKey))
  {
    await LoadMetadataAsync();
  }
}

private async Task LoadMetadataAsync()
{
  if (string.IsNullOrEmpty(GameTypeKey)) return;

  loading = true;
  try
  {
    // Load game type definition for defaults
    gameTypeDefinition = await GameTypeApi.GetAsync(GameTypeKey);
        
    // Try to load existing metadata
    metadata = await MetadataApi.GetAsync(GameTypeKey);
  }
  catch (Exception)
  {
    NotificationService.Notify(new NotificationMessage
    {
      Severity = NotificationSeverity.Warning,
      Summary = "No Metadata Found",
      Detail = "No extended metadata exists for this game type yet.",
      Duration = 3000
    });
    metadata = null;
  }
  finally
  {
    loading = false;
  }
}

private void ToggleSettingExpansion(string key)
{
  if (expandedSettings.Contains(key))
  {
    expandedSettings.Remove(key);
  }
  else
  {
    expandedSettings.Add(key);
  }
  StateHasChanged();
}

private async Task AddNewSettingMetadata()
{
  if (metadata == null || gameTypeDefinition == null) return;

  // Prompt for new key
  var result = await DialogService.OpenAsync("Add Setting", ds =>
    @<div>
      <RadzenStack Gap="1rem">
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
          Enter a setting key (environment variable name) to add metadata for.
        </RadzenAlert>
          
        <RadzenFormField Text="Setting Key" Variant="@Variant.Outlined">
          <RadzenTextBox @bind-Value="@newSettingKey" 
                         Placeholder="SETTING_NAME"
                         class="w-100" />
        </RadzenFormField>

        <div class="d-flex justify-content-end gap-2">
          <RadzenButton Text="Cancel" Click="@(() => ds.Close())" ButtonStyle="ButtonStyle.Light" />
          <RadzenButton Text="Add" 
                        Click="@(() => ds.Close(newSettingKey))" 
                        ButtonStyle="ButtonStyle.Success"
                        Disabled="@string.IsNullOrWhiteSpace(newSettingKey)" />
        </div>
      </RadzenStack>
    </div>, new DialogOptions { Width = "500px" });

  if (result is string keyValue && !string.IsNullOrWhiteSpace(keyValue))
  {
    if (metadata.SettingsMetadata.ContainsKey(keyValue))
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Warning,
        Summary = "Duplicate Key",
        Detail = $"Setting '{keyValue}' already exists.",
        Duration = 3000
      });
      return;
    }

    // Get default value if available
    var defaultValue = "";
    if (gameTypeDefinition.DefaultSettings?.TryGetValue(keyValue, out var defVal) == true)
    {
      defaultValue = defVal;
    }

    var newSetting = new SettingMetadata
    {
      Key = keyValue,
      Description = $"Default value: {defaultValue}",
      DataType = "string", // Default to string type
      DisplayOrder = metadata.SettingsMetadata.Count,
      Category = "General",
      Placeholder = defaultValue
    };

    metadata.SettingsMetadata[keyValue] = newSetting;
    expandedSettings.Add(keyValue); // Auto-expand the new setting
    StateHasChanged();

    NotificationService.Notify(new NotificationMessage
    {
      Severity = NotificationSeverity.Success,
      Summary = "Setting Added",
      Detail = $"'{keyValue}' has been added. Configure it below.",
      Duration = 3000
    });
  }
}
  
private string newSettingKey = "";

private string GetAllowedValuesString(SettingMetadata setting)
{
  return setting.AllowedValues != null ? string.Join(",", setting.AllowedValues) : "";
}

private void SetAllowedValues(SettingMetadata setting, string value)
{
  if (string.IsNullOrWhiteSpace(value))
  {
    setting.AllowedValues = null;
  }
  else
  {
    setting.AllowedValues = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
  }
  StateHasChanged();
}

private string GetValueMappingsJson(SettingMetadata setting)
{
  if (setting.ValueMappings == null || !setting.ValueMappings.Any())
    return "";

  try
  {
    return System.Text.Json.JsonSerializer.Serialize(setting.ValueMappings, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
  }
  catch
  {
    return "";
  }
}

private void SetValueMappings(SettingMetadata setting, string json)
{
  if (string.IsNullOrWhiteSpace(json))
  {
    setting.ValueMappings = null;
    StateHasChanged();
    return;
  }

  try
  {
    var mappings = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json);
    setting.ValueMappings = mappings;
    StateHasChanged();
  }
  catch (Exception)
  {
    NotificationService.Notify(new NotificationMessage
    {
      Severity = NotificationSeverity.Error,
      Summary = "Invalid JSON",
      Detail = "Value mappings must be valid JSON format.",
      Duration = 3000
    });
  }
}

  private async Task DeleteSettingMetadata(string key)
  {
    bool confirmed = false;
    try
    {
      confirmed = await DialogService.Confirm($"Delete setting metadata for '{key}'?", "Confirm Delete", 
        new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" }) ?? false;
    }
    catch
    {
      confirmed = true;
    }

    if (confirmed)
    {
      metadata!.SettingsMetadata.Remove(key);
      expandedSettings.Remove(key);
      StateHasChanged();

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "Setting Deleted",
        Detail = $"Metadata for '{key}' has been removed.",
        Duration = 3000
      });
    }
  }

  private async Task InitializeMetadata()
  {
    if (gameTypeDefinition == null)
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Error",
        Detail = "Game type definition not loaded.",
        Duration = 3000
      });
      return;
    }

    metadata = new GameTypeExtendedMetadata
    {
      GameTypeKey = GameTypeKey,
      EnableTTY = false,
      SettingsMetadata = new Dictionary<string, SettingMetadata>(),
      CustomProperties = new Dictionary<string, string>()
    };

    // Import all DefaultSettings as SettingMetadata with basic configuration
    if (gameTypeDefinition.DefaultSettings != null)
    {
      int displayOrder = 0;
      foreach (var setting in gameTypeDefinition.DefaultSettings)
      {
        var settingMetadata = new SettingMetadata
        {
          Key = setting.Key,
          Description = $"Default value: {setting.Value}",
          IsRequired = false,
          CannotBeEmpty = false,
          DataType = "string", // Default to string type
          DisplayOrder = displayOrder++,
          Category = "General",
          Placeholder = setting.Value
        };

        metadata.SettingsMetadata[setting.Key] = settingMetadata;
      }

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "Initialized",
        Detail = $"Imported {gameTypeDefinition.DefaultSettings.Count} settings from game type definition.",
        Duration = 3000
      });
    }

    await SaveMetadata();
  }

  private async Task ShowAddCustomProperty()
  {
    var key = "";
    var value = "";

    var result = await DialogService.OpenAsync("Add Custom Property", ds =>
      @<div>
        <RadzenStack Gap="1rem">
          <RadzenFormField Text="Key" Variant="@Variant.Outlined">
            <RadzenTextBox @bind-Value="@key" Placeholder="PropertyName" />
          </RadzenFormField>
          <RadzenFormField Text="Value" Variant="@Variant.Outlined">
            <RadzenTextBox @bind-Value="@value" Placeholder="PropertyValue" />
          </RadzenFormField>
          <div class="d-flex justify-content-end gap-2">
            <RadzenButton Text="Cancel" Click="@(() => ds.Close())" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="Add" Click="@(() => ds.Close((key, value)))" 
                          ButtonStyle="ButtonStyle.Success" 
                          Disabled="@string.IsNullOrWhiteSpace(key)" />
          </div>
        </RadzenStack>
      </div>, new DialogOptions { Width = "500px" });

    if (result is (string propKey, string propValue))
    {
      metadata!.CustomProperties[propKey] = propValue;
      StateHasChanged();
    }
  }

  private void DeleteCustomProperty(string key)
  {
    metadata!.CustomProperties.Remove(key);
    StateHasChanged();
  }

  // Web Host Management Methods
  private void AddWebHost(SettingMetadata setting)
  {
    var list = setting.WebHosts?.ToList() ?? new List<WebHost>();

    var newWebHost = new WebHost
    {
      Protocol = "https",
      SubdomainPattern = "{serverName}",
      PortSource = "Setting",
      PortSettingKey = setting.Key,
      Priority = list.Count + 1,
      EnableLoadBalancer = true
    };

    list.Add(newWebHost);
    setting.WebHosts = list;
    StateHasChanged();

    NotificationService.Notify(new NotificationMessage
    {
      Severity = NotificationSeverity.Success,
      Summary = "Web Host Added",
      Detail = "New web host configuration added. Configure the details below.",
      Duration = 3000
    });
  }

  private void OnPortSourceChanged(WebHost webHost, string newSource)
  {
    webHost.PortSource = newSource;

    // Initialize default values when switching port source
    if (newSource == "ContainerPort")
    {
      // Set a default port if not already set
      if (!webHost.PortContainerPort.HasValue)
      {
        webHost.PortContainerPort = 8080;
      }
      webHost.PortSettingKey = null;
    }
    else
    {
      // Clear container port when switching to Setting
      webHost.PortContainerPort = null;
    }

    StateHasChanged();
  }

  private void RemoveWebHost(SettingMetadata setting, int index)
  {
    if (setting.WebHosts != null && index >= 0 && index < setting.WebHosts.Count)
    {
      var list = setting.WebHosts.ToList();
      list.RemoveAt(index);
      setting.WebHosts = list;

      // Reorder priorities
      for (int i = 0; i < list.Count; i++)
      {
        list[i].Priority = i + 1;
      }

      StateHasChanged();

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Info,
        Summary = "Web Host Removed",
        Detail = "Web host configuration has been removed.",
        Duration = 2000
      });
    }
  }

  private async Task SaveMetadata()
  {
    if (metadata == null || string.IsNullOrEmpty(metadata.GameTypeKey)) return;

    try
    {
      // Debug: Log the metadata before saving
      var webHostCount = metadata.SettingsMetadata.Values
        .Where(s => s.WebHosts != null)
        .Sum(s => s.WebHosts.Count);

      Console.WriteLine($"Saving metadata with {webHostCount} total web hosts across all settings");

      await MetadataApi.SaveAsync(metadata.GameTypeKey, metadata);

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "Saved",
        Detail = $"Extended metadata saved successfully. ({webHostCount} web hosts configured)",
        Duration = 3000
      });

      await LoadMetadataAsync();
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Save error: {ex.Message}");
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Save Failed",
        Detail = $"Failed to save metadata: {ex.Message}",
        Duration = 5000
      });
    }
  }

  private List<string> GetAvailableSettings()
  {
    if (gameTypeDefinition?.DefaultSettings == null)
      return new List<string>();

    return gameTypeDefinition.DefaultSettings.Keys.ToList();
  }
}
