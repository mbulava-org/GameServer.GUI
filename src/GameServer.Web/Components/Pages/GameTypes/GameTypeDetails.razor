                                                    <small class="text-muted">Port inside the container</small>
                                                </div>

                                                <div class="col-12">
                                                    <RadzenFormField Text="Description" Variant="@Variant.Outlined" class="w-100">
                                                        <RadzenTextArea @bind-Value="@webHost.Description"
                                                                        Rows="2"
                                                                        Placeholder="Brief description of this interface"
                                                                        class="w-100" />
                                                    </RadzenFormField>
                                                </div>

                                                <div class="col-md-6">
                                                    <RadzenFormField Text="Path Segment (optional)" Variant="@Variant.Outlined" class="w-100">
                                                        <RadzenTextBox @bind-Value="@webHost.PathSegment"
                                                                       Placeholder="Defaults to lowercase name"
                                                                       class="w-100" />
                                                    </RadzenFormField>
                                                    <small class="text-muted">URL path: /game-{serverId}/<strong>@(webHost.PathSegment ?? webHost.Name?.ToLowerInvariant() ?? "path")</strong>/</small>
