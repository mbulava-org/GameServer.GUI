@code {
[Parameter] public string? Key { get; set; }

private GameTypeDefinition? gameType;
private List<SettingItem> settingsList = new();
private Dictionary<string, SettingMetadata> settingsMetadata = new();
private HashSet<string> expandedSettingsKeys = new();
private string? selectedSettingKey = null;
private bool enableTTY = false;
private List<global::GameServer.Docker.Client.WebHostDefinition> webHosts = new();
private List<string> dataTypes = new() { "string", "number", "boolean", "enum", "list", "port", "timezone" };
private List<string> availableTimeZones = new();
private PortRelationshipType[] portRelationshipTypes = Enum.GetValues<PortRelationshipType>();
private bool isNew = false;
private bool isLoading = true;
private bool isSaving = false;

protected override async Task OnInitializedAsync()
{
    // Load all available time zones
    availableTimeZones = TimeZoneInfo.GetSystemTimeZones()
        .Select(tz => tz.Id)
        .OrderBy(id => id)
        .ToList();

    await LoadGameTypeAsync();
}

protected override async Task OnParametersSetAsync()
{
    await LoadGameTypeAsync();
}

private async Task LoadGameTypeAsync()
{
    isLoading = true;
    StateHasChanged(); // Force UI update
        
    try
    {
        // Determine if we're creating new or editing existing
        if (string.IsNullOrEmpty(Key) || Key.Equals("new", StringComparison.OrdinalIgnoreCase))
        {
            // Creating a new game type
            isNew = true;
            gameType = new GameTypeDefinition
            {
                Key = "",
                DisplayName = "",
                Description = "",
                Image = "",
                Ports = new List<PortDefinition>(),
                Volumes = new List<VolumeDefinition>(),
                DefaultSettings = new Dictionary<string, string>()
            };
            settingsList = new List<SettingItem>();
                
            Console.WriteLine("GameTypeDetails: Creating new game type");
        }
        else
        {
            // Loading existing game type
            isNew = false;
                
            Console.WriteLine($"GameTypeDetails: Loading game type with key: {Key}");
                
            gameType = await GameTypeApi.GetAsync(Key);
                
            if (gameType == null)
            {
                throw new Exception($"Game type '{Key}' not found");
            }
                
            Console.WriteLine($"GameTypeDetails: Loaded game type: {gameType.DisplayName}");
                
            // Initialize collections if null
            gameType.Ports ??= new List<PortDefinition>();
            gameType.Volumes ??= new List<VolumeDefinition>();
            gameType.DefaultSettings ??= new Dictionary<string, string>();
                
            // Convert DefaultSettings dictionary to list for editing
            settingsList = gameType.DefaultSettings
                .Select(kvp => new SettingItem { Key = kvp.Key, Value = kvp.Value })
                .ToList();

            // Try to load extended metadata
            try
            {
                var extendedMetadata = await MetadataApi.GetAsync(Key);
                if (extendedMetadata != null)
                {
                    // Load TTY setting
                    enableTTY = extendedMetadata.EnableTTY;

                    // Load WebHosts
                    webHosts = extendedMetadata.WebHosts?.ToList() ?? new List<global::GameServer.Docker.Client.WebHostDefinition>();

                    // Load existing metadata and ensure DataType defaults to "string" if not set
                    if (extendedMetadata.SettingsMetadata != null)
                    {
                        settingsMetadata = new Dictionary<string, SettingMetadata>();
                        foreach (var kvp in extendedMetadata.SettingsMetadata)
                        {
                            var meta = kvp.Value;
                            // Default to string if DataType is null or empty
                            if (string.IsNullOrWhiteSpace(meta.DataType))
                            {
                                meta.DataType = "string";
                            }
                            settingsMetadata[kvp.Key] = meta;
                        }
                        Console.WriteLine($"GameTypeDetails: Loaded extended metadata with {settingsMetadata.Count} settings");
                    }
                    else
                    {
                        settingsMetadata = new Dictionary<string, SettingMetadata>();
                    }
                }
                else
                {
                    // No metadata exists yet, initialize empty
                    enableTTY = false;
                    webHosts = new List<global::GameServer.Docker.Client.WebHostDefinition>();
                    settingsMetadata = new Dictionary<string, SettingMetadata>();
                    Console.WriteLine("GameTypeDetails: No extended metadata found, starting fresh");
                }
            }
            catch (Exception metadataEx)
            {
                // Extended metadata is optional, don't fail if it doesn't exist
                Console.WriteLine($"GameTypeDetails: Could not load extended metadata: {metadataEx.Message}");
                enableTTY = false;
                webHosts = new List<global::GameServer.Docker.Client.WebHostDefinition>();
                settingsMetadata = new Dictionary<string, SettingMetadata>();
            }
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"GameTypeDetails: Error loading game type: {ex.Message}");
            
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Error Loading Game Type",
            Detail = $"Failed to load game type: {ex.Message}",
            Duration = 5000,
            CloseOnClick = true
        });
            
        // Navigate back on error
        Navigation.NavigateTo("/gametypes");
    }
    finally
    {
        isLoading = false;
        StateHasChanged(); // Force UI update
    }
}

    private void AddSetting()
    {
        var newKey = $"NEW_SETTING_{settingsList.Count + 1}";
        var newSetting = new SettingItem { Key = newKey, Value = "" };
        settingsList.Add(newSetting);

        // Create metadata for new setting with default type
        var metadata = new SettingMetadata
        {
            Key = newKey,
            DataType = "string", // Default to string type
            DisplayOrder = settingsMetadata.Count
        };
        settingsMetadata[newKey] = metadata;

        // Select the new setting
        selectedSettingKey = newKey;

        StateHasChanged();
    }

    private void RemoveSetting(SettingItem setting)
    {
        settingsList.Remove(setting);
        if (!string.IsNullOrEmpty(setting.Key))
        {
            settingsMetadata.Remove(setting.Key);
            expandedSettingsKeys.Remove(setting.Key);

            // Clear selection if this was the selected setting
            if (selectedSettingKey == setting.Key)
            {
                selectedSettingKey = null;
            }
        }
        StateHasChanged();
    }

    private void SelectSetting(string key)
    {
        selectedSettingKey = key;
        StateHasChanged();
    }

    private SettingItem? GetSelectedSetting()
    {
        if (string.IsNullOrEmpty(selectedSettingKey))
            return null;

        return settingsList.FirstOrDefault(s => s.Key == selectedSettingKey);
    }

    private void DeleteSelectedSetting()
    {
        if (string.IsNullOrEmpty(selectedSettingKey))
            return;

        var setting = GetSelectedSetting();
        if (setting != null)
        {
            RemoveSetting(setting);
        }
    }

    private void OnSettingKeyChanged(string oldKey, string newKey)
    {
        // Find the setting
        var setting = settingsList.FirstOrDefault(s => s.Key == oldKey);
        if (setting == null)
            return;

        // Update the setting key
        setting.Key = newKey;

        // Update metadata dictionary
        if (settingsMetadata.TryGetValue(oldKey, out var metadata))
        {
            settingsMetadata.Remove(oldKey);
            metadata.Key = newKey;
            settingsMetadata[newKey] = metadata;
        }

        // Update expanded keys
        if (expandedSettingsKeys.Contains(oldKey))
        {
            expandedSettingsKeys.Remove(oldKey);
            expandedSettingsKeys.Add(newKey);
        }

        // Update selected key
        if (selectedSettingKey == oldKey)
        {
            selectedSettingKey = newKey;
        }

        StateHasChanged();
    }

    private void OnDefaultSettingValueChanged(string key, string newValue)
    {
        // Find the setting and update its value
        var setting = settingsList.FirstOrDefault(s => s.Key == key);
        if (setting != null)
        {
            setting.Value = newValue;
        }

        // Check if this setting maps to a container port
        if (settingsMetadata.TryGetValue(key, out var metadata) && 
            metadata.MapsToContainerPort && 
            metadata.LinkedContainerPort.HasValue &&
            int.TryParse(newValue, out var newPort) && newPort > 0)
        {
            // Find the port definition with the linked container port
            var portDef = gameType?.Ports?.FirstOrDefault(p => 
                p.Port == metadata.LinkedContainerPort.Value &&
                p.Protocol.Equals(metadata.PortProtocol, StringComparison.OrdinalIgnoreCase));

            if (portDef != null)
            {
                var isUdp = metadata.PortProtocol.Equals("udp", StringComparison.OrdinalIgnoreCase);
                
                // For both UDP and TCP, update the port definition's port number
                // (In GameType definitions, there's only one Port value, not separate Container/Published)
                portDef.Port = newPort;
            }
        }

        StateHasChanged();
    }

    private void ToggleSettingExpansion(string key)
    {
        if (expandedSettingsKeys.Contains(key))
        {
            expandedSettingsKeys.Remove(key);
        }
        else
        {
            expandedSettingsKeys.Add(key);
        }
        StateHasChanged();
    }

    private SettingMetadata GetSettingMetadata(string key)
    {
        if (!settingsMetadata.ContainsKey(key))
        {
            settingsMetadata[key] = new SettingMetadata
            {
                Key = key,
                DataType = "string", // Default to string type
                DisplayOrder = settingsMetadata.Count
            };
        }

        // Ensure DataType is set - default to "string" if null/empty
        var metadata = settingsMetadata[key];
        if (string.IsNullOrWhiteSpace(metadata.DataType))
        {
            metadata.DataType = "string";
        }

        return metadata;
    }

    private string GetAllowedValuesString(SettingMetadata setting)
    {
        return setting.AllowedValues != null ? string.Join(",", setting.AllowedValues) : "";
    }

    private void SetAllowedValues(SettingMetadata setting, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            setting.AllowedValues = null;
        }
        else
        {
            setting.AllowedValues = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        }
        StateHasChanged();
    }

    private string GetValueMappingsJson(SettingMetadata setting)
    {
        if (setting.ValueMappings == null || !setting.ValueMappings.Any())
            return "";

        try
        {
            return System.Text.Json.JsonSerializer.Serialize(setting.ValueMappings, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return "";
        }
    }

    private void SetValueMappings(SettingMetadata setting, string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            setting.ValueMappings = null;
            StateHasChanged();
            return;
        }

        try
        {
            var mappings = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            setting.ValueMappings = mappings;
            StateHasChanged();
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Invalid JSON",
                Detail = "Value mappings must be valid JSON format.",
                Duration = 3000
            });
        }
    }

    private bool IsValid()
    {
        if (gameType == null) return false;
        if (string.IsNullOrWhiteSpace(gameType.Key)) return false;
        if (string.IsNullOrWhiteSpace(gameType.DisplayName)) return false;
        if (string.IsNullOrWhiteSpace(gameType.Image)) return false;

        return true;
    }

    private void AddWebHost()
    {
        webHosts.Add(new global::GameServer.Docker.Client.WebHostDefinition
        {
            Name = "",
            ContainerPort = 8080,
            Description = "",
            PathSegment = null,
            RequiresAuth = false,
            EnabledWhen = null,
            ContainerPortVariable = null
        });
        StateHasChanged();
    }

    private void RemoveWebHost(int index)
    {
        if (index >= 0 && index < webHosts.Count)
        {
            webHosts.RemoveAt(index);
            StateHasChanged();
        }
    }

    private async Task SaveGameType()
    {
        if (!IsValid() || isSaving) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            // Convert settings list back to dictionary
            gameType!.DefaultSettings = settingsList
                .Where(s => !string.IsNullOrWhiteSpace(s.Key))
                .ToDictionary(s => s.Key!, s => s.Value ?? "");

            // Save the game type first
            if (isNew)
            {
                await GameTypeApi.CreateAsync(gameType);
            }
            else
            {
                await GameTypeApi.UpdateAsync(gameType.Key, gameType);
            }

            // Save extended metadata if any settings have metadata configured
            if (settingsMetadata.Any(kvp => HasMetadataConfigured(kvp.Value)))
            {
                // Clean up metadata - only keep settings that exist in DefaultSettings
                var cleanedMetadata = settingsMetadata
                    .Where(kvp => !string.IsNullOrWhiteSpace(kvp.Key) && 
                                  gameType.DefaultSettings.ContainsKey(kvp.Key))
                    .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

                // Update the Key property to match dictionary key (in case it changed)
                // Also normalize DataType values for consistency
                foreach (var kvp in cleanedMetadata)
                {
                    kvp.Value.Key = kvp.Key;

                    // Normalize DataType to lowercase for consistency
                    if (!string.IsNullOrWhiteSpace(kvp.Value.DataType))
                    {
                        kvp.Value.DataType = kvp.Value.DataType.ToLowerInvariant();
                    }
                    else
                    {
                        // Empty or whitespace - set to null
                        kvp.Value.DataType = null;
                    }
                }

                var extendedMetadata = new GameTypeExtendedMetadata
                {
                    GameTypeKey = gameType.Key,
                    EnableTTY = enableTTY,
                    WebHosts = webHosts,
                    SettingsMetadata = cleanedMetadata,
                    CustomProperties = new Dictionary<string, string>()
                };

                try
                {
                    await MetadataApi.SaveAsync(gameType.Key, extendedMetadata);
                    Console.WriteLine($"GameTypeDetails: Saved extended metadata with {cleanedMetadata.Count} settings");
                }
                catch (Exception metadataEx)
                {
                    Console.WriteLine($"GameTypeDetails: Failed to save extended metadata: {metadataEx.Message}");
                    Console.WriteLine($"GameTypeDetails: ExtendedMetadata being saved - EnableTTY: {extendedMetadata.EnableTTY}, Settings count: {extendedMetadata.SettingsMetadata?.Count ?? 0}");

                    // Log each setting's metadata for debugging
                    if (extendedMetadata.SettingsMetadata != null)
                    {
                        foreach (var setting in extendedMetadata.SettingsMetadata)
                        {
                            Console.WriteLine($"  - Setting '{setting.Key}': DataType='{setting.Value.DataType ?? "null"}', Description='{setting.Value.Description}'");
                        }
                    }

                    // Don't fail the whole save if metadata fails, just warn
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Warning,
                        Summary = "Metadata Save Warning",
                        Detail = $"Game type saved, but extended metadata failed: {metadataEx.Message}",
                        Duration = 5000,
                        CloseOnClick = true
                    });
                }
            }

            // Show success notification
            if (isNew)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Created",
                    Detail = $"'{gameType.DisplayName}' has been created successfully.",
                    Duration = 3000,
                    CloseOnClick = true
                });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Updated",
                    Detail = $"'{gameType.DisplayName}' has been updated successfully.",
                    Duration = 3000,
                    CloseOnClick = true
                });
            }

            // Navigate back to list
            Navigation.NavigateTo("/gametypes");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"GameTypeDetails: Save failed: {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Save Failed",
                Detail = $"Failed to save game type: {ex.Message}",
                Duration = 5000,
                CloseOnClick = true
            });
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private bool HasMetadataConfigured(SettingMetadata metadata)
    {
        // Check if any meaningful metadata is configured beyond defaults
        return !string.IsNullOrWhiteSpace(metadata.Description) ||
               !string.IsNullOrWhiteSpace(metadata.DataType) ||
               !string.IsNullOrWhiteSpace(metadata.Category) ||
               metadata.IsRequired ||
               metadata.CannotBeEmpty ||
               metadata.MapsToContainerPort ||
               (metadata.AllowedValues?.Any() ?? false) ||
               (metadata.ValueMappings?.Any() ?? false) ||
               !string.IsNullOrWhiteSpace(metadata.ValidationPattern) ||
               !string.IsNullOrWhiteSpace(metadata.ValidationMessage) ||
               !string.IsNullOrWhiteSpace(metadata.Placeholder);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/gametypes");
    }

    private PortValidationRule GetOrCreatePortValidation(SettingMetadata metadata)
    {
        if (metadata.PortValidation == null)
        {
            metadata.PortValidation = new PortValidationRule
            {
                MinPort = 1024,
                MaxPort = 65535,
                CheckAvailability = true,
                IsUserEditable = true,
                ReservedPorts = new List<int>()
            };
        }
        return metadata.PortValidation;
    }

    private string GetReservedPortsString(SettingMetadata metadata)
    {
        var portValidation = GetOrCreatePortValidation(metadata);
        if (portValidation.ReservedPorts == null || !portValidation.ReservedPorts.Any())
            return "";
        return string.Join(",", portValidation.ReservedPorts);
    }

    private void OnGameTypeChanged(GameTypeDefinition updatedGameType)
    {
        gameType = updatedGameType;
        StateHasChanged();
    }

    private void SetReservedPorts(SettingMetadata metadata, string value)
    {
        var portValidation = GetOrCreatePortValidation(metadata);
        
        if (string.IsNullOrWhiteSpace(value))
        {
            portValidation.ReservedPorts = new List<int>();
            return;
        }

        try
        {
            portValidation.ReservedPorts = value
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(p => int.Parse(p))
                .Where(p => p >= 1 && p <= 65535)
                .ToList();
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Invalid Port",
                Detail = "Reserved ports must be valid numbers between 1-65535",
                Duration = 3000
            });
        }
    }

    private void AddPortRelationship(SettingMetadata metadata)
    {
        metadata.PortRelationships ??= new List<PortRelationship>();
        
        // Try to detect a good default target from existing ports
        var linkedPort = (int)(metadata.LinkedContainerPort ?? 25565);
        var protocol = metadata.PortProtocol;
        
        // Find ports that could be related (same protocol, different port number)
        var potentialTargets = gameType?.Ports?
            .Where(p => p.Protocol.Equals(protocol, StringComparison.OrdinalIgnoreCase) && p.Port != linkedPort)
            .OrderBy(p => p.Port)
            .ToList();
        
        int targetPort = linkedPort + 1; // Default to +1
        int offset = 1;
        
        // If we found potential targets, use the first one and calculate the offset
        if (potentialTargets?.Any() == true)
        {
            var firstTarget = potentialTargets.First();
            targetPort = firstTarget.Port;
            offset = (int)(firstTarget.Port - linkedPort);
        }
        
        metadata.PortRelationships.Add(new PortRelationship
        {
            RelationType = PortRelationshipType.Offset,
            TargetContainerPort = targetPort,
            TargetProtocol = protocol,
            Offset = offset,
            Description = offset == 1 ? "Query Port" : $"Port +{offset}",
            IsRequired = true
        });
        
        StateHasChanged();
    }

    private void RemovePortRelationship(SettingMetadata metadata, PortRelationship relationship)
    {
        metadata.PortRelationships?.Remove(relationship);
        StateHasChanged();
    }

    private void AutoDetectPortRelationships(SettingMetadata metadata)
    {
        if (!metadata.MapsToContainerPort || !metadata.LinkedContainerPort.HasValue || gameType?.Ports == null)
            return;

        metadata.PortRelationships ??= new List<PortRelationship>();
        metadata.PortRelationships.Clear();

        var linkedPort = metadata.LinkedContainerPort.Value;
        var protocol = metadata.PortProtocol;

        // Find all other ports with the same protocol
        var relatedPorts = gameType.Ports
            .Where(p => p.Protocol.Equals(protocol, StringComparison.OrdinalIgnoreCase) && p.Port != linkedPort)
            .OrderBy(p => p.Port)
            .ToList();

        foreach (var port in relatedPorts)
        {
            var offset = (int)(port.Port - linkedPort);
            
            metadata.PortRelationships.Add(new PortRelationship
            {
                RelationType = PortRelationshipType.Offset,
                TargetContainerPort = port.Port,
                TargetProtocol = protocol,
                Offset = offset,
                Description = offset > 0 ? $"Port +{offset}" : $"Port {offset}",
                IsRequired = true
            });
        }

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Relationships Detected",
            Detail = $"Found {metadata.PortRelationships.Count} related port(s) based on existing port definitions.",
            Duration = 3000
        });

        StateHasChanged();
    }

    private bool ValidatePortRelationship(PortRelationship relationship)
    {
        // Check if target port exists in gameType.Ports
        return gameType?.Ports?.Any(p => 
            p.Port == relationship.TargetContainerPort && 
            p.Protocol.Equals(relationship.TargetProtocol, StringComparison.OrdinalIgnoreCase)) == true;
    }

    private string GetPortRelationshipValidationMessage(PortRelationship relationship)
    {
        if (!ValidatePortRelationship(relationship))
        {
            return $"⚠ Target port {relationship.TargetContainerPort} ({relationship.TargetProtocol}) not found in port definitions!";
        }
        return "";
    }

    private string? settingsSearchQuery = null;

    private void OnSettingsSearchChanged(string? searchQuery)
    {
        settingsSearchQuery = searchQuery;
        StateHasChanged();
    }

    private List<IGrouping<string, SettingItem>> GetFilteredAndGroupedSettings()
    {
        // Start with all settings
        IEnumerable<SettingItem> filtered = settingsList;

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(settingsSearchQuery))
        {
            var searchLower = settingsSearchQuery.ToLowerInvariant();
            filtered = filtered.Where(s => 
                !string.IsNullOrEmpty(s.Key) && 
                s.Key.ToLowerInvariant().Contains(searchLower));
        }

        // Group by category, order by DisplayOrder then Key
        var grouped = filtered
            .Select(s => new
            {
                Setting = s,
                Metadata = GetSettingMetadata(s.Key ?? ""),
                Category = GetSettingMetadata(s.Key ?? "")?.Category ?? "General"
            })
            .OrderBy(x => x.Metadata?.DisplayOrder ?? int.MaxValue)
            .ThenBy(x => x.Setting.Key)
            .GroupBy(x => x.Category)
            .OrderBy(g => g.Key) // Order groups alphabetically
            .Select(g => new SettingGroup
            {
                Key = g.Key,
                Settings = g.Select(x => x.Setting).ToList()
            })
            .ToList();

        // Convert to IGrouping interface for compatibility
        return grouped.Select(g => new SettingGrouping(g.Key, g.Settings)).Cast<IGrouping<string, SettingItem>>().ToList();
    }

    private class SettingGroup
    {
        public string Key { get; set; } = "";
        public List<SettingItem> Settings { get; set; } = new();
    }

    private class SettingGrouping : IGrouping<string, SettingItem>
    {
        private readonly string _key;
        private readonly IEnumerable<SettingItem> _settings;

        public SettingGrouping(string key, IEnumerable<SettingItem> settings)
        {
            _key = key;
            _settings = settings;
        }

        public string Key => _key;

        public IEnumerator<SettingItem> GetEnumerator() => _settings.GetEnumerator();

        System.Collections.IEnumerator System.Collections.IEnumerable.GetEnumerator() => GetEnumerator();
    }

    private class SettingItem
    {
        public string? Key { get; set; }
        public string? Value { get; set; }
    }
}
