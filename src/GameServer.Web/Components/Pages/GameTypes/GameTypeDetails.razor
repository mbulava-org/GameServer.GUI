                                                </h6>
                                                <RadzenButton Icon="delete"
                                                              Size="ButtonSize.Small"
                                                              ButtonStyle="ButtonStyle.Danger"
                                                              Click="@(() => RemoveWebHost(webHostIndex))"
                                                              title="Remove Web Host" />
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <RadzenFormField Text="Name *" Variant="@Variant.Outlined" class="w-100">
