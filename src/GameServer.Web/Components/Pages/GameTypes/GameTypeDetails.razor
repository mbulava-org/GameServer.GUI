@page "/gametypes/{Key}"
@page "/gametypes/new"
@rendermode InteractiveServer
@using global::GameServer.Docker.Client
@using GameServer.Web.Components.Pages.GameTypes.Components
@using Radzen
@using Radzen.Blazor
@inject IGameTypeApi GameTypeApi
@inject IGameTypeExtendedMetadataApi MetadataApi
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>@(isNew ? "Create Game Type" : gameType?.DisplayName ?? "Game Type")</PageTitle>

<div class="container-fluid game-type-details-page">
    <div class="game-type-details-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <RadzenButton Icon="arrow_back" 
                              ButtonStyle="ButtonStyle.Light" 
                              Size="ButtonSize.Small"
                              Click="@GoBack" 
                              class="me-3" />
                <h2 class="d-inline">@(isNew ? "Create New Game Type" : $"Edit: {gameType?.DisplayName}")</h2>
            </div>
            <div class="d-flex gap-2">
                <RadzenButton Text="Cancel" 
                              Icon="close" 
                              ButtonStyle="ButtonStyle.Light" 
                              Click="@GoBack" />
                <RadzenButton Text="Save" 
                              Icon="save" 
                              ButtonStyle="ButtonStyle.Success" 
                              Click="@SaveGameType"
                              Disabled="@(!IsValid() || isSaving)" />
            </div>
        </div>
    </div>

    <div class="game-type-details-content">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                <p class="mt-3">Loading game type...</p>
            </div>
        }
        else if (gameType != null)
        {
            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Basic Information">
                    <div class="p-4">
                        <GameTypeBasicInfo GameType="@gameType" 
                                           IsNew="@isNew" 
                                           GameTypeChanged="@OnGameTypeChanged" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Ports">
                    <div class="p-4">
                        <GameTypePortsEditor Ports="@gameType.Ports" 
                                             PortsChanged="@StateHasChanged" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Volumes">
                    <div class="p-4">
                        <GameTypeVolumesEditor Volumes="@gameType.Volumes" 
                                               VolumesChanged="@StateHasChanged" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Environment Variables">
                    <div class="p-4">
                        <RadzenCard>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">Default Environment Variables</h5>
                                    <small class="text-muted">Define default values and configure metadata for the server creation wizard.</small>
                                </div>
                                <RadzenButton Text="Add Setting" 
                                              Icon="add" 
                                              Size="ButtonSize.Small"
                                              Click="@AddSetting" />
                            </div>

                            @if (settingsList == null || !settingsList.Any())
                            {
                                <p class="text-muted text-center py-4">No settings configured. Add a setting to get started.</p>
                            }
                            else
                            {
                                <div class="settings-master-detail">
                                    <div class="settings-list-panel">
                                        <div class="settings-search-box mb-3">
                                            <RadzenTextBox @bind-Value="@settingsSearchQuery" 
                                                           Placeholder="Search by key..." 
                                                           class="w-100"
                                                           @oninput="@((ChangeEventArgs e) => OnSettingsSearchChanged(e.Value?.ToString()))" />
                                        </div>

                                        @{
                                            var filteredSettings = GetFilteredAndGroupedSettings();

                                            if (!filteredSettings.Any())
                                            {
                                                <p class="text-muted text-center py-3">No settings match your search.</p>
                                            }
                                            else
                                            {
                                                @foreach (var group in filteredSettings)
                                                {
                                                    <div class="settings-group mb-3">
                                                        <div class="settings-group-header">
                                                            @group.Key
                                                        </div>
                                                        @foreach (var setting in group)
                                                        {
                                                            if (string.IsNullOrEmpty(setting.Key))
                                                            {
                                                                continue;
                                                            }
                                                            var metadata = GetSettingMetadata(setting.Key);
                                                            var isSelected = selectedSettingKey == setting.Key;

                                                            <div class="setting-list-item @(isSelected ? "selected" : "")" 
                                                                 @onclick="@(() => SelectSetting(setting.Key))">
                                                                <div class="setting-list-item-content">
                                                                    <div class="setting-list-item-header">
                                                                        <code class="setting-key">@setting.Key</code>
                                                                        <div class="setting-badges">
                                                                            @if (metadata?.IsRequired == true)
                                                                            {
                                                                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Required" Size="BadgeSize.ExtraSmall" />
                                                                            }
                                                                            @if (!string.IsNullOrWhiteSpace(metadata?.DataType))
                                                                            {
                                                                                <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                                                                                             Text="@metadata.DataType" 
                                                                                             Variant="Variant.Outlined"
                                                                                             Size="BadgeSize.ExtraSmall" />
                                                                            }
                                                                            @if (metadata?.MapsToContainerPort == true)
                                                                            {
                                                                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" 
                                                                                             Text="Port" 
                                                                                             Size="BadgeSize.ExtraSmall" />
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                    <div class="setting-list-item-value">
                                                                        <code>@(string.IsNullOrEmpty(setting.Value) ? "(empty)" : setting.Value)</code>
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(metadata?.Description))
                                                                    {
                                                                        <div class="setting-list-item-description">
                                                                            @metadata.Description
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>

                                    <div class="settings-detail-panel">
                                        @if (selectedSettingKey != null && GetSelectedSetting() != null)
                                        {
                                            var setting = GetSelectedSetting()!;
                                            var metadata = GetSettingMetadata(selectedSettingKey);

                                            <div class="setting-detail-header">
                                                <div>
                                                    <h6 class="mb-1">Edit Environment Variable</h6>
                                                    <code class="setting-key-large">@selectedSettingKey</code>
                                                </div>
                                                <RadzenButton Icon="delete" 
                                                              Text="Delete" 
                                                              Size="ButtonSize.Small" 
                                                              ButtonStyle="ButtonStyle.Danger"
                                                              Click="@(() => DeleteSelectedSetting())" />
                                            </div>

                                            <div class="setting-detail-content">
                                                <RadzenStack Gap="1.5rem">
                                                    <div class="section-title">Basic Settings</div>
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <RadzenFormField Text="Key" Variant="@Variant.Outlined" class="w-100">
                                                                <RadzenTextBox Value="@setting.Key"
                                                                               ValueChanged="@((string value) => OnSettingKeyChanged(setting.Key, value))"
                                                                               Placeholder="SETTING_NAME"
                                                                               class="w-100" />
                                                            </RadzenFormField>
                                                            <small class="text-muted">Environment variable name (uppercase recommended)</small>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <RadzenFormField Text="Default Value" Variant="@Variant.Outlined" class="w-100">
                                                                <RadzenTextBox Value="@setting.Value" 
                                                                               ValueChanged="@((string value) => OnDefaultSettingValueChanged(setting.Key, value))"
                                                                               Placeholder="true, 25565, 2G, etc."
                                                                               class="w-100" />
                                                            </RadzenFormField>
                                                            <small class="text-muted">Default value shown in server creation wizard</small>
                                                        </div>
                                                    </div>

                                                    <div class="section-title mt-3">Extended Metadata (Optional)</div>
                                                    <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <RadzenFormField Text="Data Type" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenDropDown @bind-Value="@metadata!.DataType"
                                                                                    Data="@dataTypes"
                                                                                    AllowClear="false"
                                                                                    Placeholder="Select type..."
                                                                                    class="w-100" />
                                                                </RadzenFormField>
                                                                <small class="text-muted">Default: string</small>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <RadzenFormField Text="Category" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenTextBox @bind-Value="@metadata!.Category" 
                                                                                   Placeholder="General, Network, Gameplay..."
                                                                                   class="w-100" />
                                                                </RadzenFormField>
                                                                <small class="text-muted">Group settings in wizard</small>
                                                            </div>

                                                            <div class="col-12">
                                                                <RadzenFormField Text="Description" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenTextArea @bind-Value="@metadata!.Description" 
                                                                                    Rows="2"
                                                                                    Placeholder="User-friendly description for the wizard"
                                                                                    class="w-100" />
                                                                </RadzenFormField>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <RadzenFormField Text="Display Order" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenNumeric @bind-Value="@metadata!.DisplayOrder" 
                                                                                   Min="0"
                                                                                   class="w-100" />
                                                                </RadzenFormField>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <RadzenFormField Text="Placeholder" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenTextBox @bind-Value="@metadata!.Placeholder" 
                                                                                   Placeholder="Hint text"
                                                                                   class="w-100" />
                                                                </RadzenFormField>
                                                            </div>

                                                            <div class="col-md-4 d-flex align-items-end">
                                                                <div class="w-100">
                                                                    <div class="checkbox-group mb-2">
                                                                        <RadzenCheckBox @bind-Value="@metadata!.IsRequired" />
                                                                        <RadzenLabel Text="Required" class="ms-2" />
                                                                    </div>
                                                                    <div class="checkbox-group">
                                                                        <RadzenCheckBox @bind-Value="@metadata.CannotBeEmpty" />
                                                                        <RadzenLabel Text="Cannot Be Empty" class="ms-2" />
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            @if (metadata.DataType == "enum")
                                                            {
                                                                <div class="col-12">
                                                                    <RadzenFormField Text="Allowed Values (comma-separated)" Variant="@Variant.Outlined" class="w-100">
                                                                        <RadzenTextBox Value="@GetAllowedValuesString(metadata)" 
                                                                                       ValueChanged="@((string value) => SetAllowedValues(metadata, value))"
                                                                                       Placeholder="easy,normal,hard"
                                                                                       class="w-100" />
                                                                    </RadzenFormField>
                                                                    <small class="text-muted">Dropdown options for this setting</small>
                                                                </div>

                                                                <div class="col-12">
                                                                    <RadzenFormField Text="Value Mappings (JSON format)" Variant="@Variant.Outlined" class="w-100">
                                                                        <RadzenTextArea Value="@GetValueMappingsJson(metadata)"
                                                                                        ValueChanged="@((string value) => SetValueMappings(metadata, value))"
                                                                                        Rows="3"
                                                                                        Placeholder='{"easy": "Easy - Reduced difficulty", "normal": "Normal", "hard": "Hard - Challenging"}'
                                                                                        class="w-100" />
                                                                    </RadzenFormField>
                                                                    <small class="text-muted">Display descriptions for each value</small>
                                                                </div>
                                                            }

                                                            @if (metadata.DataType == "list")
                                                            {
                                                                <div class="col-md-6">
                                                                    <RadzenFormField Text="List Delimiter" Variant="@Variant.Outlined" class="w-100">
                                                                        <RadzenTextBox @bind-Value="@metadata.ListDelimiter" 
                                                                                       Placeholder=","
                                                                                       class="w-100" />
                                                                    </RadzenFormField>
                                                                    <small class="text-muted">Character used to separate list items (default: comma)</small>
                                                                </div>
                                                            }

                                                            @if (metadata.DataType == "timezone")
                                                            {
                                                                <div class="col-12">
                                                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
                                                                        <div class="d-flex align-items-start gap-2">
                                                                            <RadzenIcon Icon="info" Style="font-size: 1rem;" />
                                                                            <div>
                                                                                <strong>Time Zone Input:</strong>
                                                                                <p class="mb-0 mt-1" style="font-size: 0.875rem;">
                                                                                    This setting will display as a searchable dropdown with all available time zones. 
                                                                                    Users can type to filter the list. The time zone ID (e.g., "America/New_York") will be stored.
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </RadzenAlert>
                                                                </div>

                                                                <div class="col-12">
                                                                    <RadzenFormField Text="Preview - Available Time Zones" Variant="@Variant.Outlined" class="w-100">
                                                                        <RadzenDropDown @bind-Value="@metadata.AllowedValues"
                                                                                       Data="@availableTimeZones"
                                                                                       AllowFiltering="true"
                                                                                       AllowClear="true"
                                                                                       FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                                       Placeholder="Select a time zone to preview..."
                                                                                       class="w-100"
                                                                                       Disabled="true"
                                                                                       Style="opacity: 0.6;" />
                                                                    </RadzenFormField>
                                                                    <small class="text-muted">
                                                                        <RadzenIcon Icon="visibility" Style="font-size: 0.875rem;" />
                                                                        Preview only - Shows how the time zone dropdown will appear to users (@availableTimeZones.Count zones available)
                                                                    </small>
                                                                </div>
                                                            }

                                                            @if (metadata.DataType == "port")
                                                            {
                                                                <div class="col-12">
                                                                    <div class="section-title">Port Configuration</div>
                                                                </div>
                                                                
                                                                <div class="col-md-6">
                                                                    <div class="checkbox-group mb-2">
                                                                        <RadzenCheckBox @bind-Value="@metadata.MapsToContainerPort" />
                                                                        <RadzenLabel Text="Maps to Container Port" class="ms-2" />
                                                                    </div>
                                                                    <small class="text-muted">This setting controls a port mapping</small>
                                                                </div>

                                                                @if (metadata.MapsToContainerPort)
                                                                {
                                                                    <div class="col-md-3">
                                                                        <RadzenFormField Text="Linked Container Port" Variant="@Variant.Outlined" class="w-100">
                                                                            <RadzenNumeric @bind-Value="@metadata.LinkedContainerPort" 
                                                                                           Min="1" Max="65535"
                                                                                           class="w-100" />
                                                                        </RadzenFormField>
                                                                    </div>

                                                                    <div class="col-md-3">
                                                                        <RadzenFormField Text="Protocol" Variant="@Variant.Outlined" class="w-100">
                                                                            <RadzenDropDown @bind-Value="@metadata.PortProtocol"
                                                                                            Data="@(new[] { "tcp", "udp" })"
                                                                                            class="w-100" />
                                                                        </RadzenFormField>
                                                                    </div>

                                                                    <div class="col-12 mt-3">
                                                                        <div class="section-title">Port Validation</div>
                                                                    </div>

                                                                    <div class="col-md-3">
                                                                        <RadzenFormField Text="Min Port" Variant="@Variant.Outlined" class="w-100">
                                                                            <RadzenNumeric @bind-Value="@GetOrCreatePortValidation(metadata).MinPort" 
                                                                                           Min="1" Max="65535"
                                                                                           class="w-100" />
                                                                        </RadzenFormField>
                                                                        <small class="text-muted">Minimum allowed port (optional)</small>
                                                                    </div>

                                                                    <div class="col-md-3">
                                                                        <RadzenFormField Text="Max Port" Variant="@Variant.Outlined" class="w-100">
                                                                            <RadzenNumeric @bind-Value="@GetOrCreatePortValidation(metadata).MaxPort" 
                                                                                           Min="1" Max="65535"
                                                                                           class="w-100" />
                                                                        </RadzenFormField>
                                                                        <small class="text-muted">Maximum allowed port (optional)</small>
                                                                    </div>

                                                                    <div class="col-md-3">
                                                                        <div class="checkbox-group mb-2">
                                                                            <RadzenCheckBox @bind-Value="@GetOrCreatePortValidation(metadata).CheckAvailability" />
                                                                            <RadzenLabel Text="Check Availability" class="ms-2" />
                                                                        </div>
                                                                        <small class="text-muted">Verify port is not in use</small>
                                                                    </div>

                                                                    <div class="col-md-3">
                                                                        <div class="checkbox-group mb-2">
                                                                            <RadzenCheckBox @bind-Value="@GetOrCreatePortValidation(metadata).IsUserEditable" />
                                                                            <RadzenLabel Text="User Editable" class="ms-2" />
                                                                        </div>
                                                                        <small class="text-muted">Allow users to change this port</small>
                                                                    </div>

                                                                    <div class="col-12">
                                                                        <RadzenFormField Text="Reserved Ports (comma-separated)" Variant="@Variant.Outlined" class="w-100">
                                                                            <RadzenTextBox Value="@GetReservedPortsString(metadata)" 
                                                                                           ValueChanged="@((string value) => SetReservedPorts(metadata, value))"
                                                                                           Placeholder="80,443,22"
                                                                                           class="w-100" />
                                                                        </RadzenFormField>
                                                                        <small class="text-muted">Ports that cannot be used (e.g., system ports)</small>
                                                                    </div>

                                                                    @* Port Relationships Section *@
                                                                    <div class="col-12 mt-4">
                                                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                                                            <div class="section-title mb-0">Port Relationships</div>
                                                                            <div class="d-flex gap-2">
                                                                                <RadzenButton Text="Auto-Detect" 
                                                                                              Icon="auto_fix_high" 
                                                                                              Size="ButtonSize.Small"
                                                                                              ButtonStyle="ButtonStyle.Info"
                                                                                              Click="@(() => AutoDetectPortRelationships(metadata))"
                                                                                              title="Automatically detect relationships from existing ports" />
                                                                                <RadzenButton Text="Add Relationship" 
                                                                                              Icon="add" 
                                                                                              Size="ButtonSize.Small"
                                                                                              ButtonStyle="ButtonStyle.Success"
                                                                                              Click="@(() => AddPortRelationship(metadata))" />
                                                                            </div>
                                                                        </div>
                                                                        <small class="text-muted d-block mb-3">Define related ports that update automatically when this port changes (e.g., Query Port, RCON Port). Use "Auto-Detect" to find relationships from existing port definitions.</small>
                                                                    </div>

                                                                    @if (metadata.PortRelationships?.Any() == true)
                                                                    {
                                                                        @foreach (var relationship in metadata.PortRelationships)
                                                                        {
                                                                            var validationMsg = GetPortRelationshipValidationMessage(relationship);
                                                                            var hasError = !string.IsNullOrEmpty(validationMsg);
                                                                            
                                                                            <div class="col-12">
                                                                                <RadzenCard class="mb-3" Style="@(hasError ? "background: var(--rz-danger-lighter); border: 2px solid var(--rz-danger);" : "background: var(--rz-base-50);")">
                                                                                    @if (hasError)
                                                                                    {
                                                                                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Size="AlertSize.Small" class="mb-3">
                                                                                            @validationMsg
                                                                                        </RadzenAlert>
                                                                                    }
                                                                                    <div class="row g-3">
                                                                                        <div class="col-md-3">
                                                                                            <RadzenFormField Text="Relationship Type" Variant="@Variant.Outlined" class="w-100">
                                                                                                <RadzenDropDown @bind-Value="@relationship.RelationType"
                                                                                                                Data="@portRelationshipTypes"
                                                                                                                class="w-100" />
                                                                                            </RadzenFormField>
                                                                                        </div>

                                                                                        <div class="col-md-2">
                                                                                            <RadzenFormField Text="Target Port" Variant="@Variant.Outlined" class="w-100">
                                                                                                <RadzenNumeric @bind-Value="@relationship.TargetContainerPort"
                                                                                                               Min="1" Max="65535"
                                                                                                               class="w-100" />
                                                                                            </RadzenFormField>
                                                                                        </div>

                                                                                        <div class="col-md-2">
                                                                                            <RadzenFormField Text="Protocol" Variant="@Variant.Outlined" class="w-100">
                                                                                                <RadzenDropDown @bind-Value="@relationship.TargetProtocol"
                                                                                                                Data="@(new[] { "tcp", "udp" })"
                                                                                                                class="w-100" />
                                                                                            </RadzenFormField>
                                                                                        </div>

                                                                                        @if (relationship.RelationType == PortRelationshipType.Offset)
                                                                                        {
                                                                                            <div class="col-md-2">
                                                                                                <RadzenFormField Text="Offset" Variant="@Variant.Outlined" class="w-100">
                                                                                                    <RadzenNumeric @bind-Value="@relationship.Offset"
                                                                                                                   Min="-65535" Max="65535"
                                                                                                                   class="w-100" />
                                                                                                </RadzenFormField>
                                                                                                <small class="text-muted">+/- from source port</small>
                                                                                            </div>
                                                                                        }
                                                                                        else if (relationship.RelationType == PortRelationshipType.Fixed)
                                                                                        {
                                                                                            <div class="col-md-2">
                                                                                                <RadzenFormField Text="Fixed Value" Variant="@Variant.Outlined" class="w-100">
                                                                                                    <RadzenNumeric @bind-Value="@relationship.FixedValue"
                                                                                                                   Min="1" Max="65535"
                                                                                                                   class="w-100" />
                                                                                                </RadzenFormField>
                                                                                                <small class="text-muted">Always this port</small>
                                                                                            </div>
                                                                                        }

                                                                                        <div class="col-md-2">
                                                                                            <RadzenFormField Text="Description" Variant="@Variant.Outlined" class="w-100">
                                                                                                <RadzenTextBox @bind-Value="@relationship.Description"
                                                                                                               Placeholder="Query Port"
                                                                                                               class="w-100" />
                                                                                            </RadzenFormField>
                                                                                        </div>

                                                                                        <div class="col-md-1 d-flex align-items-end">
                                                                                            <div class="checkbox-group mb-2">
                                                                                                <RadzenCheckBox @bind-Value="@relationship.IsRequired" />
                                                                                                <RadzenLabel Text="Required" class="ms-1" Style="font-size: 0.75rem;" />
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-12 d-flex justify-content-end">
                                                                                            <RadzenButton Icon="delete" 
                                                                                                          Text="Remove" 
                                                                                                          Size="ButtonSize.Small"
                                                                                                          ButtonStyle="ButtonStyle.Danger"
                                                                                                          Click="@(() => RemovePortRelationship(metadata, relationship))" />
                                                                                        </div>
                                                                                    </div>
                                                                                </RadzenCard>
                                                                            </div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="col-12">
                                                                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small">
                                                                                No port relationships defined. Click "Add Relationship" to create automatic port dependencies.
                                                                            </RadzenAlert>
                                                                        </div>
                                                                    }
                                                                }
                                                            }

                                                            <div class="col-md-6">
                                                                <RadzenFormField Text="Validation Pattern (Regex)" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenTextBox @bind-Value="@metadata.ValidationPattern" 
                                                                                   Placeholder="^[0-9]+$"
                                                                                   class="w-100" />
                                                                </RadzenFormField>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <RadzenFormField Text="Validation Message" Variant="@Variant.Outlined" class="w-100">
                                                                    <RadzenTextBox @bind-Value="@metadata.ValidationMessage" 
                                                                                   Placeholder="Error message"
                                                                                   class="w-100" />
                                                                </RadzenFormField>
                                                            </div>
                                                        </div>
                                                    </RadzenStack>
                                                </div>
                                        }
                                        else
                                        {
                                            <div class="settings-detail-empty">
                                                <RadzenIcon Icon="settings" Style="font-size: 4rem; opacity: 0.3;" />
                                                <p class="text-muted mt-3">Select a setting from the list to edit its properties</p>
                                                <small class="text-muted">or</small>
                                                <RadzenButton Text="Add New Setting" 
                                                              Icon="add" 
                                                              Size="ButtonSize.Small"
                                                              ButtonStyle="ButtonStyle.Primary"
                                                              class="mt-2"
                                                              Click="@AddSetting" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Advanced Settings">
                    <div class="p-4">
                        <RadzenCard class="mb-4">
                            <div class="section-title mb-3">
                                <RadzenIcon Icon="terminal" /> Console & Terminal
                            </div>
                            <div class="mb-3">
                                <div class="checkbox-group">
                                    <RadzenCheckBox @bind-Value="@enableTTY" Name="enableTty" />
                                    <RadzenLabel Text="Enable TTY (Interactive Terminal)" for="enableTty" class="ms-2" />
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <RadzenIcon Icon="info" Style="font-size: 0.875rem;" />
                                    Enable for game servers that need interactive console input (e.g., Minecraft, ARK).
                                    Required for proper terminal emulation and ANSI color support.
                                </small>
                            </div>
                        </RadzenCard>

                        <RadzenCard>
                            <div class="section-title mb-3">
                                <RadzenIcon Icon="public" /> Web Hosts & Reverse Proxy
                            </div>
                            <p class="text-muted mb-3">
                                Configure web interfaces exposed by this game server for automatic reverse proxy routing.
                                Each host will get a unique URL through your load balancer.
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <small class="text-muted">
                                        Examples: Admin panel, Dynmap, Statistics dashboard, RCON web interface
                                    </small>
                                </div>
                                <RadzenButton Text="Add Web Host"
                                              Icon="add"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="@AddWebHost" />
                            </div>

                            @if (webHosts == null || !webHosts.Any())
                            {
                                <div class="text-center py-4">
                                    <RadzenIcon Icon="public_off" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
