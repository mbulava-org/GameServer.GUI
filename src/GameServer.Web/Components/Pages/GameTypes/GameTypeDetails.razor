                                    <small class="text-muted">This game type won't expose any web interfaces through the load balancer.</small>
                                </div>
                            }
                            else
                            {
                                <RadzenStack Gap="1rem">
                                    @foreach (var webHost in webHosts.ToList())
                                    {
                                        var webHostIndex = webHosts.IndexOf(webHost);

                                        <RadzenCard class="mb-2" Style="background: var(--rz-base-50);">
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <h6 class="mb-0">
                                                    <RadzenIcon Icon="language" />
