                                                    <small class="text-muted">Display name for this web interface</small>
                                                </div>

                                                <div class="col-md-6">
                                                    <RadzenFormField Text="Container Port *" Variant="@Variant.Outlined" class="w-100">
                                                        <RadzenNumeric @bind-Value="@webHost.ContainerPort"
                                                                       Min="1"
                                                                       Max="65535"
                                                                       ShowUpDown="false"
                                                                       class="w-100" />
