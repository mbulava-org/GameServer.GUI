                                                <div class="col-md-6">
                                                    <RadzenFormField Text="Container Port Variable (optional)" Variant="@Variant.Outlined" class="w-100">
                                                        <RadzenTextBox @bind-Value="@webHost.ContainerPortVariable"
                                                                       Placeholder="e.g., WEBUI_PORT"
                                                                       class="w-100" />
                                                    </RadzenFormField>
                                                    <small class="text-muted">Read port from setting instead of fixed value</small>
                                                </div>

                                                <div class="col-md-6">
                                                    <RadzenFormField Text="Enabled When (optional)" Variant="@Variant.Outlined" class="w-100">
                                                        <RadzenTextBox @bind-Value="@webHost.EnabledWhen"
                                                                       Placeholder="e.g., DYNMAP_ENABLED=true"
                                                                       class="w-100" />
                                                    </RadzenFormField>
                                                    <small class="text-muted">Condition: VARIABLE=value or VARIABLE!=value</small>
                                                </div>

                                                <div class="col-md-6 d-flex align-items-end">
                                                    <div class="checkbox-group mb-2">
                                                        <RadzenCheckBox @bind-Value="@webHost.RequiresAuth" />
                                                        <RadzenLabel Text="Requires Authentication (future)" class="ms-2" />
                                                    </div>
                                                </div>
                                            </div>
                                        </RadzenCard>
                                    }
                                </RadzenStack>
                            }
                        </RadzenCard>

                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mt-4">
                            <div class="d-flex align-items-start gap-2">
                                <RadzenIcon Icon="lightbulb" Style="font-size: 1.2rem;" />
                                <div>
                                    <strong>Tip:</strong> Per-setting metadata (validation, port mappings, etc.) is configured directly in the
                                    <strong>Environment Variables</strong> tab. Each setting can be expanded to reveal its full metadata editor.
                                </div>
                            </div>
                        </RadzenAlert>
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
        }
    </div>
</div>

