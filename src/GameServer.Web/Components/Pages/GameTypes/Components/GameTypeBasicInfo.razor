@attribute [Obsolete("Legacy pre-V2 game type editor component. Use the V2 game type editor flow before removing the old repository chain.")]
@using GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor

<RadzenCard>
    <h5 class="mb-4">Basic Information</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <RadzenFormField Text="Key" Variant="@Variant.Outlined" class="w-100">
                <RadzenTextBox @bind-Value="@LocalGameType.Key" 
                               Disabled="@(!IsNew)"
                               Placeholder="e.g., minecraft"
                               class="w-100" />
            </RadzenFormField>
            @if (IsNew)
            {
                <small class="text-muted">Unique identifier (cannot be changed later)</small>
            }
        </div>

        <div class="col-md-6">
            <RadzenFormField Text="Display Name" Variant="@Variant.Outlined" class="w-100">
                <RadzenTextBox @bind-Value="@LocalGameType.DisplayName" 
                               Placeholder="e.g., Minecraft Server"
                               class="w-100" />
            </RadzenFormField>
        </div>

        <div class="col-12">
            <RadzenFormField Text="Description" Variant="@Variant.Outlined" class="w-100">
                <RadzenTextArea @bind-Value="@LocalGameType.Description" 
                                Rows="3"
                                Placeholder="Brief description of this game server type"
                                class="w-100" />
            </RadzenFormField>
        </div>

        <div class="col-12">
            <RadzenFormField Text="Docker Image" Variant="@Variant.Outlined" class="w-100">
                <RadzenTextBox @bind-Value="@LocalGameType.Image" 
                               Placeholder="e.g., itzg/minecraft-server:latest"
                               class="w-100" />
            </RadzenFormField>
            <small class="text-muted">Full Docker image name including tag</small>
        </div>

        <div class="col-md-6">
            <RadzenFormField Text="Thumbnail URL" Variant="@Variant.Outlined" class="w-100">
                <RadzenTextBox @bind-Value="@LocalGameType.ThumbnailUrl" 
                               Placeholder="https://example.com/image.png"
                               class="w-100" />
            </RadzenFormField>
        </div>

        <div class="col-md-6">
            <RadzenFormField Text="Documentation URL" Variant="@Variant.Outlined" class="w-100">
                <RadzenTextBox @bind-Value="@LocalGameType.DocumentationUrl" 
                               Placeholder="https://docs.example.com"
                               class="w-100" />
            </RadzenFormField>
        </div>
    </div>
</RadzenCard>

@code {
    [Parameter]
    public GameTypeDefinition GameType { get; set; } = null!;

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public EventCallback<GameTypeDefinition> GameTypeChanged { get; set; }

    private GameTypeDefinition LocalGameType
    {
        get => GameType;
        set
        {
            if (GameType != value)
            {
                GameType = value;
                _ = GameTypeChanged.InvokeAsync(GameType);
            }
        }
    }
}
