@attribute [Obsolete("Legacy pre-V2 web hosts editor. Migrate to the V2 game type editor flow before removing the old repository chain.")]
@using GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenCard>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">
                <RadzenIcon Icon="language" Style="vertical-align: middle;" />
                Web Host Definitions
            </h5>
            <small class="text-muted">
                Define web interfaces exposed by containers. Routing will be auto-configured when services are created.
            </small>
        </div>
        <RadzenButton Text="Add Web Host" 
                      Icon="add" 
                      Size="ButtonSize.Small"
                      Click="ShowAddWebHost" />
    </div>

    @if (WebHosts == null || !WebHosts.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
            <RadzenIcon Icon="info" />
            No web hosts defined. This game server has no web interfaces to expose via reverse proxy.
        </RadzenAlert>
    }
    else
    {
        <div class="web-hosts-list">
            @foreach (var host in WebHosts.Select((h, i) => new { Host = h, Index = i }))
            {
                <RadzenCard class="web-host-card mb-3" Variant="Variant.Outlined">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <RadzenIcon Icon="language" Style="font-size: 1.5rem; color: var(--rz-primary);" />
                                <h6 class="mb-0">@host.Host.Name</h6>
                                @if (host.Index == 0)
                                {
                                    <RadzenBadge Text="Primary" 
                                                 BadgeStyle="BadgeStyle.Success" 
                                                 IsPill="true"
                                                 Size="BadgeSize.Small" />
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(host.Host.Description))
                            {
                                <p class="text-muted mb-2">@host.Host.Description</p>
                            }

                            <div class="host-details mb-2">
                                @if (!string.IsNullOrWhiteSpace(host.Host.ContainerPortVariable))
                                {
                                    <RadzenBadge Text="@($"Port: ${{{host.Host.ContainerPortVariable}}}")" 
                                                 BadgeStyle="BadgeStyle.Warning"
                                                 Variant="Variant.Flat" />
                                    <small class="text-muted ms-1">(dynamic)</small>
                                }
                                else
                                {
                                    <RadzenBadge Text="@($"Port: {host.Host.ContainerPort}")" 
                                                 BadgeStyle="BadgeStyle.Info"
                                                 Variant="Variant.Flat" />
                                }

                                <RadzenBadge Text="@GetPathSegment(host.Host, host.Index)" 
                                             BadgeStyle="BadgeStyle.Secondary"
                                             Variant="Variant.Flat" />

                                @if (host.Host.RequiresAuth)
                                {
                                    <RadzenBadge Text="Auth Required" 
                                                 BadgeStyle="BadgeStyle.Warning" 
                                                 IsPill="true"
                                                 Size="BadgeSize.Small" />
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(host.Host.EnabledWhen))
                            {
                                <div class="condition-info">
                                    <RadzenIcon Icon="rule" Style="font-size: 0.9rem;" />
                                    <small class="text-muted">
                                        Enabled when: <code>@host.Host.EnabledWhen</code>
                                    </small>
                                </div>
                            }

                            <div class="mt-2">
                                <small class="text-muted">
                                    <RadzenIcon Icon="link" Style="font-size: 0.9rem; vertical-align: middle;" />
                                    URL Pattern: 
                                    <code>https://yourdomain.com@GetUrlPath(host.Host, host.Index)/</code>
                                </small>
                            </div>
                        </div>

                        <div class="host-actions">
                            @if (host.Index > 0)
                            {
                                <RadzenButton Icon="arrow_upward" 
                                              Size="ButtonSize.Small" 
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => MoveUp(host.Index))"
                                              title="Move up (affects URL priority)" />
                            }
                            @if (host.Index < WebHosts.Count - 1)
                            {
                                <RadzenButton Icon="arrow_downward" 
                                              Size="ButtonSize.Small" 
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => MoveDown(host.Index))"
                                              title="Move down" />
                            }
                            <RadzenButton Icon="edit" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => EditWebHost(host.Host))" />
                            <RadzenButton Icon="delete" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => DeleteWebHost(host.Host))" />
                        </div>
                    </div>
                </RadzenCard>
            }
        </div>

        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="mt-3">
            <RadzenIcon Icon="info" />
            <strong>Note:</strong> The first web host gets the base path <code>/game-{serverId}/</code>. 
            Additional hosts get subpaths like <code>/game-{serverId}/host-name/</code>.
        </RadzenAlert>
    }
</RadzenCard>

<style>
    .web-hosts-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .web-host-card {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .web-host-card:hover {
        border-color: var(--rz-primary);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .host-details {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .host-actions {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .condition-info {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.5rem;
        background: var(--rz-base-100);
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 768px) {
        .web-host-card > div {
            flex-direction: column;
        }

        .host-actions {
            flex-direction: row;
            width: 100%;
            justify-content: flex-end;
        }
    }
</style>

@code {
    [Parameter] public List<WebHostDefinition> WebHosts { get; set; } = new();
    [Parameter] public EventCallback WebHostsChanged { get; set; }
    [Parameter] public List<string>? AvailableSettings { get; set; }

    private async Task InvokeChangedAsync()
    {
        if (WebHostsChanged.HasDelegate)
        {
            await WebHostsChanged.InvokeAsync();
        }
        StateHasChanged();
    }

    private string GetPathSegment(WebHostDefinition host, int index)
    {
        if (index == 0)
        {
            return "Path: /game-{serverId}";
        }

        var segment = host.PathSegment ?? host.Name.ToLower().Replace(" ", "-");
        return $"Path: /{segment}";
    }

    private string GetUrlPath(WebHostDefinition host, int index)
    {
        if (index == 0)
        {
            return "/game-{serverId}";
        }

        var segment = host.PathSegment ?? host.Name.ToLower().Replace(" ", "-");
        return $"/game-{{serverId}}/{segment}";
    }

    private async Task ShowAddWebHost()
    {
        var host = new WebHostDefinition();

        var result = await DialogService.OpenAsync<WebHostDialog>("Add Web Host",
            new Dictionary<string, object>
            {
                { "WebHost", host },
                { "IsNew", true },
                { "AvailableSettings", AvailableSettings ?? new List<string>() }
            },
            new DialogOptions { Width = "700px", Height = "600px" });

        if (result != null)
        {
            WebHosts.Add(result);
            await InvokeChangedAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Web Host Added",
                Detail = $"Web host '{result.Name}' has been added.",
                Duration = 3000
            });
        }
    }

    private async Task EditWebHost(WebHostDefinition host)
    {
        // Clone the host so we can cancel changes
        var editHost = new WebHostDefinition
        {
            Name = host.Name,
            ContainerPort = host.ContainerPort,
            Description = host.Description,
            PathSegment = host.PathSegment,
            RequiresAuth = host.RequiresAuth,
            EnabledWhen = host.EnabledWhen,
            ContainerPortVariable = host.ContainerPortVariable
        };

        var result = await DialogService.OpenAsync<WebHostDialog>("Edit Web Host",
            new Dictionary<string, object>
            {
                { "WebHost", editHost },
                { "IsNew", false },
                { "AvailableSettings", AvailableSettings ?? new List<string>() }
            },
            new DialogOptions { Width = "700px", Height = "600px" });

        if (result != null)
        {
            // Update the original host
            host.Name = result.Name;
            host.ContainerPort = result.ContainerPort;
            host.Description = result.Description;
            host.PathSegment = result.PathSegment;
            host.RequiresAuth = result.RequiresAuth;
            host.EnabledWhen = result.EnabledWhen;
            host.ContainerPortVariable = result.ContainerPortVariable;

            await InvokeChangedAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Web Host Updated",
                Detail = $"Web host '{result.Name}' has been updated.",
                Duration = 3000
            });
        }
    }

    private async Task DeleteWebHost(WebHostDefinition host)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete the web host '{host.Name}'?",
            "Delete Web Host",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            WebHosts.Remove(host);
            await InvokeChangedAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Web Host Deleted",
                Detail = $"Web host '{host.Name}' has been deleted.",
                Duration = 3000
            });
        }
    }

    private async Task MoveUp(int index)
    {
        if (index <= 0) return;

        var temp = WebHosts[index];
        WebHosts[index] = WebHosts[index - 1];
        WebHosts[index - 1] = temp;

        await InvokeChangedAsync();
    }

    private async Task MoveDown(int index)
    {
        if (index >= WebHosts.Count - 1) return;

        var temp = WebHosts[index];
        WebHosts[index] = WebHosts[index + 1];
        WebHosts[index + 1] = temp;

        await InvokeChangedAsync();
    }
}
