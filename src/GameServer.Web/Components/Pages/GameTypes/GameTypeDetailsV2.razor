            RelationType = mapping.RelationType,
            TargetContainerPort = mapping.TargetContainerPort,
            TargetProtocol = mapping.TargetProtocol,
            CalculationValue = mapping.CalculationValue,
            IsRequired = mapping.IsRequired
        };
    }

    private static GameTypeRevisionPortMappingDraft MapDetectedPortMapping(DetectedSettingPortMapping mapping)
    {
        ArgumentNullException.ThrowIfNull(mapping);

        return new GameTypeRevisionPortMappingDraft
        {
            MappingRole = mapping.MappingRole,
            RelationType = mapping.RelationType,
            TargetContainerPort = mapping.TargetContainerPort,
            TargetProtocol = mapping.TargetProtocol,
            CalculationValue = mapping.CalculationValue,
            IsRequired = mapping.IsRequired
        };
    }

    private IReadOnlyList<string> GetDraftDifferences()
    {
        var baseline = CurrentRevision;
        if (baseline is null)
        {
            return
            [
                "This is a new revision draft.",
                $"Ports: {revisionPorts.Count}",
                $"Volumes: {revisionVolumes.Count}",
                $"Settings: {revisionSettingDefinitions.Count}",
                $"Web Hosts: {revisionWebHosts.Count}"
            ];
        }

        var differences = new List<string>();

        if (!string.Equals(revisionVersionTag, baseline.VersionTag, StringComparison.Ordinal))
        {
            differences.Add($"Version tag changed from '{baseline.VersionTag}' to '{revisionVersionTag}'.");
        }

        if (!string.Equals(revisionImageReference, baseline.ImageReference, StringComparison.Ordinal))
        {
            differences.Add($"Image reference changed from '{baseline.ImageReference}' to '{revisionImageReference}'.");
        }

        if (!string.Equals(revisionImageDigest, baseline.ImageDigest, StringComparison.Ordinal))
        {
            differences.Add("Image digest changed.");
        }

        if (revisionEnableTTY != baseline.EnableTTY)
        {
            differences.Add($"TTY changed from {(baseline.EnableTTY ? "enabled" : "disabled")} to {(revisionEnableTTY ? "enabled" : "disabled")}.");
        }

        if (revisionIsPublished != baseline.IsPublished)
        {
            differences.Add($"Published flag changed from {(baseline.IsPublished ? "published" : "draft")} to {(revisionIsPublished ? "published" : "draft")}.");
        }

        if (revisionPorts.Count != baseline.Ports.Count)
        {
            differences.Add($"Port count changed from {baseline.Ports.Count} to {revisionPorts.Count}.");
        }

        if (revisionVolumes.Count != baseline.Volumes.Count)
        {
            differences.Add($"Volume count changed from {baseline.Volumes.Count} to {revisionVolumes.Count}.");
        }

        if (revisionSettingDefinitions.Count != baseline.SettingDefinitions.Count)
        {
            differences.Add($"Setting count changed from {baseline.SettingDefinitions.Count} to {revisionSettingDefinitions.Count}.");
        }

        if (revisionWebHosts.Count != baseline.WebHosts.Count)
        {
            differences.Add($"Web Host count changed from {baseline.WebHosts.Count} to {revisionWebHosts.Count}.");
        }

        var baselinePortMappings = baseline.SettingDefinitions.Sum(x => x.Metadata?.PortMappings.Count ?? 0);
        var draftPortMappings = revisionSettingDefinitions.Sum(x => x.Metadata.PortMappings.Count);
        if (draftPortMappings != baselinePortMappings)
        {
            differences.Add($"Port mapping rule count changed from {baselinePortMappings} to {draftPortMappings}.");
        }

        if (!string.Equals(revisionNotes, baseline.Notes, StringComparison.Ordinal))
        {
            differences.Add("Revision notes changed.");
        }

        return differences;
    }

    private IReadOnlyList<string> GetDetailedDraftDifferences()
    {
        var baseline = CurrentRevision;
        var differences = new List<string>();

        if (baseline is null)
        {
            differences.AddRange(revisionPorts.Select((port, index) => $"Draft port #{index + 1}: {port.ContainerPort}/{port.Protocol} {(port.AdvertisedPort ? "(advertised)" : string.Empty)}".Trim()));
            differences.AddRange(revisionVolumes.Select((volume, index) => $"Draft volume #{index + 1}: '{volume.Description ?? volume.Source}' ({volume.Usage})"));
            differences.AddRange(revisionSettingDefinitions.Select(setting => $"Draft setting '{setting.SettingKey}' with {setting.Metadata.PortMappings.Count} port mapping rule(s)."));
            differences.AddRange(revisionWebHosts.Select(host => $"Draft Web Host '{host.Name}' targeting {(host.ContainerPort.HasValue ? host.ContainerPort.Value.ToString() : host.ContainerPortVariable ?? "(unset)")}."));
            return differences;
        }

        var baselinePorts = baseline.Ports.Select((port, index) => new { Key = $"{port.ContainerPort}/{port.Protocol}", Index = index, Port = port }).ToDictionary(x => x.Key, StringComparer.OrdinalIgnoreCase);
        var draftPorts = revisionPorts.Select((port, index) => new { Key = $"{port.ContainerPort}/{port.Protocol}", Index = index, Port = port }).ToList();

        foreach (var draftPort in draftPorts)
        {
            if (!baselinePorts.TryGetValue(draftPort.Key, out var baselinePort))
            {
                differences.Add($"Added port '{draftPort.Key}' at draft position {draftPort.Index + 1}.");
                continue;
            }

            if (draftPort.Index != baselinePort.Index)
            {
                differences.Add($"Port '{draftPort.Key}' moved from position {baselinePort.Index + 1} to {draftPort.Index + 1}.");
            }

            if (draftPort.Port.AdvertisedPort != baselinePort.Port.AdvertisedPort)
            {
                differences.Add($"Port '{draftPort.Key}' advertised flag changed.");
            }

            if (!string.Equals(draftPort.Port.Description, baselinePort.Port.Description, StringComparison.Ordinal))
            {
                differences.Add($"Port '{draftPort.Key}' description changed.");
            }
        }

        var removedPorts = baseline.Ports.Select(port => $"{port.ContainerPort}/{port.Protocol}").Except(draftPorts.Select(x => x.Key), StringComparer.OrdinalIgnoreCase);
        differences.AddRange(removedPorts.Select(port => $"Removed port '{port}'."));

        var baselineVolumes = baseline.Volumes.Select((volume, index) => new { Key = volume.Description ?? volume.Source, Index = index, Volume = volume }).ToDictionary(x => x.Key ?? string.Empty, StringComparer.OrdinalIgnoreCase);
        var draftVolumes = revisionVolumes.Select((volume, index) => new { Key = volume.Description ?? volume.Source, Index = index, Volume = volume }).ToList();

        foreach (var draftVolume in draftVolumes)
        {
            var key = draftVolume.Key ?? string.Empty;
            if (!baselineVolumes.TryGetValue(key, out var baselineVolume))
            {
                differences.Add($"Added volume '{key}'.");
                continue;
            }

            if (draftVolume.Index != baselineVolume.Index)
            {
                differences.Add($"Volume '{key}' moved from position {baselineVolume.Index + 1} to {draftVolume.Index + 1}.");
            }

            if (!string.Equals(draftVolume.Volume.Usage, baselineVolume.Volume.Usage, StringComparison.OrdinalIgnoreCase))
            {
                differences.Add($"Volume '{key}' usage changed from '{baselineVolume.Volume.Usage}' to '{draftVolume.Volume.Usage}'.");
            }

            if (!string.Equals(draftVolume.Volume.Source, baselineVolume.Volume.Source, StringComparison.Ordinal))
            {
                differences.Add($"Volume '{key}' source changed.");
            }
        }

        var removedVolumes = baseline.Volumes.Select(volume => volume.Description ?? volume.Source ?? string.Empty).Except(draftVolumes.Select(x => x.Key ?? string.Empty), StringComparer.OrdinalIgnoreCase);
        differences.AddRange(removedVolumes.Select(volume => $"Removed volume '{volume}'."));

        var baselineSettings = baseline.SettingDefinitions.ToDictionary(x => x.SettingKey, StringComparer.OrdinalIgnoreCase);
        foreach (var draftSetting in revisionSettingDefinitions)
        {
            if (!baselineSettings.TryGetValue(draftSetting.SettingKey, out var baselineSetting))
            {
                differences.Add($"Added setting '{draftSetting.SettingKey}'.");
                continue;
            }

            if (!string.Equals(draftSetting.DefaultValue, baselineSetting.DefaultValue, StringComparison.Ordinal))
            {
                differences.Add($"Setting '{draftSetting.SettingKey}' default value changed.");
            }

            if (!string.Equals(draftSetting.Metadata.DataType, baselineSetting.Metadata?.DataType, StringComparison.OrdinalIgnoreCase))
            {
                differences.Add($"Setting '{draftSetting.SettingKey}' data type changed.");
            }

            if (draftSetting.Metadata.PortMappings.Count != (baselineSetting.Metadata?.PortMappings.Count ?? 0))
            {
                differences.Add($"Setting '{draftSetting.SettingKey}' port mapping count changed from {baselineSetting.Metadata?.PortMappings.Count ?? 0} to {draftSetting.Metadata.PortMappings.Count}.");
            }
        }

        var removedSettings = baseline.SettingDefinitions.Select(setting => setting.SettingKey).Except(revisionSettingDefinitions.Select(x => x.SettingKey), StringComparer.OrdinalIgnoreCase);
        differences.AddRange(removedSettings.Select(setting => $"Removed setting '{setting}'."));

        var baselineHosts = baseline.WebHosts.Select((host, index) => new { Key = host.Name, Index = index, Host = host }).ToDictionary(x => x.Key, StringComparer.OrdinalIgnoreCase);
        var draftHosts = revisionWebHosts.Select((host, index) => new { Key = host.Name, Index = index, Host = host }).ToList();

        foreach (var draftHost in draftHosts)
        {
            if (!baselineHosts.TryGetValue(draftHost.Key, out var baselineHost))
            {
                differences.Add($"Added Web Host '{draftHost.Key}'.");
                continue;
            }

            if (draftHost.Index != baselineHost.Index)
            {
                differences.Add($"Web Host '{draftHost.Key}' moved from position {baselineHost.Index + 1} to {draftHost.Index + 1}.");
            }

            if (!string.Equals(draftHost.Host.PathSegment, baselineHost.Host.PathSegment, StringComparison.Ordinal))
            {
                differences.Add($"Web Host '{draftHost.Key}' path segment changed.");
            }

            if (draftHost.Host.ContainerPort != baselineHost.Host.ContainerPort || !string.Equals(draftHost.Host.ContainerPortVariable, baselineHost.Host.ContainerPortVariable, StringComparison.Ordinal))
            {
                differences.Add($"Web Host '{draftHost.Key}' port binding changed.");
            }
        }

        var removedHosts = baseline.WebHosts.Select(host => host.Name).Except(revisionWebHosts.Select(x => x.Name), StringComparer.OrdinalIgnoreCase);
        differences.AddRange(removedHosts.Select(host => $"Removed Web Host '{host}'."));

        return differences;
    }

    private static void MoveItem<T>(List<T> items, T item, int delta)
    {
        var currentIndex = items.IndexOf(item);
        if (currentIndex < 0)
        {
            return;
        }

        var newIndex = currentIndex + delta;
        if (newIndex < 0 || newIndex >= items.Count)
        {
            return;
        }

        items.RemoveAt(currentIndex);
        items.Insert(newIndex, item);
    }

    private bool CanSaveRevision()
    {
        return gameType is not null && !isNew && GetRevisionSaveValidationIssues().Count == 0;
    }

    private List<string> GetVisibleCrossTabValidationIssues()
    {
        if (editingRevisionId is null && selectedRevisionId == UnsavedDraftRevisionSelectionId && !HasRevisionDraftContent())
        {
            return [];
        }

        var issues = new List<string>();

        if (revisionPorts.Count == 0)
        {
            issues.Add("At least one port is required for a revision.");
        }

        if (revisionPorts.Count > 0 && revisionPorts.Count(x => x.AdvertisedPort) != 1)
        {
            issues.Add("Exactly one advertised port is required.");
        }

        foreach (var setting in revisionSettingDefinitions.Where(setting => !string.IsNullOrWhiteSpace(setting.SettingKey)))
        {
            issues.AddRange(GetSettingPortMappingValidationIssues(setting));
        }

        return issues.Distinct(StringComparer.Ordinal).ToList();
    }

    private List<string> GetRevisionDraftIssues()
    {
        return GetRevisionValidationIssues(includeSaveRequirements: false);
    }

    private List<string> GetRevisionSaveValidationIssues()
    {
        return GetRevisionValidationIssues(includeSaveRequirements: true);
    }

    private List<string> GetRevisionValidationIssues(bool includeSaveRequirements)
    {
        var issues = new List<string>();
        var webHostPortVariables = GetWebHostPortVariableOptions()
            .ToDictionary(option => option.SettingKey, StringComparer.OrdinalIgnoreCase);

        if (includeSaveRequirements && string.IsNullOrWhiteSpace(revisionVersionTag))
        {
            issues.Add("Revision version tag is required.");
        }

        if (includeSaveRequirements && string.IsNullOrWhiteSpace(revisionImageReference))
        {
            issues.Add("Revision image reference is required.");
        }

        if (includeSaveRequirements && revisionPorts.Count == 0)
        {
            issues.Add("At least one port is required for a revision.");
        }

        if (revisionPorts.Count > 0 && revisionPorts.Count(x => x.AdvertisedPort) != 1)
        {
            issues.Add("Exactly one advertised port is required.");
        }

        var duplicatePorts = revisionPorts
            .GroupBy(x => $"{x.ContainerPort}/{x.Protocol}", StringComparer.OrdinalIgnoreCase)
            .Where(x => x.Count() > 1)
            .Select(x => x.Key)
            .ToList();

        foreach (var duplicatePort in duplicatePorts)
        {
            issues.Add($"Duplicate port mapping detected for '{duplicatePort}'.");
        }

        var duplicateSettingKeys = revisionSettingDefinitions
            .Where(x => !string.IsNullOrWhiteSpace(x.SettingKey))
            .GroupBy(x => x.SettingKey, StringComparer.OrdinalIgnoreCase)
            .Where(x => x.Count() > 1)
            .Select(x => x.Key)
            .ToList();

        foreach (var duplicateSettingKey in duplicateSettingKeys)
        {
            issues.Add($"Duplicate setting key '{duplicateSettingKey}' detected.");
        }

        foreach (var setting in revisionSettingDefinitions)
        {
            if (string.IsNullOrWhiteSpace(setting.SettingKey))
            {
                issues.Add("Each setting must have a key.");
                continue;
            }

            if (setting.Metadata.IsRequired && setting.Metadata.CannotBeEmpty && string.IsNullOrWhiteSpace(setting.DefaultValue))
            {
                issues.Add($"Required setting '{setting.SettingKey}' cannot have an empty default value.");
            }

            issues.AddRange(GetSettingPortMappingValidationIssues(setting));
        }

        foreach (var host in revisionWebHosts)
        {
            issues.AddRange(GetWebHostValidationIssues(host, webHostPortVariables));
        }

        return issues.Distinct(StringComparer.Ordinal).ToList();
    }

    private static List<string> GetWebHostValidationIssues(GameTypeRevisionWebHostDraft host, IReadOnlyDictionary<string, WebHostPortVariableOption> webHostPortVariables)
    {
        ArgumentNullException.ThrowIfNull(host);
        ArgumentNullException.ThrowIfNull(webHostPortVariables);

        var issues = new List<string>();
        var hostLabel = string.IsNullOrWhiteSpace(host.Name) ? "(unnamed)" : host.Name;
        var hasStaticPort = host.ContainerPort.HasValue;
        var hasVariablePort = !string.IsNullOrWhiteSpace(host.ContainerPortVariable);

        if (!hasStaticPort && !hasVariablePort)
        {
            issues.Add($"Web Host '{hostLabel}' must define either a static port or a port variable.");
        }

        if (hasStaticPort && hasVariablePort)
        {
            issues.Add($"Web Host '{hostLabel}' cannot define both a static port and a port variable.");
        }

        if (hasVariablePort)
        {
            var variableName = host.ContainerPortVariable!.Trim();
            if (!webHostPortVariables.ContainsKey(variableName))
            {
                issues.Add($"Web Host '{hostLabel}' port variable '{variableName}' must reference a revision setting with a numeric default port and a 'number' or 'port' data type.");
            }
        }

        foreach (var pathIssue in GameTypeRevisionWebHostDraftRules.GetPathSegmentValidationIssues(host.PathSegment))
        {
            issues.Add($"Web Host '{hostLabel}' {pathIssue}");
        }

        return issues;
    }

    private List<string> GetRevisionWarnings()
    {
        var warnings = new List<string>();

        if (string.IsNullOrWhiteSpace(revisionNotes))
        {
            warnings.Add("Revision notes are empty; consider recording what changed in this draft.");
        }

        if (revisionVolumes.Count == 0)
        {
            warnings.Add("No volumes are defined in this draft. That can be valid, but most dedicated servers persist at least one path.");
        }

        if (revisionSettingDefinitions.Count == 0)
        {
            warnings.Add("No settings are defined in this draft. Confirm the image truly does not require configurable environment variables.");
        }

        if (revisionWebHosts.Count == 0)
        {
            warnings.Add("No Web Host rules are defined. That is fine for headless servers, but web interfaces will not be derived until rules are added.");
        }

        if (detectionComparison is not null && detectionComparison.HasChanges)
        {
            warnings.Add("Detection comparison still reports changes against the selected revision. Review whether the draft should accept those changes before publishing.");
        }

        if (CurrentRevision is not null && !GetDraftDifferences().Any())
        {
            warnings.Add("This draft currently matches the selected revision summary. Consider whether a new revision is necessary before saving.");
        }

        return warnings.Distinct(StringComparer.Ordinal).ToList();
    }

    private List<string> GetSettingPortMappingValidationIssues(GameTypeRevisionSettingDraft setting)
    {
        ArgumentNullException.ThrowIfNull(setting);

        var issues = new List<string>();
        var hasMappings = setting.Metadata.PortMappings.Count > 0;
        var isPortSetting = string.Equals(setting.Metadata.DataType, "port", StringComparison.OrdinalIgnoreCase);

        if (isPortSetting && !hasMappings)
        {
            issues.Add($"Port setting '{setting.SettingKey}' must define at least one port mapping.");
            return issues;
        }

        if (!hasMappings)
        {
            return issues;
        }

        var primaryMappings = setting.Metadata.PortMappings
            .Where(mapping => string.Equals(mapping.MappingRole, nameof(GameTypeSettingPortMappingRole.Primary), StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (primaryMappings.Count != 1)
        {
            issues.Add($"Setting '{setting.SettingKey}' must define exactly one primary port mapping.");
        }

        var primaryMapping = primaryMappings.FirstOrDefault();
        if (primaryMapping is not null)
        {
            ValidatePrimaryPortMapping(setting, primaryMapping, isPortSetting, issues);
        }

        foreach (var mapping in setting.Metadata.PortMappings)
        {
            var resolvedTargetPort = ResolveTargetContainerPort(setting, mapping, primaryMapping);
            var targetExists = resolvedTargetPort is int resolvedTargetPortValue
                && revisionPorts.Any(x => x.ContainerPort == resolvedTargetPortValue && string.Equals(x.Protocol, mapping.TargetProtocol, StringComparison.OrdinalIgnoreCase));
            if (!targetExists)
            {
                var targetPortLabel = resolvedTargetPort is int resolvedPort ? resolvedPort.ToString() : "(unresolved)";
                issues.Add($"Setting '{setting.SettingKey}' references missing {GetPortReferenceLabel(mapping)} '{targetPortLabel}/{mapping.TargetProtocol}'.");
            }

            if (primaryMapping is null || ReferenceEquals(mapping, primaryMapping))
            {
                continue;
            }

            ValidateRelatedPortMapping(setting, mapping, primaryMapping, issues);
        }

        return issues;
    }

    private static void ValidatePrimaryPortMapping(GameTypeRevisionSettingDraft setting, GameTypeRevisionPortMappingDraft primaryMapping, bool isPortSetting, List<string> issues)
    {
        ArgumentNullException.ThrowIfNull(setting);
        ArgumentNullException.ThrowIfNull(primaryMapping);
        ArgumentNullException.ThrowIfNull(issues);

        if (!string.Equals(primaryMapping.RelationType, nameof(GameTypeSettingPortRelationType.Direct), StringComparison.OrdinalIgnoreCase))
        {
            issues.Add($"Setting '{setting.SettingKey}' must use a direct relation for its primary port mapping.");
        }

        if (isPortSetting && int.TryParse(setting.DefaultValue, out var defaultPort) && defaultPort > 0 && primaryMapping.TargetContainerPort != defaultPort)
        {
            issues.Add($"Port setting '{setting.SettingKey}' must directly map its primary rule to '{defaultPort}/{primaryMapping.TargetProtocol}'.");
        }

        if (isPortSetting && (!int.TryParse(setting.DefaultValue, out var parsedPort) || parsedPort <= 0))
        {
            issues.Add($"Port setting '{setting.SettingKey}' must have a numeric default value before port mappings can be validated.");
        }
    }

    private static void ValidateRelatedPortMapping(GameTypeRevisionSettingDraft setting, GameTypeRevisionPortMappingDraft mapping, GameTypeRevisionPortMappingDraft primaryMapping, List<string> issues)
    {
        ArgumentNullException.ThrowIfNull(setting);
        ArgumentNullException.ThrowIfNull(mapping);
        ArgumentNullException.ThrowIfNull(primaryMapping);
        ArgumentNullException.ThrowIfNull(issues);

        if (!string.Equals(mapping.MappingRole, nameof(GameTypeSettingPortMappingRole.Related), StringComparison.OrdinalIgnoreCase))
        {
            issues.Add($"Setting '{setting.SettingKey}' can only use related mappings after the primary mapping.");
        }

        var isOffset = string.Equals(mapping.RelationType, nameof(GameTypeSettingPortRelationType.Offset), StringComparison.OrdinalIgnoreCase);
        var isMultiplier = string.Equals(mapping.RelationType, nameof(GameTypeSettingPortRelationType.Multiplier), StringComparison.OrdinalIgnoreCase);
        if (!isOffset && !isMultiplier)
        {
            issues.Add($"Setting '{setting.SettingKey}' can only use offset or multiplier relations for related port mappings.");
        }

        if (!mapping.CalculationValue.HasValue)
        {
            issues.Add($"Setting '{setting.SettingKey}' must define a calculation value for related mapping '{mapping.TargetProtocol}'.");
            return;
        }
    }

    private static int? ResolveTargetContainerPort(GameTypeRevisionSettingDraft setting, GameTypeRevisionPortMappingDraft mapping, GameTypeRevisionPortMappingDraft? primaryMapping = null)
    {
        ArgumentNullException.ThrowIfNull(setting);
        ArgumentNullException.ThrowIfNull(mapping);

        if (string.Equals(mapping.MappingRole, nameof(GameTypeSettingPortMappingRole.Related), StringComparison.OrdinalIgnoreCase)
            && (string.Equals(mapping.RelationType, nameof(GameTypeSettingPortRelationType.Offset), StringComparison.OrdinalIgnoreCase)
                || string.Equals(mapping.RelationType, nameof(GameTypeSettingPortRelationType.Multiplier), StringComparison.OrdinalIgnoreCase)))
        {
            primaryMapping ??= setting.Metadata.PortMappings.FirstOrDefault(existing => string.Equals(existing.MappingRole, nameof(GameTypeSettingPortMappingRole.Primary), StringComparison.OrdinalIgnoreCase));
            if (primaryMapping is not null && primaryMapping.TargetContainerPort > 0 && mapping.CalculationValue.HasValue)
            {
                return string.Equals(mapping.RelationType, nameof(GameTypeSettingPortRelationType.Multiplier), StringComparison.OrdinalIgnoreCase)
                    ? primaryMapping.TargetContainerPort * mapping.CalculationValue.Value
                    : primaryMapping.TargetContainerPort + mapping.CalculationValue.Value;
            }

            return null;
        }

        return mapping.TargetContainerPort;
    }

    private static string GetPortReferenceLabel(GameTypeRevisionPortMappingDraft mapping)
    {
        ArgumentNullException.ThrowIfNull(mapping);
        return string.Equals(mapping.MappingRole, nameof(GameTypeSettingPortMappingRole.Related), StringComparison.OrdinalIgnoreCase)
            ? "default related port"
            : "target port";
    }

}
