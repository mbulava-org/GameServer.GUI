@page "/gametypes-v2/{Key}"
@page "/gametypes-v2/new"
@rendermode InteractiveServer
@using GameServer.Web.Components.Pages.GameTypes.Components.V2
@using GameServer.Web.Models.V2
@using Radzen
@using Radzen.Blazor
@inject Services.V2.GameTypeV2ApiService GameTypeApiV2
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>@(isNew ? "Create Game Type V2" : gameType?.DisplayName ?? "Game Type V2")</PageTitle>

<div class="container-fluid game-type-details-page">
    <div class="game-type-details-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <RadzenButton Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@GoBack"
                              class="me-3" />
                <h2 class="d-inline">@(isNew ? "Create New Game Type V2" : $"Edit V2: {gameType?.DisplayName}")</h2>
            </div>
            <div class="d-flex gap-2">
                <RadzenButton Text="Cancel"
                              Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@GoBack" />
                <RadzenButton Text="Save"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@SaveAsync"
                              Disabled="@isSaving" />
            </div>
        </div>
    </div>

    <div class="game-type-details-content">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                <p class="mt-3">Loading V2 game type...</p>
            </div>
        }
        else if (!isNew && gameType is null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Light">
                The requested V2 game type could not be found.
            </RadzenAlert>
        }
        else if (gameType is not null)
        {
            <div class="row mb-3">
                <div class="col-lg-8">
                    <RadzenCard>
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h4 class="mb-0">@gameType.DisplayName</h4>
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@gameType.Key" Variant="Variant.Outlined" />
                                    <RadzenBadge BadgeStyle="@(gameType.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)" Text="@(gameType.IsActive ? "Active" : "Inactive")" />
                                </div>
                                <p class="text-muted mb-2">@(string.IsNullOrWhiteSpace(gameType.Description) ? "No description provided." : gameType.Description)</p>
                                <div><strong>Image:</strong> <code>@gameType.ImageReference</code></div>
                                @if (!string.IsNullOrWhiteSpace(gameType.DocumentationUrl))
                                {
                                    <div><strong>Docs:</strong> <a href="@gameType.DocumentationUrl" target="_blank">@gameType.DocumentationUrl</a></div>
                                }
                            </div>
                            <div class="text-end">
                                <div><strong>Revisions:</strong> @gameType.Revisions.Count</div>
                                <div><strong>Current:</strong> @(CurrentRevision?.VersionTag ?? "None")</div>
                                <div><strong>Updated:</strong> @gameType.UpdatedAt.ToLocalTime().ToString("g")</div>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="col-lg-4">
                    <RadzenCard>
                        <RadzenFormField Text="Active Revision" Variant="Variant.Outlined" class="w-100">
                            <RadzenDropDown TValue="int?"
                                            Data="@gameType.Revisions"
                                            TextProperty="VersionTag"
                                            ValueProperty="Id"
                                            @bind-Value="selectedRevisionId"
                                            Change="@(_ => OnSelectedRevisionChanged())"
                                            Placeholder="Select revision"
                                            class="w-100" />
                        </RadzenFormField>
                    </RadzenCard>
                </div>
            </div>

            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Basic">
                        <div class="p-4">
                            <GameTypeBasicInfoV2Editor IsNew="isNew"
                                                       @bind-KeyValue="keyValue"
                                                       @bind-DisplayName="displayName"
                                                       @bind-ImageReference="imageReference"
                                                       @bind-ThumbnailUrl="thumbnailUrl"
                                                       @bind-DocumentationUrl="documentationUrl"
                                                       @bind-Description="description"
                                                       @bind-IsActive="isActive" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Revisions">
                        <div class="p-4">
                            <GameTypeRevisionEditor RevisionRows="@GetRevisionRows()"
                                                   ValidationIssues="@GetRevisionValidationIssues()"
                                                   Warnings="@GetRevisionWarnings()"
                                                   @bind-VersionTag="revisionVersionTag"
                                                   @bind-ImageDigest="revisionImageDigest"
                                                   @bind-EnableTTY="revisionEnableTTY"
                                                   @bind-Notes="revisionNotes"
                                                   @bind-IsPublished="revisionIsPublished"
                                                   IsSavingRevision="isSavingRevision"
                                                   CanSaveRevision="@CanSaveRevision()"
                                                   CanSetCurrentRevision="@(editingRevisionId is not null && GetRevisionValidationIssues().Count == 0)"
                                                   OnCreateNewDraft="@CreateNewRevisionDraft"
                                                   OnSaveRevision="@SaveRevisionAsync"
                                                   OnSetCurrentRevision="@SetCurrentRevisionAsync"
                                                   OnPublishAndSetCurrent="@PublishAndSetCurrentAsync"
                                                   OnEditRevision="@EditRevisionDraft"
                                                   OnCloneRevision="@CloneRevisionDraft" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Ports">
                        <div class="p-4">
                            <GameTypeRevisionPortsEditor Ports="revisionPorts"
                                                         ProtocolOptions="protocolOptions" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Volumes">
                        <div class="p-4">
                            <GameTypeRevisionVolumesEditor Volumes="revisionVolumes"
                                                           VolumeUsageOptions="volumeUsageOptions" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Settings">
                        <div class="p-4">
                            <GameTypeRevisionSettingsEditor Settings="revisionSettingDefinitions"
                                                            DefinedPorts="revisionPorts"
                                                            DataTypeOptions="dataTypeOptions"
                                                            ProtocolOptions="protocolOptions"
                                                            PortMappingRoleOptions="portMappingRoleOptions"
                                                            PortRelationTypeOptions="portRelationTypeOptions" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Web Hosts">
                        <div class="p-4">
                            <GameTypeRevisionWebHostsEditor WebHosts="revisionWebHosts" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Detection">
                        <div class="p-4">
                            <GameTypeRevisionDetectionEditor IsNew="isNew"
                                                            IsDetecting="isDetecting"
                                                            @bind-DetectionVersionTag="detectionVersionTag"
                                                            DetectionResult="detectionResult"
                                                            DetectionComparison="detectionComparison"
                                                            OnScanTag="@RunDetectionAsync"
                                                            OnApplyAll="@ApplyDetectionToDraft"
                                                            OnApplyIdentity="@ApplyDetectionIdentity"
                                                            OnApplyPorts="@ApplyDetectionPorts"
                                                            OnApplySettings="@ApplyDetectionSettings"
                                                            OnApplyVolumes="@ApplyDetectionVolumes" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Review">
                        <div class="p-4">
                            <GameTypeRevisionReviewEditor RevisionVersionTag="revisionVersionTag"
                                                         RevisionImageDigest="revisionImageDigest"
                                                         RevisionEnableTTY="revisionEnableTTY"
                                                         RevisionIsPublished="revisionIsPublished"
                                                         PortCount="revisionPorts.Count"
                                                         VolumeCount="revisionVolumes.Count"
                                                         SettingCount="revisionSettingDefinitions.Count"
                                                         WebHostCount="revisionWebHosts.Count"
                                                         PortMappingCount="revisionSettingDefinitions.Sum(x => x.Metadata.PortMappings.Count)"
                                                         DetectionResult="detectionResult"
                                                         DetectionComparison="detectionComparison"
                                                         ValidationIssues="@GetRevisionValidationIssues()"
                                                         Warnings="@GetRevisionWarnings()"
                                                         DraftDifferences="@GetDraftDifferences()"
                                                         DetailedDraftDifferences="@GetDetailedDraftDifferences()" />
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? Key { get; set; }

    private GameTypeDetail? gameType;
    private bool isLoading = true;
    private bool isSaving;
    private bool isSavingRevision;
    private bool isDetecting;
    private bool isNew => string.IsNullOrWhiteSpace(Key);
    private int? selectedRevisionId;
    private string keyValue = string.Empty;
    private string displayName = string.Empty;
    private string? description;
    private string imageReference = string.Empty;
    private string? thumbnailUrl;
    private string? documentationUrl;
    private bool isActive = true;
    private int? editingRevisionId;
    private string revisionVersionTag = string.Empty;
    private string? revisionImageDigest;
    private bool revisionEnableTTY;
    private string? revisionNotes;
    private bool revisionIsPublished;
    private List<GameTypeRevisionPortDraft> revisionPorts = [];
    private List<GameTypeRevisionVolumeDraft> revisionVolumes = [];
    private List<GameTypeRevisionSettingDraft> revisionSettingDefinitions = [];
    private List<GameTypeRevisionWebHostDraft> revisionWebHosts = [];
    private string detectionVersionTag = string.Empty;
    private GameTypeSetupDetectionResult? detectionResult;
    private GameTypeSetupComparisonResult? detectionComparison;
    private static readonly IReadOnlyList<string> protocolOptions = ["tcp", "udp"];
    private static readonly IReadOnlyList<string> volumeUsageOptions = ["config", "world", "mods", "gamefiles"];
    private static readonly IReadOnlyList<string> dataTypeOptions = ["string", "number", "boolean", "enum", "port"];
    private static readonly IReadOnlyList<string> portMappingRoleOptions = ["Primary", "Related"];
    private static readonly IReadOnlyList<string> portRelationTypeOptions = ["Direct", "Offset", "Fixed", "Multiplier"];

    private GameTypeRevision? CurrentRevision => gameType?.Revisions.FirstOrDefault(x => x.Id == selectedRevisionId)
        ?? gameType?.Revisions.FirstOrDefault(x => x.Id == gameType.CurrentRevisionId)
        ?? gameType?.Revisions.FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;

            if (isNew)
            {
                gameType = new GameTypeDetail
                {
                    Key = string.Empty,
                    DisplayName = string.Empty,
                    ImageReference = string.Empty,
                    Revisions = []
                };
                selectedRevisionId = null;
                PopulateForm(gameType);
                LoadRevisionDraft(null);
                return;
            }

            gameType = await GameTypeApiV2.GetByKeyAsync(Key!);
            selectedRevisionId = gameType?.CurrentRevisionId ?? gameType?.Revisions.FirstOrDefault()?.Id;
            if (gameType is not null)
            {
                PopulateForm(gameType);
                LoadRevisionDraft(CurrentRevision);
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Load failed", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/gametypes-v2");
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(keyValue) || string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(imageReference))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Key, Display Name, and Image Reference are required.");
            return;
        }

        try
        {
            isSaving = true;

            var request = new SaveGameTypeRequest
            {
                Key = keyValue,
                DisplayName = displayName,
                Description = description,
                ImageReference = imageReference,
                ThumbnailUrl = thumbnailUrl,
                DocumentationUrl = documentationUrl,
                IsActive = isActive
            };

            gameType = isNew
                ? await GameTypeApiV2.CreateAsync(request)
                : await GameTypeApiV2.UpdateAsync(keyValue, request);

            selectedRevisionId = gameType.CurrentRevisionId ?? gameType.Revisions.FirstOrDefault()?.Id;
            PopulateForm(gameType);
            LoadRevisionDraft(CurrentRevision);

            NotificationService.Notify(NotificationSeverity.Success, "Saved", "V2 GameType saved successfully.");

            if (isNew)
            {
                Navigation.NavigateTo($"/gametypes-v2/{Uri.EscapeDataString(gameType.Key)}");
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnSelectedRevisionChanged()
    {
        LoadRevisionDraft(CurrentRevision);
    }

    private void CreateNewRevisionDraft()
    {
        LoadRevisionDraft(CurrentRevision, asNewDraft: true);
    }

    private void EditRevisionDraft(GameTypeRevision revision)
    {
        ArgumentNullException.ThrowIfNull(revision);
        selectedRevisionId = revision.Id;
        LoadRevisionDraft(revision);
    }

    private void CloneRevisionDraft(GameTypeRevision revision)
    {
        ArgumentNullException.ThrowIfNull(revision);
        selectedRevisionId = revision.Id;
        LoadRevisionDraft(revision, asNewDraft: true);
        if (!string.IsNullOrWhiteSpace(revisionVersionTag))
        {
            revisionVersionTag = $"{revisionVersionTag}-copy";
        }
    }

    private async Task SaveRevisionAsync()
    {
        if (gameType is null || isNew)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Save GameType first", "Create the V2 GameType before adding revisions.");
            return;
        }

        if (string.IsNullOrWhiteSpace(revisionVersionTag))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Revision version tag is required.");
            return;
        }

        try
        {
            isSavingRevision = true;

            var request = new SaveGameTypeRevisionRequest
            {
                VersionTag = revisionVersionTag,
                ImageDigest = revisionImageDigest,
                EnableTTY = revisionEnableTTY,
                Notes = revisionNotes,
                IsPublished = revisionIsPublished,
                Ports = revisionPorts.Select((port, index) => new GameTypePort
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    AdvertisedPort = port.AdvertisedPort,
                    Description = port.Description,
                    DisplayOrder = index
                }).ToList(),
                Volumes = revisionVolumes.Select((volume, index) => new GameTypeVolume
                {
                    Source = volume.Source,
                    Description = volume.Description,
                    DisplayOrder = index,
                    Usage = volume.Usage
                }).ToList(),
                SettingDefinitions = revisionSettingDefinitions.Select((setting, index) => new GameTypeSettingDefinition
                {
                    SettingKey = setting.SettingKey,
                    DefaultValue = setting.DefaultValue,
                    Description = setting.Description,
                    DisplayOrder = index,
                    Metadata = new GameTypeSettingMetadata
                    {
                        DataType = setting.Metadata.DataType,
                        Category = setting.Metadata.Category,
                        IsRequired = setting.Metadata.IsRequired,
                        CannotBeEmpty = setting.Metadata.CannotBeEmpty,
                        Placeholder = setting.Metadata.Placeholder,
                        ValidationPattern = setting.Metadata.ValidationPattern,
                        ValidationMessage = setting.Metadata.ValidationMessage,
                        AutoAllocatePort = setting.Metadata.AutoAllocatePort,
                        ValidateRelatedPortsAvailability = setting.Metadata.ValidateRelatedPortsAvailability,
                        AllowedValuesJson = setting.Metadata.AllowedValuesJson,
                        ValueMappingsJson = setting.Metadata.ValueMappingsJson,
                        PortMappings = setting.Metadata.PortMappings.Select((mapping, mappingIndex) => new GameTypeSettingPortMapping
                        {
                            MappingRole = Enum.TryParse<GameServer.Web.Models.V2.GameTypeSettingPortMappingRole>(mapping.MappingRole, true, out var role)
                                ? role.ToString()
                                : GameServer.Web.Models.V2.GameTypeSettingPortMappingRole.Primary.ToString(),
                            RelationType = Enum.TryParse<GameServer.Web.Models.V2.GameTypeSettingPortRelationType>(mapping.RelationType, true, out var relationType)
                                ? relationType.ToString()
                                : GameServer.Web.Models.V2.GameTypeSettingPortRelationType.Direct.ToString(),
                            TargetContainerPort = mapping.TargetContainerPort,
                            TargetProtocol = mapping.TargetProtocol,
                            CalculationValue = mapping.CalculationValue,
                            Description = mapping.Description,
                            IsRequired = mapping.IsRequired,
                            DisplayOrder = mappingIndex
                        }).ToList()
                    }
                }).ToList(),
                WebHosts = revisionWebHosts.Select((host, index) => new GameTypeWebHost
                {
                    Name = host.Name,
                    Description = host.Description,
                    PathSegment = host.PathSegment,
                    ContainerPort = host.ContainerPort,
                    ContainerPortVariable = host.ContainerPortVariable,
                    EnabledWhen = host.EnabledWhen,
                    DisplayOrder = index
                }).ToList()
            };

            var revision = editingRevisionId is null
                ? await GameTypeApiV2.AddRevisionAsync(gameType.Key, request)
                : await GameTypeApiV2.UpdateRevisionAsync(gameType.Key, editingRevisionId.Value, request);

            await ReloadGameTypeAsync(gameType.Key, revision.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Revision saved", $"Revision '{revision.VersionTag}' saved successfully.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Save revision failed", ex.Message);
        }
        finally
        {
            isSavingRevision = false;
        }
    }

    private async Task PublishAndSetCurrentAsync()
    {
        await PublishRevisionAsync(setAsCurrentRevision: true);
    }

    private async Task SetCurrentRevisionAsync()
    {
        if (gameType is null || editingRevisionId is null)
        {
            return;
        }

        try
        {
            await GameTypeApiV2.SetCurrentRevisionAsync(gameType.Key, editingRevisionId.Value);
            await ReloadGameTypeAsync(gameType.Key, editingRevisionId.Value);
            NotificationService.Notify(NotificationSeverity.Success, "Current revision updated", "The selected revision is now the active revision.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Set current failed", ex.Message);
        }
    }

    private async Task PublishRevisionAsync(bool setAsCurrentRevision)
    {
        if (gameType is null || editingRevisionId is null)
        {
            return;
        }

        try
        {
            isSavingRevision = true;
            var revision = await GameTypeApiV2.PublishRevisionAsync(gameType.Key, editingRevisionId.Value, setAsCurrentRevision);
            await ReloadGameTypeAsync(gameType.Key, revision.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Revision published", $"Revision '{revision.VersionTag}' published successfully.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Publish failed", ex.Message);
        }
        finally
        {
            isSavingRevision = false;
        }
    }

    private async Task RunDetectionAsync()
    {
        if (gameType is null || isNew)
        {
            return;
        }

        var versionTag = string.IsNullOrWhiteSpace(detectionVersionTag) ? revisionVersionTag : detectionVersionTag;
        if (string.IsNullOrWhiteSpace(versionTag))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Detection", "Enter a version tag to scan.");
            return;
        }

        try
        {
            isDetecting = true;
            detectionResult = await GameTypeApiV2.DetectSetupAsync(gameType.Key, versionTag);
            detectionVersionTag = detectionResult.VersionTag;
            NotificationService.Notify(NotificationSeverity.Success, "Detection complete", $"Scanned tag '{detectionResult.VersionTag}'.");

            if (CurrentRevision is not null)
            {
                detectionComparison = await GameTypeApiV2.CompareSetupAsync(gameType.Key, versionTag, CurrentRevision.Id);
                detectionResult = detectionComparison.Detection;
            }
            else
            {
                detectionComparison = null;
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Detection failed", ex.Message);
        }
        finally
        {
            isDetecting = false;
        }
    }

    private void ApplyDetectionToDraft()
    {
        if (detectionResult is null)
        {
            return;
        }

        editingRevisionId = null;
        revisionIsPublished = false;
        ApplyDetectionIdentityToDraft(notify: false);
        ApplyDetectedPortsToDraft(notify: false);
        ApplyDetectedVolumesToDraft(notify: false);
        ApplyDetectedSettingsToDraft(notify: false);

        NotificationService.Notify(NotificationSeverity.Info, "Draft updated", "Detection results have been applied to a new revision draft.");
    }

    private void ApplyDetectionIdentityToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        revisionVersionTag = detectionResult.VersionTag;
        revisionImageDigest = detectionResult.ImageDigest;
        if (notify)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Draft updated", "Detected tag and digest have been applied to the draft.");
        }
    }

    private void ApplyDetectionIdentity()
    {
        ApplyDetectionIdentityToDraft();
    }

    private void ApplyDetectedPortsToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        revisionPorts = detectionResult.Ports
            .Select((port, index) =>
            {
                var existing = revisionPorts.FirstOrDefault(x => x.ContainerPort == port.ContainerPort && string.Equals(x.Protocol, port.Protocol, StringComparison.OrdinalIgnoreCase));
                return new GameTypeRevisionPortDraft
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    AdvertisedPort = index == 0,
                    Description = existing?.Description ?? (index == 0 ? "Detected primary port" : "Detected exposed port")
                };
            })
            .ToList();

        if (notify)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Draft updated", "Detected ports have been applied to the draft.");
        }
    }

    private void ApplyDetectionPorts()
    {
        ApplyDetectedPortsToDraft();
    }

    private void ApplyDetectedVolumesToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        revisionVolumes = detectionResult.Volumes
            .Select(volume =>
            {
                var existing = revisionVolumes.FirstOrDefault(x => string.Equals(x.Description, volume.ContainerPath, StringComparison.OrdinalIgnoreCase));
                return new GameTypeRevisionVolumeDraft
                {
                    Source = existing?.Source ?? string.Empty,
                    Description = volume.ContainerPath,
                    Usage = existing?.Usage ?? InferVolumeUsage(volume.ContainerPath)
                };
            })
            .ToList();

        if (notify)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Draft updated", "Detected volumes have been applied to the draft.");
        }
    }

    private void ApplyDetectionVolumes()
    {
        ApplyDetectedVolumesToDraft();
    }

    private void ApplyDetectedSettingsToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        var existingSettings = revisionSettingDefinitions.ToDictionary(x => x.SettingKey, StringComparer.OrdinalIgnoreCase);

        revisionSettingDefinitions = detectionResult.Settings
            .Select(setting =>
            {
                if (existingSettings.TryGetValue(setting.Key, out var existing))
                {
                    return new GameTypeRevisionSettingDraft
                    {
                        SettingKey = existing.SettingKey,
                        DefaultValue = setting.DefaultValue,
                        Description = existing.Description,
                        Metadata = new GameTypeRevisionSettingMetadataDraft
                        {
                            DataType = existing.Metadata.DataType ?? InferDataType(setting.Key, setting.DefaultValue),
                            Category = existing.Metadata.Category,
                            IsRequired = existing.Metadata.IsRequired,
                            CannotBeEmpty = existing.Metadata.CannotBeEmpty,
                            Placeholder = existing.Metadata.Placeholder,
                            ValidationPattern = existing.Metadata.ValidationPattern,
                            ValidationMessage = existing.Metadata.ValidationMessage,
                            AutoAllocatePort = existing.Metadata.AutoAllocatePort,
                            ValidateRelatedPortsAvailability = existing.Metadata.ValidateRelatedPortsAvailability,
                            AllowedValuesJson = existing.Metadata.AllowedValuesJson,
                            ValueMappingsJson = existing.Metadata.ValueMappingsJson,
                            PortMappings = existing.Metadata.PortMappings.Count > 0
                                ? existing.Metadata.PortMappings.Select(ClonePortMappingDraft).ToList()
                                : setting.PortMappings.Select(MapDetectedPortMapping).ToList()
                        }
                    };
                }

                return new GameTypeRevisionSettingDraft
                {
                    SettingKey = setting.Key,
                    DefaultValue = setting.DefaultValue,
                    Metadata = new GameTypeRevisionSettingMetadataDraft
                    {
                        DataType = InferDataType(setting.Key, setting.DefaultValue),
                        IsRequired = false,
                        CannotBeEmpty = false,
                        PortMappings = setting.PortMappings.Select(MapDetectedPortMapping).ToList()
                    }
                };
            })
            .ToList();

        if (notify)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Draft updated", "Detected settings have been merged into the draft while preserving existing metadata where possible.");
        }
    }

    private void ApplyDetectionSettings()
    {
        ApplyDetectedSettingsToDraft();
    }

    private async Task ReloadGameTypeAsync(string key, int? preferredRevisionId = null)
    {
        gameType = await GameTypeApiV2.GetByKeyAsync(key);
        if (gameType is null)
        {
            return;
        }

        selectedRevisionId = preferredRevisionId ?? gameType.CurrentRevisionId ?? gameType.Revisions.FirstOrDefault()?.Id;
        PopulateForm(gameType);
        LoadRevisionDraft(CurrentRevision);
    }

    private void PopulateForm(GameTypeDetail detail)
    {
        keyValue = detail.Key;
        displayName = detail.DisplayName;
        description = detail.Description;
        imageReference = detail.ImageReference;
        thumbnailUrl = detail.ThumbnailUrl;
        documentationUrl = detail.DocumentationUrl;
        isActive = detail.IsActive;
    }

    private void LoadRevisionDraft(GameTypeRevision? revision, bool asNewDraft = false)
    {
        editingRevisionId = asNewDraft ? null : revision?.Id;
        revisionVersionTag = asNewDraft ? string.Empty : revision?.VersionTag ?? string.Empty;
        revisionImageDigest = revision?.ImageDigest;
        revisionEnableTTY = revision?.EnableTTY ?? false;
        revisionNotes = revision?.Notes;
        revisionIsPublished = asNewDraft ? false : revision?.IsPublished ?? false;
        revisionPorts = revision?.Ports.Select(x => new GameTypeRevisionPortDraft
        {
            ContainerPort = x.ContainerPort,
            Protocol = x.Protocol,
            AdvertisedPort = x.AdvertisedPort,
            Description = x.Description
        }).ToList() ?? [];
        revisionVolumes = revision?.Volumes.Select(x => new GameTypeRevisionVolumeDraft
        {
            Source = x.Source,
            Description = x.Description,
            Usage = x.Usage
        }).ToList() ?? [];
        revisionSettingDefinitions = revision?.SettingDefinitions.Select(x => new GameTypeRevisionSettingDraft
        {
            SettingKey = x.SettingKey,
            DefaultValue = x.DefaultValue,
            Description = x.Description,
            Metadata = new GameTypeRevisionSettingMetadataDraft
            {
                DataType = x.Metadata?.DataType,
                Category = x.Metadata?.Category,
                IsRequired = x.Metadata?.IsRequired ?? false,
                CannotBeEmpty = x.Metadata?.CannotBeEmpty ?? false,
                Placeholder = x.Metadata?.Placeholder,
                ValidationPattern = x.Metadata?.ValidationPattern,
                ValidationMessage = x.Metadata?.ValidationMessage,
                AutoAllocatePort = x.Metadata?.AutoAllocatePort ?? false,
                ValidateRelatedPortsAvailability = x.Metadata?.ValidateRelatedPortsAvailability ?? false,
                AllowedValuesJson = x.Metadata?.AllowedValuesJson,
                ValueMappingsJson = x.Metadata?.ValueMappingsJson,
                PortMappings = x.Metadata?.PortMappings.Select(pm => new GameTypeRevisionPortMappingDraft
                {
                    MappingRole = pm.MappingRole,
                    RelationType = pm.RelationType,
                    TargetContainerPort = pm.TargetContainerPort,
                    TargetProtocol = pm.TargetProtocol,
                    CalculationValue = pm.CalculationValue,
                    Description = pm.Description,
                    IsRequired = pm.IsRequired
                }).ToList() ?? []
            }
        }).ToList() ?? [];
        revisionWebHosts = revision?.WebHosts.Select(x => new GameTypeRevisionWebHostDraft
        {
            Name = x.Name,
            Description = x.Description,
            PathSegment = x.PathSegment,
            ContainerPort = x.ContainerPort,
            ContainerPortVariable = x.ContainerPortVariable,
            EnabledWhen = x.EnabledWhen
        }).ToList() ?? [];
        detectionVersionTag = string.IsNullOrWhiteSpace(revisionVersionTag) ? detectionVersionTag : revisionVersionTag;
        detectionComparison = null;
    }

    private IReadOnlyList<GameTypeRevisionListRow> GetRevisionRows()
    {
        if (gameType is null)
        {
            return [];
        }

        var rows = gameType.Revisions
            .Select(revision => new GameTypeRevisionListRow
            {
                Id = revision.Id,
                VersionTag = revision.VersionTag,
                ImageDigest = revision.ImageDigest,
                IsPublished = revision.IsPublished,
                EnableTTY = revision.EnableTTY,
                CreatedAt = revision.CreatedAt,
                SourceRevision = revision
            })
            .ToList();

        if (editingRevisionId is null && HasRevisionDraftContent())
        {
            rows.Insert(0, new GameTypeRevisionListRow
            {
                VersionTag = string.IsNullOrWhiteSpace(revisionVersionTag) ? "New Draft" : revisionVersionTag,
                ImageDigest = revisionImageDigest,
                IsPublished = revisionIsPublished,
                EnableTTY = revisionEnableTTY,
                CreatedAt = DateTime.UtcNow,
                IsUnsavedDraft = true
            });
        }

        return rows;
    }

    private bool HasRevisionDraftContent()
    {
        return !string.IsNullOrWhiteSpace(revisionVersionTag)
            || !string.IsNullOrWhiteSpace(revisionImageDigest)
            || !string.IsNullOrWhiteSpace(revisionNotes)
            || revisionEnableTTY
            || revisionIsPublished
            || revisionPorts.Count > 0
            || revisionVolumes.Count > 0
            || revisionSettingDefinitions.Count > 0
            || revisionWebHosts.Count > 0;
    }

    private static string InferDataType(string key, string? value)
    {
        if (key.Contains("PORT", StringComparison.OrdinalIgnoreCase) && int.TryParse(value, out _))
        {
            return "port";
        }

        if (bool.TryParse(value, out _))
        {
            return "boolean";
        }

        if (int.TryParse(value, out _) || double.TryParse(value, out _))
        {
            return "number";
        }

        return "string";
    }

    private static string InferVolumeUsage(string containerPath)
    {
        if (containerPath.Contains("config", StringComparison.OrdinalIgnoreCase))
        {
            return "config";
        }

        if (containerPath.Contains("world", StringComparison.OrdinalIgnoreCase) || containerPath.Contains("save", StringComparison.OrdinalIgnoreCase))
        {
            return "world";
        }

        if (containerPath.Contains("mod", StringComparison.OrdinalIgnoreCase))
        {
            return "mods";
        }

        return "gamefiles";
    }

    private string GetDetectionSectionRecommendation(string section)
    {
        if (detectionComparison is null)
        {
            return "Run a comparison against a selected revision to get guidance.";
        }

        return section switch
        {
            "identity" => detectionComparison.DigestChanged
                ? "Apply the detected digest if this tag now resolves to a new image build."
                : "No identity change detected.",
            "ports" => detectionComparison.AddedPorts.Count > 0 || detectionComparison.RemovedPorts.Count > 0
                ? "Review and apply ports if the container now exposes a different network shape."
                : "No port changes detected.",
            "settings" => detectionComparison.AddedSettings.Count > 0 || detectionComparison.RemovedSettings.Count > 0 || detectionComparison.ChangedSettings.Count > 0
                ? "Merge settings carefully so existing validation metadata is preserved."
                : "No setting changes detected.",
            "volumes" => detectionComparison.AddedVolumes.Count > 0 || detectionComparison.RemovedVolumes.Count > 0
                ? "Apply volumes if the image now declares different persisted paths."
                : "No volume changes detected.",
            _ => string.Empty
        };
    }

