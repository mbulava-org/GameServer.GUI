@page "/gametypes-v2/{Key}"
@page "/gametypes-v2/new"
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json
@using GameServer.Web.Components.Pages.GameTypes.Components.V2
@using GameServer.Web.Models.V2
@using Microsoft.JSInterop
@using Radzen
@using Radzen.Blazor
@inject Services.V2.IGameTypeV2ApiService GameTypeApiV2
@inject Services.V2.IMountTypeConfigApiService MountTypeConfigApi
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(isNew ? "Create Game Type V2" : gameType?.DisplayName ?? "Game Type V2")</PageTitle>

<div class="container-fluid game-type-details-page">
    <div class="game-type-details-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <RadzenButton Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@GoBack"
                              class="me-3" />
                <h2 class="d-inline">@(isNew ? "Create New Game Type V2" : $"Edit V2: {gameType?.DisplayName}")</h2>
            </div>
            <div class="d-flex gap-2">
                <RadzenButton Text="Cancel"
                              Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@GoBack" />
                <RadzenButton Text="Export"
                              Icon="download"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@ExportGameTypeAsync"
                              Disabled="@(isSaving || isNew || gameType is null)" />
                <RadzenButton Text="Save"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@SavePageAsync"
                              Disabled="@isSaving" />
            </div>
        </div>
    </div>

    <div class="game-type-details-content">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                <p class="mt-3">Loading V2 game type...</p>
            </div>
        }
        else if (!isNew && gameType is null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Light">
                The requested V2 game type could not be found.
            </RadzenAlert>
        }
        else if (gameType is not null)
        {
            <div class="row mb-3">
                <div class="col-lg-8">
                    <RadzenCard>
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h4 class="mb-0">@gameType.DisplayName</h4>
                                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@gameTypeType" Variant="Variant.Outlined" />
                                    <RadzenBadge BadgeStyle="@(gameType.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)" Text="@(gameType.IsActive ? "Active" : "Inactive")" />
                                </div>
                                <p class="text-muted mb-2">@(string.IsNullOrWhiteSpace(gameType.Description) ? "No description provided." : gameType.Description)</p>
                                <div><strong>Current Image:</strong> <code>@GetDisplayedImageReference()</code></div>
                                @if (!string.IsNullOrWhiteSpace(gameType.DocumentationUrl))
                                {
                                    <div><strong>Docs:</strong> <a href="@gameType.DocumentationUrl" target="_blank">@gameType.DocumentationUrl</a></div>
                                }
                            </div>
                            <div class="text-end">
                                <div><strong>Revisions:</strong> @gameType.Revisions.Count</div>
                                <div><strong>Current:</strong> @(CurrentRevision?.VersionTag ?? "None")</div>
                                <div><strong>Updated:</strong> @gameType.UpdatedAt.ToLocalTime().ToString("g")</div>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="col-lg-4">
                    <RadzenCard>
                        <RadzenFormField Text="Active Revision" Variant="Variant.Outlined" class="w-100">
                            <RadzenDropDown TValue="int?"
                                            Data="@GetRevisionRows()"
                                            TextProperty="VersionTag"
                                            ValueProperty="Id"
                                            @bind-Value="selectedRevisionId"
                                            Change="@(_ => OnSelectedRevisionChanged())"
                                            Placeholder="Select revision"
                                            class="w-100" />
                        </RadzenFormField>
                        <div class="d-flex gap-2 mt-3 flex-wrap">
                            <RadzenButton Text="New Draft"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@CreateNewRevisionDraft" />
                        </div>
                    </RadzenCard>
                </div>
            </div>

            @if (GetVisibleCrossTabValidationIssues().Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Light" class="mb-3">
                    <div class="fw-semibold mb-2">Cross-tab revision validation</div>
                    <ul class="mb-0 ps-3">
                        @foreach (var issue in GetVisibleCrossTabValidationIssues())
                        {
                            <li>@issue</li>
                        }
                    </ul>
                </RadzenAlert>
            }

            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Detection" Disabled="@(!IsDockerType())">
                        <div class="p-4">
                            <GameTypeRevisionDetectionEditor IsNew="isNew"
                                                            IsDetecting="isDetecting"
                                                            IsDockerType="@IsDockerType()"
                                                            @bind-DetectionImageReference="detectionImageReference"
                                                            @bind-DetectionVersionTag="detectionVersionTag"
                                                            DetectionResult="detectionResult"
                                                            DetectionComparison="detectionComparison"
                                                            OnScanTag="@RunDetectionAsync"
                                                            OnApplyAll="@ApplyDetectionToDraft"
                                                            OnApplyIdentity="@ApplyDetectionIdentity"
                                                            OnApplyPorts="@ApplyDetectionPorts"
                                                            OnApplySettings="@ApplyDetectionSettings"
                                                            OnApplyVolumes="@ApplyDetectionVolumes" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Basic">
                        <div class="p-4">
                            <GameTypeBasicInfoV2Editor IsNew="isNew"
                                                       @bind-KeyValue="keyValue"
                                                       @bind-DisplayName="displayName"
                                                       @bind-Type="gameTypeType"
                                                       TypeOptions="gameTypeTypeOptions"
                                                       @bind-ThumbnailUrl="thumbnailUrl"
                                                       @bind-DocumentationUrl="documentationUrl"
                                                       @bind-Description="description"
                                                       @bind-IsActive="isActive" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Revisions">
                        <div class="p-4">
                            <GameTypeRevisionEditor RevisionRows="@GetRevisionRows()"
                                                   ValidationIssues="Array.Empty<string>()"
                                                   Warnings="@GetRevisionWarnings()"
                                                   @bind-ImageReference="revisionImageReference"
                                                   @bind-VersionTag="revisionVersionTag"
                                                   @bind-EnableTTY="revisionEnableTTY"
                                                   @bind-ReadyLogPattern="revisionReadyLogPattern"
                                                   @bind-Notes="revisionNotes"
                                                   @bind-IsPublished="revisionIsPublished"
                                                   IsSavingRevision="isSavingRevision"
                                                   CanSetCurrentRevision="@(editingRevisionId is not null && GetRevisionSaveValidationIssues().Count == 0)"
                                                   OnCreateNewDraft="@CreateNewRevisionDraft"
                                                   OnSetCurrentRevision="@SetCurrentRevisionAsync"
                                                   OnPublishAndSetCurrent="@PublishAndSetCurrentAsync"
                                                   OnEditRevision="@EditRevisionDraft"
                                                   OnCloneRevision="@CloneRevisionDraft" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Ports">
                        <div class="p-4">
                            <GameTypeRevisionPortsEditor Ports="revisionPorts"
                                                         ProtocolOptions="protocolOptions"
                                                         OnDraftChanged="HandleRevisionDraftChangedAsync" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Volumes">
                        <div class="p-4">
                            <GameTypeRevisionVolumesEditor Volumes="revisionVolumes"
                                                           VolumeUsageOptions="volumeUsageOptions"
                                                           MountTypeOptions="mountTypeOptions"
                                                           NumericVariableOptions="@GetVolumeNumericVariableOptions()"
                                                           OnDraftChanged="HandleRevisionDraftChangedAsync" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Settings">
                        <div class="p-4">
                            <GameTypeRevisionSettingsEditor Settings="revisionSettingDefinitions"
                                                            DefinedPorts="revisionPorts"
                                                            DataTypeOptions="dataTypeOptions"
                                                            ProtocolOptions="protocolOptions"
                                                            PortMappingRoleOptions="portMappingRoleOptions"
                                                            PortRelationTypeOptions="portRelationTypeOptions"
                                                            OnDraftChanged="HandleRevisionDraftChangedAsync" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Web Hosts">
                        <div class="p-4">
                            <GameTypeRevisionWebHostsEditor WebHosts="revisionWebHosts"
                                                            PortVariableOptions="@GetWebHostPortVariableOptions()"
                                                            OnDraftChanged="HandleRevisionDraftChangedAsync" />
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Review">
                        <div class="p-4">
                            <GameTypeRevisionReviewEditor RevisionImageReference="revisionImageReference"
                                                         RevisionVersionTag="revisionVersionTag"
                                                         RevisionEnableTTY="revisionEnableTTY"
                                                         RevisionIsPublished="revisionIsPublished"
                                                         PortCount="revisionPorts.Count"
                                                         VolumeCount="revisionVolumes.Count"
                                                         SettingCount="revisionSettingDefinitions.Count"
                                                         WebHostCount="revisionWebHosts.Count"
                                                         PortMappingCount="revisionSettingDefinitions.Sum(x => x.Metadata.PortMappings.Count)"
                                                         DetectionResult="detectionResult"
                                                         DetectionComparison="detectionComparison"
                                                         ValidationIssues="Array.Empty<string>()"
                                                         Warnings="@GetRevisionWarnings()"
                                                         DraftDifferences="@GetDraftDifferences()"
                                                         DetailedDraftDifferences="@GetDetailedDraftDifferences()" />
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? Key { get; set; }

    private const int UnsavedDraftRevisionSelectionId = 0;
    private string? createdGameTypeKey;

    private GameTypeDetail? gameType;
    private bool isLoading = true;
    private bool isSaving;
    private bool isSavingRevision;
    private bool isDetecting;
    private bool isNew => string.IsNullOrWhiteSpace(Key) && string.IsNullOrWhiteSpace(createdGameTypeKey);
    private static readonly JsonSerializerOptions jsonSerializerOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private int? selectedRevisionId;
    private string keyValue = string.Empty;
    private string displayName = string.Empty;
    private string? description;
    private string gameTypeType = "docker";
    private string? thumbnailUrl;
    private string? documentationUrl;
    private bool isActive = true;
    private int? editingRevisionId;
    private string revisionImageReference = string.Empty;
    private string revisionVersionTag = string.Empty;
    private string? revisionImageDigest;
    private bool revisionEnableTTY;
    private string? revisionReadyLogPattern;
    private string? revisionNotes;
    private bool revisionIsPublished;
    private List<GameTypeRevisionPortDraft> revisionPorts = [];
    private List<GameTypeRevisionVolumeDraft> revisionVolumes = [];
    private List<GameTypeRevisionSettingDraft> revisionSettingDefinitions = [];
    private List<GameTypeRevisionWebHostDraft> revisionWebHosts = [];
    private List<VolumeMountTypeOption> mountTypeOptions = [];
    private string detectionImageReference = string.Empty;
    private string detectionVersionTag = string.Empty;
    private GameTypeSetupDetectionResult? detectionResult;
    private GameTypeSetupComparisonResult? detectionComparison;
    private static readonly IReadOnlyList<string> gameTypeTypeOptions = ["docker"];
    private static readonly IReadOnlyList<string> protocolOptions = ["tcp", "udp"];
    private static readonly IReadOnlyList<string> volumeUsageOptions = ["config", "saves", "backups", "gamefiles", "logs"];
    private static readonly IReadOnlyList<string> dataTypeOptions = ["string", "number", "boolean", "yesno", "enum", "port", "servervariable"];
    private static readonly IReadOnlyList<string> portMappingRoleOptions = ["Primary", "Related"];
    private static readonly IReadOnlyList<string> portRelationTypeOptions = ["Direct", "Offset", "Fixed", "Multiplier"];
    private static readonly HashSet<string> supportedWebHostVariableDataTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "number",
        "port"
    };

    private GameTypeRevision? CurrentRevision => selectedRevisionId == UnsavedDraftRevisionSelectionId
        ? null
        : gameType?.Revisions.FirstOrDefault(x => x.Id == selectedRevisionId)
        ?? gameType?.Revisions.FirstOrDefault(x => x.Id == gameType.CurrentRevisionId)
        ?? gameType?.Revisions.FirstOrDefault();

    private string GetDisplayedImageReference()
    {
        return CurrentRevision?.ImageReference
            ?? gameType?.Revisions.FirstOrDefault(x => x.Id == gameType.CurrentRevisionId)?.ImageReference
            ?? gameType?.Revisions.FirstOrDefault()?.ImageReference
            ?? "No current revision image";
    }

    private bool IsDockerType()
    {
        return string.Equals(gameTypeType, "docker", StringComparison.OrdinalIgnoreCase);
    }

    private GameTypeRevision? FindRevisionByIdentity(string imageReference, string? versionTag)
    {
        if (gameType is null || string.IsNullOrWhiteSpace(imageReference) || string.IsNullOrWhiteSpace(versionTag))
        {
            return null;
        }

        return gameType.Revisions.FirstOrDefault(revision =>
            string.Equals(revision.ImageReference, imageReference, StringComparison.OrdinalIgnoreCase)
            && string.Equals(revision.VersionTag, versionTag, StringComparison.OrdinalIgnoreCase));
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;

            await LoadMountTypeOptionsAsync();

            if (isNew)
            {
                createdGameTypeKey = null;
                gameType = new GameTypeDetail
                {
                    Key = string.Empty,
                    DisplayName = string.Empty,
                    Type = "docker",
                    Revisions = []
                };
                selectedRevisionId = UnsavedDraftRevisionSelectionId;
                PopulateForm(gameType);
                LoadRevisionDraft(null, asNewDraft: true);
                return;
            }

            gameType = await GameTypeApiV2.GetByKeyAsync(Key!);
            if (gameType is not null)
            {
                selectedRevisionId = gameType.CurrentRevisionId ?? gameType.Revisions.FirstOrDefault()?.Id ?? UnsavedDraftRevisionSelectionId;
                PopulateForm(gameType);
                LoadRevisionDraft(selectedRevisionId == UnsavedDraftRevisionSelectionId ? null : CurrentRevision, asNewDraft: selectedRevisionId == UnsavedDraftRevisionSelectionId);
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Load failed", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/gametypes-v2");
    }

    private async Task ExportGameTypeAsync()
    {
        if (gameType is null || string.IsNullOrWhiteSpace(gameType.Key))
        {
            return;
        }

        try
        {
            var package = await GameTypeApiV2.ExportAsync(gameType.Key);
            var json = JsonSerializer.Serialize(package, jsonSerializerOptions);
            var fileName = $"{gameType.Key}-portable.json";
            var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Exported", $"Game type '{gameType.DisplayName}' was exported successfully.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Export failed", ex.Message);
        }
    }

    private Task HandleRevisionDraftChangedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SavePageAsync()
    {
        if (string.IsNullOrWhiteSpace(keyValue) || string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(gameTypeType))
        {
            NotificationService.NotifyTimed(NotificationSeverity.Warning, "Validation", "Key, Display Name, and Type are required.");
            return;
        }

        try
        {
            isSaving = true;
            var wasNewGameType = isNew;
            var shouldSaveRevision = ShouldSaveRevisionWithPageSave();
            var revisionSaved = false;

            var request = new SaveGameTypeRequest
            {
                Key = keyValue,
                DisplayName = displayName,
                Description = description,
                Type = gameTypeType,
                ThumbnailUrl = thumbnailUrl,
                DocumentationUrl = documentationUrl,
                IsActive = isActive
            };

            gameType = isNew
                ? await GameTypeApiV2.CreateAsync(request)
                : await GameTypeApiV2.UpdateAsync(keyValue, request);
            createdGameTypeKey = gameType.Key;

            PopulateForm(gameType);
            if (!shouldSaveRevision)
            {
                selectedRevisionId = gameType.CurrentRevisionId ?? gameType.Revisions.FirstOrDefault()?.Id;
                LoadRevisionDraft(CurrentRevision);
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Saved", "V2 GameType saved successfully.");
            }
            else
            {
                revisionSaved = await SaveRevisionInternalAsync(notifySuccess: false);
                if (revisionSaved)
                {
                    NotificationService.NotifyTimed(NotificationSeverity.Success, "Saved", "V2 GameType and selected revision saved successfully.");
                }
                else
                {
                    NotificationService.NotifyTimed(NotificationSeverity.Warning, "Partially saved", "V2 GameType changes were saved, but the selected revision changes were not saved.");
                }
            }

            if (wasNewGameType && (!shouldSaveRevision || revisionSaved))
            {
                Navigation.NavigateTo($"/gametypes-v2/{Uri.EscapeDataString(gameType.Key)}");
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnSelectedRevisionChanged()
    {
        if (selectedRevisionId == UnsavedDraftRevisionSelectionId)
        {
            return;
        }

        LoadRevisionDraft(CurrentRevision);
    }

    private void CreateNewRevisionDraft()
    {
        LoadRevisionDraft(CurrentRevision, asNewDraft: true);
        selectedRevisionId = UnsavedDraftRevisionSelectionId;
    }

    private void EditRevisionDraft(GameTypeRevision revision)
    {
        ArgumentNullException.ThrowIfNull(revision);
        selectedRevisionId = revision.Id;
        LoadRevisionDraft(revision);
    }

    private void CloneRevisionDraft(GameTypeRevision revision)
    {
        ArgumentNullException.ThrowIfNull(revision);
        selectedRevisionId = revision.Id;
        LoadRevisionDraft(revision, asNewDraft: true);
        if (!string.IsNullOrWhiteSpace(revisionVersionTag))
        {
            revisionVersionTag = $"{revisionVersionTag}-copy";
        }
    }

    private async Task SaveRevisionAsync()
    {
        await SaveRevisionInternalAsync(notifySuccess: true);
    }

    private async Task<bool> SaveRevisionInternalAsync(bool notifySuccess)
    {
        if (gameType is null || string.IsNullOrWhiteSpace(gameType.Key))
        {
            NotificationService.NotifyTimed(NotificationSeverity.Warning, "Save GameType first", "Create the V2 GameType before adding revisions.");
            return false;
        }

        var saveIssues = GetRevisionSaveValidationIssues();
        if (saveIssues.Count > 0)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Warning, "Validation", saveIssues[0]);
            return false;
        }

        try
        {
            isSavingRevision = true;

            var request = new SaveGameTypeRevisionRequest
            {
                ImageReference = revisionImageReference,
                VersionTag = revisionVersionTag,
                ImageDigest = revisionImageDigest,
                EnableTTY = revisionEnableTTY,
                ReadyLogPattern = revisionReadyLogPattern,
                Notes = revisionNotes,
                IsPublished = revisionIsPublished,
                Ports = revisionPorts.Select((port, index) => new GameTypePort
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    AdvertisedPort = port.AdvertisedPort,
                    Description = port.Description,
                    DisplayOrder = index
                }).ToList(),
                Volumes = revisionVolumes.Select((volume, index) => new GameTypeVolume
                {
                    Source = volume.Source,
                    Description = volume.Description,
                    DisplayOrder = index,
                    Usage = volume.Usage,
                    MountType = volume.MountType,
                    ReadOnly = volume.ReadOnly,
                    OwnerUid = volume.OwnerUid,
                    OwnerGid = volume.OwnerGid,
                    OwnerUidVariable = volume.OwnerUidVariable,
                    OwnerGidVariable = volume.OwnerGidVariable,
                    Permissions = volume.Permissions,
                    EnsureNfsPathExists = volume.EnsureNfsPathExists,
                    Required = volume.Required
                }).ToList(),
                SettingDefinitions = revisionSettingDefinitions.Select((setting, index) => new GameTypeSettingDefinition
                {
                    SettingKey = setting.SettingKey,
                    DefaultValue = setting.DefaultValue,
                    Description = setting.Description,
                    DisplayOrder = index,
                    Metadata = new GameTypeSettingMetadata
                    {
                        DataType = setting.Metadata.DataType,
                        Category = setting.Metadata.Category,
                        IsRequired = setting.Metadata.IsRequired,
                        CannotBeEmpty = setting.Metadata.CannotBeEmpty,
                        Placeholder = setting.Metadata.Placeholder,
                        ValidationPattern = setting.Metadata.ValidationPattern,
                        ValidationMessage = setting.Metadata.ValidationMessage,
                        AutoAllocatePort = setting.Metadata.AutoAllocatePort,
                        ValidateRelatedPortsAvailability = setting.Metadata.ValidateRelatedPortsAvailability,
                        AllowedValuesJson = setting.Metadata.AllowedValuesJson,
                        ValueMappingsJson = setting.Metadata.ValueMappingsJson,
                        PortMappings = setting.Metadata.PortMappings.Select((mapping, mappingIndex) => new GameTypeSettingPortMapping
                        {
                            MappingRole = Enum.TryParse<GameServer.Web.Models.V2.GameTypeSettingPortMappingRole>(mapping.MappingRole, true, out var role)
                                ? role.ToString()
                                : GameServer.Web.Models.V2.GameTypeSettingPortMappingRole.Primary.ToString(),
                            RelationType = Enum.TryParse<GameServer.Web.Models.V2.GameTypeSettingPortRelationType>(mapping.RelationType, true, out var relationType)
                                ? relationType.ToString()
                                : GameServer.Web.Models.V2.GameTypeSettingPortRelationType.Direct.ToString(),
                            TargetContainerPort = ResolveTargetContainerPort(setting, mapping).GetValueOrDefault(mapping.TargetContainerPort),
                            TargetProtocol = mapping.TargetProtocol,
                            CalculationValue = mapping.CalculationValue,
                            IsRequired = mapping.IsRequired,
                            DisplayOrder = mappingIndex
                        }).ToList()
                    }
                }).ToList(),
                WebHosts = revisionWebHosts.Select((host, index) => new GameTypeWebHost
                {
                    Name = host.Name,
                    Description = host.Description,
                    PathSegment = host.PathSegment,
                    ContainerPort = host.ContainerPort,
                    ContainerPortVariable = host.ContainerPortVariable,
                    EnabledWhen = host.EnabledWhen,
                    DisplayOrder = index
                }).ToList()
            };

            var revision = editingRevisionId is null
                ? await GameTypeApiV2.AddRevisionAsync(gameType.Key, request)
                : await GameTypeApiV2.UpdateRevisionAsync(gameType.Key, editingRevisionId.Value, request);

            if (editingRevisionId is null && gameType.CurrentRevisionId is null)
            {
                await GameTypeApiV2.SetCurrentRevisionAsync(gameType.Key, revision.Id);
            }

            await ReloadGameTypeAsync(gameType.Key, revision.Id);
            if (notifySuccess)
            {
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Revision saved", $"Revision '{revision.VersionTag}' saved successfully.");
            }

            return true;
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Save revision failed", ex.Message);
            return false;
        }
        finally
        {
            isSavingRevision = false;
        }
    }

    private bool ShouldSaveRevisionWithPageSave()
    {
        return editingRevisionId is not null
            || HasRevisionDraftContent();
    }

    private async Task PublishAndSetCurrentAsync()
    {
        await PublishRevisionAsync(setAsCurrentRevision: true);
    }

    private async Task SetCurrentRevisionAsync()
    {
        if (gameType is null || editingRevisionId is null)
        {
            return;
        }

        try
        {
            await GameTypeApiV2.SetCurrentRevisionAsync(gameType.Key, editingRevisionId.Value);
            await ReloadGameTypeAsync(gameType.Key, editingRevisionId.Value);
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Current revision updated", "The selected revision is now the active revision.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Set current failed", ex.Message);
        }
    }

    private async Task PublishRevisionAsync(bool setAsCurrentRevision)
    {
        if (gameType is null || editingRevisionId is null)
        {
            return;
        }

        try
        {
            isSavingRevision = true;
            var revision = await GameTypeApiV2.PublishRevisionAsync(gameType.Key, editingRevisionId.Value, setAsCurrentRevision);
            await ReloadGameTypeAsync(gameType.Key, revision.Id);
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Revision published", $"Revision '{revision.VersionTag}' published successfully.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Publish failed", ex.Message);
        }
        finally
        {
            isSavingRevision = false;
        }
    }

    private async Task RunDetectionAsync()
    {
        if (gameType is null)
        {
            return;
        }

        if (!IsDockerType())
        {
            NotificationService.NotifyTimed(NotificationSeverity.Warning, "Detection", "Detection is only available for Docker game types.");
            return;
        }

        var imageReference = string.IsNullOrWhiteSpace(detectionImageReference) ? revisionImageReference : detectionImageReference;
        if (string.IsNullOrWhiteSpace(imageReference))
        {
            NotificationService.NotifyTimed(NotificationSeverity.Warning, "Detection", "Enter a Docker image reference to scan.");
            return;
        }

        var versionTag = string.IsNullOrWhiteSpace(detectionVersionTag) ? null : detectionVersionTag.Trim();
        var comparisonRevision = CurrentRevision;

        try
        {
            isDetecting = true;
            detectionResult = isNew
                ? await GameTypeApiV2.DetectSetupAsync(imageReference, versionTag)
                : await GameTypeApiV2.DetectSetupAsync(gameType.Key, imageReference, versionTag);
            detectionImageReference = detectionResult.ImageReference;
            detectionVersionTag = detectionResult.VersionTag;
            var matchingRevision = FindRevisionByIdentity(detectionResult.ImageReference, detectionResult.VersionTag);

            if (matchingRevision is not null)
            {
                selectedRevisionId = matchingRevision.Id;
                LoadRevisionDraft(matchingRevision);
                detectionComparison = await GameTypeApiV2.CompareSetupAsync(gameType.Key, detectionResult.ImageReference, detectionResult.VersionTag, matchingRevision.Id);
                detectionResult = detectionComparison.Detection;
                ApplyDetectionIdentityToDraft(notify: false);
                ApplyDetectedPortsToDraft(notify: false);
                ApplyDetectedVolumesToDraft(notify: false);
                ApplyDetectedSettingsToDraft(notify: false);
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Detection complete", $"Detected settings were imported into revision '{matchingRevision.VersionTag}'.");
            }
            else
            {
                CreateNewRevisionDraft();
                ApplyDetectionToDraft();

                if (!isNew && comparisonRevision is not null)
                {
                    detectionComparison = await GameTypeApiV2.CompareSetupAsync(gameType.Key, detectionResult.ImageReference, detectionResult.VersionTag, comparisonRevision.Id);
                    detectionResult = detectionComparison.Detection;
                }
                else
                {
                    detectionComparison = null;
                }

                NotificationService.NotifyTimed(NotificationSeverity.Success, "Detection complete", $"Detected settings were imported into a new revision draft for '{detectionResult.ImageReference}:{detectionResult.VersionTag}'.");
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Detection failed", ex.Message);
        }
        finally
        {
            isDetecting = false;
        }
    }

    private void ApplyDetectionToDraft()
    {
        if (detectionResult is null)
        {
            return;
        }

        editingRevisionId = null;
        revisionIsPublished = false;
        ApplyDetectionIdentityToDraft(notify: false);
        ApplyDetectedPortsToDraft(notify: false);
        ApplyDetectedVolumesToDraft(notify: false);
        ApplyDetectedSettingsToDraft(notify: false);

        NotificationService.NotifyTimed(NotificationSeverity.Info, "Draft updated", "Detection results have been applied to a new revision draft.");
    }

    private void ApplyDetectionIdentityToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        revisionImageReference = detectionResult.ImageReference;
        revisionVersionTag = detectionResult.VersionTag;
        revisionImageDigest = detectionResult.ImageDigest;
        if (notify)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Info, "Draft updated", "Detected image, tag, and digest have been applied to the draft.");
        }
    }

    private void ApplyDetectionIdentity()
    {
        ApplyDetectionIdentityToDraft();
    }

    private void ApplyDetectedPortsToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        revisionPorts = detectionResult.Ports
            .Select((port, index) =>
            {
                var existing = revisionPorts.FirstOrDefault(x => x.ContainerPort == port.ContainerPort && string.Equals(x.Protocol, port.Protocol, StringComparison.OrdinalIgnoreCase));
                return new GameTypeRevisionPortDraft
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    AdvertisedPort = index == 0,
                    Description = existing?.Description ?? (index == 0 ? "Detected primary port" : "Detected exposed port")
                };
            })
            .ToList();

        if (notify)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Info, "Draft updated", "Detected ports have been applied to the draft.");
        }
    }

    private void ApplyDetectionPorts()
    {
        ApplyDetectedPortsToDraft();
    }

    private void ApplyDetectedVolumesToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        revisionVolumes = detectionResult.Volumes
            .Select(volume =>
            {
                var existing = revisionVolumes.FirstOrDefault(x => string.Equals(x.Source, volume.ContainerPath, StringComparison.OrdinalIgnoreCase));
                return new GameTypeRevisionVolumeDraft
                {
                    Source = volume.ContainerPath,
                    Description = existing?.Description ?? InferVolumeDescription(volume.ContainerPath),
                    Usage = existing?.Usage ?? InferVolumeUsage(volume.ContainerPath),
                    MountType = existing?.MountType ?? "volume",
                    ReadOnly = existing?.ReadOnly ?? false,
                    OwnerUid = existing?.OwnerUid,
                    OwnerGid = existing?.OwnerGid,
                    OwnerUidVariable = existing?.OwnerUidVariable,
                    OwnerGidVariable = existing?.OwnerGidVariable,
                    Permissions = string.IsNullOrWhiteSpace(existing?.Permissions) ? "0777" : existing!.Permissions,
                    EnsureNfsPathExists = existing?.EnsureNfsPathExists ?? false,
                    Required = existing?.Required ?? true
                };
            })
            .ToList();

        if (notify)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Info, "Draft updated", "Detected volumes have been applied to the draft.");
        }
    }

    private void ApplyDetectionVolumes()
    {
        ApplyDetectedVolumesToDraft();
    }

    private void ApplyDetectedSettingsToDraft(bool notify = true)
    {
        if (detectionResult is null)
        {
            return;
        }

        var existingSettings = revisionSettingDefinitions.ToDictionary(x => x.SettingKey, StringComparer.OrdinalIgnoreCase);

        revisionSettingDefinitions = detectionResult.Settings
            .Select(setting =>
            {
                if (existingSettings.TryGetValue(setting.Key, out var existing))
                {
                    return new GameTypeRevisionSettingDraft
                    {
                        SettingKey = existing.SettingKey,
                        DefaultValue = setting.DefaultValue,
                        Description = existing.Description,
                        Metadata = new GameTypeRevisionSettingMetadataDraft
                        {
                            DataType = existing.Metadata.DataType ?? InferDataType(setting.Key, setting.DefaultValue),
                            Category = existing.Metadata.Category,
                            IsRequired = existing.Metadata.IsRequired,
                            CannotBeEmpty = existing.Metadata.CannotBeEmpty,
                            Placeholder = existing.Metadata.Placeholder,
                            ValidationPattern = existing.Metadata.ValidationPattern,
                            ValidationMessage = existing.Metadata.ValidationMessage,
                            AutoAllocatePort = existing.Metadata.AutoAllocatePort,
                            ValidateRelatedPortsAvailability = existing.Metadata.ValidateRelatedPortsAvailability,
                            AllowedValuesJson = existing.Metadata.AllowedValuesJson,
                            ValueMappingsJson = existing.Metadata.ValueMappingsJson,
                            PortMappings = existing.Metadata.PortMappings.Count > 0
                                ? existing.Metadata.PortMappings.Select(ClonePortMappingDraft).ToList()
                                : setting.PortMappings.Select(MapDetectedPortMapping).ToList()
                        }
                    };
                }

                return new GameTypeRevisionSettingDraft
                {
                    SettingKey = setting.Key,
                    DefaultValue = setting.DefaultValue,
                    Metadata = new GameTypeRevisionSettingMetadataDraft
                    {
                        DataType = InferDataType(setting.Key, setting.DefaultValue),
                        IsRequired = false,
                        CannotBeEmpty = false,
                        PortMappings = setting.PortMappings.Select(MapDetectedPortMapping).ToList()
                    }
                };
            })
            .ToList();

        if (notify)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Info, "Draft updated", "Detected settings have been merged into the draft while preserving existing metadata where possible.");
        }
    }

    private void ApplyDetectionSettings()
    {
        ApplyDetectedSettingsToDraft();
    }

    private async Task ReloadGameTypeAsync(string key, int? preferredRevisionId = null)
    {
        gameType = await GameTypeApiV2.GetByKeyAsync(key);
        if (gameType is null)
        {
            return;
        }

        selectedRevisionId = preferredRevisionId ?? gameType.CurrentRevisionId ?? gameType.Revisions.FirstOrDefault()?.Id;
        PopulateForm(gameType);
        LoadRevisionDraft(CurrentRevision);
    }

    private void PopulateForm(GameTypeDetail detail)
    {
        keyValue = detail.Key;
        displayName = detail.DisplayName;
        description = detail.Description;
        gameTypeType = string.IsNullOrWhiteSpace(detail.Type) ? "docker" : detail.Type;
        thumbnailUrl = detail.ThumbnailUrl;
        documentationUrl = detail.DocumentationUrl;
        isActive = detail.IsActive;
    }

    private void LoadRevisionDraft(GameTypeRevision? revision, bool asNewDraft = false)
    {
        editingRevisionId = asNewDraft ? null : revision?.Id;
        revisionImageReference = asNewDraft ? string.Empty : revision?.ImageReference ?? string.Empty;
        revisionVersionTag = asNewDraft ? string.Empty : revision?.VersionTag ?? string.Empty;
        revisionImageDigest = revision?.ImageDigest;
        revisionEnableTTY = revision?.EnableTTY ?? false;
        revisionReadyLogPattern = asNewDraft ? null : revision?.ReadyLogPattern;
        revisionNotes = revision?.Notes;
        revisionIsPublished = asNewDraft ? false : revision?.IsPublished ?? false;
        revisionPorts = revision?.Ports.Select(x => new GameTypeRevisionPortDraft
        {
            ContainerPort = x.ContainerPort,
            Protocol = x.Protocol,
            AdvertisedPort = x.AdvertisedPort,
            Description = x.Description
        }).ToList() ?? [];
        revisionVolumes = revision?.Volumes.Select(x => new GameTypeRevisionVolumeDraft
        {
            Source = x.Source,
            Description = x.Description,
            Usage = x.Usage,
            MountType = string.IsNullOrWhiteSpace(x.MountType) ? "volume" : x.MountType,
            ReadOnly = x.ReadOnly,
            OwnerUid = x.OwnerUid,
            OwnerGid = x.OwnerGid,
            OwnerUidVariable = x.OwnerUidVariable,
            OwnerGidVariable = x.OwnerGidVariable,
            Permissions = string.IsNullOrWhiteSpace(x.Permissions) ? "0777" : x.Permissions,
            EnsureNfsPathExists = x.EnsureNfsPathExists,
            Required = x.Required
        }).ToList() ?? [];
        revisionSettingDefinitions = revision?.SettingDefinitions.Select(x => new GameTypeRevisionSettingDraft
        {
            SettingKey = x.SettingKey,
            DefaultValue = x.DefaultValue,
            Description = x.Description,
            Metadata = new GameTypeRevisionSettingMetadataDraft
            {
                DataType = x.Metadata?.DataType,
                Category = x.Metadata?.Category,
                IsRequired = x.Metadata?.IsRequired ?? false,
                CannotBeEmpty = x.Metadata?.CannotBeEmpty ?? false,
                Placeholder = x.Metadata?.Placeholder,
                ValidationPattern = x.Metadata?.ValidationPattern,
                ValidationMessage = x.Metadata?.ValidationMessage,
                AutoAllocatePort = x.Metadata?.AutoAllocatePort ?? false,
                ValidateRelatedPortsAvailability = x.Metadata?.ValidateRelatedPortsAvailability ?? false,
                AllowedValuesJson = x.Metadata?.AllowedValuesJson,
                ValueMappingsJson = x.Metadata?.ValueMappingsJson,
                PortMappings = x.Metadata?.PortMappings.Select(pm => new GameTypeRevisionPortMappingDraft
                {
                    MappingRole = pm.MappingRole,
                    RelationType = pm.RelationType,
                    TargetContainerPort = pm.TargetContainerPort,
                    TargetProtocol = pm.TargetProtocol,
                    CalculationValue = pm.CalculationValue,
                    IsRequired = pm.IsRequired
                }).ToList() ?? []
            }
        }).ToList() ?? [];
        revisionWebHosts = revision?.WebHosts.Select(x => new GameTypeRevisionWebHostDraft
        {
            Name = x.Name,
            Description = x.Description,
            PathSegment = x.PathSegment,
            ContainerPort = x.ContainerPort,
            ContainerPortVariable = x.ContainerPortVariable,
            EnabledWhen = x.EnabledWhen
        }).ToList() ?? [];
        detectionImageReference = string.IsNullOrWhiteSpace(revisionImageReference) ? detectionImageReference : revisionImageReference;
        detectionVersionTag = string.IsNullOrWhiteSpace(revisionVersionTag) ? detectionVersionTag : revisionVersionTag;
        detectionComparison = null;

        if (asNewDraft)
        {
            selectedRevisionId = UnsavedDraftRevisionSelectionId;
        }
    }

    private IReadOnlyList<GameTypeRevisionListRow> GetRevisionRows()
    {
        if (gameType is null)
        {
            return [];
        }

        var rows = gameType.Revisions
            .Select(revision => new GameTypeRevisionListRow
            {
                Id = revision.Id,
                VersionTag = revision.VersionTag,
                ImageDigest = revision.ImageDigest,
                IsPublished = revision.IsPublished,
                EnableTTY = revision.EnableTTY,
                CreatedAt = revision.CreatedAt,
                SourceRevision = revision
            })
            .ToList();

        if (editingRevisionId is null && (selectedRevisionId == UnsavedDraftRevisionSelectionId || HasRevisionDraftContent()))
        {
            rows.Insert(0, new GameTypeRevisionListRow
            {
                Id = UnsavedDraftRevisionSelectionId,
                VersionTag = string.IsNullOrWhiteSpace(revisionVersionTag) ? "New Draft" : revisionVersionTag,
                ImageDigest = revisionImageDigest,
                IsPublished = revisionIsPublished,
                EnableTTY = revisionEnableTTY,
                CreatedAt = DateTime.UtcNow,
                IsUnsavedDraft = true
            });
        }

        return rows;
    }

    private bool HasRevisionDraftContent()
    {
        return !string.IsNullOrWhiteSpace(revisionVersionTag)
            || !string.IsNullOrWhiteSpace(revisionImageReference)
            || !string.IsNullOrWhiteSpace(revisionImageDigest)
            || !string.IsNullOrWhiteSpace(revisionNotes)
            || revisionEnableTTY
            || revisionIsPublished
            || revisionPorts.Count > 0
            || revisionVolumes.Count > 0
            || revisionSettingDefinitions.Count > 0
            || revisionWebHosts.Count > 0;
    }

    private static string InferDataType(string key, string? value)
    {
        if (key.Contains("PORT", StringComparison.OrdinalIgnoreCase) && int.TryParse(value, out _))
        {
            return "port";
        }

        if (LooksLikeYesNoValue(value))
        {
            return "yesno";
        }

        if (bool.TryParse(value, out _))
        {
            return "boolean";
        }

        if (int.TryParse(value, out _) || double.TryParse(value, out _))
        {
            return "number";
        }

        return "string";
    }

    private static bool LooksLikeYesNoValue(string? value)
    {
        return string.Equals(value, "yes", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "no", StringComparison.OrdinalIgnoreCase);
    }

    private static string InferVolumeUsage(string containerPath)
    {
        if (containerPath.Contains("config", StringComparison.OrdinalIgnoreCase))
        {
            return "config";
        }

        if (containerPath.Contains("backup", StringComparison.OrdinalIgnoreCase))
        {
            return "backups";
        }

        if (containerPath.Contains("log", StringComparison.OrdinalIgnoreCase))
        {
            return "logs";
        }

        if (containerPath.Contains("world", StringComparison.OrdinalIgnoreCase) || containerPath.Contains("save", StringComparison.OrdinalIgnoreCase))
        {
            return "saves";
        }

        return "gamefiles";
    }

    private static string InferVolumeDescription(string containerPath)
    {
        return InferVolumeUsage(containerPath) switch
        {
            "config" => "Configuration files",
            "saves" => "Save data",
            "backups" => "Backup data",
            "logs" => "Log output",
            _ => "Game files"
        };
    }

    private IReadOnlyList<WebHostPortVariableOption> GetWebHostPortVariableOptions()
    {
        return revisionSettingDefinitions
            .Select(CreateWebHostPortVariableOption)
            .OfType<WebHostPortVariableOption>()
            .OrderBy(option => option.SettingKey, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task LoadMountTypeOptionsAsync()
    {
        try
        {
            var configs = await MountTypeConfigApi.GetAllAsync();
            mountTypeOptions = configs
                .Where(config => config.IsActive)
                .OrderBy(config => config.DisplayName, StringComparer.OrdinalIgnoreCase)
                .Select(config => new VolumeMountTypeOption
                {
                    Key = config.Key,
                    DisplayName = string.IsNullOrWhiteSpace(config.DisplayName) ? config.Key : config.DisplayName,
                    DefaultReadOnly = ParseBool(GetOptionValue(config, "DefaultReadOnly")),
                    DefaultEnsureNfsPathExists = ParseBool(GetOptionValue(config, "DefaultEnsureNfsPathExists")),
                    DefaultOwnerUid = ParseInt(GetOptionValue(config, "DefaultOwnerUid")),
                    DefaultOwnerGid = ParseInt(GetOptionValue(config, "DefaultOwnerGid")),
                    DefaultPermissions = GetOptionValue(config, "DefaultPermissions")
                })
                .ToList();
        }
        catch (HttpRequestException)
        {
            // Leave options empty; the editor still allows existing values to persist.
            mountTypeOptions = [];
        }
    }

    private static string? GetOptionValue(MountTypeConfig config, string key) =>
        config.Options is not null && config.Options.TryGetValue(key, out var value) ? value : null;

    private static bool ParseBool(string? value) =>
        bool.TryParse(value, out var parsed) && parsed;

    private static int? ParseInt(string? value) =>
        int.TryParse(value, out var parsed) ? parsed : null;

    private IReadOnlyList<VolumeNumericVariableOption> GetVolumeNumericVariableOptions()
    {
        return revisionSettingDefinitions
            .Where(setting => !string.IsNullOrWhiteSpace(setting.SettingKey))
            .Where(setting =>
            {
                var dataType = setting.Metadata.DataType?.Trim();
                return !string.IsNullOrWhiteSpace(dataType) && supportedWebHostVariableDataTypes.Contains(dataType);
            })
            .Select(setting => new VolumeNumericVariableOption
            {
                SettingKey = setting.SettingKey,
                DataType = setting.Metadata.DataType?.Trim(),
                DefaultValue = int.TryParse(setting.DefaultValue, out var value) ? value : null,
                Label = int.TryParse(setting.DefaultValue, out var labelValue)
                    ? $"{setting.SettingKey} ({labelValue})"
                    : setting.SettingKey
            })
            .OrderBy(option => option.SettingKey, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static WebHostPortVariableOption? CreateWebHostPortVariableOption(GameTypeRevisionSettingDraft setting)
    {
        ArgumentNullException.ThrowIfNull(setting);

        if (string.IsNullOrWhiteSpace(setting.SettingKey))
        {
            return null;
        }

        if (!int.TryParse(setting.DefaultValue, out var defaultPort) || defaultPort <= 0 || defaultPort > 65535)
        {
            return null;
        }

        var dataType = setting.Metadata.DataType?.Trim();
        if (!string.IsNullOrWhiteSpace(dataType) && !supportedWebHostVariableDataTypes.Contains(dataType))
        {
            return null;
        }

        var normalizedDataType = string.IsNullOrWhiteSpace(dataType)
            ? "inferred numeric"
            : dataType.ToLowerInvariant();

        return new WebHostPortVariableOption
        {
            SettingKey = setting.SettingKey,
            DefaultPort = defaultPort,
            DataType = normalizedDataType,
            Label = $"{setting.SettingKey} ({defaultPort}, {normalizedDataType})"
        };
    }

    private string GetDetectionSectionRecommendation(string section)
    {
        if (detectionComparison is null)
        {
            return "Run a comparison against a selected revision to get guidance.";
        }

        return section switch
        {
            "identity" => detectionComparison.DigestChanged
                ? "Apply the detected digest if this tag now resolves to a new image build."
                : "No identity change detected.",
            "ports" => detectionComparison.AddedPorts.Count > 0 || detectionComparison.RemovedPorts.Count > 0
                ? "Review and apply ports if the container now exposes a different network shape."
                : "No port changes detected.",
            "settings" => detectionComparison.AddedSettings.Count > 0 || detectionComparison.RemovedSettings.Count > 0 || detectionComparison.ChangedSettings.Count > 0
                ? "Merge settings carefully so existing validation metadata is preserved."
                : "No setting changes detected.",
            "volumes" => detectionComparison.AddedVolumes.Count > 0 || detectionComparison.RemovedVolumes.Count > 0
                ? "Apply volumes if the image now declares different persisted paths."
                : "No volume changes detected.",
            _ => string.Empty
        };
    }

    private static GameTypeRevisionPortMappingDraft ClonePortMappingDraft(GameTypeRevisionPortMappingDraft mapping)
    {
