@using GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject IGameTypeApi GameTypeApi
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Basic Info">
            <div class="p-3">
                <EditForm Model="@GameType" OnValidSubmit="SaveGameType">
                    <DataAnnotationsValidator />
                    
                    <div class="mb-3">
                        <label class="form-label">Key *</label>
                        <RadzenTextBox @bind-Value="@GameType.Key" 
                                       class="w-100" 
                                       Placeholder="minecraft, valheim, etc."
                                       Disabled="@(!IsNew)" />
                        <small class="text-muted">Unique identifier (cannot be changed after creation)</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Display Name *</label>
                        <RadzenTextBox @bind-Value="@GameType.DisplayName" 
                                       class="w-100" 
                                       Placeholder="Minecraft Server" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <RadzenTextArea @bind-Value="@GameType.Description" 
                                        class="w-100" 
                                        Rows="3"
                                        Placeholder="Brief description of this game server type" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Docker Image *</label>
                        <RadzenTextBox @bind-Value="@GameType.Image" 
                                       class="w-100" 
                                       Placeholder="itzg/minecraft-server:latest" />
                        <small class="text-muted">Full Docker image name, can include ':tag' but defaulting to latest is recomended</small>
                    </div>
                </EditForm>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Ports">
            <div class="p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6>Port Mappings</h6>
                    <RadzenButton Text="Add Port" 
                                  Icon="add" 
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Click="AddPort" />
                </div>
                <div class="mb-3">
                    <p>These are the ports the game needs open to function.
                        You shouldn't edit these values unless you understand the services networking, changing these values may require one or Environment Variables to be set to a the matching value.
                    </p>
                </div>
                @if (!GameType.Ports.Any())
                {
                    <div class="alert alert-info">
                        No ports configured. Add ports that need to be exposed for this game server.
                    </div>
                }
                else
                {
                    <RadzenDataGrid Data="@GameType.Ports" TItem="PortDefinition" AllowRowSelectOnRowClick="false">
                        <Columns>
                            <RadzenDataGridColumn TItem="PortDefinition" Title="Port" Width="150px">
                                <Template Context="port">
                                    <RadzenNumeric @bind-Value="@port.Port" Min="1" Max="65535" class="w-100" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PortDefinition" Title="Protocol" Width="150px">
                                <Template Context="port">
                                    <RadzenDropDown @bind-Value="@port.Protocol" 
                                                    Data="@protocols" 
                                                    class="w-100" />
                                </Template>
                            </RadzenDataGridColumn>
                            @* <RadzenDataGridColumn TItem="PortDefinition" Title="Description">
                                <Template Context="port">
                                    <RadzenTextBox @bind-Value="@port.Description" 
                                                   class="w-100" 
                                                   Placeholder="Game server port, RCON, etc." />
                                </Template>
                            </RadzenDataGridColumn> *@
                            <RadzenDataGridColumn TItem="PortDefinition" Title="" Width="80px">
                                <Template Context="port">
                                    <RadzenButton Icon="delete" 
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Click="@(() => RemovePort(port))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Volumes">
            <div class="p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6>Volume Mappings</h6>
                    <RadzenButton Text="Add Volume" 
                                  Icon="add" 
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Click="AddVolume" />
                    
                </div>
                <div class="mb-3">
                    <p>Persistent storage will be allocated for each Target when when the game is provisioned.</p>
                </div>
                @if (!GameType.Volumes.Any())
                {
                    <div class="alert alert-info">
                        No volumes configured. Add volumes to persist data for this game server.
                    </div>
                }
                else
                {
                    
                    <RadzenDataGrid Data="@GameType.Volumes" TItem="VolumeDefinition" AllowRowSelectOnRowClick="false">
                        <Columns>
                            <RadzenDataGridColumn TItem="VolumeDefinition" Title="Source (Host Path)" Width="40%">
                                <Template Context="volume">
                                    <RadzenTextBox @bind-Value="@volume.Source" 
                                                   class="w-100" 
                                                   Disabled="true"
                                                   Placeholder="Leave blank.." />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VolumeDefinition" Title="Target (Container Path)" Width="40%">
                                <Template Context="volume">
                                    <RadzenTextBox @bind-Value="@volume.Target" 
                                                   class="w-100" 
                                                   Placeholder="/data" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VolumeDefinition" Title="" Width="80px">
                                <Template Context="volume">
                                    <RadzenButton Icon="delete" 
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Click="@(() => RemoveVolume(volume))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Default Settings">
            <div class="p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6>Default Environment Variables / Settings</h6>
                    <RadzenButton Text="Add Setting" 
                                  Icon="add" 
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Click="AddSetting" />
                </div>
                <div class="mb-3">
                    <p>Any and all Environment Variables the image defines. 
                        Environment Variables will filter out values that match the "default" value.
                    </p>
                </div>
                @if (GameType.DefaultSettings == null || !GameType.DefaultSettings.Any())
                {
                    <div class="alert alert-info">
                        No default settings configured. Add environment variables or configuration settings for this game type.
                    </div>
                }
                else
                {
                    <RadzenDataGrid Data="@settingsList" TItem="SettingEntry" AllowRowSelectOnRowClick="false">
                        <Columns>
                            <RadzenDataGridColumn TItem="SettingEntry" Title="Variable" Width="35%">
                                <Template Context="setting">
                                    <RadzenTextBox @bind-Value="@setting.Key" 
                                                   class="w-100" 
                                                   Placeholder="EULA, MAX_MEMORY, SERVER_PORT, MISC_URL, etc." />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="SettingEntry" Title="Default Value" Width="55%">
                                <Template Context="setting">
                                    <RadzenTextBox @bind-Value="@setting.Value" 
                                                   class="w-100" 
                                                   Placeholder="true, 4G, 1234, http://someserver.com/api/function, etc." />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="SettingEntry" Title="" Width="80px">
                                <Template Context="setting">
                                    <RadzenButton Icon="delete" 
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger" 
                                                  Click="@(() => RemoveSetting(setting))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

<div class="d-flex justify-content-end gap-2 mt-4 p-3 border-top">
    <RadzenButton Text="Cancel" 
                  ButtonStyle="ButtonStyle.Light" 
                  Click="@(() => DialogService.Close(false))" />
    <RadzenButton Text="@(IsNew ? "Create" : "Save")" 
                  ButtonStyle="ButtonStyle.Primary" 
                  Click="SaveGameType" />
</div>

@code {
    [Parameter] public GameTypeDefinition GameType { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private List<string> protocols = new() { "tcp", "udp", "tcp/udp" };
    private List<SettingEntry> settingsList = new();

    protected override void OnInitialized()
    {
        // Initialize collections if null
        GameType.Ports ??= new List<PortDefinition>();
        GameType.Volumes ??= new List<VolumeDefinition>();
        GameType.DefaultSettings ??= new Dictionary<string, string>();

        // Convert settings dictionary to list for easier editing
        settingsList = GameType.DefaultSettings
            .Select(kvp => new SettingEntry { Key = kvp.Key, Value = kvp.Value })
            .ToList();
    }

    private void AddPort()
    {
        GameType.Ports.Add(new PortDefinition { Port = 25565, Protocol = "tcp" });
        StateHasChanged();
    }

    private void RemovePort(PortDefinition port)
    {
        GameType.Ports.Remove(port);
        StateHasChanged();
    }

    private void AddVolume()
    {
        GameType.Volumes.Add(new VolumeDefinition { Source = "", Target = "" });
    }

    private void RemoveVolume(VolumeDefinition volume)
    {
        GameType.Volumes.Remove(volume);
    }

    private void AddSetting()
    {
        settingsList.Add(new SettingEntry { Key = "", Value = "" });
    }

    private void RemoveSetting(SettingEntry setting)
    {
        settingsList.Remove(setting);
    }

    private async Task SaveGameType()
    {
        // Validate required fields
        if (string.IsNullOrWhiteSpace(GameType.Key))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Validation Error",
                Detail = "Key is required",
                Duration = 3000
            });
            return;
        }

        if (string.IsNullOrWhiteSpace(GameType.DisplayName))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Validation Error",
                Detail = "Display Name is required",
                Duration = 3000
            });
            return;
        }

        if (string.IsNullOrWhiteSpace(GameType.Image))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Validation Error",
                Detail = "Docker Image is required",
                Duration = 3000
            });
            return;
        }

        // Convert settings list back to dictionary
        GameType.DefaultSettings = settingsList
            .Where(s => !string.IsNullOrWhiteSpace(s.Key))
            .ToDictionary(s => s.Key, s => s.Value ?? "");

        try
        {
            if (IsNew)
            {
                await GameTypeApi.SaveAsync(GameType);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Created",
                    Detail = $"'{GameType.DisplayName}' has been created successfully.",
                    Duration = 3000
                });
            }
            else
            {
                await GameTypeApi.SaveAsync(GameType);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Game Type Updated",
                    Detail = $"'{GameType.DisplayName}' has been updated successfully.",
                    Duration = 3000
                });
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"{(IsNew ? "Create" : "Update")} Failed",
                Detail = $"Failed to {(IsNew ? "create" : "update")} game type: {ex.Message}",
                Duration = 5000
            });
        }
    }

    private class SettingEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }
}