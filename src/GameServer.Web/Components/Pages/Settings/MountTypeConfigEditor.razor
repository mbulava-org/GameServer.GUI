@page "/settings/mount-types"
@rendermode InteractiveServer
@using GameServer.Web.Models.V2
@using Radzen
@using Radzen.Blazor
@inject Services.V2.MountTypeConfigApiService MountTypeConfigApi
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Volume Setup Configuration</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1">Mount Type Configuration</h2>
            <p class="text-muted mb-0">Define how GameType volume definitions are resolved into per-server storage mounts.</p>
        </div>
        <div class="d-flex gap-2">
            <RadzenButton Text="Back"
                          Icon="arrow_back"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@GoBack" />
            <RadzenButton Text="New Mount Type"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@AddNewConfig" />
            <RadzenButton Text="Save Changes"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@SaveAsync"
                          Disabled="@isSaving" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading mount type configurations...</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-4">
                <RadzenCard class="h-100">
                    <h5 class="mb-3">Mount Types</h5>
                    @if (!configs.Any())
                    {
                        <p class="text-muted">No mount types configured.</p>
                    }
                    else
                    {
                        <RadzenListBox @bind-Value="selectedConfig"
                                       Change="@(() => RefreshOptionRows())"
                                       Data="@configs"
                                       TextProperty="@nameof(MountTypeConfig.DisplayName)"
                                       TValue="MountTypeConfig"
                                       class="w-100" />
                    }
                </RadzenCard>
            </div>

            <div class="col-lg-8">
                @if (selectedConfig is null)
                {
                    <p class="text-muted">Select or create a mount type to edit.</p>
                }
                else
                {
                    <RadzenCard class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">@selectedConfig.DisplayName</h5>
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteAsync(selectedConfig))" />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <RadzenFormField Text="Key" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="selectedConfig.Key" class="w-100" Disabled="@(selectedConfig.CreatedAt != default)" />
                                </RadzenFormField>
                            </div>
                            <div class="col-md-4">
                                <RadzenFormField Text="Display Name" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="selectedConfig.DisplayName" class="w-100" />
                                </RadzenFormField>
                            </div>
                            <div class="col-md-4">
                                <RadzenFormField Text="Volume Name Format" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="selectedConfig.VolumeNameFormat" class="w-100" />
                                </RadzenFormField>
                            </div>
                            <div class="col-md-6">
                                <RadzenFormField Text="Description" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextArea @bind-Value="selectedConfig.Description" class="w-100" Rows="4" />
                                </RadzenFormField>
                            </div>
                            <div class="col-md-3">
                                <RadzenCheckBox @bind-Value="selectedConfig.IsActive" />
                                <span class="small text-muted ms-2">Active</span>
                            </div>
                        </div>
                        <p class="text-muted small mb-0">
                            <strong>Volume Name Format</strong> is the template used to compute the name of the Docker
                            named volume created for this mount type. This becomes the actual volume name, so it must
                            resolve to a value that is unique per server/volume (e.g. <code>{gameTypeKey}_{serverId}_{Source}</code>).
                        </p>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Options</h6>
                            <RadzenButton Text="Add Option" Icon="add" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@AddOptionRow" />
                        </div>
                        <p class="text-muted small">
                            Free-form key/value options for this mount type (e.g. <code>Driver</code>, <code>DriverOptionsJson</code>,
                            <code>SourcePathTemplate</code>, <code>DefaultReadOnly</code>, <code>DefaultEnsureNfsPathExists</code>,
                            <code>DefaultOwnerUid</code>, <code>DefaultOwnerGid</code>, <code>DefaultPermissions</code>). Values may
                            contain tokens such as <code>{Source}</code>, <code>{serverId}</code>, <code>{gameTypeKey}</code>, and
                            <code>{Target}</code> that are substituted when volumes are resolved.
                        </p>
                        @foreach (var row in optionRows)
                        {
                            <div class="row g-2 align-items-center mb-2">
                                <div class="col-md-4">
                                    <RadzenTextBox Value="@row.Key" ValueChanged="@(v => UpdateOptionKey(row, v))" class="w-100" Placeholder="Key" />
                                </div>
                                <div class="col-md-7">
                                    <RadzenTextBox Value="@row.Value" ValueChanged="@(v => UpdateOptionValue(row, v))" class="w-100" Placeholder="Value" />
                                </div>
                                <div class="col-md-1">
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveOptionRow(row))" />
                                </div>
                            </div>
                        }
                    </RadzenCard>


                    <RadzenCard class="mb-3">
                        <h5 class="mb-3">Live Preview</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <RadzenFormField Text="Game Type Key" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="previewGameTypeKey" class="w-100" Placeholder="minecraft" />
                                </RadzenFormField>
                            </div>
                            <div class="col-md-4">
                                <RadzenFormField Text="Server Id" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="previewServerId" class="w-100" Placeholder="srv1" />
                                </RadzenFormField>
                            </div>
                            <div class="col-md-4">
                                <RadzenFormField Text="Container Source" Variant="Variant.Outlined" class="w-100">
                                    <RadzenTextBox @bind-Value="previewSource" class="w-100" Placeholder="/data/worlds" />
                                </RadzenFormField>
                            </div>
                        </div>

                        <hr />

                        <h6>Resolved Volume Name (Source Path Template)</h6>
                        <code class="d-block text-break mb-2">@ResolvePreviewPath(selectedConfig, useLocal: false)</code>

                        <h6>Resolved Container Path</h6>
                        <code class="d-block text-break">@ResolvePreviewContainerPath(selectedConfig)</code>
                    </RadzenCard>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isSaving;
    private List<MountTypeConfig> configs = [];
    private MountTypeConfig? selectedConfig;
    private List<OptionRow> optionRows = [];

    private sealed class OptionRow
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private string previewGameTypeKey = "minecraft";
    private string previewServerId = "srv1";
    private string previewSource = "/data/worlds";
    private string previewLayout = "standard";
    private static readonly IReadOnlyList<string> previewLayoutOptions = ["standard", "local"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configs = [.. await MountTypeConfigApi.GetAllAsync()];
            selectedConfig = configs.FirstOrDefault();
            RefreshOptionRows();
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Load failed", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RefreshOptionRows()
    {
        optionRows = selectedConfig?.Options is { Count: > 0 }
            ? selectedConfig.Options.Select(kvp => new OptionRow { Key = kvp.Key, Value = kvp.Value }).ToList()
            : [];
    }

    private void SyncOptionsToSelectedConfig()
    {
        if (selectedConfig is null)
        {
            return;
        }

        selectedConfig.Options = optionRows
            .Where(r => !string.IsNullOrWhiteSpace(r.Key))
            .ToDictionary(r => r.Key, r => r.Value);
    }

    private void AddOptionRow()
    {
        optionRows.Add(new OptionRow());
    }

    private void RemoveOptionRow(OptionRow row)
    {
        optionRows.Remove(row);
        SyncOptionsToSelectedConfig();
    }

    private void UpdateOptionKey(OptionRow row, string value)
    {
        row.Key = value;
        SyncOptionsToSelectedConfig();
    }

    private void UpdateOptionValue(OptionRow row, string value)
    {
        row.Value = value;
        SyncOptionsToSelectedConfig();
    }

    private void AddNewConfig()
    {
        var draft = new MountTypeConfig
        {
            Key = string.Empty,
            DisplayName = "New mount type",
            VolumeNameFormat = "{gameTypeKey}_{serverId}_{Source}",
            Options = new Dictionary<string, string>
            {
                ["Driver"] = "local",
                ["SourcePathTemplate"] = "{gameTypeKey}_{serverId}_{Source}"
            }
        };
        configs.Add(draft);
        selectedConfig = draft;
        RefreshOptionRows();
    }

    private async Task SaveAsync()
    {
        if (selectedConfig is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedConfig.Key))
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Save failed", "A Key is required.");
            return;
        }

        try
        {
            isSaving = true;
            SyncOptionsToSelectedConfig();
            var saved = await MountTypeConfigApi.SaveAsync(selectedConfig);
            var index = configs.FindIndex(c => string.Equals(c.Key, saved.Key, StringComparison.OrdinalIgnoreCase));
            if (index >= 0)
            {
                configs[index] = saved;
            }
            else
            {
                configs.Add(saved);
            }

            selectedConfig = saved;
            RefreshOptionRows();
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Configuration saved", $"Mount type '{saved.Key}' has been persisted.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync(MountTypeConfig config)
    {
        try
        {
            await MountTypeConfigApi.DeleteAsync(config.Key);
            configs.Remove(config);
            selectedConfig = configs.FirstOrDefault();
            RefreshOptionRows();
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Configuration deleted", $"Mount type '{config.Key}' has been removed.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Delete failed", ex.Message);
        }
    }

    private string ResolvePreviewPath(MountTypeConfig config, bool useLocal)
    {
        if (string.Equals(config.Key, "tmpfs", StringComparison.OrdinalIgnoreCase))
        {
            return "tmpfs";
        }

        // The {Source} token is a normalized copy of the container source: drop a leading '/',
        // then replace any remaining '/' with '-'. The calculated template value is the volume name.
        var sourceToken = NormalizeSourceToken(previewSource);

        var template = config.Options is not null && config.Options.TryGetValue("SourcePathTemplate", out var t) ? t : string.Empty;

        return template
            .Replace("{gameTypeKey}", previewGameTypeKey, StringComparison.OrdinalIgnoreCase)
            .Replace("{serverId}", previewServerId, StringComparison.OrdinalIgnoreCase)
            .Replace("{Source}", sourceToken, StringComparison.OrdinalIgnoreCase);
    }

    private string ResolvePreviewContainerPath(MountTypeConfig config)
    {
        // The resolved container path matches the Container Source sample (leading-slash absolute).
        var value = (previewSource ?? string.Empty).Replace('\\', '/').Trim('/');
        return value.Length == 0 ? "/" : "/" + value;
    }

    private static string NormalizeSourceToken(string containerSource)
    {
        var value = (containerSource ?? string.Empty).Replace('\\', '/');
        if (value.StartsWith('/'))
        {
            value = value[1..];
        }

        return value.Replace('/', '-');
    }

    private void GoBack() => Navigation.NavigateTo("/");
}
