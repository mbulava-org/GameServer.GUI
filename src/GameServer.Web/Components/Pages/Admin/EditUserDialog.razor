@inject IAuthApiService AuthService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IOperationDialogService OperationDialog

<RadzenTemplateForm TItem="UsersManager.EditUserViewModel" Data="@Model" Submit="@HandleSubmit">
    <RadzenStack Gap="1.25rem">
        <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: 600;">User: @Model.Username</RadzenText>

        <RadzenFormField Text="Role" Variant="Variant.Outlined">
            <ChildContent>
                <RadzenDropDown @bind-Value="@Model.Role" Data="@_roles" Style="width: 100%;" />
            </ChildContent>
        </RadzenFormField>

        <RadzenFormField Text="Assigned Groups" Variant="Variant.Outlined">
            <ChildContent>
                <RadzenDropDown @bind-Value="@Model.SelectedGroupIds" Data="@AvailableGroups" TextProperty="Name" ValueProperty="Id" Multiple="true" AllowClear="true" Placeholder="Select groups..." Style="width: 100%;" />
            </ChildContent>
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenCheckBox @bind-Value="@Model.IsActive" Name="IsActive" />
            <RadzenLabel Text="Account is active" Component="IsActive" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="mt-3">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save Changes" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter]
    public UsersManager.EditUserViewModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<GroupModel> AvailableGroups { get; set; } = [];

    private readonly List<string> _roles = ["User", "GameManager", "Admin"];

    private async Task HandleSubmit()
    {
        var res = await OperationDialog.ExecuteAsync("Saving User...", $"Updating user '{Model.Username}'", async () =>
        {
            // Admin edits of another user are limited to: active flag, role, and group membership.
            // Email and password changes are intentionally omitted here and remain the user's own responsibility.
            var req = new UpdateUserRequest(
                Email: null,
                Role: Model.Role,
                IsActive: Model.IsActive,
                NewPassword: null,
                GroupIds: Model.SelectedGroupIds?.ToList());

            var (success, error, user) = await AuthService.UpdateUserAsync(Model.Id, req);
            return success ? OperationResult.Ok() : OperationResult.Fail(error ?? "Could not update user.");
        });

        if (res.Success)
        {
            DialogService.Close(true);
        }
    }
}
