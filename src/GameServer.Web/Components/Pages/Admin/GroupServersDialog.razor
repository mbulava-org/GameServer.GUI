@using GameServer.Web.Models.V2
@inject IAuthApiService AuthService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenStack Gap="1.25rem">
    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary">
        Configure which game servers the members of <strong>@Group.Name</strong> can access, and their permission level (View vs Edit).
    </RadzenText>

    <RadzenDataGrid Data="@_serverRows" TItem="ServerAccessRow" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" Responsive="true" Style="max-height: 400px; overflow-y: auto;">
        <Columns>
            <RadzenDataGridColumn Property="ServerName" Title="Server Name">
                <Template Context="row">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="dns" Style="color: var(--rz-primary);" />
                        <div>
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: 600;" class="mb-0">@row.ServerName</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">ID: @row.ServerId</RadzenText>
                        </div>
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="GameType" Title="Game Type" Width="140px" />
            <RadzenDataGridColumn Property="AccessLevel" Title="Permission Level" Width="180px">
                <Template Context="row">
                    <RadzenDropDown @bind-Value="@row.AccessLevel" Data="@_accessOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="mt-3">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
        <RadzenButton Text="Save Server Access" ButtonStyle="ButtonStyle.Primary" Click="@HandleSave" IsBusy="@_isBusy" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter]
    public GroupDetailModel Group { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<GameServerListItem> AllServers { get; set; } = [];

    public class ServerAccessRow
    {
        public string ServerId { get; set; } = string.Empty;
        public string ServerName { get; set; } = string.Empty;
        public string GameType { get; set; } = string.Empty;
        public string AccessLevel { get; set; } = "None"; // "None", "View", "Edit"
    }

    private class AccessOption
    {
        public string Text { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private readonly List<AccessOption> _accessOptions =
    [
        new AccessOption { Text = "No Access", Value = "None" },
        new AccessOption { Text = "View Only", Value = "View" },
        new AccessOption { Text = "View & Edit", Value = "Edit" }
    ];

    private List<ServerAccessRow> _serverRows = [];
    private bool _isBusy;

    protected override void OnInitialized()
    {
        var existingAccess = Group.Servers.ToDictionary(s => s.ServerId, s => s.AccessLevel);

        _serverRows = AllServers.Select(s => new ServerAccessRow
        {
            ServerId = s.ServerId,
            ServerName = s.Name,
            GameType = s.GameTypeDisplayName,
            AccessLevel = existingAccess.TryGetValue(s.ServerId, out var lvl) ? lvl : "None"
        }).ToList();
    }

    private async Task HandleSave()
    {
        _isBusy = true;
        try
        {
            var assigned = _serverRows
                .Where(r => r.AccessLevel is "View" or "Edit")
                .Select(r => new ServerGroupAssignmentModel(r.ServerId, r.AccessLevel))
                .ToList();

            var (success, error, updated) = await AuthService.SetGroupServersAsync(Group.Id, assigned);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Access Saved", $"Saved server access rules for group '{Group.Name}'.");
                DialogService.Close(true);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", error ?? "Could not save server access.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }
}
