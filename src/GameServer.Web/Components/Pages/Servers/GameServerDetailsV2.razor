@page "/gameservers-v2/{ServerId}"
@rendermode InteractiveServer
@using GameServer.Web.Models.V2
@using GameServer.Web.Components.Server
@using Radzen
@using Radzen.Blazor
@inject Services.V2.IGameServerV2ApiService GameServerApiV2
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject Services.IThumbnailCacheService ThumbnailCacheService

<PageTitle>@(server?.Name ?? "Game Server")</PageTitle>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading game server...</p>
        </div>
    }
    else if (server is null)
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="error" Style="font-size: 4rem; color: var(--rz-danger);" />
                <h4 class="mt-3">Game Server Not Found</h4>
                <p class="text-muted">The requested game server could not be found.</p>
                <RadzenButton Text="Back to Servers"
                              Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@GoBack" />
            </div>
        </RadzenCard>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <RadzenButton Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@GoBack" />
                @if (!string.IsNullOrWhiteSpace(cachedGameTypeThumbnailUrl))
                {
                    <img src="@cachedGameTypeThumbnailUrl"
                         alt="@server.GameTypeDisplayName"
                         class="gameserver-detail-thumbnail"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="gameserver-detail-thumbnail-fallback" style="display: none;">
                        <RadzenIcon Icon="dns" Style="font-size: 2rem;" />
                    </div>
                }
                else
                {
                    <div class="gameserver-detail-thumbnail-fallback">
                        <RadzenIcon Icon="dns" Style="font-size: 2rem;" />
                    </div>
                }
                <div>
                    <h2 class="mb-1">@server.Name</h2>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(server.Status)" Text="@GetStatusText(server.Status)" />
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@server.ServerId" Variant="Variant.Outlined" />
                        @if (!string.IsNullOrWhiteSpace(server.RevisionVersionTag))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@server.RevisionVersionTag" Variant="Variant.Outlined" />
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <RadzenButton Text="Start"
                              Icon="play_arrow"
                              ButtonStyle="ButtonStyle.Success"
                              Disabled="@(isOperating || string.Equals(server.Status, "Running", StringComparison.OrdinalIgnoreCase))"
                              Click="@StartServiceAsync" />
                <RadzenButton Text="Stop"
                              Icon="stop"
                              ButtonStyle="ButtonStyle.Warning"
                              Disabled="@(isOperating || !string.Equals(server.Status, "Running", StringComparison.OrdinalIgnoreCase))"
                              Click="@StopServiceAsync" />
                <RadzenButton Text="Restart"
                              Icon="restart_alt"
                              ButtonStyle="ButtonStyle.Info"
                              Disabled="@isOperating"
                              Click="@RestartServiceAsync" />
                <RadzenButton Text="Update Service"
                              Icon="system_update_alt"
                              ButtonStyle="ButtonStyle.Secondary"
                              Disabled="@isOperating"
                              Click="@RedeployServiceAsync" />
                <RadzenButton Text="Edit"
                              Icon="edit"
                              ButtonStyle="ButtonStyle.Primary"
                              Click='@(() => Navigation.NavigateTo($"/gameservers-v2/{Uri.EscapeDataString(ServerId)}/edit"))' />
                <RadzenButton Text="Delete"
                              Icon="delete"
                              ButtonStyle="ButtonStyle.Danger"
                              Disabled="@isOperating"
                              Click="@DeleteServerAsync" />
                <RadzenButton Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Disabled="@isOperating"
                              Click="@OnRefresh" />
            </div>
        </div>

        @if (isOperating)
        {
            <div class="gameserver-details-overlay">
                <div class="gameserver-details-overlay-card">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                    <h4 class="mt-3 mb-1">@operationTitle</h4>
                    <p class="text-muted mb-0">@operationSubtitle</p>
                </div>
            </div>
        }

        @if (validationPreview is not null)
        {
            <RadzenCard class="mb-3">
                <h5 class="mb-3">Current Validation</h5>
                @if (!validationPreview.Issues.Any())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">
                        The current server configuration validates successfully against the selected revision.
                    </RadzenAlert>
                }
                else
                {
                    <ul class="mb-0 ps-3">
                        @foreach (var issue in validationPreview.Issues)
                        {
                            <li>
                                <strong>@issue.Scope</strong>: @issue.Message
                            </li>
                        }
                    </ul>
                }
            </RadzenCard>
        }

        <div class="row g-3 mb-3">
            <div class="col-lg-4">
                <RadzenCard>
                    <h5 class="mb-3">Overview</h5>
                    <div><strong>Game Type:</strong> @(server.GameTypeDisplayName ?? "Unknown")</div>
                    @if (!string.IsNullOrWhiteSpace(server.GameTypeKey))
                    {
                        <div><strong>Key:</strong> <code>@server.GameTypeKey</code></div>
                    }
                    <div><strong>Service:</strong> @(string.IsNullOrWhiteSpace(server.ServiceName) ? "Not assigned" : server.ServiceName)</div>
                    <div><strong>Last Deployed:</strong> @(server.LastDeployedAt?.ToLocalTime().ToString("g") ?? "Never")</div>
                    <div><strong>Last Seen:</strong> @(server.LastSeenAt?.ToLocalTime().ToString("g") ?? "Never")</div>
                    <div><strong>Updated:</strong> @server.UpdatedAt.ToLocalTime().ToString("g")</div>
                    @if (!string.IsNullOrWhiteSpace(server.Description))
                    {
                        <div class="mt-3 text-muted">@server.Description</div>
                    }
                </RadzenCard>
            </div>
            <div class="col-lg-4">
                <RadzenCard>
                    <h5 class="mb-3">Resolved Runtime</h5>
                    <div><strong>Ports:</strong> @CurrentResolvedPorts.Count</div>
                    <div><strong>Volumes:</strong> @CurrentResolvedVolumes.Count</div>
                    <div><strong>Web Hosts:</strong> @CurrentResolvedWebHosts.Count</div>
                    <div><strong>Settings:</strong> @server.Settings.Count</div>
                    <div><strong>Configuration Rules:</strong> @CurrentValidationIssues.Count</div>
                </RadzenCard>
            </div>
            <div class="col-lg-4">
                <RadzenCard>
                    <h5 class="mb-3">Containers & Host</h5>
                    <div><strong>Containers:</strong> @(server.Containers.Count > 0 ? server.Containers.Count.ToString() : "0 (Stopped)")</div>
                    @if (server.Containers.Any())
                    {
                        <div><strong>Primary Container:</strong> <code>@server.Containers.First().Id[..Math.Min(12, server.Containers.First().Id.Length)]</code></div>
                    }
                    <div><strong>Docker Volume Options:</strong> @(validationPreview?.DockerVolumeOptions.Count ?? server.DockerVolumeOptions.Count)</div>
                    <div><strong>Network Options:</strong> @(validationPreview?.NetworkOptions.Count ?? server.NetworkOptions.Count)</div>
                </RadzenCard>
            </div>
        </div>

        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="Resource Monitor" Icon="monitoring">
                    <div class="p-3">
                        <ResourceMonitorTab ServerId="@ServerId" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Console / Logs" Icon="terminal">
                    <div class="p-3">
                        <ContainerConsole ServerId="@ServerId" ContainerId="@RunningContainerId" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Terminal" Icon="code">
                    <div class="p-3">
                        <ContainerTerminal ServerId="@ServerId" ContainerId="@RunningContainerId" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="File Manager" Icon="folder">
                    <div class="p-3">
                        <ServerFileManager ServerId="@ServerId" Volumes="@CurrentResolvedVolumes" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Settings" Icon="tune">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Effective Settings</h5>
                            @if (!server.Settings.Any())
                            {
                                <p class="text-muted mb-0">No server setting overrides are stored.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@server.Settings.OrderBy(setting => setting.SettingKey)"
                                                TItem="GameServerSetting"
                                                AllowSorting="true"
                                                AllowFiltering="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerSetting" Property="SettingKey" Title="Key" Width="220px" />
                                        <RadzenDataGridColumn TItem="GameServerSetting" Title="Value">
                                            <Template Context="setting">
                                                @if (string.IsNullOrWhiteSpace(setting.Value))
                                                {
                                                    <span class="text-muted">(empty)</span>
                                                }
                                                else
                                                {
                                                    <code class="gameserver-detail-code">@setting.Value</code>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Ports" Icon="lan">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Resolved Ports</h5>
                            @if (!CurrentResolvedPorts.Any())
                            {
                                <p class="text-muted mb-0">No resolved ports were derived from the selected revision.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@CurrentResolvedPorts.OrderBy(port => port.DisplayOrder)"
                                                TItem="GameServerResolvedPort"
                                                AllowSorting="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="ContainerPort" Title="Container Port" Width="140px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Title="Published Port (Ingress)" Width="180px">
                                            <Template Context="port">
                                                <span>@port.PublishedPort</span>
                                                @if (port.PublishedPort != port.ContainerPort)
                                                {
                                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Custom" Style="margin-left: 6px;" />
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="Protocol" Title="Protocol" Width="120px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Title="Advertised" Width="120px">
                                            <Template Context="port">
                                                <RadzenBadge BadgeStyle="@(port.AdvertisedPort ? BadgeStyle.Success : BadgeStyle.Light)"
                                                             Text="@(port.AdvertisedPort ? "Yes" : "No")" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="Description" Title="Description" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Volumes" Icon="storage">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Resolved Volumes</h5>
                            @if (!CurrentResolvedVolumes.Any())
                            {
                                <p class="text-muted mb-0">No resolved volumes were derived from the selected revision.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@CurrentResolvedVolumes.OrderBy(volume => volume.CreatedAt)"
                                                TItem="GameServerResolvedVolume"
                                                AllowSorting="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="ContainerPath" Title="Container Path" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="VolumeName" Title="Volume Name" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="Usage" Title="Usage" Width="140px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="MountType" Title="Type" Width="100px" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Web Hosts" Icon="language">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Resolved Web Hosts</h5>
                            @if (!CurrentResolvedWebHosts.Any())
                            {
                                <p class="text-muted mb-0">No web hosts are enabled for the current setting state.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@CurrentResolvedWebHosts.OrderBy(host => host.DisplayOrder)"
                                                TItem="GameServerResolvedWebHost"
                                                AllowSorting="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="Name" Title="Name" Width="180px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="ContainerPort" Title="Port" Width="100px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="PathSegment" Title="Path" Width="160px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="EnabledWhen" Title="Enabled When" Width="180px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="Description" Title="Description" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Configuration Rules" Icon="rule">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Validation and Configuration Rules</h5>
                            @if (!CurrentValidationIssues.Any())
                            {
                                <p class="text-muted mb-0">No validation issues are currently reported for this server.</p>
                            }
                            else
                            {
                                <ul class="mb-0 ps-3">
                                    @foreach (var issue in CurrentValidationIssues)
                                    {
                                        <li>@issue.Message</li>
                                    }
                                </ul>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</div>

<style>
    .gameserver-detail-thumbnail,
    .gameserver-detail-thumbnail-fallback {
        width: 72px;
        height: 72px;
        border-radius: 12px;
        object-fit: cover;
        background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
    }

    .gameserver-detail-thumbnail-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--rz-text-disabled-color);
    }

    .gameserver-detail-code {
        font-size: 0.8rem;
        word-break: break-word;
    }

    .gameserver-details-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .gameserver-details-overlay-card {
        background: var(--rz-base-card-background-color, #ffffff);
        color: var(--rz-text-color, #212529);
        border: 1px solid var(--rz-border-color, #e0e0e0);
        border-radius: 16px;
        padding: 2.5rem 3rem;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.25);
        text-align: center;
        max-width: 440px;
        width: 90%;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: detailsFadeIn 0.2s ease-out;
    }

    @@keyframes detailsFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    [Parameter]
    public string ServerId { get; set; } = string.Empty;

    private GameServerDetail? server;
    private GameServerValidationResult? validationPreview;
    private string? cachedGameTypeThumbnailUrl;
    private bool isLoading = true;
    private bool isOperating;
    private string operationTitle = string.Empty;
    private string operationSubtitle = string.Empty;

    private string? RunningContainerId => server?.Containers?.FirstOrDefault()?.Id;

    private IReadOnlyList<GameServerResolvedPort> CurrentResolvedPorts => validationPreview?.ResolvedPorts ?? server?.ResolvedPorts ?? [];

    private IReadOnlyList<GameServerResolvedVolume> CurrentResolvedVolumes => validationPreview?.ResolvedVolumes ?? server?.ResolvedVolumes ?? [];

    private IReadOnlyList<GameServerResolvedWebHost> CurrentResolvedWebHosts => validationPreview?.ResolvedWebHosts ?? server?.ResolvedWebHosts ?? [];

    private IReadOnlyList<GameServerValidationIssue> CurrentValidationIssues => validationPreview?.Issues ?? server?.ConfigurationRules ?? [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadServerDataAsync();
        _ = RunValidationInBackgroundAsync();
    }

    private async Task LoadServerDataAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId))
        {
            server = null;
            cachedGameTypeThumbnailUrl = null;
            isLoading = false;
            return;
        }

        try
        {
            isLoading = true;
            cachedGameTypeThumbnailUrl = null;
            server = await GameServerApiV2.GetByServerIdAsync(ServerId);
            cachedGameTypeThumbnailUrl = server is null
                ? null
                : await ThumbnailCacheService.GetCachedThumbnailUrlAsync(server.GameTypeThumbnailUrl);
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Load failed", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunValidationInBackgroundAsync()
    {
        if (server is null)
        {
            return;
        }

        try
        {
            validationPreview = await GameServerApiV2.ValidateAsync(BuildValidationRequest(server));
            await InvokeAsync(StateHasChanged);
        }
        catch (HttpRequestException)
        {
            // Silently ignore validation failures; the page still shows server data.
        }
    }

    private async Task OnRefresh()
    {
        validationPreview = null;
        await LoadServerDataAsync();
        _ = RunValidationInBackgroundAsync();
    }

    private async Task StartServiceAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId)) return;

        try
        {
            isOperating = true;
            operationTitle = "Starting Service...";
            operationSubtitle = "Scaling service to 1 replica in Docker Swarm...";
            var updated = await GameServerApiV2.StartAsync(ServerId);
            server = updated;
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Service Started", $"Server '{server.Name}' is now running.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Start failed", ex.Message);
        }
        finally
        {
            isOperating = false;
        }
    }

    private async Task StopServiceAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId)) return;

        try
        {
            isOperating = true;
            operationTitle = "Stopping Service...";
            operationSubtitle = "Scaling service to 0 replicas in Docker Swarm...";
            var updated = await GameServerApiV2.StopAsync(ServerId);
            server = updated;
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Service Stopped", $"Server '{server.Name}' has been stopped.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Stop failed", ex.Message);
        }
        finally
        {
            isOperating = false;
        }
    }

    private async Task RestartServiceAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId)) return;

        try
        {
            isOperating = true;
            operationTitle = "Restarting Service...";
            operationSubtitle = "Forcing container restart in Docker Swarm...";
            var updated = await GameServerApiV2.RestartAsync(ServerId);
            server = updated;
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Service Restarted", $"Server '{server.Name}' was restarted.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Restart failed", ex.Message);
        }
        finally
        {
            isOperating = false;
        }
    }

    private async Task RedeployServiceAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId)) return;

        try
        {
            isOperating = true;
            operationTitle = "Updating Service...";
            operationSubtitle = "Provisioning storage volumes and redeploying service in Docker Swarm...";
            var updated = await GameServerApiV2.RedeployAsync(ServerId);
            server = updated;
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Service Updated", $"Server '{server.Name}' has been updated and redeployed.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Update failed", ex.Message);
        }
        finally
        {
            isOperating = false;
        }
    }

    private async Task DeleteServerAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId))
        {
            return;
        }

        try
        {
            isOperating = true;
            operationTitle = "Deleting Server...";
            operationSubtitle = "Removing GameServer definition...";
            await GameServerApiV2.DeleteAsync(ServerId);
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Deleted", $"Server '{server?.Name ?? ServerId}' was deleted.");
            Navigation.NavigateTo("/gameservers-v2");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Delete failed", ex.Message);
        }
        finally
        {
            isOperating = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/gameservers-v2");
    }

    private static SaveGameServerRequest BuildValidationRequest(GameServerDetail server)
    {
        ArgumentNullException.ThrowIfNull(server);

        return new SaveGameServerRequest
        {
            ServerId = server.ServerId,
            Name = server.Name,
            Description = server.Description,
            GameTypeRevisionId = server.GameTypeRevisionId,
            ServiceName = server.ServiceName,
            Status = server.Status,
            Ports = server.Ports
                .Select(port => new GameServerPort
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    PublishedPort = port.PublishedPort
                })
                .ToList(),
            Settings = server.Settings
                .Select(setting => new GameServerSetting
                {
                    Id = setting.Id,
                    SettingKey = setting.SettingKey,
                    Value = setting.Value
                })
                .ToList(),
            VolumeBindingLayout = "standard",
            NetworkOptions = server.NetworkOptions
        };
    }

    private static BadgeStyle GetStatusBadgeStyle(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "running" => BadgeStyle.Success,
            "starting" => BadgeStyle.Info,
            "stopped" => BadgeStyle.Secondary,
            "stopping" => BadgeStyle.Warning,
            "failed" => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private static string GetStatusText(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "running" => "Running",
            "starting" => "Starting",
            "stopped" => "Stopped",
            "stopping" => "Stopping",
            "failed" => "Failed",
            _ => string.IsNullOrWhiteSpace(status) ? "Unknown" : status
        };
    }
}
