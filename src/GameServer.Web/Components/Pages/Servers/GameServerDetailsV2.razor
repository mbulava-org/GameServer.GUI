    private static SaveGameServerRequest BuildValidationRequest(GameServerDetail server)
    {
        ArgumentNullException.ThrowIfNull(server);

        return new SaveGameServerRequest
        {
            ServerId = server.ServerId,
            Name = server.Name,
            Description = server.Description,
            GameTypeRevisionId = server.GameTypeRevisionId,
            ServiceName = server.ServiceName,
            Status = server.Status,
            Ports = server.Ports
                .Select(port => new GameServerPort
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    PublishedPort = port.PublishedPort
                })
                .ToList(),
            Settings = server.Settings
                .Select(setting => new GameServerSetting
                {
                    Id = setting.Id,
                    SettingKey = setting.SettingKey,
                    Value = setting.Value
                })
                .ToList(),
            VolumeBindingLayout = "standard",
            NetworkOptions = server.NetworkOptions
        };
    }

    private static BadgeStyle GetStatusBadgeStyle(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "running" => BadgeStyle.Success,
            "preparing" => BadgeStyle.Primary,
            "starting" => BadgeStyle.Info,
            "stopped" => BadgeStyle.Secondary,
            "stopping" => BadgeStyle.Warning,
            "failed" => BadgeStyle.Danger,
            "scaling down" => BadgeStyle.Warning,
            _ => BadgeStyle.Secondary
        };
    }

    private static string GetStatusText(string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "running" => "Running",
            "preparing" => "Preparing",
            "starting" => "Starting",
            "stopped" => "Stopped",
            "stopping" => "Stopping",
            "failed" => "Failed",
            "scaling down" => "Scaling Down",
            _ => string.IsNullOrWhiteSpace(status) ? "Unknown" : status
        };
    }

    private string GetWebHostUrl(GameServerResolvedWebHost host)
    {
        ArgumentNullException.ThrowIfNull(host);
        var rawSegment = !string.IsNullOrWhiteSpace(host.PathSegment) ? host.PathSegment : host.Name;
        var expanded = rawSegment;

        if (server is not null)
        {
            var tokens = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
            {
                ["ServerId"] = server.ServerId,
                ["Id"] = server.ServerId,
                ["Name"] = server.Name,
                ["ServiceName"] = server.ServiceName,
                ["GameType"] = server.GameTypeKey,
                ["GameTypeKey"] = server.GameTypeKey,
                ["GameTypeDisplayName"] = server.GameTypeDisplayName
            };

            foreach (var setting in server.Settings)
            {
                if (!string.IsNullOrWhiteSpace(setting.SettingKey))
                {
                    tokens[setting.SettingKey] = setting.Value;
                }
            }

            foreach (var (k, v) in tokens)
            {
                if (v is not null)
                {
                    expanded = expanded.Replace("{" + k + "}", v, StringComparison.OrdinalIgnoreCase);
                }
            }
        }

        var path = expanded.Trim('/');
        if (string.IsNullOrWhiteSpace(path) && server is not null)
        {
            var slug = new string(host.Name.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
            path = $"{server.ServiceName}-{slug.Trim('-')}";
        }

        return $"/{path}/";
    }
