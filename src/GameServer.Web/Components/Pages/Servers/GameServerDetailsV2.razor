@page "/gameservers-v2/{ServerId}"
@rendermode InteractiveServer
@using GameServer.Web.Models.V2
@using GameServer.Web.Components.Server
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using GameServer.Web.Configurations
@using Radzen
@using Radzen.Blazor
@inject Services.V2.IGameServerV2ApiService GameServerApiV2
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject Services.IThumbnailCacheService ThumbnailCacheService
@inject IOptions<GameServerDockerApi> ApiConfig
@inject IJSRuntime JSRuntime

<PageTitle>@(server?.Name ?? "Game Server")</PageTitle>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading game server...</p>
        </div>
    }
    else if (server is null)
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="error" Style="font-size: 4rem; color: var(--rz-danger);" />
                <h4 class="mt-3">Game Server Not Found</h4>
                <p class="text-muted">The requested game server could not be found.</p>
                <RadzenButton Text="Back to Servers"
                              Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@GoBack" />
            </div>
        </RadzenCard>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <RadzenButton Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@GoBack" />
                @if (!string.IsNullOrWhiteSpace(cachedGameTypeThumbnailUrl))
                {
                    <img src="@cachedGameTypeThumbnailUrl"
                         alt="@server.GameTypeDisplayName"
                         class="gameserver-detail-thumbnail"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="gameserver-detail-thumbnail-fallback" style="display: none;">
                        <RadzenIcon Icon="dns" Style="font-size: 2rem;" />
                    </div>
                }
                else
                {
                    <div class="gameserver-detail-thumbnail-fallback">
                        <RadzenIcon Icon="dns" Style="font-size: 2rem;" />
                    </div>
                }
                <div>
                    <h2 class="mb-1">@server.Name</h2>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(server.Status)" Text="@GetStatusText(server.Status)" />
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@server.ServerId" Variant="Variant.Outlined" />
                        @if (!string.IsNullOrWhiteSpace(server.RevisionVersionTag))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@server.RevisionVersionTag" Variant="Variant.Outlined" />
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <RadzenButton Text="Start"
                              Icon="play_arrow"
                              ButtonStyle="ButtonStyle.Success"
                              Disabled="@(isOperating || string.Equals(server.Status, "Running", StringComparison.OrdinalIgnoreCase) || string.Equals(server.Status, "Preparing", StringComparison.OrdinalIgnoreCase) || string.Equals(server.Status, "Starting", StringComparison.OrdinalIgnoreCase))"
                              Click="@StartServiceAsync" />
                <RadzenButton Text="Stop"
                              Icon="stop"
                              ButtonStyle="ButtonStyle.Warning"
                              Disabled="@(isOperating || string.Equals(server.Status, "Stopped", StringComparison.OrdinalIgnoreCase))"
                              Click="@StopServiceAsync" />
                <RadzenButton Text="Restart"
                              Icon="restart_alt"
                              ButtonStyle="ButtonStyle.Info"
                              Disabled="@isOperating"
                              Click="@RestartServiceAsync" />
                <RadzenButton Text="Update Service"
                              Icon="system_update_alt"
                              ButtonStyle="ButtonStyle.Secondary"
                              Disabled="@isOperating"
                              Click="@RedeployServiceAsync" />
                <RadzenButton Text="Edit"
                              Icon="edit"
                              ButtonStyle="ButtonStyle.Primary"
                              Click='@(() => Navigation.NavigateTo($"/gameservers-v2/{Uri.EscapeDataString(ServerId)}/edit"))' />
                <RadzenButton Text="Delete"
                              Icon="delete"
                              ButtonStyle="ButtonStyle.Danger"
                              Disabled="@isOperating"
                              Click="@DeleteServerAsync" />
                <RadzenButton Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Disabled="@isOperating"
                              Click="@OnRefresh" />
            </div>
        </div>

        @if (isOperating)
        {
            <div class="gameserver-details-overlay">
                <div class="gameserver-details-overlay-card">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                    <h4 class="mt-3 mb-1">@operationTitle</h4>
                    <p class="text-muted mb-0">@operationSubtitle</p>
                </div>
            </div>
        }


        <div class="row g-3 mb-3">
            <div class="col-lg-4">
                <RadzenCard>
                    <h5 class="mb-3">Overview</h5>
                    <div><strong>Game Type:</strong> @(server.GameTypeDisplayName ?? "Unknown")</div>
                    @if (!string.IsNullOrWhiteSpace(server.GameTypeKey))
                    {
                        <div><strong>Key:</strong> <code>@server.GameTypeKey</code></div>
                    }
                    <div><strong>Service:</strong> @(string.IsNullOrWhiteSpace(server.ServiceName) ? "Not assigned" : server.ServiceName)</div>
                    <div><strong>Last Deployed:</strong> @(server.LastDeployedAt?.ToLocalTime().ToString("g") ?? "Never")</div>
                    <div><strong>Last Seen:</strong> @(server.LastSeenAt?.ToLocalTime().ToString("g") ?? "Never")</div>
                    <div><strong>Updated:</strong> @server.UpdatedAt.ToLocalTime().ToString("g")</div>
                    @if (!string.IsNullOrWhiteSpace(server.Description))
                    {
                        <div class="mt-3 text-muted">@server.Description</div>
                    }
                </RadzenCard>
            </div>
            <div class="col-lg-4">
                <RadzenCard>
                    <h5 class="mb-3">Resolved Runtime</h5>
                    <div><strong>Ports:</strong> @CurrentResolvedPorts.Count</div>
                    <div><strong>Volumes:</strong> @CurrentResolvedVolumes.Count</div>
                    <div><strong>Web Hosts:</strong> @CurrentResolvedWebHosts.Count</div>
                    <div><strong>Settings:</strong> @server.Settings.Count</div>
                    <div><strong>Configuration Rules:</strong> @CurrentValidationIssues.Count</div>
                </RadzenCard>
            </div>
            <div class="col-lg-4">
                <RadzenCard>
                    <h5 class="mb-3">Containers & Host</h5>
                    <div><strong>Containers:</strong> @(server.Containers.Count > 0 ? server.Containers.Count.ToString() : "0 (Stopped)")</div>
                    @if (server.Containers.Any())
                    {
                        <div><strong>Primary Container:</strong> <code>@server.Containers.First().Id[..Math.Min(12, server.Containers.First().Id.Length)]</code></div>
                    }
                    <div><strong>Docker Volume Options:</strong> @(validationPreview?.DockerVolumeOptions.Count ?? server.DockerVolumeOptions.Count)</div>
                    <div><strong>Network Options:</strong> @(validationPreview?.NetworkOptions.Count ?? server.NetworkOptions.Count)</div>
                </RadzenCard>
            </div>
        </div>

        @if (CurrentAdvertisedPorts.Any())
        {
            <RadzenCard class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="sports_esports" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                        <h5 class="mb-0">Connection Info</h5>
                    </div>
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"{CurrentAdvertisedPorts.Count} Port Mapping{(CurrentAdvertisedPorts.Count > 1 ? "s" : "")}")" Variant="Variant.Flat" />
                </div>
                <div class="row g-3">
                    @foreach (var port in CurrentAdvertisedPorts.OrderBy(p => p.DisplayOrder))
                    {
                        var ipEndpoint = $"{ResolvedPublicIp}:{port.PublishedPort}";
                        var hostEndpoint = !string.IsNullOrWhiteSpace(ConfiguredHostName) ? $"{ConfiguredHostName}:{port.PublishedPort}" : null;
                        <div class="col-md-6 col-lg-@(CurrentAdvertisedPorts.Count == 1 ? "12" : "6")">
                            <div class="card h-100 border-0 shadow-sm p-3" style="background: var(--rz-base-50); border-radius: 8px;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(port.Description) ? "Game Connection Port" : port.Description)</h6>
                                        <span class="small text-muted">Published Port @port.PublishedPort / @port.Protocol.ToUpperInvariant() (Container Port: @port.ContainerPort)</span>
                                    </div>
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@port.Protocol.ToUpperInvariant()" Size="BadgeSize.Small" />
                                </div>

                                <div class="d-flex flex-column gap-2 mt-2">
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded border bg-white">
                                        <div>
                                            <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Internet IP Address</div>
                                            <code class="fw-bold fs-6" style="color: var(--rz-primary);">@ipEndpoint</code>
                                        </div>
                                        <RadzenButton Icon="content_copy"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => CopyToClipboardAsync(ipEndpoint, "Internet IP"))"
                                                      title="Copy IP:Port" />
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(hostEndpoint))
                                    {
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded border bg-white">
                                            <div>
                                                <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">HostName Address</div>
                                                <code class="fw-bold fs-6" style="color: var(--rz-primary-darker);">@hostEndpoint</code>
                                            </div>
                                            <RadzenButton Icon="content_copy"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small"
                                                          Click="@(() => CopyToClipboardAsync(hostEndpoint, "HostName:Port"))"
                                                          title="Copy HostName:Port" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </RadzenCard>
        }

        @if (CurrentResolvedWebHosts.Any())
        {
            <RadzenCard class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="language" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                        <h5 class="mb-0">Web Applications & Interfaces</h5>
                    </div>
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@($"{CurrentResolvedWebHosts.Count} Available")" Variant="Variant.Flat" />
                </div>
                <div class="row g-3">
                    @foreach (var host in CurrentResolvedWebHosts.OrderBy(h => h.DisplayOrder))
                    {
                        var targetUrl = GetWebHostUrl(host);
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm" style="background: var(--rz-base-50); border-radius: 8px;">
                                <div class="card-body d-flex flex-column justify-content-between p-3">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="card-title fw-bold mb-0">@host.Name</h6>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(host.Description))
                                        {
                                            <p class="card-text text-muted small mb-2">@host.Description</p>
                                        }
                                        <div class="small text-muted mb-3">
                                            <code>@targetUrl</code>
                                        </div>
                                    </div>
                                    <a href="@targetUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-primary d-flex align-items-center justify-content-center gap-1 mt-auto">
                                        <span>Open @host.Name</span>
                                        <RadzenIcon Icon="open_in_new" Style="font-size: 1rem;" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </RadzenCard>
        }

        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="Resource Monitor" Icon="monitoring">
                    <div class="p-3">
                        <ResourceMonitorTab ServerId="@ServerId" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Console / Logs" Icon="terminal">
                    <div class="p-3">
                        <ContainerConsole ServerId="@ServerId" ContainerId="@RunningContainerId" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Terminal" Icon="code">
                    <div class="p-3">
                        <ContainerTerminal ServerId="@ServerId" ContainerId="@RunningContainerId" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="File Manager" Icon="folder">
                    <div class="p-3">
                        <ServerFileManager ServerId="@ServerId" Volumes="@CurrentResolvedVolumes" />
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Settings" Icon="tune">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Effective Settings</h5>
                            @if (!server.Settings.Any())
                            {
                                <p class="text-muted mb-0">No server setting overrides are stored.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@server.Settings.OrderBy(setting => setting.SettingKey)"
                                                TItem="GameServerSetting"
                                                AllowSorting="true"
                                                AllowFiltering="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerSetting" Property="SettingKey" Title="Key" Width="220px" />
                                        <RadzenDataGridColumn TItem="GameServerSetting" Title="Value">
                                            <Template Context="setting">
                                                @if (string.IsNullOrWhiteSpace(setting.Value))
                                                {
                                                    <span class="text-muted">(empty)</span>
                                                }
                                                else
                                                {
                                                    <code class="gameserver-detail-code">@setting.Value</code>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Ports" Icon="router">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Resolved Ports</h5>
                            @if (!CurrentResolvedPorts.Any())
                            {
                                <p class="text-muted mb-0">No ports are currently exposed for this server.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@CurrentResolvedPorts.OrderBy(port => port.DisplayOrder)"
                                                TItem="GameServerResolvedPort"
                                                AllowSorting="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="ContainerPort" Title="Container Port" Width="140px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="PublishedPort" Title="Published Port" Width="140px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="Protocol" Title="Protocol" Width="100px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="AdvertisedPort" Title="Advertised" Width="120px">
                                            <Template Context="port">
                                                <RadzenBadge BadgeStyle="@(port.AdvertisedPort ? BadgeStyle.Success : BadgeStyle.Light)"
                                                             Text="@(port.AdvertisedPort ? "Yes" : "No")" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="GameServerResolvedPort" Property="Description" Title="Description" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Volumes" Icon="storage">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Resolved Volumes</h5>
                            @if (!CurrentResolvedVolumes.Any())
                            {
                                <p class="text-muted mb-0">No volumes are currently bound for this server.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@CurrentResolvedVolumes.OrderBy(volume => volume.Usage)"
                                                TItem="GameServerResolvedVolume"
                                                AllowSorting="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="ContainerPath" Title="Container Path" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="VolumeName" Title="Volume Name" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="Usage" Title="Usage" Width="140px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedVolume" Property="MountType" Title="Type" Width="100px" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Web Hosts" Icon="language">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Resolved Web Hosts</h5>
                            @if (!CurrentResolvedWebHosts.Any())
                            {
                                <p class="text-muted mb-0">No web hosts are enabled for the current setting state.</p>
                            }
                            else
                            {
                                <RadzenDataGrid Data="@CurrentResolvedWebHosts.OrderBy(host => host.DisplayOrder)"
                                                TItem="GameServerResolvedWebHost"
                                                AllowSorting="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="Name" Title="Name" Width="180px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="ContainerPort" Title="Port" Width="100px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="PathSegment" Title="Path" Width="160px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="EnabledWhen" Title="Enabled When" Width="180px" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Property="Description" Title="Description" />
                                        <RadzenDataGridColumn TItem="GameServerResolvedWebHost" Title="Access" Width="130px" Sortable="false" Filterable="false">
                                            <Template Context="host">
                                                <a href="@GetWebHostUrl(host)"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                                    <span>Open</span>
                                                    <RadzenIcon Icon="open_in_new" Style="font-size: 0.9rem;" />
                                                </a>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Configuration Rules" Icon="rule">
                    <div class="p-3">
                        <RadzenCard>
                            <h5 class="mb-3">Validation and Configuration Rules</h5>
                            @if (!CurrentValidationIssues.Any())
                            {
                                <p class="text-muted mb-0">No validation issues are currently reported for this server.</p>
                            }
                            else
                            {
                                <ul class="mb-0 ps-3">
                                    @foreach (var issue in CurrentValidationIssues)
                                    {
                                        <li>@issue.Message</li>
                                    }
                                </ul>
                            }
                        </RadzenCard>
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        @if (validationPreview is not null)
        {
            <div class="gameserver-sticky-validation">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        @if (!validationPreview.Issues.Any())
                        {
                            <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1.3rem;" />
                            <span class="fw-bold">Current Validation: Valid</span>
                            <span class="text-muted small d-none d-md-inline">— Server configuration matches the selected revision.</span>
                        }
                        else
                        {
                            <RadzenIcon Icon="warning" Style="color: var(--rz-warning); font-size: 1.3rem;" />
                            <span class="fw-bold text-danger">Current Validation: @(validationPreview.Issues.Count) Issue@(validationPreview.Issues.Count > 1 ? "s" : "")</span>
                            <span class="text-muted small d-none d-md-inline">— Review validation issues below.</span>
                        }
                    </div>
                    @if (validationPreview.Issues.Any())
                    {
                        <RadzenButton Text="@(showValidationDetails ? "Hide Issues" : "Show Issues")"
                                      Icon="@(showValidationDetails ? "expand_less" : "expand_more")"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => showValidationDetails = !showValidationDetails)" />
                    }
                </div>
                @if (validationPreview.Issues.Any() && !showValidationDetails)
                {
                    <div class="mt-2 pt-2 border-top">
                        <ul class="mb-0 ps-3 small text-danger">
                            @foreach (var issue in validationPreview.Issues)
                            {
                                <li><strong>@issue.Scope</strong>: @issue.Message</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .gameserver-sticky-validation {
        position: sticky;
        bottom: 12px;
        z-index: 100;
        margin-top: 1rem;
        margin-bottom: 1rem;
        background: var(--rz-panel-background-color, #ffffff);
        border: 1px solid var(--rz-border-color, #e0e0e0);
        border-radius: 8px;
        padding: 10px 16px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }

    .gameserver-detail-thumbnail,
    .gameserver-detail-thumbnail-fallback {
        width: 72px;
        height: 72px;
        border-radius: 12px;
        object-fit: cover;
        background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
    }

    .gameserver-detail-thumbnail-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--rz-text-disabled-color);
    }

    .gameserver-detail-code {
        font-size: 0.8rem;
        word-break: break-word;
    }

    .gameserver-details-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .gameserver-details-overlay-card {
        background: var(--rz-base-card-background-color, #ffffff);
        color: var(--rz-text-color, #212529);
        border: 1px solid var(--rz-border-color, #e0e0e0);
        border-radius: 16px;
        padding: 2.5rem 3rem;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.25);
        text-align: center;
        max-width: 440px;
        width: 90%;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: detailsFadeIn 0.2s ease-out;
    }

    @@keyframes detailsFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    [Parameter]
    public string ServerId { get; set; } = string.Empty;

    private GameServerDetail? server;
    private GameServerValidationResult? validationPreview;
    private string? cachedGameTypeThumbnailUrl;
    private bool isLoading = true;
    private bool isOperating;
    private string operationTitle = string.Empty;
    private string operationSubtitle = string.Empty;

    private bool showValidationDetails;

    private IReadOnlyList<GameServerResolvedPort> CurrentAdvertisedPorts =>
        CurrentResolvedPorts.Where(p => p.AdvertisedPort).ToList().Count > 0
            ? CurrentResolvedPorts.Where(p => p.AdvertisedPort).ToList()
            : CurrentResolvedPorts.Where(p => p.PublishedPort > 0).ToList();

    private string ResolvedPublicIp
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(ApiConfig?.Value?.PublicIp))
            {
                return ApiConfig.Value.PublicIp.Trim();
            }

            try
            {
                return new Uri(Navigation.Uri).Host;
            }
            catch
            {
                return "127.0.0.1";
            }
        }
    }

    private string? ConfiguredHostName => !string.IsNullOrWhiteSpace(ApiConfig?.Value?.HostName) ? ApiConfig.Value.HostName.Trim() : null;

    private async Task CopyToClipboardAsync(string text, string label)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Copied to Clipboard",
                Detail = $"{label}: {text}",
                Duration = 3000
            });
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = label,
                Detail = text,
                Duration = 3000
            });
        }
    }

    private string? RunningContainerId => server?.Containers?.FirstOrDefault()?.Id;

    private IReadOnlyList<GameServerResolvedPort> CurrentResolvedPorts => validationPreview?.ResolvedPorts ?? server?.ResolvedPorts ?? [];

    private IReadOnlyList<GameServerResolvedVolume> CurrentResolvedVolumes => validationPreview?.ResolvedVolumes ?? server?.ResolvedVolumes ?? [];

    private IReadOnlyList<GameServerResolvedWebHost> CurrentResolvedWebHosts => validationPreview?.ResolvedWebHosts ?? server?.ResolvedWebHosts ?? [];

