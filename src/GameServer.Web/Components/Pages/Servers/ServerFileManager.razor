@using Radzen
@using Radzen.Blazor
@using GameServer.Docker.Client
@using Microsoft.AspNetCore.Components.Forms
@inject IGameServerApi ServerApi
@inject NotificationService NotificationService

<div class="file-manager">
  <div class="file-toolbar">
    <RadzenDropDown Data="Server.Volumes" 
                    @bind-Value="selectedVolume" 
                    TextProperty="Target" 
                    Placeholder="Select Volume"
                    Change="OnVolumeChanged"
                    Style="width:250px" />
    <div class="path-breadcrumb">
      <RadzenBreadCrumb Data="breadcrumbs" />
    </div>
    <div class="toolbar-actions">
      <RadzenButton Icon="create_new_folder" Text="New Folder" Click="CreateFolder" ButtonStyle="ButtonStyle.Light" />
      <RadzenButton Icon="upload_file" Text="Upload" Click="ShowUploadDialog" ButtonStyle="ButtonStyle.Primary" />
      <RadzenButton Icon="refresh" Click="RefreshFiles" ButtonStyle="ButtonStyle.Light" />
    </div>
  </div>

  @if (loadingFiles)
  {
    <div class="loading-indicator">
      <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
      <span>Loading files...</span>
    </div>
  }
  else
  {
    <RadzenDataGrid Data="currentFiles" TItem="FileItem" class="file-grid" AllowSorting="true" AllowFiltering="true">
      <Columns>
        <RadzenDataGridColumn TItem="FileItem" Property="Name" Title="Name" Width="50%">
          <Template Context="file">
            <div class="file-name-cell" @onclick='@(() => OnFileClick(file))'>
              <RadzenIcon Icon='@(file.IsDirectory ? "folder" : GetFileIcon(file.Name))' class="file-icon" />
              <span class="file-name">@file.Name</span>
            </div>
          </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="FileItem" Property="Size" Title="Size" Width="15%">
          <Template Context="file">
            @FormatFileSize(file.Size)
          </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="FileItem" Property="Modified" Title="Modified" Width="20%" FormatString="{0:yyyy-MM-dd HH:mm}" />
        <RadzenDataGridColumn TItem="FileItem" Title="Actions" Width="15%" Sortable="false" Filterable="false">
          <Template Context="file">
            <div class="file-actions">
              @if (!file.IsDirectory)
              {
                <RadzenButton Icon="download" Size="ButtonSize.Small" Click='@(() => DownloadFile(file))' ButtonStyle="ButtonStyle.Light" />
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Click='@(() => EditFile(file))' ButtonStyle="ButtonStyle.Light" />
              }
              <RadzenButton Icon="delete" Size="ButtonSize.Small" Click='@(() => DeleteFile(file))' ButtonStyle="ButtonStyle.Danger" />
            </div>
          </Template>
        </RadzenDataGridColumn>
      </Columns>
    </RadzenDataGrid>
  }
</div>

@code {
  [Parameter] public string ServerId { get; set; } = "";
  [Parameter] public GameServer Server { get; set; } = new();



  VolumeDefinition? selectedVolume;
  string currentPath = "/";
  List<FileItem> currentFiles = new();
  bool loadingFiles = false;
  List<BreadcrumbItem> breadcrumbs = new();

  async Task OnVolumeChanged()
  {
    if (selectedVolume != null)
    {
      currentPath = "/";
      await LoadFilesAsync();
    }
  }

  async Task LoadFilesAsync()
  {
    if (selectedVolume == null) return;

    loadingFiles = true;
    try
    {
      var files = await ServerApi.GetFilesAsync(ServerId, selectedVolume.Target, currentPath);
      currentFiles = files.Select(f => new FileItem
      {
        Name = f.Name,
        Path = f.Path,
        IsDirectory = f.IsDirectory,
        Size = f.Size,
        ModifiedTime = f.ModifiedTime
      }).ToList();

      UpdateBreadcrumbs();
    }
    catch (Exception ex)
    {
      NotificationService.Notify(new NotificationMessage 
      { 
        Severity = NotificationSeverity.Error, 
        Summary = "Error", 
        Detail = $"Failed to load files: {ex.Message}", 
        Duration = 5000 
      });
    }
    finally
    {
      loadingFiles = false;
    }
  }

  void UpdateBreadcrumbs()
  {
    breadcrumbs.Clear();
    breadcrumbs.Add(new BreadcrumbItem { Text = selectedVolume?.Target ?? "Root", Path = "/" });

    if (currentPath != "/")
    {
      var parts = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
      var path = "";
      foreach (var part in parts)
      {
        path += "/" + part;
        breadcrumbs.Add(new BreadcrumbItem { Text = part, Path = path });
      }
    }
  }

  async Task OnFileClick(FileItem file)
  {
    if (file.IsDirectory)
    {
      currentPath = file.Path;
      await LoadFilesAsync();
    }
  }

  async Task RefreshFiles()
