@using Microsoft.AspNetCore.SignalR.Client
@using Radzen
@using Radzen.Blazor
@using GameServer.Docker.Client
@using GameServer.Docker.Client.Interfaces
@using GameServer.Docker.Client.Services
@inject IConfiguration Configuration
@inject NotificationService NotificationService
@inject ILoggerFactory LoggerFactory
@implements IAsyncDisposable

<div class="console-container">
  <div class="console-toolbar">
    <RadzenBadge BadgeStyle='@GetConnectionBadgeStyle()' 
                 Text='@GetConnectionStatusText()' />
    <RadzenButton Icon="clear" Text="Clear" Click="ClearConsole" ButtonStyle="ButtonStyle.Secondary" class="ml-auto" />
  </div>

  <div class="console-output" @ref="consoleOutputRef">
    @foreach (var line in consoleLines)
    {
      <div class="console-line">@line</div>
    }
    @if (consoleLines.Count == 0)
    {
      <div class="console-hint">Enter commands below to interact with the server...</div>
    }
  </div>

  <div class="console-input">
    <RadzenTextBox @bind-Value="commandInput" 
                   Placeholder="Enter command..." 
                   class="command-input" 
                   @onkeydown="OnKeyDown"
                   Disabled="@(!IsConnected())" />
    <RadzenButton Text="Send" 
                  Icon="send" 
                  Click="SendCommand" 
                  Disabled="@(!IsConnected() || string.IsNullOrWhiteSpace(commandInput))" />
  </div>
</div>

@code {
  [Parameter] public string ServerId { get; set; } = "";
  [Parameter] public GameServer Server { get; set; } = new();

  private IServerConsoleClient? consoleClient;
  private List<string> consoleLines = new();
  private List<string> commandHistory = new();
  private int historyIndex = -1;
  private string commandInput = "";
  private ElementReference consoleOutputRef;

  protected override void OnInitialized()
  {
    InitializeConsoleClient();
  }

  protected override async Task OnInitializedAsync()
  {
    await ConnectToConsole();
  }

  protected override async Task OnParametersSetAsync()
  {
    // Recreate client if server ID changes
    if (consoleClient != null)
    {
      await DisconnectFromConsole();
      consoleLines.Clear();
      await ConnectToConsole();
    }
  }

  private void InitializeConsoleClient()
  {
    if (string.IsNullOrWhiteSpace(ServerId))
    {
      return;
    }

    var apiBaseUrl = Configuration["GameServerDockerApi:BaseUri"]?.TrimEnd('/') ?? "http://localhost:5164";
    var hubUrl = $"{apiBaseUrl}/hubs/console";

    consoleClient = new ServerConsoleClient(
      hubUrl,
      builder => builder
        .WithAutomaticReconnect(new[] 
        { 
          TimeSpan.Zero, 
          TimeSpan.FromSeconds(2), 
          TimeSpan.FromSeconds(5), 
          TimeSpan.FromSeconds(10) 
        }),
      LoggerFactory.CreateLogger<ServerConsoleClient>());

    // Wire up events
    consoleClient.ConsoleOutput += OnConsoleOutputReceived;
    consoleClient.ConsoleError += OnConsoleErrorReceived;
    consoleClient.ConsoleStarted += OnConsoleStarted;
    consoleClient.ConsoleEnded += OnConsoleEnded;
    consoleClient.ConsoleStopped += OnConsoleStopped;
    consoleClient.StateChanged += OnStateChanged;
  }

  private async Task ConnectToConsole()
  {
    if (string.IsNullOrWhiteSpace(ServerId))
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Warning,
        Summary = "Invalid Server",
        Detail = "Server ID is required",
        Duration = 3000
      });
      return;
    }

    if (consoleClient == null)
    {
      InitializeConsoleClient();
    }

    if (consoleClient == null)
    {
      return;
    }

    try
    {
      // Connect to the hub
      await consoleClient.ConnectAsync();

      // Start console session
      await consoleClient.StartConsoleAsync(ServerId);

      consoleLines.Add($"[{DateTime.Now:HH:mm:ss}] Connected to server console");

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "Connected",
        Detail = "Console connection established",
        Duration = 3000
      });
    }
    catch (Exception ex)
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Connection Error",
        Detail = $"Failed to connect to console: {ex.Message}",
        Duration = 5000
      });
      consoleLines.Add($"[ERROR] Failed to connect: {ex.Message}");
    }
  }

  private async Task DisconnectFromConsole()
  {
    if (consoleClient != null)
    {
      try
      {
        await consoleClient.StopConsoleAsync();
        await consoleClient.DisconnectAsync();
      }
      catch (Exception ex)
      {
        NotificationService.Notify(new NotificationMessage
        {
          Severity = NotificationSeverity.Warning,
          Summary = "Disconnect Warning",
          Detail = $"Error disconnecting: {ex.Message}",
          Duration = 3000
        });
      }
    }
  }

  private void OnConsoleOutputReceived(object? sender, string output)
  {
    InvokeAsync(() =>
    {
      consoleLines.Add(output);

      // Limit console lines
      while (consoleLines.Count > 1000)
      {
        consoleLines.RemoveAt(0);
      }

      StateHasChanged();
    });
  }

  private void OnConsoleErrorReceived(object? sender, string error)
  {
    InvokeAsync(() =>
    {
      consoleLines.Add($"[ERROR] {error}");
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Console Error",
        Detail = error,
        Duration = 5000
      });
      StateHasChanged();
    });
  }

  private void OnConsoleStarted(object? sender, string serverId)
  {
    InvokeAsync(() =>
    {
      consoleLines.Add($"[{DateTime.Now:HH:mm:ss}] Console session started for server: {serverId}");
      StateHasChanged();
    });
  }

  private void OnConsoleEnded(object? sender, EventArgs e)
  {
    InvokeAsync(() =>
    {
      consoleLines.Add($"[{DateTime.Now:HH:mm:ss}] Console session ended");
      StateHasChanged();
    });
  }

  private void OnConsoleStopped(object? sender, EventArgs e)
  {
    InvokeAsync(() =>
    {
      consoleLines.Add($"[{DateTime.Now:HH:mm:ss}] Console session stopped");
      StateHasChanged();
    });
  }

  private void OnStateChanged(object? sender, ConnectionState state)
  {
    InvokeAsync(() =>
    {
      StateHasChanged();
    });
  }

  private async Task SendCommand()
  {
    if (string.IsNullOrWhiteSpace(commandInput) || !IsConnected())
    {
      return;
    }

    try
    {
      var command = commandInput.Trim();
      consoleLines.Add($"> {command}");

      // Add to history
      if (commandHistory.Count == 0 || commandHistory[^1] != command)
      {
        commandHistory.Add(command);
        if (commandHistory.Count > 50)
        {
          commandHistory.RemoveAt(0);
        }
      }
      historyIndex = commandHistory.Count;

      // Send command via console client
      await consoleClient!.SendInputAsync(command);

      commandInput = "";
    }
    catch (Exception ex)
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Command Error",
        Detail = $"Failed to send command: {ex.Message}",
        Duration = 5000
      });
      consoleLines.Add($"[ERROR] Failed to send command: {ex.Message}");
    }
  }

  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
    {
      await SendCommand();
    }
    else if (e.Key == "ArrowUp")
    {
      if (commandHistory.Count > 0 && historyIndex > 0)
      {
        historyIndex--;
        commandInput = commandHistory[historyIndex];
      }
    }
    else if (e.Key == "ArrowDown")
    {
      if (historyIndex < commandHistory.Count - 1)
      {
        historyIndex++;
        commandInput = commandHistory[historyIndex];
      }
      else
      {
        historyIndex = commandHistory.Count;
        commandInput = "";
      }
    }
  }

  private void ClearConsole()
  {
    consoleLines.Clear();
  }

  private bool IsConnected()
  {
    return consoleClient?.State == ConnectionState.Connected;
  }

  private BadgeStyle GetConnectionBadgeStyle()
  {
    return consoleClient?.State switch
    {
      ConnectionState.Connected => BadgeStyle.Success,
      ConnectionState.Connecting => BadgeStyle.Info,
      ConnectionState.Reconnecting => BadgeStyle.Warning,
      _ => BadgeStyle.Secondary
    };
  }

  private string GetConnectionStatusText()
  {
    return consoleClient?.State switch
    {
      ConnectionState.Connected => "Connected",
      ConnectionState.Connecting => "Connecting...",
      ConnectionState.Reconnecting => "Reconnecting...",
      _ => "Disconnected"
    };
  }

  public async ValueTask DisposeAsync()
  {
    if (consoleClient != null)
    {
      // Unwire events
      consoleClient.ConsoleOutput -= OnConsoleOutputReceived;
      consoleClient.ConsoleError -= OnConsoleErrorReceived;
      consoleClient.ConsoleStarted -= OnConsoleStarted;
      consoleClient.ConsoleEnded -= OnConsoleEnded;
      consoleClient.ConsoleStopped -= OnConsoleStopped;
      consoleClient.StateChanged -= OnStateChanged;

      await consoleClient.DisposeAsync();
    }
  }
}