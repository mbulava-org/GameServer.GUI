@using Radzen
@using Radzen.Blazor
@using GameServer.Docker.Client
@using GameServer.Web.Services
@inject GameServerWebSocketService WebSocketService
@inject NotificationService NotificationService
@implements IAsyncDisposable

<div class="console-container">
  <div class="console-toolbar">
    <RadzenBadge BadgeStyle='@(isConnected ? BadgeStyle.Success : BadgeStyle.Secondary)' 
                 Text='@(isConnected ? "Connected" : "Disconnected")' />
    <RadzenButton Icon="clear" Text="Clear" Click="ClearConsole" ButtonStyle="ButtonStyle.Secondary" class="ml-auto" />
  </div>

  <div class="console-output" @ref="consoleOutputRef">
    @foreach (var line in consoleLines)
    {
      <div class="console-line">@line</div>
    }
    @if (consoleLines.Count == 0)
    {
      <div class="console-hint">Enter commands below to interact with the server...</div>
    }
  </div>

  <div class="console-input">
    <RadzenTextBox @bind-Value="commandInput" 
                   Placeholder="Enter command..." 
                   class="command-input" 
                   @onkeydown="OnKeyDown"
                   Disabled="@(!isConnected)" />
    <RadzenButton Text="Send" 
                  Icon="send" 
                  Click="SendCommand" 
                  Disabled="@(!isConnected || string.IsNullOrWhiteSpace(commandInput))" />
  </div>
</div>

@code {
  [Parameter] public string ServerId { get; set; } = "";
  [Parameter] public GameServer Server { get; set; } = new();

  List<string> consoleLines = new();
  List<string> commandHistory = new();
  int historyIndex = -1;
  string commandInput = "";
  bool isConnected = false;
  ElementReference consoleOutputRef;
  IDisposable? consoleSubscription;

  protected override async Task OnInitializedAsync()
  {
    await ConnectToConsole();
  }

  async Task ConnectToConsole()
  {
    try
    {
      consoleSubscription = await WebSocketService.SubscribeToConsoleAsync(
        ServerId,
        OnConsoleMessageReceived,
        null);
      
      isConnected = true;
      consoleLines.Add($"[{DateTime.Now:HH:mm:ss}] Connected to server console");
    }
    catch (Exception ex)
    {
      NotificationService.Notify(new NotificationMessage 
      { 
        Severity = NotificationSeverity.Error, 
        Summary = "Connection Error", 
        Detail = $"Failed to connect to console: {ex.Message}", 
        Duration = 5000 
      });
      consoleLines.Add($"[ERROR] Failed to connect: {ex.Message}");
    }
  }

  async Task OnConsoleMessageReceived(string message)
  {
    await InvokeAsync(() =>
    {
      consoleLines.Add(message);
      
      if (consoleLines.Count > 1000)
      {
        consoleLines.RemoveAt(0);
      }
      
      StateHasChanged();
    });
  }

  async Task SendCommand()
  {
    if (string.IsNullOrWhiteSpace(commandInput) || !isConnected) 
      return;

    try
    {
      var command = commandInput.Trim();
      consoleLines.Add($"> {command}");
      
      // Add to history
      if (commandHistory.Count == 0 || commandHistory[^1] != command)
      {
        commandHistory.Add(command);
        if (commandHistory.Count > 50)
        {
          commandHistory.RemoveAt(0);
        }
      }
      historyIndex = commandHistory.Count;

      // Send command via WebSocket service
      await WebSocketService.SendConsoleCommandAsync(ServerId, command);

      commandInput = "";
    }
    catch (Exception ex)
    {
      NotificationService.Notify(new NotificationMessage 
      { 
        Severity = NotificationSeverity.Error, 
        Summary = "Command Error", 
        Detail = $"Failed to send command: {ex.Message}", 
        Duration = 5000 
      });
      consoleLines.Add($"[ERROR] Failed to send command: {ex.Message}");
    }
  }

  async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
    {
      await SendCommand();
    }
    else if (e.Key == "ArrowUp")
    {
      if (commandHistory.Count > 0 && historyIndex > 0)
      {
        historyIndex--;
        commandInput = commandHistory[historyIndex];
      }
    }
    else if (e.Key == "ArrowDown")
    {
      if (historyIndex < commandHistory.Count - 1)
      {
        historyIndex++;
        commandInput = commandHistory[historyIndex];
      }
      else
      {
        historyIndex = commandHistory.Count;
        commandInput = "";
      }
    }
  }

  void ClearConsole()
  {
    consoleLines.Clear();
  }

  public async ValueTask DisposeAsync()
  {
    consoleSubscription?.Dispose();
    consoleSubscription = null;
    isConnected = false;
  }
}