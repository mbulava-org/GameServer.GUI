@page "/gameservers-v2/new"
@page "/gameservers-v2/{ServerId}/edit"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.Json
@using GameServer.Web.Models.V2
@using GameServer.Web.Components.Server
@using GameServer.API.Client.Interfaces
@using GameServer.API.Client.Services
@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Logging
@using GameServer.Web.Configurations
@using Radzen
@using Radzen.Blazor
@inject Services.V2.IGameServerV2ApiService GameServerApiV2
@inject Services.V2.IGameTypeV2ApiService GameTypeApiV2
@inject Services.V2.IMountTypeConfigApiService MountTypeConfigApi
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IOptions<GameServerDockerApi> ApiConfig
@inject ILogger<GameServerEditorV2> Logger

<PageTitle>@(isEditMode ? $"Edit {draft.Name}" : "Create Game Server")</PageTitle>

@if (isSaving)
{
    <div class="gameserver-saving-overlay">
        <div class="gameserver-saving-modal">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <h5 class="mt-3 mb-1">@operationTitle</h5>
            <p class="text-muted small mb-0">@operationSubtitle</p>
        </div>
    </div>
}

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Loading editor...</p>
        </div>
    }
    else if (!isEditMode && !gameTypes.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="inventory_2" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Game Types Available</h4>
                <p class="text-muted">Create a GameType revision before creating a GameServer.</p>
                <RadzenButton Text="Go to Game Types"
                              Icon="arrow_forward"
                              ButtonStyle="ButtonStyle.Primary"
                              Click='@(() => Navigation.NavigateTo("/gametypes-v2"))' />
            </div>
        </RadzenCard>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="mb-0">@(isEditMode ? $"Edit {draft.Name}" : "Create Game Server")</h2>
                    @if (isEditMode)
                    {
                        <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(draft.Status)"
                                     Text="@(string.IsNullOrWhiteSpace(draft.Status) ? "Unknown" : draft.Status)" />
                    }
                </div>
                <p class="text-muted mb-0 mt-1">Configure a GameServer from a GameType revision with backend validation previews.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <RadzenButton Text="Back"
                              Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@GoBack" />
                @if (isEditMode)
                {
                    <RadzenButton Text="Delete"
                                  Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@DeleteServerAsync"
                                  Disabled="@isSaving" />
                }
                <RadzenButton Text="@(isEditMode ? "Save Changes" : "Create Server")"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@SaveAsync"
                              Disabled="@(isSaving || !CanSave)" />
            </div>
        </div>


        <div class="row g-3">
            <div class="col-xl-4">
                <RadzenCard class="mb-3">
                    <h5 class="mb-3">Revision Selection</h5>
                    <div class="mb-3">
                        <RadzenFormField Text="Game Type" Variant="Variant.Outlined" class="w-100">
                            <RadzenDropDown TValue="string"
                                            Value="@selectedGameTypeKey"
                                            ValueChanged="@OnGameTypeChanged"
                                            Data="@gameTypes"
                                            TextProperty="DisplayName"
                                            ValueProperty="Key"
                                            AllowClear="true"
                                            Placeholder="Select a game type..."
                                            class="w-100" />
                        </RadzenFormField>
                        @if (string.IsNullOrWhiteSpace(selectedGameTypeKey))
                        {
                            <small class="text-danger">A game type must be selected before continuing.</small>
                        }
                    </div>
                    <div class="mb-3">
                        <RadzenFormField Text="Revision" Variant="Variant.Outlined" class="w-100">
                            <RadzenDropDown TValue="int?"
                                            Value="@draft.GameTypeRevisionId"
                                            ValueChanged="@OnRevisionChanged"
                                            Data="@availableRevisions"
                                            TextProperty="Label"
                                            ValueProperty="Id"
                                            class="w-100"
                                            Disabled="@(string.IsNullOrWhiteSpace(selectedGameTypeKey) || !availableRevisions.Any())" />
                        </RadzenFormField>
                    </div>
                    @if (selectedGameType is not null)
                    {
                        <div class="small text-muted">
                            <div><strong>Game Type:</strong> @selectedGameType.DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(selectedGameType.Description))
                            {
                                <div class="mt-1">@selectedGameType.Description</div>
                            }
                        </div>
                    }
                </RadzenCard>

                <RadzenCard class="mb-3">
                    <h5 class="mb-3">Basic Information</h5>
                    <div class="mb-3">
                        <RadzenFormField Text="Server Name" Variant="Variant.Outlined" class="w-100">
                            <RadzenTextBox Value="@draft.Name"
                                           ValueChanged="@OnServerNameChanged"
                                           @oninput="@(e => OnServerNameInput(e.Value?.ToString()))"
                                           class="w-100" />
                        </RadzenFormField>
                    </div>
                    <div class="mb-3">
                        <RadzenFormField Text="Description" Variant="Variant.Outlined" class="w-100">
                            <RadzenTextArea Value="@draft.Description"
                                            ValueChanged="@OnDescriptionChanged"
                                            @oninput="@(e => OnDescriptionInput(e.Value?.ToString()))"
                                            Rows="4"
                                            class="w-100" />
                        </RadzenFormField>
                    </div>
                    <div class="mb-3">
                        <RadzenFormField Text="Service Name" Variant="Variant.Outlined" class="w-100">
                            <RadzenTextBox Value="@ComputedServiceName" ReadOnly="true" Disabled="true" class="w-100" />
                        </RadzenFormField>
                        <small class="text-muted">Generated automatically from the selected game type and the server id.</small>
                    </div>
                </RadzenCard>

                <RadzenCard class="mb-3">
                    <h5 class="mb-3">Volume Mounts</h5>
                    <p class="small text-muted mb-2">Each volume defined on the GameType revision is listed below. Select a mount type for each volume.</p>
                    @if (CurrentRevisionVolumes.Any())
                    {
                        @foreach (var volume in CurrentRevisionVolumes)
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="fw-semibold mb-1"><code>@volume.Source</code></div>
                                @if (!string.IsNullOrWhiteSpace(volume.Description))
                                {
                                    <div class="small text-muted mb-1">@volume.Description</div>
                                }
                                <div class="small text-muted mb-1">Usage: @volume.Usage · @(volume.ReadOnly ? "read-only" : "read/write")</div>
                                @{
                                    var generatedName = ComputeVolumeName(volume);
                                }
                                @if (!string.IsNullOrWhiteSpace(generatedName))
                                {
                                    <div class="small mb-1"><strong>Volume Name:</strong> <code>@generatedName</code></div>
                                }
                                <RadzenFormField Text="Mount Type" Variant="Variant.Outlined" class="w-100">
                                    <RadzenDropDown TValue="string"
                                                    Value="@GetVolumeMountType(volume)"
                                                    ValueChanged="@(value => SetVolumeMountType(volume, value))"
                                                    Data="@mountTypeOptions"
                                                    TextProperty="DisplayName"
                                                    ValueProperty="Key"
                                                    class="w-100" />
                                </RadzenFormField>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No volumes defined on the selected revision.</p>
                    }
                </RadzenCard>

                <RadzenCard class="mb-3">
                    <h5 class="mb-3">Port Mappings</h5>
                    <p class="small text-muted mb-2">Set the published (exposed) port for each container port. Ports with auto-calculated offsets will update automatically.</p>
                    @if (CurrentRevisionPorts.Any())
                    {
                        @foreach (var port in CurrentRevisionPorts.OrderBy(p => p.DisplayOrder))
                        {
                            var isAutoCalculated = IsAutoCalculatedPort(port);
                            <div class="border rounded p-2 mb-2">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <code>@port.ContainerPort/@port.Protocol</code>
                                    @if (port.AdvertisedPort)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Advertised" Variant="Variant.Outlined" />
                                    }
                                    @if (isAutoCalculated)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Auto" Variant="Variant.Outlined" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(port.Description))
                                    {
                                        <span class="text-muted small">@port.Description</span>
                                    }
                                </div>
                                <RadzenFormField Text="Published Port" Variant="Variant.Outlined" class="w-100">
                                    <RadzenNumeric TValue="int"
                                                   Value="@GetPublishedPort(port)"
                                                   ValueChanged="@(value => OnPublishedPortChanged(port, value))"
                                                   Change="@(value => OnPublishedPortChanged(port, value))"
                                                   Min="1"
                                                   Max="65535"
                                                   class="w-100"
                                                   Disabled="@isAutoCalculated" />
                                </RadzenFormField>
                                @{
                                    var availability = GetPortAvailability(port);
                                    var publishedPortNum = GetPublishedPort(port);
                                }
                                @if (availability is not null)
                                {
                                    @if (availability.IsAvailable)
                                    {
                                        <div class="small text-success mt-1">Port @publishedPortNum/@port.Protocol is available.</div>
                                    }
                                    else
                                    {
                                        <div class="small text-danger mt-1">@availability.Reason</div>
                                    }
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No ports defined on the selected revision.</p>
                    }
                </RadzenCard>
            </div>

            <div class="col-xl-8">
                <RadzenTabs SelectedIndex="@selectedTabIndex" Change="@OnSelectedTabChanged">
                    <Tabs>
                        <RadzenTabsItem Text="Settings">
                            <div class="p-3">
                                <RadzenCard>
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <h5 class="mb-0">Revision Settings</h5>
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info"
                                                     Text="@($"{CurrentSettingDefinitions.Count} setting definition(s)")"
                                                     Variant="Variant.Outlined" />
                                    </div>

                                    @if (!CurrentSettingDefinitions.Any())
                                    {
                                        <p class="text-muted mb-0">The selected revision does not define any configurable settings.</p>
                                    }
                                    else
                                    {
                                        @foreach (var category in GetSettingCategories())
                                        {
                                            <div class="v2-server-settings-category mb-4">
                                                <h6 class="mb-3">@category.Key</h6>
                                                <div class="row g-3">
                                                    @foreach (var definition in category)
                                                    {
                                                        <div class="col-lg-6">
                                                            <div class="v2-server-setting-field">
                                                                <label class="form-label fw-semibold">
                                                                    @definition.SettingKey
                                                                    @if (definition.Metadata?.IsRequired == true)
                                                                    {
                                                                        <span class="text-danger">*</span>
                                                                    }
                                                                </label>
                                                                <GameServerSettingFieldV2 Definition="definition"
                                                                                          Value="@GetSettingValue(definition)"
                                                                                          ValidationMessage="@GetSettingValidationMessage(definition)"
                                                                                          ValueChanged="@(value => SetSettingValue(definition.SettingKey, value))" />
                                                                @if (!string.IsNullOrWhiteSpace(definition.Description))
                                                                {
                                                                    <div class="small text-muted mt-1">@definition.Description</div>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(definition.DefaultValue))
                                                                {
                                                                    <div class="small text-muted">Default: <code>@definition.DefaultValue</code></div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </RadzenCard>
                            </div>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Validation Preview">
                            <div class="p-3">
                                <div class="row g-3">
                                    <div class="col-lg-4">
                                        <RadzenCard>
                                            <h5 class="mb-3">Resolved Ports</h5>
                                            @if (validationResult?.ResolvedPorts.Any() == true)
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var port in validationResult.ResolvedPorts.OrderBy(port => port.DisplayOrder))
                                                    {
                                                        <li>@port.ContainerPort/@port.Protocol</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">Run validation to preview resolved ports.</p>
                                            }
                                        </RadzenCard>
                                    </div>
                                    <div class="col-lg-4">
                                        <RadzenCard>
                                            <h5 class="mb-3">Resolved Volumes</h5>
                                            @if (validationResult?.ResolvedVolumes.Any() == true)
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var volume in validationResult.ResolvedVolumes)
                                                    {
                                                        <li>
                                                            <strong>@volume.VolumeName</strong>:
                                                            <code>@volume.ContainerPath</code> &rarr; <code>@volume.Source</code>
                                                            <span class="text-muted small"> — @volume.MountType · @volume.Usage</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">Run validation to preview resolved volumes.</p>
                                            }
                                        </RadzenCard>
                                    </div>
                                    <div class="col-lg-4">
                                        <RadzenCard>
                                            <h5 class="mb-3">Resolved Web Hosts</h5>
                                            @if (validationResult?.ResolvedWebHosts.Any() == true)
                                            {
                                                <ul class="mb-0 ps-3">
                                                    @foreach (var host in validationResult.ResolvedWebHosts.OrderBy(host => host.DisplayOrder))
                                                    {
                                                        <li>@host.Name (@host.ContainerPort)</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">Run validation to preview resolved web hosts.</p>
                                            }
                                        </RadzenCard>
                                    </div>
                                </div>
                            </div>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Deployment Preview">
                            <div class="p-3">
                                <GameServerDeploymentPreviewV2 Preview="@deploymentPreview"
                                                               IsLoading="@isPreviewLoading"
                                                               OnRefresh="@LoadDeploymentPreviewAsync" />
                            </div>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            </div>
        </div>

        @if (validationResult is not null)
        {
            <div class="gameserver-sticky-validation">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        @if (!validationResult.Issues.Any())
                        {
                            <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1.3rem;" />
                            <span class="fw-bold">Configuration Valid</span>
                            <span class="text-muted small d-none d-md-inline">— Ready for persistence.</span>
                        }
                        else
                        {
                            <RadzenIcon Icon="error" Style="color: var(--rz-danger); font-size: 1.3rem;" />
                            <span class="fw-bold text-danger">@(validationResult.Issues.Count) Validation Issue@(validationResult.Issues.Count > 1 ? "s" : "")</span>
                            <span class="text-muted small d-none d-md-inline">— Blocking issues prevent saving.</span>
                        }
                    </div>
                    @if (validationResult.Issues.Any())
                    {
                        <RadzenButton Text="@(showValidationDetails ? "Hide Issues" : "Show Issues")"
                                      Icon="@(showValidationDetails ? "expand_less" : "expand_more")"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.ExtraSmall"
                                      Click="@(() => showValidationDetails = !showValidationDetails)" />
                    }
                </div>
                @if (showValidationDetails && validationResult.Issues.Any())
                {
                    <div class="mt-2 pt-2 border-top">
                        <ul class="mb-0 ps-3 small text-danger">
                            @foreach (var issue in validationResult.Issues)
                            {
                                <li>
                                    <strong>@issue.Scope</strong>: @issue.Message
                                    @if (!issue.IsBlocking)
                                    {
                                        <span class="text-muted"> (warning)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .gameserver-sticky-validation {
        position: sticky;
        bottom: 12px;
        z-index: 100;
        margin-top: 1rem;
        margin-bottom: 1rem;
        background: var(--rz-panel-background-color, #ffffff);
        border: 1px solid var(--rz-border-color, #e0e0e0);
        border-radius: 8px;
        padding: 10px 16px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }

    .v2-server-settings-category {
        border-bottom: 1px solid var(--rz-border-color);
        padding-bottom: 1rem;
    }

    .v2-server-settings-category:last-child {
        border-bottom: none;
        padding-bottom: 0;
        margin-bottom: 0 !important;
    }

    .v2-server-setting-field code {
        font-size: 0.8rem;
    }
</style>

@code {
    [Parameter]
    public string? ServerId { get; set; }

    private readonly List<GameTypeListItem> gameTypes = [];
    private readonly List<RevisionOption> availableRevisions = [];
    private GameServerEditorDraft draft = new();
    private GameServerValidationResult? validationResult;
    private bool showValidationDetails;
    private GameServerDeploymentPreview? deploymentPreview;
    private bool isPreviewLoading;
    private GameTypeDetail? selectedGameType;
    private string? selectedGameTypeKey;
    private bool isLoading = true;
    private bool isSaving;
    private string operationTitle = "Saving Server Changes...";
    private string operationSubtitle = "Provisioning volumes and deploying Docker Swarm service...";
    private int selectedTabIndex;

    // Volume mount type selections (keyed by GameTypeVolume.Id)
    private readonly List<MountTypeConfig> mountTypeOptions = [];
    private readonly Dictionary<int, string> volumeMountTypeSelections = new();

    // Published port selections (keyed by GameTypePort.Id)
    private readonly Dictionary<int, int> publishedPortSelections = new();
    private List<GameServerPort>? initialServerPorts;

    // Published port values as originally loaded, so reverting a port is never flagged unavailable.
    private readonly Dictionary<int, int> originalPublishedPorts = new();

    // Live availability results (keyed by GameTypePort.Id)
    private readonly Dictionary<int, GameServerPortAvailability> portAvailability = new();
    private bool isCheckingPorts;
    private int portCheckToken;

    private bool isEditMode => !string.IsNullOrWhiteSpace(ServerId);

    private IReadOnlyList<GameTypeSettingDefinition> CurrentSettingDefinitions =>
        selectedGameType?.Revisions.FirstOrDefault(revision => revision.Id == draft.GameTypeRevisionId)?.SettingDefinitions
        ?? [];

    private IReadOnlyList<GameTypeVolume> CurrentRevisionVolumes =>
        selectedGameType?.Revisions.FirstOrDefault(revision => revision.Id == draft.GameTypeRevisionId)?.Volumes
        ?? [];

    private IReadOnlyList<GameTypePort> CurrentRevisionPorts =>
        selectedGameType?.Revisions.FirstOrDefault(revision => revision.Id == draft.GameTypeRevisionId)?.Ports
        ?? [];

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(draft.Name)
        && !string.IsNullOrWhiteSpace(selectedGameTypeKey)
        && draft.GameTypeRevisionId > 0
        && !HasUnavailablePort
        && !isCheckingPorts;

    private string ComputedServiceName =>
        string.IsNullOrWhiteSpace(selectedGameTypeKey) || string.IsNullOrWhiteSpace(draft.ServerId)
            ? string.Empty
            : $"{selectedGameTypeKey}-{draft.ServerId}";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            validationResult = null;
            gameTypes.Clear();
            availableRevisions.Clear();

            if (isEditMode)
            {
                var gameTypesTask = GameTypeApiV2.GetListAsync(includeInactive: true);
                var serverTask = GameServerApiV2.GetByServerIdAsync(ServerId!);
                await Task.WhenAll(gameTypesTask, serverTask);

                gameTypes.AddRange(await gameTypesTask);
                await LoadMountTypesAsync();
                var server = await serverTask;
                if (server is null)
                {
                    draft = new();
                    selectedGameType = null;
                    selectedGameTypeKey = null;
                    initialServerPorts = null;
                    return;
                }

                initialServerPorts = server.Ports;

                draft = new GameServerEditorDraft
                {
                    ServerId = server.ServerId,
                    Name = server.Name,
                    Description = server.Description,
                    GameTypeRevisionId = server.GameTypeRevisionId,
                    ServiceName = server.ServiceName,
                    Status = server.Status
                };
                foreach (var setting in server.Settings)
                {
                    draft.SettingValues[setting.SettingKey] = setting.Value;
                }

                selectedGameTypeKey = server.GameTypeKey;
                if (!string.IsNullOrWhiteSpace(selectedGameTypeKey))
                {
                    selectedGameType = await GameTypeApiV2.GetByKeyAsync(selectedGameTypeKey);
                }

                RefreshRevisionOptions();
                EnsureRevisionSelected();
                EnsureSettingsInitialized();
                EnsurePortsInitialized();
                await CheckPortAvailabilityAsync();
                TriggerLiveValidation();
                return;
            }

            gameTypes.AddRange(await GameTypeApiV2.GetListAsync(includeInactive: true));
            await LoadMountTypesAsync();
            selectedGameTypeKey = null;
            selectedGameType = null;
            draft = new GameServerEditorDraft
            {
                ServerId = Guid.NewGuid().ToString("N")
            };

            RefreshRevisionOptions();
            EnsureRevisionSelected();
            EnsureSettingsInitialized();
            EnsurePortsInitialized();
            await CheckPortAvailabilityAsync();
            TriggerLiveValidation();
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Load failed", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnGameTypeChanged(string? value)
    {
        selectedGameTypeKey = value;
        selectedGameType = string.IsNullOrWhiteSpace(value)
            ? null
            : await GameTypeApiV2.GetByKeyAsync(value);

        draft.GameTypeRevisionId = 0;
        draft.SettingValues.Clear();
        validationResult = null;
        deploymentPreview = null;
        RefreshRevisionOptions();
        EnsureRevisionSelected();
        EnsureSettingsInitialized();
        EnsurePortsInitialized();
        await CheckPortAvailabilityAsync();
        TriggerLiveValidation();
    }

    private async Task OnRevisionChanged(int? revisionId)
    {
        draft.GameTypeRevisionId = revisionId ?? 0;
        validationResult = null;
        deploymentPreview = null;
        EnsureSettingsInitialized();
        EnsurePortsInitialized();
        await CheckPortAvailabilityAsync();
        TriggerLiveValidation();
    }

    private void RefreshRevisionOptions()
    {
        availableRevisions.Clear();
        if (selectedGameType is null)
        {
            return;
        }

        availableRevisions.AddRange(selectedGameType.Revisions
            .OrderByDescending(revision => revision.CreatedAt)
            .Select(revision => new RevisionOption(revision.Id, BuildRevisionLabel(revision))));
    }

    private void EnsureRevisionSelected()
    {
        if (draft.GameTypeRevisionId > 0 && availableRevisions.Any(option => option.Id == draft.GameTypeRevisionId))
        {
            return;
        }

        draft.GameTypeRevisionId = selectedGameType?.CurrentRevisionId
            ?? availableRevisions.FirstOrDefault()?.Id
            ?? 0;
    }

    private void EnsureSettingsInitialized()
    {
        foreach (var definition in CurrentSettingDefinitions)
        {
            if (!draft.SettingValues.ContainsKey(definition.SettingKey))
            {
                draft.SettingValues[definition.SettingKey] = definition.DefaultValue;
            }
        }

        var validKeys = CurrentSettingDefinitions.Select(definition => definition.SettingKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var key in draft.SettingValues.Keys.Where(key => !validKeys.Contains(key)).ToList())
        {
            draft.SettingValues.Remove(key);
        }
    }

    private void EnsurePortsInitialized()
    {
        publishedPortSelections.Clear();
        originalPublishedPorts.Clear();
        portAvailability.Clear();

        foreach (var port in CurrentRevisionPorts)
        {
            var savedPort = initialServerPorts?.FirstOrDefault(p =>
                p.ContainerPort == port.ContainerPort && string.Equals(p.Protocol, port.Protocol, StringComparison.OrdinalIgnoreCase));

            publishedPortSelections[port.Id] = (savedPort != null && savedPort.PublishedPort > 0)
                ? savedPort.PublishedPort
                : (TryGetPortSettingValue(port) ?? port.ContainerPort);
            originalPublishedPorts[port.Id] = publishedPortSelections[port.Id];
        }

        RecalculateAutoPortsFromAll();
        SyncPortSettingsFromPublishedPorts();
    }

    /// <summary>
    /// Returns the port-type setting definition whose primary direct mapping targets the port.
    /// </summary>
    private GameTypeSettingDefinition? FindPrimarySettingForPort(GameTypePort port)
    {
        return CurrentSettingDefinitions.FirstOrDefault(definition =>
            definition.Metadata?.PortMappings.Any(mapping =>
                mapping.TargetContainerPort == port.ContainerPort
                && string.Equals(mapping.TargetProtocol, port.Protocol, StringComparison.OrdinalIgnoreCase)
                && (string.Equals(mapping.RelationType, "Direct", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(mapping.MappingRole, "Primary", StringComparison.OrdinalIgnoreCase))) == true)
            ?? CurrentSettingDefinitions.FirstOrDefault(definition =>
                string.Equals(definition.Metadata?.DataType, "port", StringComparison.OrdinalIgnoreCase)
                && (definition.Metadata?.PortMappings == null || definition.Metadata.PortMappings.Count == 0)
                && int.TryParse(definition.DefaultValue, out var defPort)
                && defPort == port.ContainerPort)
            ?? CurrentSettingDefinitions.FirstOrDefault(definition =>
                (definition.Metadata?.PortMappings == null || definition.Metadata.PortMappings.Count == 0)
                && int.TryParse(definition.DefaultValue, out var defPort2)
                && defPort2 == port.ContainerPort)
            ?? CurrentSettingDefinitions.FirstOrDefault(definition =>
                string.Equals(definition.Metadata?.DataType, "port", StringComparison.OrdinalIgnoreCase)
                && (definition.Metadata?.PortMappings == null || definition.Metadata.PortMappings.Count == 0));
    }

    private int? TryGetPortSettingValue(GameTypePort port)
    {
        var definition = FindPrimarySettingForPort(port);
        if (definition is null)
        {
            return null;
        }

        var value = draft.SettingValues.TryGetValue(definition.SettingKey, out var stored) ? stored : definition.DefaultValue;
        return int.TryParse(value, out var parsed) && parsed is > 0 and <= 65535 ? parsed : null;
    }

    /// <summary>
    /// Pushes the current published port values back into the port-type settings that own them
    /// so the saved request and the deployment preview reflect the edited ports.
    /// </summary>
    private void SyncPortSettingsFromPublishedPorts()
    {
        foreach (var port in CurrentRevisionPorts)
        {
            var definition = FindPrimarySettingForPort(port);
            if (definition is null)
            {
                continue;
            }

            draft.SettingValues[definition.SettingKey] =
                GetPublishedPort(port).ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private int GetPublishedPort(GameTypePort port)
    {
        return publishedPortSelections.TryGetValue(port.Id, out var published) ? published : port.ContainerPort;
    }

    private async Task OnPublishedPortChanged(GameTypePort port, int value)
    {
        if (value <= 0 || value > 65535)
        {
            return;
        }

        publishedPortSelections[port.Id] = value;
        RecalculateAutoPortsFrom(port);
        SyncPortSettingsFromPublishedPorts();
        await CheckPortAvailabilityAsync();
        TriggerLiveValidation();
    }

    private bool IsAutoCalculatedPort(GameTypePort port)
    {
        // A port is auto-calculated if any setting has a Related (non-Primary) port mapping
        // targeting this container port with an Offset, Fixed, or Multiplier relation.
        return CurrentSettingDefinitions.Any(def =>
            def.Metadata?.PortMappings.Any(pm =>
                pm.TargetContainerPort == port.ContainerPort
                && string.Equals(pm.TargetProtocol, port.Protocol, StringComparison.OrdinalIgnoreCase)
                && (string.Equals(pm.MappingRole, "Related", StringComparison.OrdinalIgnoreCase)
                    || (!string.Equals(pm.RelationType, "Direct", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(pm.RelationType)))
            ) == true);
    }

    private void RecalculateAutoPortsFromAll()
    {
        foreach (var port in CurrentRevisionPorts)
        {
            if (!IsAutoCalculatedPort(port))
            {
                RecalculateAutoPortsFrom(port);
            }
        }
    }

    private void RecalculateAutoPortsFrom(GameTypePort sourcePort)
    {
        // Find all settings that have a Direct/Primary mapping to this port,
        // then recalculate any Related offset/multiplier ports from the same setting.
        var sourcePublished = GetPublishedPort(sourcePort);

        foreach (var definition in CurrentSettingDefinitions)
        {
            var portMappings = definition.Metadata?.PortMappings;
            if (portMappings is null || portMappings.Count == 0)
            {
                continue;
            }

            // Check if this setting has a Direct/Primary mapping to the source port
            var primaryMapping = portMappings.FirstOrDefault(pm =>
                pm.TargetContainerPort == sourcePort.ContainerPort
                && string.Equals(pm.TargetProtocol, sourcePort.Protocol, StringComparison.OrdinalIgnoreCase)
                && (string.Equals(pm.RelationType, "Direct", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(pm.MappingRole, "Primary", StringComparison.OrdinalIgnoreCase)));

            if (primaryMapping is null)
            {
                continue;
            }

            // Now recalculate all related (non-Direct) ports in this setting
            foreach (var relatedMapping in portMappings.Where(pm =>
                !string.Equals(pm.RelationType, "Direct", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(pm.MappingRole, "Primary", StringComparison.OrdinalIgnoreCase)))
            {
                var targetPort = CurrentRevisionPorts.FirstOrDefault(p =>
                    p.ContainerPort == relatedMapping.TargetContainerPort
                    && string.Equals(p.Protocol, relatedMapping.TargetProtocol, StringComparison.OrdinalIgnoreCase));

                if (targetPort is null)
                {
                    continue;
                }

                var calculated = relatedMapping.RelationType switch
                {
                    "Offset" => sourcePublished + (relatedMapping.CalculationValue ?? 0),
                    "Multiplier" => sourcePublished * (relatedMapping.CalculationValue ?? 1),
                    "Fixed" => relatedMapping.CalculationValue ?? targetPort.ContainerPort,
                    _ => targetPort.ContainerPort
                };

                publishedPortSelections[targetPort.Id] = Math.Clamp(calculated, 1, 65535);
            }
        }
    }

    private IEnumerable<IGrouping<string, GameTypeSettingDefinition>> GetSettingCategories()
    {
        return CurrentSettingDefinitions
            .OrderBy(definition => definition.Metadata?.Category ?? "General", StringComparer.OrdinalIgnoreCase)
            .ThenBy(definition => definition.DisplayOrder)
            .ThenBy(definition => definition.SettingKey, StringComparer.OrdinalIgnoreCase)
            .GroupBy(definition => string.IsNullOrWhiteSpace(definition.Metadata?.Category) ? "General" : definition.Metadata!.Category!, StringComparer.OrdinalIgnoreCase);
    }

    private string? GetSettingValue(GameTypeSettingDefinition definition)
    {
        ArgumentNullException.ThrowIfNull(definition);
        return draft.SettingValues.TryGetValue(definition.SettingKey, out var value) ? value : definition.DefaultValue;
    }

    private async Task SetSettingValue(string settingKey, string? value)
    {
        if (string.IsNullOrWhiteSpace(settingKey))
        {
            return;
        }

        draft.SettingValues[settingKey] = value;

        // A port typed on the Settings tab must drive the same recalculation and availability
        // pipeline as the Port Mappings panel so both views stay consistent.
        var port = FindPortForSetting(settingKey);
        if (port is not null && int.TryParse(value, out var parsedPort) && parsedPort is > 0 and <= 65535)
        {
            publishedPortSelections[port.Id] = parsedPort;
            RecalculateAutoPortsFrom(port);
            SyncPortSettingsFromPublishedPorts();
            await CheckPortAvailabilityAsync();
        }

        TriggerLiveValidation();
    }

    /// <summary>
    /// Finds the revision port whose primary direct mapping belongs to the given setting.
    /// </summary>
    private GameTypePort? FindPortForSetting(string settingKey)
    {
        var definition = CurrentSettingDefinitions.FirstOrDefault(candidate =>
            string.Equals(candidate.SettingKey, settingKey, StringComparison.OrdinalIgnoreCase));

        if (definition is null)
        {
            return null;
        }

        var primaryMapping = definition.Metadata?.PortMappings.FirstOrDefault(mapping =>
            string.Equals(mapping.RelationType, "Direct", StringComparison.OrdinalIgnoreCase)
            || string.Equals(mapping.MappingRole, "Primary", StringComparison.OrdinalIgnoreCase));

        if (primaryMapping is not null)
        {
            return CurrentRevisionPorts.FirstOrDefault(port =>
                port.ContainerPort == primaryMapping.TargetContainerPort
                && string.Equals(port.Protocol, primaryMapping.TargetProtocol, StringComparison.OrdinalIgnoreCase));
        }

        if (string.Equals(definition.Metadata?.DataType, "port", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(definition.DefaultValue, out var defPort))
        {
            return CurrentRevisionPorts.FirstOrDefault(port => port.ContainerPort == defPort);
        }

        return null;
    }

    /// <summary>
    /// Checks availability for all published ports against active servers and allocation rules.
    /// Ensures that even default port values are validated immediately upon loading/selecting.
    /// </summary>
    private async Task CheckPortAvailabilityAsync()
    {
        var token = ++portCheckToken;

        var portsToCheck = CurrentRevisionPorts.ToList();
        if (portsToCheck.Count == 0)
        {
            portAvailability.Clear();
            return;
        }

        try
        {
            isCheckingPorts = true;
            var result = await GameServerApiV2.CheckPortAvailabilityAsync(new GameServerPortAvailabilityRequest
            {
                ServerId = isEditMode ? ServerId : draft.ServerId,
                Ports = portsToCheck
                    .Select(port => new GameServerPortAvailabilityRequestPort
                    {
                        PortId = port.Id,
                        Port = GetPublishedPort(port),
                        Protocol = port.Protocol
                    })
                    .ToList()
            });

            // Ignore responses superseded by a newer edit.
            if (token != portCheckToken)
            {
                return;
            }

            portAvailability.Clear();
            foreach (var entry in result.Ports)
            {
                portAvailability[entry.PortId] = entry;
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Port check failed", ex.Message);
        }
        finally
        {
            if (token == portCheckToken)
            {
                isCheckingPorts = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private GameServerPortAvailability? GetPortAvailability(GameTypePort port)
    {
        return portAvailability.TryGetValue(port.Id, out var availability) ? availability : null;
    }

    /// <summary>
    /// Returns the availability message for the setting that owns a port, used to surface
    /// port conflicts inline on the Settings tab.
    /// </summary>
    private string? GetSettingValidationMessage(GameTypeSettingDefinition definition)
    {
        var port = FindPortForSetting(definition.SettingKey);
        if (port is null)
        {
            return null;
        }

        var availability = GetPortAvailability(port);
        return availability is null || availability.IsAvailable ? null : availability.Reason;
    }

    private bool HasUnavailablePort => portAvailability.Values.Any(availability => !availability.IsAvailable);

    private CancellationTokenSource? liveValidationCts;

    private void TriggerLiveValidation()
    {
        liveValidationCts?.Cancel();
        liveValidationCts?.Dispose();
        liveValidationCts = new CancellationTokenSource();
        var token = liveValidationCts.Token;

        _ = RunLiveValidationAsync(token);
    }

    private async Task RunLiveValidationAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(300, token);

            if (draft.GameTypeRevisionId <= 0)
            {
                validationResult = null;
                deploymentPreview = null;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var request = BuildSaveRequest();
            var valTask = GameServerApiV2.ValidateAsync(request, token);
            var prevTask = GameServerApiV2.PreviewAsync(request, token);

            await Task.WhenAll(valTask, prevTask);

            if (token.IsCancellationRequested)
            {
                return;
            }

            validationResult = await valTask;
            deploymentPreview = await prevTask;

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Expected during continuous user input
        }
        catch (Exception ex)
        {
            Logger?.LogDebug(ex, "Live validation failed");
        }
    }

    private async Task ValidateAsync()
    {
        try
        {
            validationResult = await GameServerApiV2.ValidateAsync(BuildSaveRequest());
            selectedTabIndex = 1;
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Validation failed", ex.Message);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            isSaving = true;
            validationResult = await GameServerApiV2.ValidateAsync(BuildSaveRequest());
            if (!validationResult.IsValid)
            {
                NotificationService.NotifyTimed(NotificationSeverity.Warning, "Validation failed", "Resolve the blocking validation issues before saving.");
                selectedTabIndex = 1;
                return;
            }

            var result = isEditMode
                ? await GameServerApiV2.UpdateAsync(ServerId!, BuildSaveRequest())
                : await GameServerApiV2.CreateAsync(BuildSaveRequest());

            NotificationService.NotifyTimed(NotificationSeverity.Success, isEditMode ? "Server updated" : "Server created", $"'{result.Name}' was saved successfully.");
            Navigation.NavigateTo($"/gameservers-v2/{Uri.EscapeDataString(result.ServerId)}");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private SaveGameServerRequest BuildSaveRequest()
    {
        SyncPortSettingsFromPublishedPorts();

        return new SaveGameServerRequest
        {
            ServerId = isEditMode ? ServerId : draft.ServerId,
            Name = draft.Name,
            Description = draft.Description,
            GameTypeRevisionId = draft.GameTypeRevisionId,
            ServiceName = string.IsNullOrWhiteSpace(ComputedServiceName) ? null : ComputedServiceName,
            Status = string.IsNullOrWhiteSpace(draft.Status) ? null : draft.Status,
            Ports = CurrentRevisionPorts
                .Select(port => new GameServerPort
                {
                    ContainerPort = port.ContainerPort,
                    Protocol = port.Protocol,
                    PublishedPort = GetPublishedPort(port)
                })
                .ToList(),
            Settings = CurrentSettingDefinitions
                .Select(definition => new GameServerSetting
                {
                    SettingKey = definition.SettingKey,
                    Value = draft.SettingValues.TryGetValue(definition.SettingKey, out var value) ? value : definition.DefaultValue
                })
                .ToList(),
            VolumeBindingLayout = "per-volume",
            NetworkOptions = []
        };
    }

    private string GetVolumeMountType(GameTypeVolume volume)
    {
        return volumeMountTypeSelections.TryGetValue(volume.Id, out var selected) ? selected : volume.MountType;
    }

    private void SetVolumeMountType(GameTypeVolume volume, string? value)
    {
        volumeMountTypeSelections[volume.Id] = value ?? volume.MountType;
        TriggerLiveValidation();
    }

    private void OnServerNameInput(string? value)
    {
        draft.Name = value ?? string.Empty;
        TriggerLiveValidation();
        StateHasChanged();
    }

    private void OnServerNameChanged(string value)
    {
        draft.Name = value ?? string.Empty;
        TriggerLiveValidation();
        StateHasChanged();
    }

    private void OnDescriptionInput(string? value)
    {
        draft.Description = value;
        TriggerLiveValidation();
        StateHasChanged();
    }

    private void OnDescriptionChanged(string? value)
    {
        draft.Description = value;
        TriggerLiveValidation();
        StateHasChanged();
    }

    private string? ComputeVolumeName(GameTypeVolume volume)
    {
        var mountTypeKey = GetVolumeMountType(volume);
        var config = mountTypeOptions.FirstOrDefault(m => string.Equals(m.Key, mountTypeKey, StringComparison.OrdinalIgnoreCase));
        if (config is null || string.IsNullOrWhiteSpace(config.VolumeNameFormat))
        {
            return null;
        }

        var serverName = !string.IsNullOrWhiteSpace(draft.Name)
            ? draft.Name
            : "<server-name>";

        var serviceName = !string.IsNullOrWhiteSpace(ComputedServiceName)
            ? ComputedServiceName
            : !string.IsNullOrWhiteSpace(draft.Name)
                ? draft.Name.Replace(' ', '-').ToLowerInvariant()
                : "<service-name>";

        return config.VolumeNameFormat
            .Replace("{ServiceName}", serviceName, StringComparison.OrdinalIgnoreCase)
            .Replace("{gameTypeKey}", selectedGameTypeKey ?? "<game-type-key>", StringComparison.OrdinalIgnoreCase)
            .Replace("{serverId}", string.IsNullOrWhiteSpace(draft.ServerId) ? "<server-id>" : draft.ServerId, StringComparison.OrdinalIgnoreCase)
            .Replace("{serverName}", serverName.Replace(' ', '-').ToLowerInvariant(), StringComparison.OrdinalIgnoreCase)
            .Replace("{Name}", serverName, StringComparison.OrdinalIgnoreCase)
            .Replace("{Usage}", volume.Usage, StringComparison.OrdinalIgnoreCase)
            .Replace("{Source}", NormalizeSourceToken(volume.Source), StringComparison.OrdinalIgnoreCase)
            .Replace("{MountType}", mountTypeKey, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeSourceToken(string containerSource)
    {
        var value = (containerSource ?? string.Empty).Replace('\\', '/').Trim('/');
        return value.Replace('/', '-');
    }

    private async Task DeleteServerAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId))
        {
            return;
        }

        try
        {
            isSaving = true;
            operationTitle = "Deleting Server...";
            operationSubtitle = "Removing GameServer definition...";
            await GameServerApiV2.DeleteAsync(ServerId);
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Deleted", $"Server '{draft.Name}' was deleted.");
            Navigation.NavigateTo("/gameservers-v2");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Delete failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private static BadgeStyle GetStatusBadgeStyle(string? status)
    {
        var normalized = status?.Trim().ToLowerInvariant().Replace("-", "");
        return normalized switch
        {
            "running" or "available" => BadgeStyle.Success,
            "preparing" or "starting" => BadgeStyle.Info,
            "stopped" or "deleted" or "failed" => BadgeStyle.Danger,
            "stopping" or "scalingdown" => BadgeStyle.Warning,
            _ => BadgeStyle.Secondary
        };
    }

    private async Task LoadMountTypesAsync()
    {
        try
        {
            mountTypeOptions.Clear();
            var configs = await MountTypeConfigApi.GetAllAsync();
            mountTypeOptions.AddRange(configs);
        }
        catch (HttpRequestException)
        {
            // Mount types will remain empty; user can still proceed.
        }
    }

    private void GoBack()
    {
        if (isEditMode && !string.IsNullOrWhiteSpace(ServerId))
        {
            Navigation.NavigateTo($"/gameservers-v2/{Uri.EscapeDataString(ServerId)}");
            return;
        }

        Navigation.NavigateTo("/gameservers-v2");
    }

    private async Task LoadDeploymentPreviewAsync()
    {
        if (draft.GameTypeRevisionId <= 0)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Warning, "Preview unavailable", "Select a game type and revision first.");
            return;
        }

        try
        {
            isPreviewLoading = true;
            deploymentPreview = await GameServerApiV2.PreviewAsync(BuildSaveRequest());
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Preview failed", ex.Message);
        }
        finally
        {
            isPreviewLoading = false;
        }
    }

    private async Task OnSelectedTabChanged(int index)
    {
        selectedTabIndex = index;
        if (index == 1)
        {
            await LoadDeploymentPreviewAsync();
        }
    }

    private static string BuildRevisionLabel(GameTypeRevision revision)
    {
        ArgumentNullException.ThrowIfNull(revision);
        return string.IsNullOrWhiteSpace(revision.VersionTag)
            ? $"Revision {revision.Id}"
            : $"{revision.VersionTag} ({revision.ImageReference})";
    }

    public ValueTask DisposeAsync()
    {
        liveValidationCts?.Cancel();
        liveValidationCts?.Dispose();
        return ValueTask.CompletedTask;
    }

