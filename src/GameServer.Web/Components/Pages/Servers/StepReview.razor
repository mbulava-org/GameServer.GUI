@using GameServer.Docker.Client;

<h4>Review Server</h4>

<ul>
    <li><strong>Name:</strong> @Server.Name</li>
    <li><strong>Description:</strong> @Server.Description</li>
    <li><strong>Game Type:</strong> @Definition.DisplayName</li>
</ul>

<h5>Settings</h5>
<ul>
    @foreach (var kvp in Server.Settings)
    {
        <li><strong>@kvp.Key:</strong> @kvp.Value</li>
    }
</ul>

<h5>Lists</h5>
<div class="mt-3">
    <button class="btn btn-secondary me-2" @onclick="OnBack">Back</button>
    <button class="btn btn-success" @onclick="OnCreate">Create Server</button>
</div>

@code {
    [Parameter]
    public GameTypeDefinition Definition { get; set; } = new();
    [Parameter]
    public GameServer Server { get; set; } = new();
    [Parameter]
    public EventCallback OnCreate { get; set; }
    [Parameter]
    public EventCallback OnBack { get; set; }
}
