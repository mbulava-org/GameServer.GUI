@using Radzen
@using Radzen.Blazor
@using GameServer.Docker.Client
@using System.Text
@inject IGameServerApi ServerApi
@inject NotificationService NotificationService
@inject DialogService DialogService

<div class="file-editor-dialog">
  <div class="editor-header">
    <div class="file-info">
      <RadzenIcon Icon="description" />
      <span class="file-name">@FileName</span>
      <RadzenBadge Text="@FormatFileSize(FileSize)" BadgeStyle="BadgeStyle.Secondary" />
    </div>
    <div class="editor-actions">
      <RadzenCheckBox @bind-Value="wordWrap" />
      <RadzenLabel Text="Word Wrap" class="ms-2" />
    </div>
  </div>

  @if (loading)
  {
    <div class="editor-loading">
      <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
      <span>Loading file content...</span>
    </div>
  }
  else if (isFileTooLarge)
  {
    <div class="editor-error">
      <RadzenIcon Icon="error" Style="font-size: 3rem; color: var(--rz-danger);" />
      <h4 class="mt-3">File Too Large</h4>
      <p>This file is @FormatFileSize(FileSize). Files larger than @FormatFileSize(MaxFileSize) cannot be edited in the browser.</p>
      <p class="text-muted">Please download the file to edit it locally.</p>
    </div>
  }
  else if (!string.IsNullOrEmpty(errorMessage))
  {
    <div class="editor-error">
      <RadzenIcon Icon="error" Style="font-size: 3rem; color: var(--rz-danger);" />
      <h4 class="mt-3">Error Loading File</h4>
      <p>@errorMessage</p>
    </div>
  }
  else
  {
    <div class="editor-content">
      <RadzenTextArea @bind-Value="fileContent" 
                      Style="@GetTextAreaStyle()" 
                      class="file-editor-textarea" 
                      Rows="20" />
    </div>

    <div class="editor-footer">
      <div class="footer-info">
        <span class="text-muted">Lines: @GetLineCount() | Characters: @fileContent.Length</span>
        @if (hasChanges)
        {
          <RadzenBadge Text="Modified" BadgeStyle="BadgeStyle.Warning" class="ms-2" />
        }
      </div>
      <div class="footer-actions">
        <RadzenButton Text="Cancel" 
                      Click="Cancel" 
                      ButtonStyle="ButtonStyle.Light" />
        <RadzenButton Text="Save" 
                      Click="SaveFile" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Disabled="@(!hasChanges || saving)"
                      Icon="@(saving ? "hourglass_empty" : "save")" />
      </div>
    </div>
  }
</div>

@code {
  [Parameter] public string ServerId { get; set; } = "";
  [Parameter] public string VolumeTarget { get; set; } = "";
  [Parameter] public string FilePath { get; set; } = "";
  [Parameter] public string FileName { get; set; } = "";
  [Parameter] public long FileSize { get; set; }

  private const long MaxFileSize = 5 * 1024; // 5KB in bytes
  private string fileContent = "";
  private string originalContent = "";
  private bool loading = true;
  private bool saving = false;
  private bool isFileTooLarge = false;
  private bool hasChanges = false;
  private bool wordWrap = true;
  private string errorMessage = "";

  protected override async Task OnInitializedAsync()
  {
    // Check file size before attempting to load
    if (FileSize > MaxFileSize)
    {
      isFileTooLarge = true;
      loading = false;
      return;
    }

    await LoadFileContent();
  }

  protected override void OnParametersSet()
  {
    // Track changes
    if (!loading && fileContent != originalContent)
    {
      hasChanges = true;
    }
    else
    {
      hasChanges = false;
    }
  }

  private async Task LoadFileContent()
  {
    loading = true;
    errorMessage = "";

    try
    {
      var response = await ServerApi.DownloadFileAsync(ServerId, VolumeTarget, FilePath);
      
      using var memoryStream = new MemoryStream();
      await response.Stream.CopyToAsync(memoryStream);
      var bytes = memoryStream.ToArray();

      // Try to decode as UTF-8 text
      try
      {
        fileContent = Encoding.UTF8.GetString(bytes);
        originalContent = fileContent;
      }
      catch
      {
        // If UTF-8 fails, try other encodings
        try
        {
          fileContent = Encoding.ASCII.GetString(bytes);
          originalContent = fileContent;
        }
        catch
        {
          errorMessage = "This file appears to be binary and cannot be edited as text.";
        }
      }
    }
    catch (Exception ex)
    {
      errorMessage = $"Failed to load file: {ex.Message}";
    }
    finally
    {
      loading = false;
    }
  }

  private async Task SaveFile()
  {
    if (!hasChanges || saving)
    {
      return;
    }

    saving = true;

    try
    {
      var bytes = Encoding.UTF8.GetBytes(fileContent);
      
      using var stream = new MemoryStream(bytes);
      var fileParameter = new FileParameter(stream, FileName);

      await ServerApi.UploadFileAsync(ServerId, VolumeTarget, FilePath, fileParameter);

      originalContent = fileContent;
      hasChanges = false;

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "File Saved",
        Detail = $"{FileName} has been saved successfully.",
        Duration = 3000
      });

      // Close dialog after successful save
      DialogService.Close(true);
    }
    catch (Exception ex)
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Save Failed",
        Detail = $"Failed to save file: {ex.Message}",
        Duration = 5000
      });
    }
    finally
    {
      saving = false;
    }
  }

  private void Cancel()
  {
    if (hasChanges)
    {
      // Could add confirmation dialog here
      var confirmed = DialogService.Confirm("You have unsaved changes. Are you sure you want to close?", "Unsaved Changes");
      if (confirmed != null)
      {
        DialogService.Close(false);
      }
    }
    else
    {
      DialogService.Close(false);
    }
  }

  private int GetLineCount()
  {
    if (string.IsNullOrEmpty(fileContent))
    {
      return 0;
    }

    return fileContent.Split('\n').Length;
  }

  private string GetTextAreaStyle()
  {
    return $"width: 100%; font-family: 'Courier New', monospace; white-space: {(wordWrap ? "pre-wrap" : "pre")};";
  }

  private string FormatFileSize(long bytes)
  {
    if (bytes < 1024)
      return $"{bytes} B";
    else if (bytes < 1024 * 1024)
      return $"{bytes / 1024.0:F2} KB";
    else if (bytes < 1024 * 1024 * 1024)
      return $"{bytes / (1024.0 * 1024.0):F2} MB";
    else
      return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
  }
}

<style>
  .file-editor-dialog {
    display: flex;
    flex-direction: column;
    height: 600px;
    max-height: 80vh;
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid var(--rz-border-color);
  }

  .file-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .file-name {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .editor-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .editor-loading,
  .editor-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 40px;
    text-align: center;
  }

  .editor-content {
    flex: 1;
    overflow: auto;
    padding: 16px;
  }

  .file-editor-textarea {
    width: 100%;
    resize: vertical;
    min-height: 400px;
  }

  .editor-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    border-top: 1px solid var(--rz-border-color);
  }

  .footer-info {
    display: flex;
    align-items: center;
  }

  .footer-actions {
    display: flex;
    gap: 8px;
  }
</style>