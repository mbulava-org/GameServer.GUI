@page "/servers"
@rendermode InteractiveServer
@using global::GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@inject IDashboardApi DashboardApi
@inject IGameTypeApi GameTypeApi
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>Game Servers Dashboard</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Game Servers</h2>
            <p class="text-muted mb-0">Manage and monitor your game servers</p>
        </div>
        <RadzenButton Text="New Server" 
                      Icon="add" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="CreateNewServer" />
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3">Loading servers...</p>
        </div>
    }
    else if (!servers.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="dns" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Servers Found</h4>
                <p class="text-muted">Get started by creating your first game server.</p>
                <RadzenButton Text="Create Server" 
                              Icon="add" 
                              ButtonStyle="ButtonStyle.Primary" 
                              Click="CreateNewServer" 
                              class="mt-3" />
            </div>
        </RadzenCard>
    }
    else
    {
        <div class="row">
            @foreach (var server in servers)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <RadzenCard class="server-card h-100" Style="cursor: pointer;" @onclick="@(() => NavigateToServer(server.ServerId))">
                        <div class="server-card-header">
                            <div class="d-flex align-items-start justify-content-between">
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">@server.Name</h5>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <RadzenBadge BadgeStyle='@GetStatusBadgeStyle(server.IsRunning)' 
                                                     Text='@GetStatusText(server.IsRunning)' />
                                        @if (!string.IsNullOrWhiteSpace(server.ServiceName))
                                        {
                                            <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                                                         Text="@server.ServiceName" 
                                                         Variant="Variant.Outlined" />
                                        }
                                    </div>
                                </div>
                                <RadzenIcon Icon="chevron_right" Style="font-size: 1.5rem; color: var(--rz-text-disabled-color);" />
                            </div>
                        </div>

                        <div class="server-card-body mt-3">
                            @if (!string.IsNullOrWhiteSpace(server.Description))
                            {
                                <p class="text-muted mb-3">@server.Description</p>
                            }

                            <div class="server-info">
                                <div class="info-item">
                                    <RadzenIcon Icon="sports_esports" class="info-icon" />
                                    <div>
                                        <small class="text-muted d-block">Game Type</small>
                                        <span class="fw-semibold">@server.GameType</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(server.Ports))
                                {
                                    <div class="info-item">
                                        <RadzenIcon Icon="settings_ethernet" class="info-icon" />
                                        <div>
                                            <small class="text-muted d-block">Ports</small>
                                            <span class="fw-semibold">@server.Ports</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="server-card-footer mt-auto pt-3 border-top">
                            <small class="text-muted">
                                <RadzenIcon Icon="touch_app" Style="font-size: 0.9rem;" />
                                Click to view details and manage server
                            </small>
                        </div>
                    </RadzenCard>
                </div>
            }
        </div>
    }
</div>

<style>
    .server-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid var(--rz-border-color);
        display: flex;
        flex-direction: column;
    }

    .server-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        border-color: var(--rz-primary);
    }

    .server-card-header h5 {
        color: var(--rz-text-color);
        margin-bottom: 0;
    }

    .server-card-body {
        flex: 1;
    }

    .server-info {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .info-icon {
        font-size: 1.2rem;
        color: var(--rz-primary);
    }

    .server-card-footer {
        text-align: center;
    }

    .server-thumbnail {
        height: 150px;
        width: 100%;
        overflow: hidden;
        border-radius: 8px 8px 0 0;
        margin: -1rem -1rem 0 -1rem;
        position: relative;
    }

    .thumbnail-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .thumbnail-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--rz-base-100);
    }
</style>

@code {
    private List<GameServerDashboardItem> servers = new();
    private List<GameTypeDefinition> gameTypes = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadServersAsync();
    }

    private async Task LoadServersAsync()
    {
        loading = true;
        try
        {
            // Load servers and game types in parallel
            var serversTask = DashboardApi.GetServersAsync();
            var gameTypesTask = GameTypeApi.GetAllAsync();
            
            await Task.WhenAll(serversTask, gameTypesTask);
            
            servers = (await serversTask).ToList();
            gameTypes = (await gameTypesTask).ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Loading Servers",
                Detail = $"Failed to load servers: {ex.Message}",
                Duration = 5000
            });
        }
        finally
        {
            loading = false;
        }
    }

    private void NavigateToServer(string serverId)
    {
        Navigation.NavigateTo($"/servers/{serverId}");
    }

    private void CreateNewServer()
    {
        Navigation.NavigateTo("/servers/new");
    }

    private BadgeStyle GetStatusBadgeStyle(bool isRunning)
    {
        return isRunning ? BadgeStyle.Success : BadgeStyle.Secondary;
    }

    private string GetStatusText(bool isRunning)
    {
        return isRunning ? "● Running" : "○ Stopped";
    }
}
