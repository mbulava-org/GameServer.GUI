@page "/servers"
@rendermode InteractiveServer
@using GameServer.Docker.Client

<PageTitle>Game Servers Dashboard</PageTitle>
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Game Servers</h2>
        <RadzenButton Click=@CreateNewServer Text="New Server" ButtonStyle="ButtonStyle.Primary" />
        @* <button class="btn btn-primary" @onclick="CreateNewServer">New Server</button> *@
    </div>

    @if (Servers.Count == 0)
    {
        <div class="alert alert-info">
            No servers have been created yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var server in Servers)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">

                        <div class="card-body">
                            <h5 class="card-title">@server.Name</h5>
                            <p class="card-text text-muted">@server.Description</p>

                            <div class="mb-2">
                                <strong>Game:</strong> @server.GameType
                            </div>

                            <div class="mb-2">
                                <strong>Status:</strong>
                                <span class="badge @(server.IsRunning ? "bg-success" : "bg-secondary")">
                                    @(server.IsRunning ? "Running" : "Stopped")
                                </span>
                            </div>
@* 
                            <ul class="list-unstyled small">
                                <li><strong>Port:</strong> @server.Port</li>
                                <li><strong>Version:</strong> @server.Version</li>
                            </ul>
 *@
                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-success btn-sm"
                                        @onclick="() => StartServer(server)"
                                        disabled="@server.IsRunning">
                                    Start
                                </button>

                                <button class="btn btn-warning btn-sm"
                                        @onclick="() => RestartServer(server)"
                                        disabled="@(!server.IsRunning)">
                                    Restart
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => StopServer(server)"
                                        disabled="@(!server.IsRunning)">
                                    Stop
                                </button>
                            </div>

                            <div class="mt-3">
                                <a class="btn btn-outline-primary btn-sm w-100"
                                   href="/servers/edit/@server.ServerId">
                                    Edit Configuration
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    protected List<GameServerDashboardItem> Servers { get; set; } = new();

    [Inject] public IDashboardApi Api { get; set; } = default!;
    [Inject] public NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetServersAsync();
        Servers = data.ToList();
    }

    protected async Task StartServer(GameServerDashboardItem server)
    {
        await Api.StartAsync(server.ServerId);
        server.IsRunning = true;
        StateHasChanged();
    }

    protected async Task StopServer(GameServerDashboardItem server)
    {
        await Api.StopAsync(server.ServerId);
        server.IsRunning = false;
        StateHasChanged();
    }

    protected async Task RestartServer(GameServerDashboardItem server)
    {
        await Api.RestartAsync(server.ServerId);
        server.IsRunning = true;
        StateHasChanged();
    }

    protected void CreateNewServer()
    {
        Nav.NavigateTo("/servers/new");
    }

}
