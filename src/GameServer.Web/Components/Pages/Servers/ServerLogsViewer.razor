@using Microsoft.AspNetCore.SignalR.Client
@using Radzen
@using Radzen.Blazor
@using GameServer.Docker.Client
@using GameServer.Docker.Client.Interfaces
@using GameServer.Docker.Client.Services
@using System.Text
@inject IConfiguration Configuration
@inject NotificationService NotificationService
@inject ILoggerFactory LoggerFactory
@implements IAsyncDisposable

<div class="logs-viewer">
  <div class="logs-toolbar">
    <div class="toolbar-left">
      <RadzenButton Icon='@(isStreaming ? "pause" : "play_arrow")' 
                    Text='@(isStreaming ? "Pause" : "Stream Logs")' 
                    Click="ToggleStreaming" 
                    ButtonStyle='@(isStreaming ? ButtonStyle.Warning : ButtonStyle.Success)' />
      <RadzenButton Icon="refresh" Text="Refresh" Click="RefreshLogs" Disabled="@isStreaming" />
      <RadzenButton Icon="delete_sweep" Text="Clear" Click="ClearLogs" ButtonStyle="ButtonStyle.Secondary" />
    </div>
    <div class="toolbar-right">
      <RadzenCheckBox @bind-Value="autoScroll" />
      <RadzenLabel Text="Auto-scroll" class="ml-2" />
      <RadzenNumeric @bind-Value="maxLines" Min="100" Max="10000" Step="100" class="ml-3" Style="width:120px" />
      <RadzenLabel Text="Max Lines" class="ml-2" />
      <RadzenNumeric @bind-Value="tailLines" Min="10" Max="1000" Step="10" class="ml-3" Style="width:120px" />
      <RadzenLabel Text="Tail Lines" class="ml-2" />
      <RadzenButton Icon="download" Text="Download" Click="DownloadLogs" ButtonStyle="ButtonStyle.Light" />
    </div>
  </div>

  <div class="logs-filter">
    <RadzenTextBox @bind-Value="filterText" Placeholder="Filter logs..." class="filter-input" />
    <RadzenDropDown Data="logLevels" @bind-Value="selectedLogLevel" AllowClear="true" Placeholder="All Levels" class="ml-2" Style="width:150px" />
  </div>

  <div class="logs-content" @ref="logsContentRef">
    @if (loadingLogs)
    {
      <div class="loading-indicator">
        <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
        <span>Loading logs...</span>
      </div>
    }
    else if (!logLines.Any())
    {
      <div class="no-logs">No logs available</div>
    }
    else
    {
      <div class="log-lines">
        @foreach (var line in GetFilteredLogs())
        {
          <div class='@GetLogLineClass(line)'>
            <span class="log-timestamp">@line.Timestamp.ToString("HH:mm:ss.fff")</span>
            <span class="log-level">[@line.Level]</span>
            <span class="log-message">@line.Message</span>
          </div>
        }
      </div>
    }
  </div>

  <div class="logs-footer">
    <span>Total: @logLines.Count lines | Filtered: @GetFilteredLogs().Count() lines</span>
    @if (isStreaming)
    {
      <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="● Live" />
    }
    else if (logsClient?.State == ConnectionState.Connected)
    {
      <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="● Connected" />
    }
    else if (logsClient?.State == ConnectionState.Connecting || logsClient?.State == ConnectionState.Reconnecting)
    {
      <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="● Connecting..." />
    }
    else
    {
      <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="● Disconnected" />
    }
  </div>
</div>

@code {
  [Parameter] public string ServerId { get; set; } = "";
  [Parameter] public GameServer Server { get; set; } = new();

  class LogLine
  {
    public DateTime Timestamp { get; set; }
    public string Level { get; set; } = "INFO";
    public string Message { get; set; } = "";
  }

  private IServerLogsClient? logsClient;
  private List<LogLine> logLines = new();
  private bool loadingLogs = false;
  private bool isStreaming = false;
  private bool autoScroll = true;
  private int maxLines = 10000;
  private int tailLines = 100;
  private string filterText = "";
  private string? selectedLogLevel;
  private readonly string[] logLevels = ["DEBUG", "INFO", "WARN", "ERROR", "FATAL"];
  private ElementReference logsContentRef;

  protected override void OnInitialized()
  {
    InitializeLogsClient();
  }

  protected override async Task OnParametersSetAsync()
  {
    // Recreate client if server ID changes
    if (logsClient != null && isStreaming)
    {
      await StopStreaming();
      logLines.Clear();
      InitializeLogsClient();
    }
  }

  private void InitializeLogsClient()
  {
    if (string.IsNullOrWhiteSpace(ServerId))
    {
      return;
    }

    var apiBaseUrl = Configuration["GameServerDockerApi:BaseUri"]?.TrimEnd('/') ?? "http://localhost:5164";
    var hubUrl = $"{apiBaseUrl}/hubs/logs";

    logsClient = new ServerLogsClient(
      hubUrl,
      builder => builder
        .WithAutomaticReconnect(new[] 
        { 
          TimeSpan.Zero, 
          TimeSpan.FromSeconds(2), 
          TimeSpan.FromSeconds(5), 
          TimeSpan.FromSeconds(10) 
        }),
      LoggerFactory.CreateLogger<ServerLogsClient>());

    // Wire up events
    logsClient.LogLine += OnLogLineReceived;
    logsClient.LogError += OnLogErrorReceived;
    logsClient.LogsStarted += OnLogsStarted;
    logsClient.LogsEnded += OnLogsEnded;
    logsClient.LogsStopped += OnLogsStopped;
    logsClient.StateChanged += OnStateChanged;
  }

  private async Task ToggleStreaming()
  {
    if (isStreaming)
    {
      await StopStreaming();
    }
    else
    {
      await StartStreaming();
    }
  }

  private async Task StartStreaming()
  {
    if (string.IsNullOrWhiteSpace(ServerId))
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Warning,
        Summary = "Invalid Server",
        Detail = "Server ID is required",
        Duration = 3000
      });
      return;
    }

    if (logsClient == null)
    {
      InitializeLogsClient();
    }

    if (logsClient == null)
    {
      return;
    }

    try
    {
      loadingLogs = true;

      // Connect to the hub if not already connected
      if (logsClient.State != ConnectionState.Connected)
      {
        await logsClient.ConnectAsync();
      }

      // Start streaming logs
      await logsClient.StartLogsAsync(
        serverId: ServerId,
        follow: true,
        tail: tailLines,
        timestamps: true);

      isStreaming = true;

      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Success,
        Summary = "Connected",
        Detail = "Live log streaming started",
        Duration = 3000
      });
    }
    catch (Exception ex)
    {
      isStreaming = false;
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Connection Error",
        Detail = $"Failed to start log streaming: {ex.Message}",
        Duration = 5000
      });
    }
    finally
    {
      loadingLogs = false;
    }
  }

  private void OnLogLineReceived(object? sender, string line)
  {
    var logLine = ParseLogLine(line);

    InvokeAsync(() =>
    {
      logLines.Add(logLine);

      while (logLines.Count > maxLines)
      {
        logLines.RemoveAt(0);
      }

      StateHasChanged();
    });
  }

  private void OnLogErrorReceived(object? sender, string error)
  {
    InvokeAsync(() =>
    {
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Log Error",
        Detail = error,
        Duration = 5000
      });
      StateHasChanged();
    });
  }

  private void OnLogsStarted(object? sender, string serverId)
  {
    InvokeAsync(() =>
    {
      logLines.Add(new LogLine
      {
        Timestamp = DateTime.Now,
        Level = "INFO",
        Message = $"Log streaming started for server: {serverId}"
      });
      StateHasChanged();
    });
  }

  private void OnLogsEnded(object? sender, EventArgs e)
  {
    InvokeAsync(() =>
    {
      isStreaming = false;
      logLines.Add(new LogLine
      {
        Timestamp = DateTime.Now,
        Level = "INFO",
        Message = "Log streaming ended"
      });
      StateHasChanged();
    });
  }

  private void OnLogsStopped(object? sender, EventArgs e)
  {
    InvokeAsync(() =>
    {
      isStreaming = false;
      logLines.Add(new LogLine
      {
        Timestamp = DateTime.Now,
        Level = "INFO",
        Message = "Log streaming stopped"
      });
      StateHasChanged();
    });
  }

  private void OnStateChanged(object? sender, ConnectionState state)
  {
    InvokeAsync(() =>
    {
      StateHasChanged();
    });
  }

  private async Task StopStreaming()
  {
    if (logsClient != null && isStreaming)
    {
      try
      {
        await logsClient.StopLogsAsync();
      }
      catch (Exception ex)
      {
        NotificationService.Notify(new NotificationMessage
        {
          Severity = NotificationSeverity.Warning,
          Summary = "Stop Warning",
          Detail = $"Error stopping stream: {ex.Message}",
          Duration = 3000
        });
      }
    }

    isStreaming = false;
  }

  private async Task RefreshLogs()
  {
    if (isStreaming)
    {
      // Stop current stream
      await StopStreaming();
    }

    logLines.Clear();

    // Restart with fresh logs
    await StartStreaming();
  }

  private void ClearLogs() => logLines.Clear();

  private Task DownloadLogs()
  {
    var content = string.Join(Environment.NewLine, logLines.Select(l =>
      $"[{l.Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{l.Level}] {l.Message}"));

    NotificationService.Notify(new NotificationMessage
    {
      Severity = NotificationSeverity.Info,
      Summary = "Download",
      Detail = $"{logLines.Count} lines ready for download",
      Duration = 3000
    });

    return Task.CompletedTask;
  }

  private LogLine ParseLogLine(string message)
  {
    var line = new LogLine { Timestamp = DateTime.Now, Message = message };
    var lower = message.ToLowerInvariant();

    line.Level = lower switch
    {
      _ when lower.Contains("[error]") || lower.Contains("error:") => "ERROR",
      _ when lower.Contains("[warn]") || lower.Contains("warning:") => "WARN",
      _ when lower.Contains("[debug]") => "DEBUG",
      _ when lower.Contains("[fatal]") => "FATAL",
      _ => "INFO"
    };

    return line;
  }

  private IEnumerable<LogLine> GetFilteredLogs()
  {
    var filtered = logLines.AsEnumerable();

    if (!string.IsNullOrWhiteSpace(filterText))
      filtered = filtered.Where(l => l.Message.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    if (!string.IsNullOrWhiteSpace(selectedLogLevel))
      filtered = filtered.Where(l => l.Level == selectedLogLevel);

    return filtered;
  }

  private string GetLogLineClass(LogLine line) => line.Level.ToLowerInvariant() switch
  {
    "error" or "fatal" => "log-line log-line-error",
    "warn" => "log-line log-line-warning",
    "debug" => "log-line log-line-debug",
    _ => "log-line log-line-info"
  };

  public async ValueTask DisposeAsync()
  {
    if (logsClient != null)
    {
      // Unwire events
      logsClient.LogLine -= OnLogLineReceived;
      logsClient.LogError -= OnLogErrorReceived;
      logsClient.LogsStarted -= OnLogsStarted;
      logsClient.LogsEnded -= OnLogsStopped;
      logsClient.LogsStopped -= OnLogsStopped;
      logsClient.StateChanged -= OnStateChanged;

      await logsClient.DisposeAsync();
    }
  }
}