@using System.Text.Json
@using GameServer.Web.Models.V2
@using GameServer.Web.Services
@using Radzen
@using Radzen.Blazor

@if (dataType == "yesno" || dataType == "yes/no")
{
    <div class="d-flex align-items-center gap-2">
        <RadzenSwitch TValue="bool"
                      Value="@IsChecked"
                      Change="@OnYesNoChanged" />
        <span>@(IsChecked ? "YES" : GetNoValue())</span>
    </div>
}
else if (dataType == "boolean")
{
    <div class="d-flex align-items-center gap-2">
        <RadzenCheckBox TValue="bool"
                        Value="@IsChecked"
                        Change="@OnBooleanChanged" />
        <span>@(IsChecked ? "Enabled" : "Disabled")</span>
    </div>
}
else if (dataType == "enum")
{
    @if (enumOptions.Count > 0)
    {
        <RadzenDropDown TValue="string"
                        Value="@Value"
                        ValueChanged="@OnStringChanged"
                        Data="@enumOptions"
                        TextProperty="Label"
                        ValueProperty="Value"
                        class="w-100" />
    }
    else
    {
        <RadzenTextBox Value="@Value"
                       ValueChanged="@OnStringChanged"
                       class="w-100" />
    }
}
else if (dataType == "port")
{
    <div class="d-flex flex-column gap-1">
        <RadzenNumeric TValue="int"
                       Value="@PortValue"
                       ValueChanged="@OnPortChanged"
                       Min="1"
                       Max="65535"
                       class="w-100" />
        @if (!string.IsNullOrWhiteSpace(ValidationMessage))
        {
            <div class="small text-danger">@ValidationMessage</div>
        }
    </div>
}
else if (dataType == "timezone" || dataType == "time zone")
{
    <RadzenDropDown TValue="string"
                    Value="@Value"
                    ValueChanged="@OnStringChanged"
                    Data="@LinuxTimeZoneProvider.AllTimeZones"
                    AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    FilterOperator="StringFilterOperator.Contains"
                    Placeholder="@GetTimeZonePlaceholder()"
                    AllowClear="true"
                    class="w-100" />
}
else if (dataType == "password")
{
    <div class="d-flex flex-column gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="flex-grow-1">
                @if (IsMasked && !isEditingMaskedPassword)
                {
                    <div class="d-flex align-items-center gap-2">
                        <RadzenTextBox Value="••••••••••••" Disabled="true" class="w-100" />
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Restricted" />
                        <RadzenButton Text="Change"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => isEditingMaskedPassword = true)" />
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        @if (showPassword)
                        {
                            <RadzenTextBox Value="@Value"
                                           ValueChanged="@OnStringChanged"
                                           Placeholder="Enter password..."
                                           class="w-100" />
                        }
                        else
                        {
                            <RadzenPassword Value="@Value"
                                            ValueChanged="@OnStringChanged"
                                            Placeholder="Enter password..."
                                            class="w-100" />
                        }
                        <RadzenButton Icon="@(showPassword ? "visibility_off" : "visibility")"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="@(() => showPassword = !showPassword)"
                                      Title="@(showPassword ? "Hide password" : "Show password")" />
                    </div>
                }
            </div>
        </div>

        @if (AllowAccessPolicyConfig)
        {
            <div class="p-2 border rounded bg-light mt-1">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-muted">
                        <RadzenIcon Icon="security" Style="font-size: 1rem; vertical-align: text-bottom;" /> Password Access Policy:
                    </span>
                    <RadzenSelectBar TValue="string"
                                     Value="@EffectiveAccessPolicy"
                                     ValueChanged="@OnAccessPolicyChanged"
                                     Size="ButtonSize.ExtraSmall">
                        <Items>
                            <RadzenSelectBarItem Value="@("Group")" Text="Entire Group" />
                            <RadzenSelectBarItem Value="@("Individual")" Text="Specific Users / Creator Only" />
                        </Items>
                    </RadzenSelectBar>
                </div>

                @if (EffectiveAccessPolicy == "Individual")
                {
                    <div class="mt-1">
                        <span class="small text-muted d-block mb-1">Users permitted to view this password:</span>
                        @if (AvailableUsers is not null && AvailableUsers.Count > 0)
                        {
                            <RadzenDropDown TValue="IEnumerable<int>"
                                            Value="@SelectedUserIdsEnumerable"
                                            ValueChanged="@OnAllowedUsersChanged"
                                            Data="@AvailableUsers"
                                            TextProperty="Username"
                                            ValueProperty="Id"
                                            Multiple="true"
                                            AllowClear="true"
                                            Placeholder="Select specific users..."
                                            Chips="true"
                                            class="w-100" />
                        }
                        else
                        {
                            <small class="text-muted fst-italic">Creator and Administrators always retain access.</small>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else if (dataType == ServerVariableSetting.DataType)
{
    <div class="d-flex flex-column gap-2">
        <RadzenTextBox Value="@rawValue"
                       ValueChanged="@OnServerVariableTextChanged"
                       class="w-100" />
        <div class="d-flex align-items-center gap-2">
            <RadzenSwitch Value="@expandVariables"
                          Change="@OnExpandVariablesChanged" />
            <span class="small">@(expandVariables ? "Replace {Variables}" : "Literal text")</span>
        </div>
        @if (expandVariables)
        {
            <div class="small text-muted">
                Available: @string.Join(", ", ServerVariableSetting.SupportedTokens.Select(token => $"{{{token}}}"))
            </div>
        }
    </div>
}
else
{
    <RadzenTextBox Value="@Value"
                   ValueChanged="@OnStringChanged"
                   class="w-100" />
}

@code {
    [Parameter]
    public GameTypeSettingDefinition Definition { get; set; } = new();

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? AccessPolicy { get; set; } = "Group";

    [Parameter]
    public EventCallback<string?> AccessPolicyChanged { get; set; }

    [Parameter]
    public List<int>? AllowedUserIds { get; set; } = [];

    [Parameter]
    public EventCallback<List<int>?> AllowedUserIdsChanged { get; set; }

    [Parameter]
    public bool IsMasked { get; set; } = false;

    [Parameter]
    public bool AllowAccessPolicyConfig { get; set; } = false;

    [Parameter]
    public IReadOnlyList<UserOption>? AvailableUsers { get; set; }

    /// <summary>
    /// Optional validation message rendered under the field, used for live port availability feedback.
    /// </summary>
    [Parameter]
    public string? ValidationMessage { get; set; }

    private string dataType = string.Empty;
    private IReadOnlyList<EnumOption> enumOptions = [];
    private string? rawValue;
    private bool expandVariables;
    private bool showPassword = false;
    private bool isEditingMaskedPassword = false;

    private string EffectiveAccessPolicy => string.IsNullOrWhiteSpace(AccessPolicy) ? "Group" : AccessPolicy;

    private IEnumerable<int> SelectedUserIdsEnumerable => AllowedUserIds ?? [];

    private int PortValue => int.TryParse(Value, out var parsed) ? parsed : 0;

    private bool IsChecked
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Value))
            {
                return string.Equals(Value, "true", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Value, "yes", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Value, "1", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Value, "on", StringComparison.OrdinalIgnoreCase);
            }

            var def = Definition?.DefaultValue;
            return string.Equals(def, "true", StringComparison.OrdinalIgnoreCase)
                || string.Equals(def, "yes", StringComparison.OrdinalIgnoreCase)
                || string.Equals(def, "1", StringComparison.OrdinalIgnoreCase)
                || string.Equals(def, "on", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Definition);

        dataType = string.IsNullOrWhiteSpace(Definition.Metadata?.DataType)
            ? string.Empty
            : Definition.Metadata.DataType.Trim().ToLowerInvariant();

        enumOptions = GetEnumOptions(Definition);

        if (dataType == ServerVariableSetting.DataType)
        {
            var (defEnabled, defOn, defOff) = ServerVariableSetting.DecodeDefinitionDefault(Definition.DefaultValue);
            if (string.IsNullOrEmpty(Value) || Value.StartsWith(ServerVariableSetting.DefinitionDefaultPrefix, StringComparison.Ordinal))
            {
                expandVariables = defEnabled;
                rawValue = expandVariables ? defOn : defOff;
            }
            else
            {
                (expandVariables, rawValue) = ServerVariableSetting.Decode(Value);
            }
        }
        else
        {
            (expandVariables, rawValue) = ServerVariableSetting.Decode(Value);
        }
    }

    private Task OnAccessPolicyChanged(string value)
    {
        AccessPolicy = value;
        return AccessPolicyChanged.InvokeAsync(value);
    }

    private Task OnAllowedUsersChanged(IEnumerable<int> userIds)
    {
        var list = userIds?.ToList() ?? [];
        AllowedUserIds = list;
        return AllowedUserIdsChanged.InvokeAsync(list);
    }

    private Task OnServerVariableTextChanged(string? value)
    {
        rawValue = value;
        return ValueChanged.InvokeAsync(ServerVariableSetting.Encode(expandVariables, rawValue));
    }

    private Task OnExpandVariablesChanged(bool value)
    {
        var (defEnabled, defOn, defOff) = ServerVariableSetting.DecodeDefinitionDefault(Definition.DefaultValue);
        
        if (value)
        {
            if (string.IsNullOrEmpty(rawValue) || string.Equals(rawValue, defOff, StringComparison.Ordinal))
            {
                rawValue = defOn ?? rawValue;
            }
        }
        else
        {
            if (string.IsNullOrEmpty(rawValue) || string.Equals(rawValue, defOn, StringComparison.Ordinal))
            {
                rawValue = defOff ?? rawValue;
            }
        }

        expandVariables = value;
        return ValueChanged.InvokeAsync(ServerVariableSetting.Encode(expandVariables, rawValue));
    }

    private Task OnStringChanged(string? value)
    {
        isEditingMaskedPassword = false;
        return ValueChanged.InvokeAsync(value);
    }

    private Task OnPortChanged(int value)
    {
        return ValueChanged.InvokeAsync(value.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private Task OnBooleanChanged(bool value)
    {
        return ValueChanged.InvokeAsync(value ? "true" : "false");
    }

    private Task OnYesNoChanged(bool value)
    {
        return ValueChanged.InvokeAsync(value ? "YES" : GetNoValue());
    }

    private string GetNoValue()
    {
        var def = Definition?.DefaultValue;
        if (!string.IsNullOrEmpty(def) && string.Equals(def, "NO", StringComparison.Ordinal))
        {
            return "NO";
        }

        return "no";
    }

    private string GetTimeZonePlaceholder()
    {
        if (!string.IsNullOrWhiteSpace(Definition?.Metadata?.Placeholder))
        {
            return Definition.Metadata.Placeholder;
        }

        if (!string.IsNullOrWhiteSpace(Definition?.DefaultValue))
        {
            return $"Select timezone (Default: {Definition.DefaultValue})";
        }

        return "Select timezone...";
    }

    private static IReadOnlyList<EnumOption> GetEnumOptions(GameTypeSettingDefinition definition)
    {
        ArgumentNullException.ThrowIfNull(definition);

        if (string.IsNullOrWhiteSpace(definition.Metadata?.AllowedValuesJson))
        {
            return [];
        }

        try
        {
            var allowedValues = JsonSerializer.Deserialize<List<string>>(definition.Metadata.AllowedValuesJson) ?? [];
            var valueMappings = string.IsNullOrWhiteSpace(definition.Metadata.ValueMappingsJson)
                ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                : JsonSerializer.Deserialize<Dictionary<string, string>>(definition.Metadata.ValueMappingsJson) ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            return allowedValues
                .Select(value => new EnumOption(value, valueMappings.TryGetValue(value, out var label) ? label : value))
                .ToList();
        }
        catch (JsonException)
        {
            return [];
        }
    }

    public sealed record UserOption(int Id, string Username);
    private sealed record EnumOption(string Value, string Label);
}
