@using Radzen
@using Radzen.Blazor
@using GameServer.Docker.Client
@inject NotificationService NotificationService

<RadzenCard Style="max-width:900px">
  <ChildContent>
    <h4>@(GameDefinition.DisplayName ?? "Game") Basic Information</h4>
    <EditForm Model="Server">
      <DataAnnotationsValidator />

      <div >
        <div>
          <RadzenLabel Text="Name" />
          <RadzenTextBox @bind-Value="Server.Name" Style="width:100%" />
        </div>

        <div>
          <RadzenLabel Text="Description" />
          <RadzenTextArea @bind-Value="Server.Description" Style="width:100%;height:120px" />
        </div>

        <div>
          <RadzenLabel Text="Port Mapping(s)" />
          <PortMappingEditor Server="Server" OnChanged="@( s => Server = s )" />
        </div>
      </div>
    </EditForm>
    
  </ChildContent>
</RadzenCard>

@code {
    [Parameter]
    public GameServer Server { get; set; } = new();

    [Parameter]
    public GameTypeDefinition GameDefinition { get; set; } = new();

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    async Task NextAsync()
    {
        if (string.IsNullOrWhiteSpace(Server?.Name))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Validation",
                Detail = "Server name is required.",
                Duration = 4000
            });
            return;
        }

        await OnNext.InvokeAsync(null);
    }

    Task BackAsync() => OnBack.InvokeAsync(null);
}
