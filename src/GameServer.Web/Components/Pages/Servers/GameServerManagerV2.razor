@page "/gameservers-v2"
@rendermode InteractiveServer
@using GameServer.Web.Models.V2
@using Radzen
@using Radzen.Blazor
@inject Services.V2.IGameServerV2ApiService GameServerApiV2
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject Services.IThumbnailCacheService ThumbnailCacheService
@inject Services.IUserTimeZoneService TimeZoneService

<PageTitle>Game Servers</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Game Servers</h2>
            <p class="text-muted mb-0">Managed GameServer list built with backend validation-aware projections.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <RadzenCheckBox @bind-Value="includeDeleted" TValue="bool" Change="@(_ => LoadAsync())" />
            <span>Include deleted</span>
            <RadzenButton Text="New Server" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Click='@(() => Navigation.NavigateTo("/gameservers-v2/new"))' />
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadAsync" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Loading game servers...</p>
        </div>
    }
    else if (!servers.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="dns" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Game Servers Found</h4>
                <p class="text-muted">Once game servers are created, they will appear here with their resolved revision
                    state.</p>
                </div>
            </RadzenCard>
        }
    else
        {
            <RadzenCard>
                <RadzenDataGrid @ref="grid" Data="@servers" TItem="GameServerListItem" AllowSorting="true" AllowFiltering="true"
                                FilterMode="FilterMode.Advanced" AllowColumnResize="true" RowClick="@OnRowClick" RowRender="@OnRowRender">
                    <Columns>
                        <RadzenDataGridColumn TItem="GameServerListItem" Property="GameTypeThumbnailUrl" Title="" Width="80px"
                                              Sortable="false" Filterable="false">
                            <Template Context="server">
                                @if (!string.IsNullOrWhiteSpace(server.GameTypeThumbnailUrl))
                                {
                                    <img src="@GetThumbnailUrl(server.GameTypeThumbnailUrl)" alt="@server.GameTypeDisplayName"
                                         class="gameserver-list-thumbnail"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <div class="gameserver-list-thumbnail-fallback" style="display: none;">
                                        <RadzenIcon Icon="dns" Style="font-size: 1.5rem;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="gameserver-list-thumbnail-fallback">
                                        <RadzenIcon Icon="dns" Style="font-size: 1.5rem;" />
                                    </div>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="GameServerListItem" Property="Name" Title="Server" Width="240px">
                            <Template Context="server">
                                <div class="gameserver-list-name">
                                    <strong>@server.Name</strong>
                                    <div class="small text-muted">@server.ServerId</div>
                                    @if (!string.IsNullOrWhiteSpace(server.Description))
                                    {
                                        <div class="small text-muted">@server.Description</div>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="GameServerListItem" Property="Status" Title="State" Width="120px">
                            <Template Context="server">
                                <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(server.Status, server.IsDeleted)"
                                             Text="@GetStatusText(server.Status, server.IsDeleted)" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="GameServerListItem" Title="Game Type" Width="180px" Sortable="false"
                                              Filterable="false">
                            <Template Context="server">
                                <div>
                                    <strong>@(string.IsNullOrWhiteSpace(server.GameTypeDisplayName) ? "Unknown revision" :
                                                                                                                server.GameTypeDisplayName)</strong>
                                        @if (!string.IsNullOrWhiteSpace(server.GameTypeKey))
                                        {
                                            <div class="small text-muted">@server.GameTypeKey</div>
                                        }
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="GameServerListItem" Property="ServiceName" Title="Service" Width="170px">
                                <Template Context="server">
                                    @if (string.IsNullOrWhiteSpace(server.ServiceName))
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                    else
                                    {
                                        <code class="gameserver-list-service">@server.ServiceName</code>
                                    }
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="GameServerListItem" Title="Ports" Width="140px" Sortable="false"
                                                  Filterable="false">
                                <Template Context="server">
                                    @{
                                        var primaryPort = server.ResolvedPorts.FirstOrDefault(p => p.AdvertisedPort)
                                            ?? server.ResolvedPorts.OrderBy(p => p.DisplayOrder).FirstOrDefault();
                                        var portText = FormatPublishedPort(primaryPort);
                                    }
                                    @if (string.IsNullOrEmpty(portText))
                                    {
                                        <span class="text-muted">No resolved ports</span>
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@portText" Size="BadgeSize.Small"
                                                     title="Primary Port (Published)" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>


                            <RadzenDataGridColumn TItem="GameServerListItem" Property="UpdatedAt" Title="Updated" Width="160px">
                                <Template Context="server">
                                    <span>@FormatLocalDateTime(server.UpdatedAt)</span>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="GameServerListItem" Title="Actions" Width="140px" Sortable="false"
                                                  Filterable="false">
                                <Template Context="server">
                                    <div class="d-flex gap-2 justify-content-end" @onclick:stopPropagation="true">
                                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                      Click="@(() => EditServer(server))" title="Edit" />
                                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                      Click="@(() => DeleteServerAsync(server))" title="Delete" />
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            }
        </div>

        <style>
            .gameserver-list-thumbnail,
            .gameserver-list-thumbnail-fallback {
                width: 60px;
                height: 60px;
                border-radius: 8px;
                object-fit: cover;
                background: linear-gradient(135deg, var(--rz-base-100) 0%, var(--rz-base-200) 100%);
            }

            .gameserver-list-thumbnail-fallback {
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--rz-text-disabled-color);
            }

            .gameserver-list-name {
                display: flex;
                flex-direction: column;
                gap: 0.15rem;
            }

            .gameserver-list-service {
                font-size: 0.8rem;
                word-break: break-word;
            }

            .gameserver-list-ports {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
            }
        </style>

@code {
    private List<GameServerListItem> servers = [];
    private RadzenDataGrid<GameServerListItem>? grid;
    private readonly Dictionary<string, string> cachedThumbnailUrls = new(StringComparer.Ordinal);
    private bool includeDeleted;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var initialized = await TimeZoneService.InitializeAsync();
            if (initialized)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            var items = await GameServerApiV2.GetListAsync(includeDeleted);
            servers = items.ToList();
            isLoading = false;
            StateHasChanged();
            if (grid is not null)
            {
                await grid.Reload();
            }
            _ = CacheThumbnailUrlsAsync(servers.Select(static server => server.GameTypeThumbnailUrl));
        }
        catch (HttpRequestException ex)
        {
            isLoading = false;
            StateHasChanged();
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Load failed", ex.Message);
        }
    }

    private void EditServer(GameServerListItem server)
    {
        ArgumentNullException.ThrowIfNull(server);
        Navigation.NavigateTo($"/gameservers-v2/{Uri.EscapeDataString(server.ServerId)}/edit");
    }

    private async Task DeleteServerAsync(GameServerListItem server)
    {
        ArgumentNullException.ThrowIfNull(server);

        try
        {
            await GameServerApiV2.DeleteAsync(server.ServerId);
            await LoadAsync();
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Deleted", $"Game server '{server.Name}' was deleted.");
        }
        catch (HttpRequestException ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Delete failed", ex.Message);
        }
    }

    private void OnRowClick(DataGridRowMouseEventArgs<GameServerListItem> args)
    {
        Navigation.NavigateTo($"/gameservers-v2/{Uri.EscapeDataString(args.Data.ServerId)}");
    }

    private static void OnRowRender(RowRenderEventArgs<GameServerListItem> args)
    {
        args.Attributes.Add("style", "cursor: pointer;");
    }

    private string? GetThumbnailUrl(string? sourceUrl)
    {
        if (string.IsNullOrWhiteSpace(sourceUrl))
        {
            return null;
        }

        return cachedThumbnailUrls.TryGetValue(sourceUrl, out var cachedUrl) ? cachedUrl : sourceUrl;
    }

    private async Task CacheThumbnailUrlsAsync(IEnumerable<string?> thumbnailUrls)
    {
        var sourceUrls = thumbnailUrls
            .Where(static url => !string.IsNullOrWhiteSpace(url))
            .Select(static url => url!)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        if (sourceUrls.Count == 0)
        {
            return;
        }

        try
        {
            var cacheEntries = await Task.WhenAll(sourceUrls.Select(async url =>
                new KeyValuePair<string, string>(url, (await ThumbnailCacheService.GetCachedThumbnailUrlAsync(url)) ?? url)));

            foreach (var cacheEntry in cacheEntries)
            {
                cachedThumbnailUrls[cacheEntry.Key] = cacheEntry.Value;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Non-critical background thumbnail cache failure
        }
    }

    private static string FormatPublishedPort(GameServerResolvedPort? port)
    {
        if (port == null)
        {
            return string.Empty;
        }

        var exposedPort = port.PublishedPort > 0 ? port.PublishedPort : port.ContainerPort;
        return exposedPort > 0 ? exposedPort.ToString() : string.Empty;
    }

    private string FormatLocalDateTime(DateTime dateTime)
    {
        return TimeZoneService.FormatLocalDateTime(dateTime);
    }

    private static BadgeStyle GetStatusBadgeStyle(string? status, bool isDeleted = false)
    {
        if (isDeleted)
        {
            return BadgeStyle.Danger;
        }

        var normalized = status?.Trim().ToLowerInvariant().Replace("-", "");
        return normalized switch
        {
            "running" or "available" => BadgeStyle.Success,
            "preparing" or "starting" => BadgeStyle.Info,
            "stopped" or "deleted" or "failed" => BadgeStyle.Danger,
            "stopping" or "scalingdown" => BadgeStyle.Warning,
            _ => BadgeStyle.Secondary
        };
    }

    private static string GetStatusText(string? status, bool isDeleted = false)
    {
        if (isDeleted)
        {
            return "Deleted";
        }

        var normalized = status?.Trim().ToLowerInvariant().Replace("-", "");
        return normalized switch
        {
            "running" => "Running",
            "available" => "Available",
            "preparing" => "Preparing",
            "starting" => "Starting",
            "stopped" => "Stopped",
            "stopping" => "Stopping",
            "failed" => "Failed",
            "deleted" => "Deleted",
            "scalingdown" => "Scaling Down",
            _ => string.IsNullOrWhiteSpace(status) ? "Unknown" : status
        };
    }
}
