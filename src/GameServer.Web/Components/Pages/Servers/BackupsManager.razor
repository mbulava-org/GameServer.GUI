@page "/backups"
@attribute [Authorize]
@rendermode InteractiveServer
@using GameServer.Web.Models.V2
@using GameServer.Web.Services.V2
@using Radzen
@using Radzen.Blazor
@inject IBackupsApiService BackupsApi
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GameServer.Web.Services.IUserTimeZoneService TimeZoneService

<PageTitle>Server Backups</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2>Server Backups</h2>
            <p class="text-muted mb-0">Manage and download zipped server volume and path backups.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadAsync" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Loading backups...</p>
        </div>
    }
    else if (!backups.Any())
    {
        <RadzenCard>
            <div class="text-center py-5">
                <RadzenIcon Icon="backup" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <h4 class="mt-3">No Backups Found</h4>
                <p class="text-muted">You can create backups from the <strong>File Manager</strong> tab of any game server.</p>
                <RadzenButton Text="Go to Game Servers" Icon="dns" ButtonStyle="ButtonStyle.Primary" Click='@(() => Navigation.NavigateTo("/gameservers-v2"))' class="mt-2" />
            </div>
        </RadzenCard>
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid @ref="grid" Data="@backups" TItem="GameServerBackup" AllowSorting="true" AllowFiltering="true"
                            FilterMode="FilterMode.Advanced" AllowColumnResize="true">
                <Columns>
                    <RadzenDataGridColumn TItem="GameServerBackup" Property="FileName" Title="Archive File" Width="260px">
                        <Template Context="backup">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="archive" Style="color: var(--rz-info); font-size: 1.5rem;" />
                                <div>
                                    <strong class="text-break">@backup.FileName</strong>
                                    <div class="small text-muted">@FormatFileSize(backup.FileSizeBytes)</div>
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerBackup" Property="ServerName" Title="Game Server" Width="200px">
                        <Template Context="backup">
                            <div>
                                <a href="@($"/gameservers-v2/{backup.ServerId}")" class="fw-bold text-decoration-none">
                                    @backup.ServerName
                                </a>
                                <div class="small text-muted"><code>@backup.ServerId</code></div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerBackup" Property="VolumePath" Title="Source Location" Width="220px">
                        <Template Context="backup">
                            <div class="small">
                                <div><strong>Volume:</strong> <code>@backup.VolumePath</code></div>
                                @if (!string.IsNullOrWhiteSpace(backup.SourceSubPath))
                                {
                                    <div><strong>Path:</strong> <code>@backup.SourceSubPath</code></div>
                                }
                                <div class="text-muted">@(backup.IsDirectory ? "Folder (recursive)" : "Single File")</div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerBackup" Property="CreatedByUsername" Title="Created By" Width="150px">
                        <Template Context="backup">
                            <div>
                                <span><RadzenIcon Icon="person" Style="font-size: 0.85rem; vertical-align: text-bottom;" /> @backup.CreatedByUsername</span>
                                <div class="small text-muted">@TimeZoneService.FormatLocalDateTime(backup.CreatedAt)</div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerBackup" Property="ExpiresAt" Title="Retention / Expiry" Width="180px">
                        <Template Context="backup">
                            @{
                                var remaining = backup.ExpiresAt - DateTime.UtcNow;
                                var isExpired = remaining <= TimeSpan.Zero;
                            }
                            <div>
                                @if (isExpired)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Expired" />
                                }
                                else if (remaining.TotalDays <= 3)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"Expires in {Math.Ceiling(remaining.TotalHours)} hrs")" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"Expires in {Math.Ceiling(remaining.TotalDays)} days")" />
                                }
                                <div class="small text-muted mt-1">@TimeZoneService.FormatLocalDateTime(backup.ExpiresAt)</div>
                                @if (backup.ExtensionDaysAdded > 0)
                                {
                                    <div class="small text-muted">(Extended +@backup.ExtensionDaysAdded d)</div>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerBackup" Property="IsSharedWithGroups" Title="Group Sharing" Width="140px">
                        <Template Context="backup">
                            @if (backup.IsOwner)
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <RadzenSwitch Value="@backup.IsSharedWithGroups"
                                                  Change="@(args => ToggleSharingAsync(backup, args))" />
                                    <span class="small">@(backup.IsSharedWithGroups ? "Shared" : "Private")</span>
                                </div>
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="@(backup.IsSharedWithGroups ? BadgeStyle.Info : BadgeStyle.Light)"
                                             Text="@(backup.IsSharedWithGroups ? "Shared" : "Private")" />
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerBackup" Title="Actions" Width="180px" Sortable="false" Filterable="false">
                        <Template Context="backup">
                            <div class="d-flex gap-1 align-items-center">
                                <RadzenButton Icon="download"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Click="@(() => DownloadBackupAsync(backup))"
                                              title="Download backup archive" />

                                @if (backup.IsOwner && backup.CanExtend)
                                {
                                    <RadzenButton Icon="update"
                                                  ButtonStyle="ButtonStyle.Secondary"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => ExtendBackupAsync(backup))"
                                                  title="Extend retention deadline (+30 days)" />
                                }

                                @if (backup.IsOwner)
                                {
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => DeleteBackupAsync(backup))"
                                                  title="Permanently delete backup" />
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</div>

@code {
    private RadzenDataGrid<GameServerBackup>? grid;
    private List<GameServerBackup> backups = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            var list = await BackupsApi.GetBackupsAsync();
            backups = list.ToList();
        }
        catch (Exception ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Failed to load backups", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadBackupAsync(GameServerBackup backup)
    {
        try
        {
            NotificationService.NotifyTimed(NotificationSeverity.Info, "Downloading...", backup.FileName);
            var bytes = await BackupsApi.DownloadBackupAsync(backup.BackupId);
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("eval", $"{{ let a = document.createElement('a'); a.href = 'data:application/zip;base64,{base64}'; a.download = '{backup.FileName}'; a.click(); }}");
        }
        catch (Exception ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Download Failed", ex.Message);
        }
    }

    private async Task ExtendBackupAsync(GameServerBackup backup)
    {
        var confirmed = await DialogService.Confirm(
            $"Extend retention for '{backup.FileName}' by up to 30 additional days?",
            "Extend Backup Retention",
            new ConfirmOptions { OkButtonText = "Extend (+30 Days)", CancelButtonText = "Cancel" });

        if (confirmed is true)
        {
            try
            {
                var updated = await BackupsApi.ExtendBackupAsync(backup.BackupId, new ExtendBackupRequest { AdditionalDays = 30 });
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Retention Extended", $"Expires on {TimeZoneService.FormatLocalDateTime(updated.ExpiresAt)}.");
                await LoadAsync();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyTimed(NotificationSeverity.Error, "Extension Failed", ex.Message);
            }
        }
    }

    private async Task ToggleSharingAsync(GameServerBackup backup, bool isShared)
    {
        try
        {
            await BackupsApi.UpdateSharingAsync(backup.BackupId, new UpdateBackupSharingRequest { IsSharedWithGroups = isShared });
            NotificationService.NotifyTimed(NotificationSeverity.Success, "Sharing Updated", isShared ? "Backup shared with group members." : "Backup is now private.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Sharing Update Failed", ex.Message);
            await LoadAsync();
        }
    }

    private async Task DeleteBackupAsync(GameServerBackup backup)
    {
        var confirmed = await DialogService.Confirm(
            $"Permanently delete backup '{backup.FileName}'? This cannot be undone.",
            "Delete Backup",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed is true)
        {
            try
            {
                await BackupsApi.DeleteBackupAsync(backup.BackupId);
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Backup Deleted", $"Deleted '{backup.FileName}'.");
                await LoadAsync();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyTimed(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
