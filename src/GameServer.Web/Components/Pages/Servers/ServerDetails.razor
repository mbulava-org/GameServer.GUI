@page "/servers/{ServerId}"
@rendermode InteractiveServer
@using GameServer.Web.Components.Server
@using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using System.Text.Json
@inject IGameServerApi ServerApi
@inject IGameTypeApi GameTypeApi
@inject IGameTypeExtendedMetadataApi ExtendedMetadataApi
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>@(server?.Name ?? "Server Details")</PageTitle>

@if (loading)
{
  <div class="loading-container text-center py-5">
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
    <p>Loading server details...</p>
  </div>
}
else if (server == null)
{
  <RadzenCard class="error-card">
    <div class="text-center py-5">
      <RadzenIcon Icon="error" Style="font-size: 4rem; color: var(--rz-danger);" />
      <h3 class="mt-3">Server Not Found</h3>
      <p>The requested server could not be found.</p>
      <RadzenButton Text="Back to Dashboard" Click='@(() => NavigationManager.NavigateTo("/servers"))' />
    </div>
  </RadzenCard>
}
else
{
  <div class="details-container">
    <RadzenCard class="mb-3">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
          <RadzenButton Icon="arrow_back" 
                        ButtonStyle="ButtonStyle.Light" 
                        Click='@(() => NavigationManager.NavigateTo("/servers"))' 
                        Size="ButtonSize.Small" />
          @if (!string.IsNullOrWhiteSpace(gameType?.ThumbnailUrl))
          {
            <div class="game-thumbnail">
              <img src="@gameType.ThumbnailUrl" 
                   alt="@gameType.DisplayName"
                   onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <div class="thumbnail-fallback" style="display: none;">
                <RadzenIcon Icon="sports_esports" Style="font-size: 2rem;" />
              </div>
            </div>
          }
          <div>
            <h2 class="mb-1">@server.Name</h2>
            <div class="d-flex align-items-center gap-2">
              <RadzenBadge BadgeStyle='@GetStatusBadgeStyle(server.Status)' 
                           Text='@GetStatusText(server.Status)' />
              @if (!string.IsNullOrWhiteSpace(server.ServiceName))
              {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@server.ServiceName" Variant="Variant.Outlined" />
              }
            </div>
          </div>
        </div>
        <div class="d-flex gap-2">
          <RadzenButton Text="Edit" 
                        Icon="edit" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Click="@(() => NavigationManager.NavigateTo($"/servers/{ServerId}/edit"))" />
          <RadzenButton Text='@(IsServerRunning(server.Status) ? "Stop" : "Start")' 
                        Icon='@(IsServerRunning(server.Status) ? "stop" : "play_arrow")' 
                        Click="ToggleServerState" 
                        ButtonStyle='@(IsServerRunning(server.Status) ? ButtonStyle.Warning : ButtonStyle.Success)' 
                        Disabled="@actionInProgress" />
          <RadzenButton Text="Delete" 
                        Icon="delete" 
                        Click="DeleteServer" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Disabled="@actionInProgress" />
        </div>
      </div>
    </RadzenCard>

    <RadzenTabs @bind-SelectedIndex="selectedTab">
      <Tabs>
        <RadzenTabsItem Text="Overview">
          <div class="tab-content">
            <div class="details-grid">
              <div class="column-left">
                <RadzenCard class="mb-3">
                  <div class="card-header">
                    <h4><RadzenIcon Icon="info" /> Server Information</h4>
                  </div>
                  
                  <div class="info-section">
                    <div class="info-row">
                      <span class="label">Server ID:</span>
                      <span class="value">@server.ServerId</span>
                    </div>
                    <div class="info-row">
                      <span class="label">Game Type:</span>
                      <span class="value">@server.GameType</span>
                    </div>
                    <div class="info-row">
                      <span class="label">Service Name:</span>
                      <span class="value">@server.ServiceName</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(server.Description))
                    {
                      <div class="info-row-full">
                        <span class="label">Description:</span>
                        <div class="description-value">@server.Description</div>
                      </div>
                    }
                  </div>
                </RadzenCard>

                <RadzenCard class="mb-3">
                  <div class="card-header">
                    <h4><RadzenIcon Icon="settings_ethernet" /> Network</h4>
                  </div>
                  
                  <div class="info-section">
                    <div class="info-row">
                      <span class="label">Host IP:</span>
                      <span class="value">@(publicIp ?? "Loading...")</span>
                    </div>
                    <div class="info-row">
                      <span class="label">Published Port:</span>
                      <span class="value">
                        @GetDefaultPublishedPort()
                        @if (HasDefaultPort())
                        {
                          <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Default" Size="BadgeSize.Small" class="ms-2" />
                        }
                      </span>
                    </div>
                    <div class="info-row">
                      <span class="label">Connection:</span>
                      <span class="value">
                        <code class="connection-string">@GetConnectionString()</code>
                        <RadzenButton Icon="content_copy" 
                                      Size="ButtonSize.Small" 
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="CopyConnectionString" 
                                      class="ms-2"
                                      title="Copy connection string" />
                      </span>
                    </div>
                  </div>
                  
                  @if (server.Ports?.Any() == true)
                  {
                    <div class="mt-3">
                      <div class="card-subheader">
                        <strong>Port Mappings</strong>
                      </div>
                      <div class="ports-list">
                        @foreach (var port in server.Ports)
                        {
                          var isDefault = IsDefaultPort(port);
                          <div class="port-mapping-item">
                            <div class="d-flex align-items-center gap-2">
                              <RadzenBadge BadgeStyle="@(isDefault ? BadgeStyle.Success : BadgeStyle.Info)" 
                                           Text='@($"{port.PublishedPort} → {port.ContainerPort} ({port.Protocol})")' />
                              @if (isDefault)
                              {
                                <RadzenIcon Icon="star" Style="color: var(--rz-warning); font-size: 1rem;" title="Default connection port" />
                              }
                            </div>
                          </div>
                        }
                      </div>
                    </div>
                  }
                </RadzenCard>

              </div>

              <div class="column-right">
                <div class="monitors-stack">
                  <!-- REST API Monitor (simple polling, manual refresh) -->
                  <ResourceMonitorRest ServerId="@ServerId"
                                      Title="REST API Monitor"
                                      ShowTimestamps="true" />
                  
                  <!-- SignalR Monitor (detailed, on-demand) -->
                  <div class="mt-3">
                    <ResourceMonitor ContainerId="@ServerId" 
                                    Title="Real-Time Monitor (SignalR)"
                                    AutoConnect="true" 
                                    ShowHistory="true" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Logs">
          <div class="tab-content">
            <ServerLogsViewer ServerId="@ServerId" Server="@server" />
          </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Terminal">
          <div class="tab-content">
            @if (IsServerRunning(server?.Status))
            {
              <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
                <div class="d-flex align-items-center gap-2">
                  <RadzenIcon Icon="terminal" Style="font-size: 1rem;" />
                  <span><strong>Interactive Shell</strong> - Execute commands directly in the container using /bin/sh</span>
                </div>
              </RadzenAlert>
              <ContainerTerminal ContainerId="@(containerId ?? ServerId)" 
                                 AutoConnect="true"
                                 Shell="/bin/sh" />
            }
            else
            {
              <RadzenCard>
                <div class="text-center py-5">
                  <RadzenIcon Icon="terminal" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                  <h5 class="mt-3">Terminal Unavailable</h5>
                  <p class="text-muted">Server must be running to access the terminal. Start the server first.</p>
                </div>
              </RadzenCard>
            }
          </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Files">
          <div class="tab-content">
            <ServerFileManager ServerId="@ServerId" Server="@server" />
          </div>
        </RadzenTabsItem>

        @if (IsTtyEnabled())
        {
          <RadzenTabsItem Text="TTY Console">
            <div class="tab-content">
              @if (IsServerRunning(server?.Status))
              {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
                  <div class="d-flex align-items-center gap-2">
                    <RadzenIcon Icon="info" Style="font-size: 1rem;" />
                    <span><strong>Attached Console</strong> - View the main process output (requires TTY enabled)</span>
                  </div>
                </RadzenAlert>
                <ContainerConsole ServerId="@(containerId ?? ServerId)" 
                                 AutoConnect="false" />
              }
              else
              {
                <RadzenCard>
                  <div class="text-center py-5">
                    <RadzenIcon Icon="info" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                    <p class="text-muted mt-3">Server must be running to access the console. Start the server first.</p>
                  </div>
                </RadzenCard>
              }
            </div>
          </RadzenTabsItem>
        }
      </Tabs>
    </RadzenTabs>
  </div>
}

<style>
  .details-container {
    padding: 1rem;
  }

  .tab-content {
    padding: 1rem 0;
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 1rem;
  }

  .monitors-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @@media (max-width: 1200px) {
    .details-grid {
      grid-template-columns: 1fr;
    }
  }

  .card-header {
    border-bottom: 1px solid var(--rz-border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
  }

  .card-header h4 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .info-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rz-border-color);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-row-full {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rz-border-color);
  }

  .info-row-full:last-child {
    border-bottom: none;
  }

  .label {
    font-weight: 600;
    color: var(--rz-text-secondary-color);
    font-size: 0.875rem;
  }

  .value {
    color: var(--rz-text-color);
    font-weight: 500;
    text-align: right;
  }

  .description-value {
    color: var(--rz-text-color);
    font-weight: 400;
    line-height: 1.6;
    white-space: pre-wrap;
    word-wrap: break-word;
    background: var(--rz-base-100);
    padding: 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--rz-border-color);
  }

  /* Ports Grid */
  .ports-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .port-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--rz-base-50);
    border-radius: 6px;
    border: 1px solid var(--rz-border-color);
  }

  .port-arrow {
    color: var(--rz-text-secondary-color);
    font-weight: 600;
  }

  /* Connection Section */
  .connection-section {
    border-top: 1px solid var(--rz-border-color);
    padding-top: 1rem;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .connection-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .connection-label {
    font-weight: 600;
    color: var(--rz-text-secondary-color);
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .connection-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .connection-string {
    flex: 1;
    background: var(--rz-base-100);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--rz-border-color);
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: var(--rz-primary);
    word-break: break-all;
  }

  .no-data {
    text-align: center;
    color: var(--rz-text-secondary-color);
    padding: 2rem;
    margin: 0;
  }

  .game-thumbnail {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--rz-base-100);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .game-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rz-text-disabled-color);
  }

  @@media (max-width: 768px) {
    .connection-value {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

@code {
[Parameter] public string ServerId { get; set; } = "";

private string VanityDomain => "games.dev.bulavafamily.com";

private GameServer? server;
private GameTypeDefinition? gameType;
private GameTypeExtendedMetadata? extendedMetadata;
private ServerResourceUsage? resourceUsage;
private bool loading = true;
private bool actionInProgress = false;
private int selectedTab = 0;
private string? publicIp;
private string? containerId;

protected override async Task OnInitializedAsync()
{
    await LoadServerAsync();
    await LoadPublicIpAsync();
    await LoadResourceUsageAsync();
}

protected override async Task OnParametersSetAsync()
{
    if (!string.IsNullOrEmpty(ServerId))
    {
        await LoadServerAsync();
        await LoadResourceUsageAsync();
    }
}

private async Task LoadServerAsync()
{
    loading = true;
    try
    {
        server = await ServerApi.GetAsync(ServerId);

        if (server != null && !string.IsNullOrWhiteSpace(server.GameType))
        {
            // Load the game type definition to get thumbnail
            var allGameTypes = await GameTypeApi.GetAllAsync();
            gameType = allGameTypes.FirstOrDefault(gt => gt.Key == server.GameType);
                
            // Load extended metadata to check TTY setting
            try
            {
                extendedMetadata = await ExtendedMetadataApi.GetAsync(server.GameType);
            }
            catch
            {
                // Extended metadata is optional
                extendedMetadata = null;
            }
        }
    }
    catch (Exception ex)
    {
        NotificationService.Notify(new NotificationMessage 
  { 
    Severity = NotificationSeverity.Error, 
    Summary = "Error", 
    Detail = $"Failed to load server: {ex.Message}", 
    Duration = 5000 
  });
        server = null;
    }
    finally
    {
        loading = false;
    }
}

    private async Task LoadPublicIpAsync()
    {
        try
        {
            using var http = new HttpClient();
            publicIp = await http.GetStringAsync("https://api.ipify.org");
        }
        catch
        {
            publicIp = "localhost";
        }
    }

    private async Task LoadResourceUsageAsync()
    {
        try
        {
            resourceUsage = await ServerApi.GetResourceUsageAsync(ServerId);
            
            // Extract the first container ID if available
            if (resourceUsage?.ContainerIds?.Any() == true)
            {
                containerId = resourceUsage.ContainerIds.First();
            }
            else
            {
                // Fallback to ServerId if no containers yet
                containerId = ServerId;
            }
        }
        catch
        {
            // If resource usage fails, fall back to using ServerId
            containerId = ServerId;
        }
    }

    private string GetConnectionString(string? vanity=null)
    {
        var defaultPort = GetDefaultPort();
        var port = defaultPort?.PublishedPort ?? 0;
        var host = vanity ?? publicIp ?? "localhost";
        return port > 0 ? $"{host}:{port}" : "N/A";
    }

    private string GetDefaultPublishedPort()
    {
        var defaultPort = GetDefaultPort();
        return defaultPort?.PublishedPort.ToString() ?? "Not configured";
    }

    private bool HasDefaultPort()
    {
        return gameType?.Ports?.Any(p => p.IsDefaultPort) == true;
    }

    private bool IsDefaultPort(PortMapping port)
    {
        if (!HasDefaultPort() || gameType?.Ports == null)
            return false;

        // Find the default port definition
        var defaultPortDef = gameType.Ports.FirstOrDefault(p => p.IsDefaultPort);
        if (defaultPortDef == null)
            return false;

        // Find the index of the default port in the definition
        var portDefsList = gameType.Ports.ToList();
        var defaultIndex = portDefsList.IndexOf(defaultPortDef);

        if (defaultIndex < 0)
            return false;

        // Check if this port is at the same index in Server.Ports
        var serverPortsList = server?.Ports?.ToList();
        if (serverPortsList == null || defaultIndex >= serverPortsList.Count)
            return false;

        return serverPortsList[defaultIndex] == port;
    }

    private PortMapping? GetDefaultPort()
    {
        if (!HasDefaultPort() || gameType?.Ports == null || server?.Ports == null)
            return server?.Ports?.FirstOrDefault();

        // Find the default port definition
        var defaultPortDef = gameType.Ports.FirstOrDefault(p => p.IsDefaultPort);
        if (defaultPortDef == null)
            return server.Ports.FirstOrDefault();

        // Find the index of the default port in the definition
        var portDefsList = gameType.Ports.ToList();
        var defaultIndex = portDefsList.IndexOf(defaultPortDef);

        if (defaultIndex < 0)
            return server.Ports.FirstOrDefault();

        // Get the port at the same index in Server.Ports
        var serverPortsList = server.Ports.ToList();
        if (defaultIndex < serverPortsList.Count)
            return serverPortsList[defaultIndex];

        return server.Ports.FirstOrDefault();
    }

    private async Task ToggleServerState()
    {
        if (server == null) return;

        actionInProgress = true;
        try
        {
            if (server.IsRunning)
            {
                await ServerApi.StopServerAsync(server.ServerId);
            }
            else
            {
                await ServerApi.StartServerAsync(server.ServerId);
            }
            await Task.Delay(2000); // Wait a moment for state to update    
            await LoadServerAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage 
      { 
        Severity = NotificationSeverity.Error, 
        Summary = "Error", 
        Detail = $"Failed to change server state: {ex.Message}", 
        Duration = 5000 
      });
        }
        finally
        {
            actionInProgress = false;
        }
    }

    private async Task DeleteServer()
    {
        if (server == null) return;

        // Show confirmation dialog
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this server?",
            "Delete Server",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel",
                AutoFocusFirstElement = true
            });

        if (confirmed != true)
            return;

        // Show second dialog to ask about deleting data
        var deleteData = await DialogService.Confirm(
            $"Do you also want to delete the server data directories?\n\n" +
            $"This will permanently remove all game files, configurations, and world data.\n\n" +
            $"Data paths:\n{string.Join("\n", server.Volumes?.Select(v => v.Source) ?? Array.Empty<string>())}",
            "Delete Server Data?",
            new ConfirmOptions
            {
                OkButtonText = "Delete Data",
                CancelButtonText = "Keep Data",
                AutoFocusFirstElement = false
            });

        actionInProgress = true;
        StateHasChanged();

        try
        {
            await ServerApi.DeleteServerAsync(ServerId, deleteData == true);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Server Deleted",
                Detail = deleteData == true
                    ? "Server and data deleted successfully"
                    : "Server deleted successfully (data preserved)",
                Duration = 5000
            });

            // Navigate back to servers list
            NavigationManager.NavigateTo("/servers");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Delete Failed",
                Detail = $"Failed to delete server: {ex.Message}",
                Duration = 5000
            });
        }
        finally
        {
            actionInProgress = false;
            StateHasChanged();
        }
    }

    private async Task CopyConnectionString()
    {
        NotificationService.Notify(new NotificationMessage 
        { 
          Severity = NotificationSeverity.Info, 
          Summary = "Connection String", 
          Detail = GetConnectionString(), 
          Duration = 5000 
        });
    }

    private void CopyVanityConnectionString(MouseEventArgs args)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Connection String",
            Detail = GetConnectionString(VanityDomain),
            Duration = 5000
        });
    }


    private bool IsServerRunning(string? status)
    {
        return status?.ToLowerInvariant() == "running";
    }

    private BadgeStyle GetStatusBadgeStyle(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "running" => BadgeStyle.Success,
            "starting" => BadgeStyle.Info,
            "stopped" => BadgeStyle.Secondary,
            "stopping" => BadgeStyle.Warning,
            "failed" => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private string GetStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "running" => "● Running",
            "starting" => "◐ Starting",
            "stopped" => "○ Stopped",
            "stopping" => "◑ Stopping",
            "failed" => "✕ Failed",
            _ => status ?? "Unknown"
        };
    }
    
    private bool IsTtyEnabled()
    {
        return extendedMetadata?.EnableTTY == true;
    }

}
