@page "/servers/{ServerId}"
@rendermode InteractiveServer
@using GameServer.Web.Components.Server
@using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using System.Text.Json
@inject IGameServerApi ServerApi
@inject IGameTypeApi GameTypeApi
@inject NavigationManager Nav
@inject NotificationService NotificationService

<PageTitle>@(server?.Name ?? "Server Details")</PageTitle>

@if (loading)
{
  <div class="loading-container text-center py-5">
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
    <p>Loading server details...</p>
  </div>
}
else if (server == null)
{
  <RadzenCard class="error-card">
    <div class="text-center py-5">
      <RadzenIcon Icon="error" Style="font-size: 4rem; color: var(--rz-danger);" />
      <h3 class="mt-3">Server Not Found</h3>
      <p>The requested server could not be found.</p>
      <RadzenButton Text="Back to Dashboard" Click='@(() => Nav.NavigateTo("/servers"))' />
    </div>
  </RadzenCard>
}
else
{
  <div class="details-container">
    <RadzenCard class="mb-3">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
          <RadzenButton Icon="arrow_back" 
                        ButtonStyle="ButtonStyle.Light" 
                        Click='@(() => Nav.NavigateTo("/servers"))' 
                        Size="ButtonSize.Small" />
          @if (!string.IsNullOrWhiteSpace(gameType?.ThumbnailUrl))
          {
            <div class="game-thumbnail">
              <img src="@gameType.ThumbnailUrl" 
                   alt="@gameType.DisplayName"
                   onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <div class="thumbnail-fallback" style="display: none;">
                <RadzenIcon Icon="sports_esports" Style="font-size: 2rem;" />
              </div>
            </div>
          }
          <div>
            <h2 class="mb-1">@server.Name</h2>
            <div class="d-flex align-items-center gap-2">
              <RadzenBadge BadgeStyle='@GetStatusBadgeStyle(server.Status)' 
                           Text='@GetStatusText(server.Status)' />
              @if (!string.IsNullOrWhiteSpace(server.ServiceName))
              {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@server.ServiceName" Variant="Variant.Outlined" />
              }
            </div>
          </div>
        </div>
        <div class="d-flex gap-2">
          <RadzenButton Text="Edit" 
                        Icon="edit" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Click="@(() => Nav.NavigateTo($"/servers/{ServerId}/edit"))" />
          <RadzenButton Text='@(IsServerRunning(server.Status) ? "Stop" : "Start")' 
                        Icon='@(IsServerRunning(server.Status) ? "stop" : "play_arrow")' 
                        Click="ToggleServerState" 
                        ButtonStyle='@(IsServerRunning(server.Status) ? ButtonStyle.Warning : ButtonStyle.Success)' 
                        Disabled="@actionInProgress" />
          <RadzenButton Text="Delete" 
                        Icon="delete" 
                        Click="DeleteServer" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Disabled="@actionInProgress" />
        </div>
      </div>
    </RadzenCard>

    <RadzenTabs @bind-SelectedIndex="selectedTab">
      <Tabs>
        <RadzenTabsItem Text="Overview">
          <div class="tab-content">
            <div class="details-grid">
              <div class="column-left">
                <RadzenCard class="mb-3">
                  <div class="card-header">
                    <h4><RadzenIcon Icon="info" /> Server Information</h4>
                  </div>
                <div class="info-row">
                  <span class="label">Server ID:</span>
                  <span class="value">@server.ServerId</span>
                </div>
                <div class="info-row">
                  <span class="label">Game Type:</span>
                  <span class="value">@server.GameType</span>
                </div>
                <div class="info-row">
                  <span class="label">Service Name:</span>
                  <span class="value">@server.ServiceName</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(server.Description))
                {
                  <div class="info-row">
                    <span class="label">Description:</span>
                    <span class="value">@server.Description</span>
                  </div>
                }
              </RadzenCard>

              <RadzenCard class="mb-3">
                <div class="card-header">
                  <h4><RadzenIcon Icon="settings_ethernet" /> Network</h4>
                </div>
                @if (server.Ports?.Any() == true)
                {
                  @foreach (var port in server.Ports)
                  {
                    <div class="port-row mb-2">
                      <RadzenBadge BadgeStyle="BadgeStyle.Info" Text='@($"{port.PublishedPort} → {port.ContainerPort}")' />
                      <span class="protocol ms-2">@port.Protocol</span>
                    </div>
                  }
                  <div class="connection-info mt-3 pt-3 border-top">
                    <span class="label">Connect to:</span>
                    <code class="connection-string ms-2">@GetConnectionString()</code>
                    <RadzenButton Icon="content_copy" 
                                  Size="ButtonSize.Small" 
                                  Click="CopyConnectionString" 
                                  class="ms-2" />
                  </div>
                                        <div class="connection-info mt-3 pt-3 border-top">
                                            <span class="label">Connect to:</span>
                                            <code class="connection-string ms-2">@GetConnectionString(VanityDomain)</code>
                                            <RadzenButton Icon="content_copy"
                                                          Size="ButtonSize.Small"
                                                          Click="CopyVanityConnectionString"
                                                          class="ms-2" />
                                        </div>
                }
                else
                {
                  <p class="no-data">No port mappings configured</p>
                }
              </RadzenCard>

              <RadzenCard>
                <div class="card-header">
                  <h4><RadzenIcon Icon="storage" /> Volumes</h4>
                </div>
                @if (server.Volumes?.Any() == true)
                {
                  @foreach (var vol in server.Volumes)
                  {
                    <div class="volume-row mb-2">
                      <div class="volume-path">
                        <strong>Host:</strong> <code>@vol.Source</code>
                      </div>
                      <div class="volume-arrow">→</div>
                      <div class="volume-path">
                        <strong>Container:</strong> <code>@vol.Target</code>
                      </div>
                    </div>
                  }
                }
                else
                {
                  <p class="no-data">No volumes configured</p>
                }
              </RadzenCard>
            </div>

            <div class="column-right">
              <ResourceMonitor ServerId="@ServerId" AutoStart="true" />
            </div>
          </div>
          </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Logs">
          <div class="tab-content">
            <ServerLogsViewer ServerId="@ServerId" Server="@server" />
          </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Files">
          <div class="tab-content">
            <ServerFileManager ServerId="@ServerId" Server="@server" />
          </div>
        </RadzenTabsItem>
      </Tabs>
    </RadzenTabs>
  </div>
}

<style>
  .details-container {
    padding: 1rem;
  }

  .tab-content {
    padding: 1rem 0;
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 1rem;
  }

  @@media (max-width: 1200px) {
    .details-grid {
      grid-template-columns: 1fr;
    }
  }

  .card-header {
    border-bottom: 1px solid var(--rz-border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-header h4 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rz-border-color);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .label {
    font-weight: 600;
    color: var(--rz-text-secondary-color);
  }

  .value {
    color: var(--rz-text-color);
    text-align: right;
  }

  .port-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .volume-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--rz-base-100);
    border-radius: 4px;
  }

  .volume-path {
    flex: 1;
  }

  .volume-path code {
    background: var(--rz-base-200);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }

  .connection-info {
    background: var(--rz-base-50);
    padding: 0.75rem;
    border-radius: 4px;
  }

  .connection-string {
    background: var(--rz-base-200);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .no-data {
    text-align: center;
    color: var(--rz-text-secondary-color);
    padding: 2rem;
    font-style: italic;
  }

  .game-thumbnail {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid var(--rz-border-color);
    position: relative;
  }

  .game-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--rz-base-100);
  }
</style>

@code {
    [Parameter] public string ServerId { get; set; } = "";

    private string VanityDomain => "games.dev.bulavafamily.com";

    private GameServer? server;
    private GameTypeDefinition? gameType;
    private bool loading = true;
    private bool actionInProgress = false;
    private int selectedTab = 0;
    private string? publicIp;

    protected override async Task OnInitializedAsync()
    {
        await LoadServerAsync();
        await LoadPublicIpAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ServerId))
        {
            await LoadServerAsync();
        }
    }

    private async Task LoadServerAsync()
    {
        loading = true;
        try
        {
            server = await ServerApi.GetAsync(ServerId);

            if (server != null && !string.IsNullOrWhiteSpace(server.GameType))
            {
                // Load the game type definition to get thumbnail
                var allGameTypes = await GameTypeApi.GetAllAsync();
                gameType = allGameTypes.FirstOrDefault(gt => gt.Key == server.GameType);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage 
      { 
        Severity = NotificationSeverity.Error, 
        Summary = "Error", 
        Detail = $"Failed to load server: {ex.Message}", 
        Duration = 5000 
      });
            server = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadPublicIpAsync()
    {
        try
        {
            using var http = new HttpClient();
            publicIp = await http.GetStringAsync("https://api.ipify.org");
        }
        catch
        {
            publicIp = "localhost";
        }
    }

    private string GetConnectionString(string? vanity=null)
    {
        var port = server?.Ports?.FirstOrDefault()?.PublishedPort ?? 0;
        var host = vanity ?? publicIp ?? "localhost";
        return port > 0 ? $"{host}:{port}" : "N/A";
    }

    private async Task ToggleServerState()
    {
        if (server == null) return;

        actionInProgress = true;
        try
        {
            if (server.IsRunning)
            {
                await ServerApi.StopServerAsync(server.ServerId);
            }
            else
            {
                await ServerApi.StartServerAsync(server.ServerId);
            }
            await Task.Delay(2000); // Wait a moment for state to update    
            await LoadServerAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage 
      { 
        Severity = NotificationSeverity.Error, 
        Summary = "Error", 
        Detail = $"Failed to change server state: {ex.Message}", 
        Duration = 5000 
      });
        }
        finally
        {
            actionInProgress = false;
        }
    }

    private async Task DeleteServer()
    {
        if (server == null) return;

        NotificationService.Notify(new NotificationMessage 
    { 
      Severity = NotificationSeverity.Info, 
      Summary = "Info", 
      Detail = "Server deletion feature is currently disabled.", 
      Duration = 3000 
    });

        actionInProgress = false;
    }

    private async Task CopyConnectionString()
    {
        NotificationService.Notify(new NotificationMessage 
        { 
          Severity = NotificationSeverity.Info, 
          Summary = "Connection String", 
          Detail = GetConnectionString(), 
          Duration = 5000 
        });
    }

    private void CopyVanityConnectionString(MouseEventArgs args)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Connection String",
            Detail = GetConnectionString(VanityDomain),
            Duration = 5000
        });
    }


    private bool IsServerRunning(string? status)
    {
        return status?.ToLowerInvariant() == "running";
    }

    private BadgeStyle GetStatusBadgeStyle(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "running" => BadgeStyle.Success,
            "starting" => BadgeStyle.Info,
            "stopped" => BadgeStyle.Secondary,
            "stopping" => BadgeStyle.Warning,
            "failed" => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private string GetStatusText(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "running" => "● Running",
            "starting" => "◐ Starting",
            "stopped" => "○ Stopped",
            "stopping" => "◑ Stopping",
            "failed" => "✕ Failed",
            _ => status ?? "Unknown"
        };
    }
    

}
