@attribute [Obsolete("Legacy pre-V2 web hosts preview component. Migrate to the V2 server flow before removing the old repository chain.")]
@using GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor

@if (WebHosts != null && WebHosts.Any())
{
    <RadzenCard class="web-hosts-preview-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                <RadzenIcon Icon="language" Style="vertical-align: middle;" />
                Web Access Preview
            </h5>
            <RadzenBadge Text="@($"{EnabledCount} of {WebHosts.Count} Active")" 
                         BadgeStyle="@(EnabledCount > 0 ? BadgeStyle.Success : BadgeStyle.Secondary)" />
        </div>

        <p class="text-muted mb-3">
            <small>
                This server has @WebHosts.Count web interface(s) configured. 
                Based on your current settings, @EnabledCount will be accessible.
            </small>
        </p>

        <div class="web-hosts-preview-list">
            @foreach (var host in WebHosts)
            {
                var isEnabled = IsHostEnabled(host);
                var resolvedPort = GetResolvedPort(host);

                <div class="web-host-preview-item @(isEnabled ? "enabled" : "disabled")">
                    <div class="preview-status">
                        <RadzenIcon Icon="@(isEnabled ? "check_circle" : "cancel")" 
                                    Style="@($"color: {(isEnabled ? "var(--rz-success)" : "var(--rz-text-disabled-color)")}")" />
                    </div>
                    
                    <div class="preview-content">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong>@host.Name</strong>
                            @if (isEnabled)
                            {
                                <RadzenBadge Text="Will be accessible" 
                                             BadgeStyle="BadgeStyle.Success" 
                                             Size="BadgeSize.Small"
                                             IsPill="true" />
                            }
                            else
                            {
                                <RadzenBadge Text="Disabled" 
                                             BadgeStyle="BadgeStyle.Secondary" 
                                             Size="BadgeSize.Small"
                                             IsPill="true" />
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(host.Description))
                        {
                            <p class="text-muted mb-1" style="font-size: 0.875rem;">@host.Description</p>
                        }

                        <div class="preview-details">
                            @if (resolvedPort.HasValue)
                            {
                                <small class="text-muted">
                                    <RadzenIcon Icon="settings_ethernet" Style="font-size: 0.875rem; vertical-align: middle;" />
                                    Port: @resolvedPort.Value
                                    @if (!string.IsNullOrWhiteSpace(host.ContainerPortVariable))
                                    {
                                        <span> (from <code>@host.ContainerPortVariable</code>)</span>
                                    }
                                </small>
                            }
                            else if (!string.IsNullOrWhiteSpace(host.ContainerPortVariable))
                            {
                                <small class="text-warning">
                                    <RadzenIcon Icon="warning" Style="font-size: 0.875rem; vertical-align: middle;" />
                                    Port variable <code>@host.ContainerPortVariable</code> not set
                                </small>
                            }

                            @if (!string.IsNullOrWhiteSpace(host.EnabledWhen))
                            {
                                <small class="@(isEnabled ? "text-success" : "text-danger")" style="display: block; margin-top: 0.25rem;">
                                    <RadzenIcon Icon="@(isEnabled ? "rule" : "block")" 
                                                Style="font-size: 0.875rem; vertical-align: middle;" />
                                    Condition: <code>@host.EnabledWhen</code>
                                    @if (!isEnabled)
                                    {
                                        <strong> → Not met</strong>
                                    }
                                </small>
                            }
                        </div>

                        @if (!isEnabled && !string.IsNullOrWhiteSpace(host.EnabledWhen))
                        {
                            <div class="enable-hint">
                                <RadzenIcon Icon="lightbulb" Style="font-size: 0.9rem;" />
                                <small>
                                    To enable: @GetEnableHint(host)
                                </small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (EnabledCount > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small" class="mt-3">
                <RadzenIcon Icon="info" />
                After saving, access these interfaces via the <strong>Web Access</strong> tab.
            </RadzenAlert>
        }
    </RadzenCard>
}

<style>
    .web-hosts-preview-card {
        background: var(--rz-base-50);
        border: 1px solid var(--rz-border-color);
    }

    .web-hosts-preview-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .web-host-preview-item {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem;
        background: var(--rz-base-background);
        border-radius: 6px;
        border: 1px solid var(--rz-border-color);
        transition: all 0.2s;
    }

    .web-host-preview-item.enabled {
        border-left: 3px solid var(--rz-success);
    }

    .web-host-preview-item.disabled {
        border-left: 3px solid var(--rz-text-disabled-color);
        opacity: 0.7;
    }

    .preview-status {
        padding-top: 0.125rem;
    }

    .preview-content {
        flex: 1;
    }

    .preview-details {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        margin-top: 0.25rem;
    }

    .enable-hint {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        padding: 0.5rem;
        background: var(--rz-info-lighter);
        border-radius: 4px;
        color: var(--rz-info-dark);
    }

    .preview-details code {
        background: var(--rz-base-100);
        padding: 0.125rem 0.25rem;
        border-radius: 3px;
        font-size: 0.8125rem;
    }
</style>

@code {
    [Parameter] public ICollection<WebHostDefinition>? WebHosts { get; set; }
    [Parameter] public IDictionary<string, string>? ServerSettings { get; set; }

    private int EnabledCount => WebHosts?.Count(IsHostEnabled) ?? 0;

    private bool IsHostEnabled(WebHostDefinition host)
    {
        if (string.IsNullOrWhiteSpace(host.EnabledWhen))
            return true;

        if (ServerSettings == null)
            return false;

        var condition = host.EnabledWhen.Trim();

        // Parse condition: "VAR=value" or "VAR!=value"
        string varName, expectedValue;
        bool isNegated = false;

        if (condition.Contains("!="))
        {
            var parts = condition.Split("!=", 2);
            if (parts.Length != 2) return false;
            varName = parts[0].Trim();
            expectedValue = parts[1].Trim();
            isNegated = true;
        }
        else if (condition.Contains("="))
        {
            var parts = condition.Split("=", 2);
            if (parts.Length != 2) return false;
            varName = parts[0].Trim();
            expectedValue = parts[1].Trim();
        }
        else
        {
            return false;
        }

        if (!ServerSettings.TryGetValue(varName, out var actualValue))
        {
            actualValue = "";
        }

        var matches = string.Equals(actualValue, expectedValue, StringComparison.OrdinalIgnoreCase);
        return isNegated ? !matches : matches;
    }

    private int? GetResolvedPort(WebHostDefinition host)
    {
        if (!string.IsNullOrWhiteSpace(host.ContainerPortVariable))
        {
            if (ServerSettings?.TryGetValue(host.ContainerPortVariable, out var portString) == true)
            {
                if (int.TryParse(portString, out var port) && port > 0 && port <= 65535)
                {
                    return port;
                }
            }
            return null;
        }

        return host.ContainerPort > 0 ? host.ContainerPort : null;
    }

    private string GetEnableHint(WebHostDefinition host)
    {
        if (string.IsNullOrWhiteSpace(host.EnabledWhen))
            return "";

        var condition = host.EnabledWhen.Trim();

        if (condition.Contains("!="))
        {
            var parts = condition.Split("!=", 2);
            if (parts.Length == 2)
            {
                return $"Set {parts[0].Trim()} to any value except '{parts[1].Trim()}'";
            }
        }
        else if (condition.Contains("="))
        {
            var parts = condition.Split("=", 2);
            if (parts.Length == 2)
            {
                return $"Set {parts[0].Trim()} to '{parts[1].Trim()}'";
            }
        }

        return $"Ensure condition {condition} is met";
    }
}
