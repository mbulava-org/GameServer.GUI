    private string GetCpuColor(double cpuPercent)
    {
        if (cpuPercent < 50) return "#4ec9b0"; // Green
        if (cpuPercent < 75) return "#dcdcaa"; // Yellow
        return "#f48771"; // Red
    }

    private string GetMemoryColor(double memoryPercent)
    {
        if (memoryPercent < 70) return "#4ec9b0"; // Green
        if (memoryPercent < 85) return "#dcdcaa"; // Yellow
        return "#f48771"; // Red
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string FormatBytesPerSecond(double bytesPerSecond)
    {
        return $"{FormatBytes((long)bytesPerSecond)}/s";
    }

    public async ValueTask DisposeAsync()
    {
        // Clean up OUR client instance
        try
        {
            if (client != null)
            {
                client.ResourceUpdateReceived -= OnMetricsReceived;
                client.ErrorReceived -= OnErrorReceived;
                
                // Dispose OUR client
                await client.DisposeAsync();
                Logger.LogDebug("ResourceMonitor client disposed");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error during client disposal");
        }

        connectionCts?.Cancel();
        connectionCts?.Dispose();
        connectionCts = null;
    }

    private class MetricPoint
    {
        public string Timestamp { get; set; } = "";
        public double Value { get; set; }
    }
