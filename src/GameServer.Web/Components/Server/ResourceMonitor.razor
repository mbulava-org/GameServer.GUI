    private string GetMemoryUsageText()
    {
        if (currentMetrics == null) return "0 B / 0 B";
        var type = currentMetrics.GetType();
        
        long usageBytes = 0;
        long limitBytes = 0;
        
        // Try new structure
        var realTimeStatsProp = type.GetProperty("RealTimeStats");
        if (realTimeStatsProp != null)
        {
            var realTimeStats = realTimeStatsProp.GetValue(currentMetrics);
            if (realTimeStats != null)
            {
                var usageProp = realTimeStats.GetType().GetProperty("MemoryUsageBytes");
                var limitProp = realTimeStats.GetType().GetProperty("MemoryLimitBytes");
                usageBytes = (long?)(usageProp?.GetValue(realTimeStats) as ulong?) ?? 0;
                limitBytes = (long?)(limitProp?.GetValue(realTimeStats) as ulong?) ?? 0;
            }
        }
        else
        {
            // Try old structure
            var usageProp = type.GetProperty("MemoryUsageBytes");
            var limitProp = type.GetProperty("MemoryLimitBytes");
            usageBytes = (usageProp?.GetValue(currentMetrics) as long?) ?? 0;
            limitBytes = (limitProp?.GetValue(currentMetrics) as long?) ?? 0;
        }
        
        return $"{FormatBytes(usageBytes)} / {FormatBytes(limitBytes)}";
    }
    
