@using global::GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable
@inject IGameServerApi ServerApi
@inject NotificationService NotificationService

<RadzenCard class="resource-monitor">
    <div class="monitor-header">
        <div class="header-left">
            <RadzenIcon Icon="monitor_heart" Style="font-size: 1.5rem; color: var(--rz-primary);" />
            <h4>Resource Monitor</h4>
        </div>
        <div class="header-right">
            @if (isMonitoring)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="? LIVE" />
                <span class="text-muted small">Next update: @nextUpdateIn s</span>
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="? OFFLINE" />
            }
        </div>
    </div>

    @if (currentUsage != null && string.IsNullOrEmpty(errorMessage))
    {
        @if (currentUsage.HasRealTimeStats && currentUsage.RealTimeStats != null)
        {
            <div class="metrics-grid">
                @* CPU Usage Gauge *@
                <RadzenCard class="metric-card">
                    <div class="card-header">
                        <RadzenIcon Icon="speed" class="header-icon cpu-icon" />
                        <h5>CPU Usage</h5>
                    </div>
                    <div class="card-content">
                        <div class="gauge-container">
                            <RadzenArcGauge Style="width: 100%; height: 180px;">
                                <RadzenArcGaugeScale Min="0" Max="100" Y="0.8" Radius="1.8">
                                    <RadzenArcGaugeScaleValue Value="@currentUsage.RealTimeStats.CpuUsagePercent" 
                                                              Fill="@GetCpuColor(currentUsage.RealTimeStats.CpuUsagePercent)" 
                                                              FormatString="{0:F1}%" />
                                    <RadzenArcGaugeScaleRange From="0" To="60" Fill="#4ade80" />
                                    <RadzenArcGaugeScaleRange From="60" To="80" Fill="#3b82f6" />
                                    <RadzenArcGaugeScaleRange From="80" To="90" Fill="#fb923c" />
                                    <RadzenArcGaugeScaleRange From="90" To="100" Fill="#ef4444" />
                                </RadzenArcGaugeScale>
                            </RadzenArcGauge>
                        </div>
                        <div class="metric-details">
                            <div class="detail-row">
                                <span class="detail-label">Online CPUs:</span>
                                <span class="detail-value">@currentUsage.RealTimeStats.OnlineCpus</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Total Usage:</span>
                                <span class="detail-value">@FormatCpuNano(currentUsage.RealTimeStats.CpuTotalUsage)</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">System Usage:</span>
                                <span class="detail-value">@FormatCpuNano(currentUsage.RealTimeStats.CpuSystemUsage)</span>
                            </div>
                        </div>
                    </div>
                </RadzenCard>

                @* Memory Usage Gauge *@
                <RadzenCard class="metric-card">
                    <div class="card-header">
                        <RadzenIcon Icon="memory" class="header-icon memory-icon" />
                        <h5>Memory Usage</h5>
                    </div>
                    <div class="card-content">
                        <div class="gauge-container">
                            <RadzenArcGauge Style="width: 100%; height: 180px;">
                                <RadzenArcGaugeScale Min="0" Max="100" Y="0.8" Radius="1.8">
                                    <RadzenArcGaugeScaleValue Value="@currentUsage.RealTimeStats.MemoryUsagePercent" 
                                                              Fill="@GetMemoryColor(currentUsage.RealTimeStats.MemoryUsagePercent)" 
                                                              FormatString="{0:F1}%" />
                                    <RadzenArcGaugeScaleRange From="0" To="60" Fill="#4ade80" />
                                    <RadzenArcGaugeScaleRange From="60" To="80" Fill="#3b82f6" />
                                    <RadzenArcGaugeScaleRange From="80" To="90" Fill="#fb923c" />
                                    <RadzenArcGaugeScaleRange From="90" To="100" Fill="#ef4444" />
                                </RadzenArcGaugeScale>
                            </RadzenArcGauge>
                        </div>
                        <div class="metric-details">
                            <div class="detail-row">
                                <span class="detail-label">Used:</span>
                                <span class="detail-value">@FormatBytes((long)currentUsage.RealTimeStats.MemoryUsageBytes)</span>
                            </div>
                            @if (currentUsage.RealTimeStats.MemoryLimitBytes > 0)
                            {
                                <div class="detail-row">
                                    <span class="detail-label">Limit:</span>
                                    <span class="detail-value">@FormatBytes((long)currentUsage.RealTimeStats.MemoryLimitBytes)</span>
                                </div>
                            }
                            <div class="detail-row">
                                <span class="detail-label">Peak:</span>
                                <span class="detail-value">@FormatBytes((long)currentUsage.RealTimeStats.MemoryMaxUsageBytes)</span>
                            </div>
                        </div>
                    </div>
                </RadzenCard>

                @* Network I/O *@
                <RadzenCard class="metric-card">
                    <div class="card-header">
                        <RadzenIcon Icon="settings_ethernet" class="header-icon network-icon" />
                        <h5>Network I/O</h5>
                    </div>
                    <div class="card-content">
                        <div class="io-stats">
                            <div class="io-stat">
                                <div class="io-direction">
                                    <RadzenIcon Icon="arrow_downward" class="rx-icon" />
                                    <span>Received</span>
                                </div>
                                <div class="io-value">
                                    <div class="io-number">@FormatBytes(currentUsage.RealTimeStats.NetworkRxBytes)</div>
                                    <div class="io-total">Total</div>
                                </div>
                            </div>
                            <div class="io-divider"></div>
                            <div class="io-stat">
                                <div class="io-direction">
                                    <RadzenIcon Icon="arrow_upward" class="tx-icon" />
                                    <span>Transmitted</span>
                                </div>
                                <div class="io-value">
                                    <div class="io-number">@FormatBytes(currentUsage.RealTimeStats.NetworkTxBytes)</div>
                                    <div class="io-total">Total</div>
                                </div>
                            </div>
                        </div>
                        <div class="metric-note">
                            <small class="text-muted">
                                <RadzenIcon Icon="info" Style="font-size: 0.875rem;" />
                                Cumulative totals since container start
                            </small>
                        </div>
                    </div>
                </RadzenCard>

                @* Block I/O *@
                <RadzenCard class="metric-card">
                    <div class="card-header">
                        <RadzenIcon Icon="storage" class="header-icon disk-icon" />
                        <h5>Block I/O</h5>
                    </div>
                    <div class="card-content">
                        <div class="io-stats">
                            <div class="io-stat">
                                <div class="io-direction">
                                    <RadzenIcon Icon="file_download" class="read-icon" />
                                    <span>Read</span>
                                </div>
                                <div class="io-value">
                                    <div class="io-number">@FormatBytes(currentUsage.RealTimeStats.BlockReadBytes)</div>
                                    <div class="io-total">Total</div>
                                </div>
                            </div>
                            <div class="io-divider"></div>
                            <div class="io-stat">
                                <div class="io-direction">
                                    <RadzenIcon Icon="file_upload" class="write-icon" />
                                    <span>Write</span>
                                </div>
                                <div class="io-value">
                                    <div class="io-number">@FormatBytes(currentUsage.RealTimeStats.BlockWriteBytes)</div>
                                    <div class="io-total">Total</div>
                                </div>
                            </div>
                        </div>
                        <div class="metric-details mt-3">
                            <div class="detail-row">
                                <span class="detail-label">Container ID:</span>
                                <code class="detail-code">@(currentUsage.RealTimeStats.ContainerId.Length > 12 ? currentUsage.RealTimeStats.ContainerId.Substring(0, 12) : currentUsage.RealTimeStats.ContainerId)</code>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">PIDs:</span>
                                <span class="detail-value">@currentUsage.RealTimeStats.Pids</span>
                            </div>
                        </div>
                    </div>
                </RadzenCard>
            </div>

            <div class="monitor-footer">
                <small class="text-muted">
                    <RadzenIcon Icon="update" Style="font-size: 0.875rem;" />
                    Container stats from: @currentUsage.RealTimeStats.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")
                </small>
            </div>
        }
        else
        {
            <div class="no-stats-message">
                <RadzenIcon Icon="info_outline" Style="font-size: 3rem; color: var(--rz-info);" />
                <h5>Real-time container stats not available</h5>
                <p>The container is either not running or stats collection is not enabled.</p>
                <div class="service-summary mt-3">
                    <RadzenCard>
                        <div class="summary-grid">
                            <div class="summary-item">
                                <span class="summary-label">Status:</span>
                                <RadzenBadge Text="@currentUsage.ServiceStatus" BadgeStyle="@GetStatusBadgeStyle(currentUsage.ServiceStatus)" />
                            </div>
                            <div class="summary-item">
                                <span class="summary-label">Replicas:</span>
                                <span class="summary-value">@currentUsage.RunningReplicas / @currentUsage.DesiredReplicas</span>
                            </div>
                            <div class="summary-item">
                                <span class="summary-label">Health:</span>
                                <span class="summary-value">@currentUsage.ReplicaHealthPercent.ToString("F1")%</span>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
        }
    }
    else if (isMonitoring && string.IsNullOrEmpty(errorMessage))
    {
        <div class="loading-state">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <p>Fetching resource data...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <RadzenIcon Icon="error_outline" Style="font-size: 3rem; color: var(--rz-danger);" />
            <p class="error-message">@errorMessage</p>
            <RadzenButton Text="Retry" 
                          Icon="refresh"
                          Click="StartMonitoring" 
                          ButtonStyle="ButtonStyle.Danger"
                          Size="ButtonSize.Small" />
        </div>
    }
    else
    {
        <div class="idle-state">
            <RadzenIcon Icon="show_chart" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
            <p>Resource monitoring is offline</p>
            @if (!string.IsNullOrEmpty(ServerId))
            {
                <RadzenButton Text="Start Monitoring" 
                              Icon="play_arrow"
                              Click="StartMonitoring" 
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Small" />
            }
        </div>
    }

    @if (isMonitoring && !string.IsNullOrEmpty(ServerId))
    {
        <div class="monitor-controls">
            <div class="controls-content">
                <div class="control-group">
                    <RadzenLabel Text="Refresh Interval:" class="mb-0" />
                    <RadzenNumeric @bind-Value="refreshInterval" Min="1" Max="60" Step="1" Style="width:70px" />
                    <RadzenLabel Text="sec" class="mb-0" />
                </div>
                <RadzenButton Icon="stop" 
                              Text="Stop Monitoring" 
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Danger" 
                              Click="StopMonitoring" />
            </div>
        </div>
    }
</RadzenCard>

