</style>

@code {
    [Parameter] public string? ServerId { get; set; }
    [Parameter] public bool AutoStart { get; set; } = true;

    private ServerResourceUsage? currentUsage;
    private bool isMonitoring = false;
    private string? errorMessage;
    private int refreshInterval = 2;
    private int nextUpdateIn = 0;

    private CancellationTokenSource? pollingCts;
    private Task? pollingTask;

    protected override async Task OnInitializedAsync()
    {
        if (AutoStart && !string.IsNullOrEmpty(ServerId))
        {
            await StartMonitoring();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isMonitoring && !string.IsNullOrEmpty(ServerId))
        {
            await StopMonitoring();
            await StartMonitoring();
        }
    }

    private async Task StartMonitoring()
    {
        if (string.IsNullOrEmpty(ServerId))
        {
            errorMessage = "Server ID is required";
            return;
        }

        isMonitoring = true;
        errorMessage = null;
        pollingCts = new CancellationTokenSource();
        pollingTask = PollResourcesAsync(pollingCts.Token);

        await InvokeAsync(StateHasChanged);
    }

    private async Task PollResourcesAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                currentUsage = await ServerApi.GetResourceUsageAsync(ServerId!, cancellationToken);
                errorMessage = null;

                await InvokeAsync(StateHasChanged);

                for (int i = refreshInterval; i > 0; i--)
                {
                    if (cancellationToken.IsCancellationRequested)
                        break;

                    nextUpdateIn = i;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000, cancellationToken);
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to fetch resource data: {ex.Message}";
                currentUsage = null;
                
                await InvokeAsync(() =>
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Resource Monitor Error",
                        Detail = errorMessage,
                        Duration = 5000
                    });
                    StateHasChanged();
                });

                try
                {
                    await Task.Delay(refreshInterval * 1000, cancellationToken);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        }
    }

    private async Task StopMonitoring()
    {
        isMonitoring = false;
        
        if (pollingCts != null)
        {
            pollingCts.Cancel();
            
            if (pollingTask != null)
            {
                try
                {
                    await pollingTask;
                }
                catch (OperationCanceledException)
                {
                }
            }
            
            pollingCts.Dispose();
            pollingCts = null;
            pollingTask = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private string GetCpuColor(double percent)
    {
        if (percent >= 90) return "#ef4444";
        if (percent >= 80) return "#fb923c";
        if (percent >= 60) return "#3b82f6";
        return "#4ade80";
    }

    private string GetMemoryColor(double percent)
    {
        if (percent >= 90) return "#ef4444";
        if (percent >= 80) return "#fb923c";
        if (percent >= 60) return "#3b82f6";
        return "#4ade80";
    }

    private BadgeStyle GetStatusBadgeStyle(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "running" => BadgeStyle.Success,
            "starting" => BadgeStyle.Info,
            "stopped" => BadgeStyle.Secondary,
            "stopping" => BadgeStyle.Warning,
            "failed" => BadgeStyle.Danger,
            _ => BadgeStyle.Secondary
        };
    }

    private string FormatBytes(long bytes)
    {
        if (bytes == 0) return "0 B";
        if (bytes < 0) return "N/A";

        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string FormatCpuNano(ulong nanoCpus)
    {
        // Convert nanoseconds to seconds
        double seconds = nanoCpus / 1_000_000_000.0;
        return $"{seconds:0.##}s";
    }

    public async ValueTask DisposeAsync()
    {
        await StopMonitoring();
    }
}
