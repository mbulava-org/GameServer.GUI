@using Microsoft.Extensions.Options
@using GameServer.Web.Configurations
@using GameServer.Web.Models.V2
@using GameServer.Web.Services.V2
@using GameServer.API.Client.Interfaces
@using Radzen
@using Radzen.Blazor
@inject IOptions<GameServerDockerApi> ApiConfig
@inject IGameServerV2ApiService GameServerApiV2
@inject NotificationService NotificationService
@inject ILogger<ResourceMonitorTab> Logger
@implements IAsyncDisposable

<div class="resource-monitor-container">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0">Live Resource Usage</h5>
            @if (isConnected)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Live Monitoring" Variant="Variant.Flat" />
            }
            else if (isConnecting)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Connecting..." Variant="Variant.Flat" />
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Disconnected" Variant="Variant.Flat" />
            }
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (latestUsage is not null)
            {
                <span class="text-muted small">Last update: @latestUsage.Timestamp.ToLocalTime().ToString("T")</span>
            }
            @if (!isConnected && !isConnecting)
            {
                <RadzenButton Icon="refresh" Text="Reconnect" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ConnectAndSubscribeAsync" />
            }
        </div>
    </div>

    @if (latestUsage is null && isConnecting)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Connecting to resource stream for server @ServerId...</p>
        </div>
    }
    else if (latestUsage is null && !isConnected)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
            Resource usage data is currently unavailable. Ensure the game server container is running and the Node Agent is connected.
            <div class="mt-2">
                <RadzenButton Text="Retry Connection" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ConnectAndSubscribeAsync" />
            </div>
        </RadzenAlert>
    }
    else
    {
        <div class="row g-3 mb-4">
            <!-- CPU Card -->
            <div class="col-lg-3 col-md-6">
                <RadzenCard class="h-100 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold">CPU Usage</span>
                        <RadzenIcon Icon="memory" Style="color: var(--rz-primary);" />
                    </div>
                    <div class="d-flex align-items-baseline gap-1 mb-2">
                        <h2 class="mb-0 fw-bold">@((latestUsage?.CpuUsagePercent ?? 0).ToString("F1"))</h2>
                        <span class="text-muted fs-5">%</span>
                    </div>
                    <RadzenProgressBar Value="@(Math.Clamp(latestUsage?.CpuUsagePercent ?? 0, 0, 100))"
                                       Max="100"
                                       ShowValue="false"
                                       ProgressBarStyle="@GetCpuProgressStyle(latestUsage?.CpuUsagePercent ?? 0)"
                                       Style="height: 8px;" />
                </RadzenCard>
            </div>

            <!-- Memory Card -->
            <div class="col-lg-3 col-md-6">
                <RadzenCard class="h-100 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold">Memory Usage</span>
                        <RadzenIcon Icon="developer_board" Style="color: var(--rz-info);" />
                    </div>
                    <div class="d-flex align-items-baseline gap-1 mb-2">
                        <h2 class="mb-0 fw-bold">@FormatBytes(latestUsage?.MemoryUsageBytes ?? 0)</h2>
                        @if ((latestUsage?.MemoryLimitBytes ?? 0) > 0)
                        {
                            <span class="text-muted small">/ @FormatBytes(latestUsage!.MemoryLimitBytes!.Value)</span>
                        }
                    </div>
                    <RadzenProgressBar Value="@(Math.Clamp(latestUsage?.MemoryUsagePercent ?? 0, 0, 100))"
                                       Max="100"
                                       ShowValue="false"
                                       ProgressBarStyle="@GetMemoryProgressStyle(latestUsage?.MemoryUsagePercent ?? 0)"
                                       Style="height: 8px;" />
                    <div class="d-flex justify-content-between mt-1 text-muted small">
                        <span>@((latestUsage?.MemoryUsagePercent ?? 0).ToString("F1"))% used</span>
                    </div>
                </RadzenCard>
            </div>

            <!-- Network I/O Card -->
            <div class="col-lg-3 col-md-6">
                <RadzenCard class="h-100 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold">Network I/O</span>
                        <RadzenIcon Icon="swap_vert" Style="color: var(--rz-success);" />
                    </div>
                    <div class="mt-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small"><RadzenIcon Icon="arrow_downward" Style="font-size: 0.9rem; color: var(--rz-success);" /> Rx (In)</span>
                            <strong>@FormatBytes(latestUsage?.NetworkRxBytes ?? 0)</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small"><RadzenIcon Icon="arrow_upward" Style="font-size: 0.9rem; color: var(--rz-info);" /> Tx (Out)</span>
                            <strong>@FormatBytes(latestUsage?.NetworkTxBytes ?? 0)</strong>
                        </div>
                    </div>
                </RadzenCard>
            </div>

            <!-- Block I/O Card -->
            <div class="col-lg-3 col-md-6">
                <RadzenCard class="h-100 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold">Disk I/O</span>
                        <RadzenIcon Icon="storage" Style="color: var(--rz-warning);" />
                    </div>
                    <div class="mt-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Read</span>
                            <strong>@FormatBytes(latestUsage?.BlockReadBytes ?? 0)</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Write</span>
                            <strong>@FormatBytes(latestUsage?.BlockWriteBytes ?? 0)</strong>
                        </div>
                    </div>
                </RadzenCard>
            </div>
        </div>
    }

    <!-- Resource History Section -->
    <RadzenCard class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <RadzenIcon Icon="history" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                <h5 class="mb-0">Resource History</h5>
                @if (historyRecords.Any())
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@($"{historyRecords.Count} records")" Variant="Variant.Flat" />
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <RadzenDropDown TValue="int"
                                Data="@(new[] { 25, 50, 100, 250, 500 })"
                                Value="@historyLimit"
                                ValueChanged="@OnHistoryLimitChanged"
                                Style="width: 100px;" />
                <RadzenButton Icon="refresh"
                              Text="Refresh History"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@LoadHistoryAsync"
                              Disabled="@isHistoryLoading" />
            </div>
        </div>

        @if (isHistoryLoading && !historyRecords.Any())
        {
            <div class="text-center py-4">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <p class="mt-2 text-muted small">Loading historical resource records...</p>
            </div>
        }
        else if (!historyRecords.Any())
        {
            <div class="text-center py-4 border rounded bg-light">
                <RadzenIcon Icon="analytics" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                <p class="text-muted mt-2 mb-0">No historical resource records have been saved yet for this game server.</p>
            </div>
        }
        else
        {
            <RadzenDataGrid Data="@historyRecords"
                            TItem="GameServerResourceHistoryItem"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="10"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            ShowPagingSummary="true"
                            class="border rounded">
                <Columns>
                    <RadzenDataGridColumn TItem="GameServerResourceHistoryItem" Property="Timestamp" Title="Time" Width="170px" SortOrder="SortOrder.Descending">
                        <Template Context="item">
                            <span>@item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerResourceHistoryItem" Property="CpuUsagePercent" Title="CPU" Width="110px">
                        <Template Context="item">
                            <span class="fw-bold">@((item.CpuUsagePercent ?? 0).ToString("F1"))%</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerResourceHistoryItem" Property="MemoryUsageBytes" Title="Memory" Width="180px">
                        <Template Context="item">
                            <div>@FormatBytes(item.MemoryUsageBytes ?? 0)</div>
                            <small class="text-muted">@((item.MemoryUsagePercent ?? 0).ToString("F1"))% used</small>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerResourceHistoryItem" Title="Network I/O" Width="180px" Sortable="false">
                        <Template Context="item">
                            <div class="small">
                                <span class="text-success"><RadzenIcon Icon="arrow_downward" Style="font-size: 0.8rem;" /> @FormatBytes(item.NetworkRxBytes ?? 0)</span>
                                <span class="ms-2 text-info"><RadzenIcon Icon="arrow_upward" Style="font-size: 0.8rem;" /> @FormatBytes(item.NetworkTxBytes ?? 0)</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerResourceHistoryItem" Title="Disk I/O" Width="180px" Sortable="false">
                        <Template Context="item">
                            <div class="small text-muted">
                                <span>R: @FormatBytes(item.BlockReadBytes ?? 0)</span>
                                <span class="ms-2">W: @FormatBytes(item.BlockWriteBytes ?? 0)</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="GameServerResourceHistoryItem" Property="RunningReplicas" Title="Replicas" Width="100px">
                        <Template Context="item">
                            <RadzenBadge BadgeStyle="@(item.RunningReplicas >= item.DesiredReplicas && item.RunningReplicas > 0 ? BadgeStyle.Success : BadgeStyle.Warning)"
                                         Text="@($"{item.RunningReplicas}/{item.DesiredReplicas}")"
                                         Size="BadgeSize.Small" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
</div>

@code {
    [Parameter]
    public string? ServerId { get; set; }

    [Parameter]
    public bool AutoConnect { get; set; } = true;

    [Parameter]
    public IResourceMonitoringClient? Client { get; set; }

    private IResourceMonitoringClient? client;
    private ServerResourceUsage? latestUsage;
    private bool isConnected;
    private bool isConnecting;
    private List<GameServerResourceHistoryItem> historyRecords = [];
    private bool isHistoryLoading;
    private int historyLimit = 100;

    protected override async Task OnParametersSetAsync()
    {
        if (AutoConnect)
        {
            await ConnectAndSubscribeAsync();
        }

        await LoadHistoryAsync();
    }

    private async Task OnHistoryLimitChanged(int newLimit)
    {
        historyLimit = newLimit;
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId) || GameServerApiV2 is null)
        {
            return;
        }

        try
        {
            isHistoryLoading = true;
            var result = await GameServerApiV2.GetResourceHistoryAsync(ServerId, limit: historyLimit);
            historyRecords = result.OrderByDescending(r => r.Timestamp).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load resource history for server {ServerId}", ServerId);
            historyRecords = [];
        }
        finally
        {
            isHistoryLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConnectAndSubscribeAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId))
        {
            return;
        }

        try
        {
            isConnecting = true;
            await DisconnectAsync();

            if (Client != null)
            {
                client = Client;
            }
            else
            {
                var baseUri = ApiConfig.Value.BaseUri?.TrimEnd('/') ?? "http://localhost:5164";
                var hubUrl = $"{baseUri}/hubs/resources";
                client = new GameServer.API.Client.Services.ResourceMonitoringClient(hubUrl);
            }

            client.ResourceUpdateReceived += OnResourceUpdate;
            client.ErrorReceived += OnError;

            await client.ConnectAsync(CancellationToken.None);
            isConnected = true;

            try
            {
                var snapshot = await client.GetSnapshotAsync(ServerId, CancellationToken.None);
                if (snapshot != null)
                {
                    latestUsage = snapshot;
                }
            }
            catch (Exception snapshotEx)
            {
                Logger.LogDebug(snapshotEx, "Initial snapshot fetch failed; waiting for live stream updates for server {ServerId}", ServerId);
            }

            await client.SubscribeToServerAsync(ServerId, intervalSeconds: 2, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to connect to ResourceMonitoringHub for server {ServerId}", ServerId);
            isConnected = false;
        }
        finally
        {
            isConnecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnResourceUpdate(object? sender, ServerResourceUsage usage)
    {
        InvokeAsync(() =>
        {
            latestUsage = usage;
            StateHasChanged();
        });
    }

    private void OnError(object? sender, string error)
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private static ProgressBarStyle GetCpuProgressStyle(double percent) =>
        percent switch
        {
            > 85 => ProgressBarStyle.Danger,
            > 65 => ProgressBarStyle.Warning,
            _ => ProgressBarStyle.Primary
        };

    private static ProgressBarStyle GetMemoryProgressStyle(double percent) =>
        percent switch
        {
            > 90 => ProgressBarStyle.Danger,
            > 75 => ProgressBarStyle.Warning,
            _ => ProgressBarStyle.Info
        };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task DisconnectAsync()
    {
        if (client is not null)
        {
            try
            {
                client.ResourceUpdateReceived -= OnResourceUpdate;
                client.ErrorReceived -= OnError;
                await client.UnsubscribeAsync(CancellationToken.None);
                await client.StopAsync(CancellationToken.None);
                await client.DisposeAsync();
            }
            catch
            {
                // Best effort disconnect
            }
            finally
            {
                client = null;
                isConnected = false;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DisconnectAsync();
    }
}
