@using Radzen
@using Radzen.Blazor
@attribute [Obsolete("Legacy pre-V2 server environment editor. Migrate to the V2 server flow before removing the old repository chain.")]
@using global::GameServer.Docker.Client
@using System.Linq
@using Microsoft.AspNetCore.Components.Rendering
@inject IGameTypeExtendedMetadataApi ExtendedMetadataApi
@inject IPortApi PortApi
@inject NotificationService NotificationService

@if (isLoadingMetadata)
{
    <div class="text-center py-4">
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        <p class="text-muted mt-2">Loading environment settings...</p>
    </div>
}
else if (GameTypeDefinition?.DefaultSettings == null || !GameTypeDefinition.DefaultSettings.Any())
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="mb-3">
        <div class="d-flex align-items-center gap-2">
            <RadzenIcon Icon="info" />
            <span>No environment variables configured for this game type.</span>
        </div>
    </RadzenAlert>
}
else if (extendedMetadata?.SettingsMetadata?.Any() == true || GameTypeDefinition?.DefaultSettings?.Any() == true)
{
    @* Render settings grouped by category in tabs *@
    @* Create metadata entries for settings that don't have metadata *@
    var allSettingsMetadata = new Dictionary<string, SettingMetadata>();
    
    // First, add all settings from GameTypeDefinition.DefaultSettings
    if (GameTypeDefinition?.DefaultSettings != null)
    {
        foreach (var setting in GameTypeDefinition.DefaultSettings)
        {
            if (!allSettingsMetadata.ContainsKey(setting.Key))
            {
                // Create a basic metadata entry if one doesn't exist
                allSettingsMetadata[setting.Key] = new SettingMetadata
                {
                    Key = setting.Key,
                    Category = "General",
                    DisplayOrder = 999,
                    DataType = InferDataType(setting.Value)
                };
            }
        }
    }
    
    // Then overlay with actual metadata from extended metadata
    if (extendedMetadata?.SettingsMetadata != null)
    {
        foreach (var kvp in extendedMetadata.SettingsMetadata)
        {
            allSettingsMetadata[kvp.Key] = kvp.Value;
        }
    }
    
    var categories = allSettingsMetadata.Values
        .GroupBy(s => s.Category ?? "General")
        .OrderBy(g => g.Key == "General" ? 0 : 1)
        .ThenBy(g => g.Key)
        .ToList();

    @if (categories.Count > 1)
    {
        <RadzenTabs @bind-SelectedIndex="selectedTabIndex">
            <Tabs>
                @foreach (var category in categories)
                {
                    <RadzenTabsItem Text="@category.Key">
                        <div class="category-content">
                            @RenderCategorySettings(category.OrderBy(s => s.DisplayOrder))
                        </div>
                    </RadzenTabsItem>
                }
            </Tabs>
        </RadzenTabs>
    }
    else
    {
        @* Single category - no tabs needed *@
        <div class="category-content">
            @RenderCategorySettings(categories.First().OrderBy(s => s.DisplayOrder))
        </div>
    }
}
else
{
    @* Fallback: Render basic settings without metadata *@
    @if (GameTypeDefinition?.DefaultSettings != null)
    {
        <div class="settings-grid">
            @foreach (var setting in GameTypeDefinition.DefaultSettings.OrderBy(s => s.Key))
            {
                <div class="setting-item">
                    <label class="setting-label">@setting.Key</label>
                    <RadzenFormField Variant="@Variant.Outlined" class="w-100">
                        <RadzenTextBox Value="@GetSettingValue(setting.Key)" 
                                       ValueChanged="@((string value) => SetSettingValue(setting.Key, value))"
                                       Placeholder="@setting.Value"
                                       class="w-100" />
                    </RadzenFormField>
                    <small class="text-muted">Default: @setting.Value</small>
                </div>
            }
        </div>
    }
}

@if (validationErrors.Any())
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" class="mt-3">
        <div class="d-flex flex-column gap-1">
            <div class="fw-bold">
                <RadzenIcon Icon="error" />
                Validation Errors:
            </div>
            @foreach (var error in validationErrors)
            {
                <div class="ms-3">• @error</div>
            }
        </div>
    </RadzenAlert>
}

<style>
    .category-content {
        padding: 1.5rem 0;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .setting-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .setting-label {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--rz-text-title-color);
    }

    .required-indicator {
        color: var(--rz-danger);
        font-weight: bold;
    }

    .setting-description {
        font-size: 0.75rem;
        color: var(--rz-text-secondary-color);
        line-height: 1.4;
        margin-top: -0.25rem;
    }

    .setting-validation-error {
        font-size: 0.75rem;
        color: var(--rz-danger);
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .settings-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [Parameter] public GameTypeDefinition? GameTypeDefinition { get; set; }
    [Parameter] public GameServer? Server { get; set; }
    [Parameter] public EventCallback<GameServer> ServerChanged { get; set; }
    [Parameter] public EventCallback<bool> OnValidationChanged { get; set; }
    [Parameter] public EventCallback OnPortsChanged { get; set; }

    private GameTypeExtendedMetadata? extendedMetadata;
    private bool isLoadingMetadata = false;
    private List<string> validationErrors = new();
    private int selectedTabIndex = 0;

    protected override async Task OnParametersSetAsync()
    {
        if (GameTypeDefinition != null && !string.IsNullOrEmpty(GameTypeDefinition.Key))
        {
            await LoadExtendedMetadataAsync();
        }
    }

    private async Task LoadExtendedMetadataAsync()
    {
        isLoadingMetadata = true;
        StateHasChanged();

        try
        {
            extendedMetadata = await ExtendedMetadataApi.GetAsync(GameTypeDefinition!.Key);
            
            // Initialize settings in Server.Settings if not already present
            if (extendedMetadata?.SettingsMetadata != null && Server != null)
            {
                foreach (var settingMeta in extendedMetadata.SettingsMetadata.Values)
                {
                    if (!Server.Settings.ContainsKey(settingMeta.Key))
                    {
                        // Set default value from Definition if available
                        if (GameTypeDefinition.DefaultSettings?.TryGetValue(settingMeta.Key, out var defaultValue) == true)
                        {
                            Server.Settings[settingMeta.Key] = defaultValue;
                        }
                        else
                        {
                            Server.Settings[settingMeta.Key] = "";
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
            // Extended metadata is optional - if not found, fall back to basic rendering
            extendedMetadata = null;
        }
        finally
        {
            isLoadingMetadata = false;
            StateHasChanged();
        }
    }

    private RenderFragment RenderCategorySettings(IEnumerable<SettingMetadata> settings)
    {
        return builder =>
        {
            var sequence = 0;
            
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "settings-grid");
            
            foreach (var settingMeta in settings)
            {
                // Skip settings without a key or with invalid data
                if (string.IsNullOrWhiteSpace(settingMeta.Key))
                    continue;
                    
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "setting-item");
                builder.AddContent(sequence++, RenderSettingControl(settingMeta));
                builder.CloseElement();
            }
            
            builder.CloseElement();
        };
    }

    private string GetSettingValue(string key)
    {
        if (Server?.Settings.TryGetValue(key, out var value) == true)
            return value;
        return "";
    }

    private async Task SetSettingValue(string key, string value)
    {
        if (Server == null) return;
        
        Server.Settings[key] = value;

        // Check if this setting maps to a container port
        if (extendedMetadata?.SettingsMetadata.TryGetValue(key, out var settingMeta) == true && 
            settingMeta.MapsToContainerPort && 
            settingMeta.LinkedContainerPort.HasValue)
        {
            // Find the port mapping with the linked container port
            var portMapping = Server.Ports?.FirstOrDefault(p => 
                p.ContainerPort == settingMeta.LinkedContainerPort.Value &&
                p.Protocol.Equals(settingMeta.PortProtocol, StringComparison.OrdinalIgnoreCase));

            if (portMapping != null && int.TryParse(value, out var newPort) && newPort > 0)
            {
                var isUdp = settingMeta.PortProtocol.Equals("udp", StringComparison.OrdinalIgnoreCase);
                
                if (isUdp)
                {
                    // UDP: All three must match (Setting = ContainerPort = PublishedPort)
                    portMapping.ContainerPort = newPort;
                    portMapping.PublishedPort = newPort;
                }
                else
                {
                    // TCP: Setting = ContainerPort, but PublishedPort can differ
                    // Only update PublishedPort if it was previously matching the old ContainerPort
                    var wasMatching = portMapping.PublishedPort == portMapping.ContainerPort;
                    portMapping.ContainerPort = newPort;
                    
                    if (wasMatching)
                    {
                        // Published port was matching, update it too
                        portMapping.PublishedPort = newPort;
                    }
                    // Otherwise leave PublishedPort as-is (user may have customized it)
                }

                // Process port relationships - update related ports
                if (settingMeta.PortRelationships?.Any() == true)
                {
                    foreach (var relationship in settingMeta.PortRelationships)
                    {
                        // Find the related port mapping
                        var relatedPort = Server.Ports?.FirstOrDefault(p => 
                            p.ContainerPort == relationship.TargetContainerPort &&
                            p.Protocol.Equals(relationship.TargetProtocol, StringComparison.OrdinalIgnoreCase));

                        if (relatedPort != null)
                        {
                            int calculatedPort = 0;

                            switch (relationship.RelationType)
                            {
                                case PortRelationshipType.Offset:
                                    // Calculate: SourcePort + Offset
                                    calculatedPort = newPort + relationship.Offset;
                                    break;

                                case PortRelationshipType.Fixed:
                                    // Use fixed value
                                    calculatedPort = (int)(relationship.FixedValue ?? relationship.TargetContainerPort);
                                    break;

                                case PortRelationshipType.Multiplier:
                                    // Calculate: SourcePort * Offset (using Offset as multiplier)
                                    calculatedPort = newPort * relationship.Offset;
                                    break;
                            }

                            // Validate the calculated port is in valid range
                            if (calculatedPort > 0 && calculatedPort <= 65535)
                            {
                                var relatedIsUdp = relationship.TargetProtocol.Equals("udp", StringComparison.OrdinalIgnoreCase);
                                
                                if (relatedIsUdp)
                                {
                                    // UDP: All must match
                                    relatedPort.ContainerPort = calculatedPort;
                                    relatedPort.PublishedPort = calculatedPort;
                                }
                                else
                                {
                                    // TCP: Update container port, published port only if it was matching
                                    var relatedWasMatching = relatedPort.PublishedPort == relatedPort.ContainerPort;
                                    relatedPort.ContainerPort = calculatedPort;
                                    
                                    if (relatedWasMatching)
                                    {
                                        relatedPort.PublishedPort = calculatedPort;
                                    }
                                }
                            }
                        }
                        else if (relationship.IsRequired)
                        {
                            // Required related port doesn't exist - we should create it
                            // This handles cases where the GameType defines relationships but the port wasn't in the initial list
                            int calculatedPort = 0;

                            switch (relationship.RelationType)
                            {
                                case PortRelationshipType.Offset:
                                    calculatedPort = newPort + relationship.Offset;
                                    break;

                                case PortRelationshipType.Fixed:
                                    calculatedPort = (int)(relationship.FixedValue ?? relationship.TargetContainerPort);
                                    break;

                                case PortRelationshipType.Multiplier:
                                    calculatedPort = newPort * relationship.Offset;
                                    break;
                            }

                            if (calculatedPort > 0 && calculatedPort <= 65535)
                            {
                                // Create the missing required port
                                var newRelatedPort = new PortMapping
                                {
                                    ContainerPort = calculatedPort,
                                    PublishedPort = calculatedPort,
                                    Protocol = relationship.TargetProtocol
                                };
                                
                                Server.Ports ??= new List<PortMapping>();
                                Server.Ports.Add(newRelatedPort);
                            }
                        }
                    }
                }

                // Notify that ports were changed so validation can run
                if (OnPortsChanged.HasDelegate)
                {
                    await OnPortsChanged.InvokeAsync();
                }
            }
        }

        await ValidateAsync();
        await ServerChanged.InvokeAsync(Server);
    }

    public async Task<bool> ValidateAsync()
    {
        validationErrors.Clear();

        if (extendedMetadata?.SettingsMetadata == null || Server == null)
        {
            await OnValidationChanged.InvokeAsync(true);
            return true;
        }

        // Validate required fields
        foreach (var settingMeta in extendedMetadata.SettingsMetadata.Values)
        {
            if (settingMeta.IsRequired)
            {
                if (!Server.Settings.ContainsKey(settingMeta.Key) || 
                    string.IsNullOrWhiteSpace(Server.Settings[settingMeta.Key]))
                {
                    validationErrors.Add($"{settingMeta.Key} is required");
                }
            }

            // Validate CannotBeEmpty
            if (settingMeta.CannotBeEmpty && 
                Server.Settings.TryGetValue(settingMeta.Key, out var value) &&
                string.IsNullOrWhiteSpace(value))
            {
                validationErrors.Add($"{settingMeta.Key} cannot be empty");
            }

            // Validate patterns
            if (!string.IsNullOrWhiteSpace(settingMeta.ValidationPattern) &&
                Server.Settings.TryGetValue(settingMeta.Key, out var patternValue) &&
                !string.IsNullOrWhiteSpace(patternValue))
            {
                if (!System.Text.RegularExpressions.Regex.IsMatch(patternValue, settingMeta.ValidationPattern))
                {
                    validationErrors.Add(settingMeta.ValidationMessage ?? $"{settingMeta.Key} format is invalid");
                }
            }

            // Validate port ranges if DataType is "port"
            if (settingMeta.DataType?.ToLowerInvariant() == "port" &&
                Server.Settings.TryGetValue(settingMeta.Key, out var portValue) &&
                !string.IsNullOrWhiteSpace(portValue))
            {
                if (int.TryParse(portValue, out var port))
                {
                    // Validate range
                    if (settingMeta.PortValidation != null)
                    {
                        if (port < settingMeta.PortValidation.MinPort || port > settingMeta.PortValidation.MaxPort)
                        {
                            validationErrors.Add($"{settingMeta.Key} must be between {settingMeta.PortValidation.MinPort} and {settingMeta.PortValidation.MaxPort}");
                            continue; // Skip availability check if range is invalid
                        }
                    }
                    else if (port < 1 || port > 65535)
                    {
                        validationErrors.Add($"{settingMeta.Key} must be a valid port (1-65535)");
                        continue; // Skip availability check if range is invalid
                    }

                    // Validate availability if this setting maps to a container port
                    if (settingMeta.MapsToContainerPort && settingMeta.LinkedContainerPort.HasValue)
                    {
                        // Find the protocol for this port
                        var protocol = settingMeta.PortProtocol ?? "tcp";

                        // Check if the main port is available
                        var isMainPortAvailable = await PortApi.CheckAsync(protocol, port);
                        if (!isMainPortAvailable)
                        {
                            validationErrors.Add($"{settingMeta.Key}: Port {port}/{protocol} is already in use");
                        }

                        // Validate all related ports from relationships
                        if (settingMeta.PortRelationships?.Any() == true)
                        {
                            foreach (var relationship in settingMeta.PortRelationships)
                            {
                                int calculatedPort = relationship.RelationType switch
                                {
                                    PortRelationshipType.Offset => port + relationship.Offset,
                                    PortRelationshipType.Fixed => (int)(relationship.FixedValue ?? relationship.TargetContainerPort),
                                    PortRelationshipType.Multiplier => port * relationship.Offset,
                                    _ => 0
                                };

                                // Validate calculated port range
                                if (calculatedPort < 1 || calculatedPort > 65535)
                                {
                                    validationErrors.Add($"{relationship.Description ?? $"Related port {relationship.TargetContainerPort}/{relationship.TargetProtocol}"}: Calculated port {calculatedPort} is out of valid range (1-65535)");
                                    continue;
                                }

                                // Check if calculated port is available
                                var isRelatedPortAvailable = await PortApi.CheckAsync(relationship.TargetProtocol, calculatedPort);
                                if (!isRelatedPortAvailable)
                                {
                                    validationErrors.Add($"{relationship.Description ?? $"Related port {relationship.TargetContainerPort}/{relationship.TargetProtocol}"}: Port {calculatedPort}/{relationship.TargetProtocol} is already in use");
                                }
                            }
                        }
                    }
                }
                else
                {
                    validationErrors.Add($"{settingMeta.Key} must be a valid number");
                }
            }
        }

        var isValid = validationErrors.Count == 0;
        await OnValidationChanged.InvokeAsync(isValid);
        StateHasChanged();
        return isValid;
    }

    public List<string> GetValidationErrors() => new List<string>(validationErrors);

    private string? InferDataType(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "string";

        // Try to infer type from value
        if (bool.TryParse(value, out _))
            return "boolean";

        if (int.TryParse(value, out var intVal))
        {
            // Check if it looks like a port number
            if (intVal >= 1 && intVal <= 65535)
                return "number"; // Could be port, but safer to default to number
            return "number";
        }

        return "string";
    }

    private RenderFragment RenderSettingControl(SettingMetadata settingMeta)
    {
        return builder =>
        {
            var sequence = 0;
            
            // Ensure setting exists in Server.Settings
            if (Server != null && !Server.Settings.ContainsKey(settingMeta.Key))
            {
                Server.Settings[settingMeta.Key] = "";
            }

            // Label with required indicator
            builder.OpenElement(sequence++, "label");
            builder.AddAttribute(sequence++, "class", "setting-label");
            builder.AddContent(sequence++, settingMeta.Key);
            if (settingMeta.IsRequired)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "required-indicator");
                builder.AddContent(sequence++, " *");
                builder.CloseElement();
            }
            builder.CloseElement();

            // Render appropriate control based on DataType
            var dataType = settingMeta.DataType?.ToLowerInvariant() ?? "string";

            // Normalize null or empty dataType to "string"
            if (string.IsNullOrWhiteSpace(dataType))
            {
                dataType = "string";
            }

            if (dataType == "boolean")
            {
                RenderBooleanControl(builder, ref sequence, settingMeta);
            }
            else if (dataType == "number" || dataType == "port")
            {
                RenderNumberControl(builder, ref sequence, settingMeta);
            }
            else if (dataType == "enum" && settingMeta.AllowedValues?.Any() == true)
            {
                RenderEnumControl(builder, ref sequence, settingMeta);
            }
            else if (dataType == "timezone")
            {
                RenderTimezoneControl(builder, ref sequence, settingMeta);
            }
            else if (dataType == "list")
            {
                RenderListControl(builder, ref sequence, settingMeta);
            }
            else
            {
                // Default to text control for string or unknown types
                RenderTextControl(builder, ref sequence, settingMeta);
            }

            // Description
            if (!string.IsNullOrWhiteSpace(settingMeta.Description))
            {
                builder.OpenElement(sequence++, "small");
                builder.AddAttribute(sequence++, "class", "setting-description");
                builder.AddContent(sequence++, settingMeta.Description);
                builder.CloseElement();
            }
        };
    }

    private void RenderTextControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        if (Server == null) return;

        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenTextBox>(s2++);
            b2.AddAttribute(s2++, "Value", Server.Settings.TryGetValue(settingMeta.Key, out var val) ? val : "");
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<string>(this, async value =>
            {
                await SetSettingValue(settingMeta.Key, value);
            }));
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? "");
            b2.AddAttribute(s2++, "class", "w-100");
            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void RenderNumberControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        if (Server == null) return;

        // Parse current value
        int currentValue = 0;
        if (Server.Settings.TryGetValue(settingMeta.Key, out var strValue))
        {
            int.TryParse(strValue, out currentValue);
        }

        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenNumeric<int>>(s2++);
            
            b2.AddAttribute(s2++, "Value", currentValue);
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<int>(this, async value =>
            {
                await SetSettingValue(settingMeta.Key, value.ToString());
            }));
            b2.AddAttribute(s2++, "class", "w-100");
            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void RenderBooleanControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        if (Server == null) return;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "d-flex align-items-center gap-2 mt-2");
        
        builder.OpenComponent<RadzenSwitch>(sequence++);
        
        // Parse current value
        bool currentValue = false;
        if (Server.Settings.TryGetValue(settingMeta.Key, out var strValue))
        {
            bool.TryParse(strValue, out currentValue);
        }
        
        builder.AddAttribute(sequence++, "Value", currentValue);
        builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<bool>(this, async value =>
        {
            await SetSettingValue(settingMeta.Key, value.ToString().ToLower());
        }));
        builder.CloseComponent();

        // Add value mapping label if available
        if (settingMeta.ValueMappings?.Any() == true)
        {
            var mappingKey = currentValue.ToString().ToLower();
            if (settingMeta.ValueMappings.TryGetValue(mappingKey, out var mappingLabel))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "text-muted");
                builder.AddContent(sequence++, mappingLabel);
                builder.CloseElement();
            }
        }
        
        builder.CloseElement();
    }

    private void RenderEnumControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        if (Server == null) return;

        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenDropDown<string>>(s2++);
            b2.AddAttribute(s2++, "Data", settingMeta.AllowedValues);

            // Get current value or empty string
            var currentValue = "";
            if (Server.Settings.TryGetValue(settingMeta.Key, out var val))
            {
                currentValue = val;
            }

            b2.AddAttribute(s2++, "Value", currentValue);
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<string>(this, async value =>
            {
                await SetSettingValue(settingMeta.Key, value);
            }));
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? "Select an option");
            b2.AddAttribute(s2++, "class", "w-100");
            b2.AddAttribute(s2++, "AllowClear", true);
            b2.AddAttribute(s2++, "AllowFiltering", true);

            // Use Template for custom display when ValueMappings exist
            if (settingMeta.ValueMappings?.Any() == true)
            {
                b2.AddAttribute(s2++, "Template", (RenderFragment<object>)((item) => (builder3) =>
                {
                    var itemStr = item?.ToString() ?? "";
                    var displayText = settingMeta.ValueMappings.TryGetValue(itemStr, out var label) ? label : itemStr;
                    builder3.AddContent(0, displayText);
                }));
            }

            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void RenderListControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        if (Server == null) return;

        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenTextArea>(s2++);
            b2.AddAttribute(s2++, "Value", Server.Settings.TryGetValue(settingMeta.Key, out var val) ? val : "");
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<string>(this, async value =>
            {
                await SetSettingValue(settingMeta.Key, value);
            }));
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? $"Enter items separated by {settingMeta.ListDelimiter}");
            b2.AddAttribute(s2++, "Rows", 3);
            b2.AddAttribute(s2++, "class", "w-100");
            b2.CloseComponent();
        }));
        builder.CloseComponent();

        // Show list delimiter hint
        builder.OpenElement(sequence++, "small");
        builder.AddAttribute(sequence++, "class", "text-muted");
        builder.AddContent(sequence++, $"Separate items with '{settingMeta.ListDelimiter}'");
        builder.CloseElement();
    }

    private void RenderTimezoneControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        if (Server == null) return;

        // Get all available time zones
        var timeZones = TimeZoneInfo.GetSystemTimeZones()
            .Select(tz => tz.Id)
            .OrderBy(id => id)
            .ToList();

        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenDropDown<string>>(s2++);
            b2.AddAttribute(s2++, "Data", timeZones);

            // Get current value or default
            var currentValue = "";
            if (Server.Settings.TryGetValue(settingMeta.Key, out var val))
            {
                currentValue = val;
            }

            b2.AddAttribute(s2++, "Value", currentValue);
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<string>(this, async value =>
            {
                await SetSettingValue(settingMeta.Key, value);
            }));
            b2.AddAttribute(s2++, "AllowFiltering", true);
            b2.AddAttribute(s2++, "FilterCaseSensitivity", FilterCaseSensitivity.CaseInsensitive);
            b2.AddAttribute(s2++, "AllowClear", true);
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? "Select a time zone");
            b2.AddAttribute(s2++, "class", "w-100");

            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }
}

