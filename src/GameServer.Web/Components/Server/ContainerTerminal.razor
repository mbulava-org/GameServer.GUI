@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using GameServer.Web.Configurations
@using GameServer.API.Client.Interfaces
@using XtermBlazor
@using Radzen
@inject IJSRuntime JSRuntime
@inject IOptions<GameServerDockerApi> ApiConfig
@inject NotificationService NotificationService
@inject ILogger<ContainerTerminal> Logger
@implements IAsyncDisposable

@if (!isConnected && !isConnecting && !string.IsNullOrEmpty(connectionErrorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Class="mb-3" Shade="Shade.Lighter" AllowClose="false">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <RadzenIcon Icon="error_outline" Style="font-size: 1.25rem;" />
                <span><strong>Connection to Swarm manager agent failed:</strong> @connectionErrorMessage</span>
            </div>
            <RadzenButton Icon="refresh" Text="Retry Connection" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@ConnectAsync" Disabled="@string.IsNullOrEmpty(ContainerId ?? ServerId)" />
        </div>
    </RadzenAlert>
}

<div class="terminal-container">
    <div class="terminal-header">
        <div class="terminal-title">
            <RadzenIcon Icon="terminal" Style="font-size: 1rem;" />
            <span class="ms-2">Interactive Shell (@Shell)</span>
        </div>
        <div class="terminal-controls">
            @if (isConnected)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Connected" Variant="Variant.Flat" Size="BadgeSize.Small" />
                <RadzenButton Icon="refresh" 
                             Size="ButtonSize.Small" 
                             ButtonStyle="ButtonStyle.Light"
                             Click="@ClearTerminal"
                             title="Clear terminal" />
                <RadzenButton Icon="close" 
                             Size="ButtonSize.Small" 
                             ButtonStyle="ButtonStyle.Danger"
                             Click="@DisconnectAsync"
                             title="Disconnect" />
            }
            else if (isConnecting)
            {
                <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" Style="width: 18px; height: 18px;" />
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Connecting..." Variant="Variant.Flat" Size="BadgeSize.Small" />
            }
            else
            {
                @if (!string.IsNullOrEmpty(connectionErrorMessage))
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Connection Failed" Variant="Variant.Flat" Size="BadgeSize.Small" />
                    <RadzenButton Icon="refresh" 
                                 Text="Retry" 
                                 Size="ButtonSize.Small" 
                                 ButtonStyle="ButtonStyle.Primary"
                                 Click="@ConnectAsync"
                                 Disabled="@string.IsNullOrEmpty(ContainerId ?? ServerId)"
                                 title="Retry connection to terminal" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="Disconnected" Variant="Variant.Flat" Size="BadgeSize.Small" />
                    <RadzenButton Icon="play_arrow" 
                                 Text="Connect" 
                                 Size="ButtonSize.Small" 
                                 ButtonStyle="ButtonStyle.Success"
                                 Click="@ConnectAsync"
                                 Disabled="@string.IsNullOrEmpty(ContainerId ?? ServerId)"
                                 title="Connect to terminal" />
                }
            }
        </div>
    </div>

    <div class="xterm-wrapper" @ref="_terminalWrapperRef">
        @if (isConnecting)
        {
            <div class="terminal-overlay">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                <span class="mt-2 text-light small">Connecting to interactive shell session...</span>
            </div>
        }
        <Xterm @ref="terminal" 
               Options="@terminalOptions"
               Addons="@_addons"
               OnFirstRender="@OnTerminalReady"
               OnData="@OnTerminalData" />
    </div>
</div>

<style>
    .terminal-container {
        display: flex;
        flex-direction: column;
        height: 650px;
        background: #000;
        border: 1px solid var(--rz-border-color);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .terminal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        background: #1e1e1e;
        border-bottom: 1px solid #333;
        color: #d4d4d4;
        flex-shrink: 0;
    }

    .terminal-title {
        display: flex;
        align-items: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .terminal-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .xterm-wrapper {
        position: relative;
        flex: 1;
        overflow: hidden;
        background: #000;
        width: 100%;
        height: 100%;
    }

    .terminal-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.75);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 10;
        backdrop-filter: blur(2px);
    }

    .xterm-wrapper ::deep .xterm {
        height: 100%;
        width: 100%;
        padding: 0.5rem;
        box-sizing: border-box;
    }

    .xterm-wrapper ::deep .xterm-viewport {
        background-color: transparent !important;
        width: 100% !important;
    }

    .xterm-wrapper ::deep .xterm-screen {
        height: 100%;
        width: 100%;
    }

    @@media (max-width: 768px) {
        .terminal-container {
            height: 450px;
        }
    }
</style>

@code {
    [Parameter] public string? ServerId { get; set; }
    [Parameter] public string? ContainerId { get; set; }
    [Parameter] public bool AutoConnect { get; set; } = false;
    [Parameter] public string Shell { get; set; } = "/bin/sh";

    private Xterm? terminal;
    private ElementReference _terminalWrapperRef;
    private readonly HashSet<string> _addons = ["addon-fit"];
    private TerminalOptions terminalOptions = new()
    {
        CursorBlink = true,
        CursorStyle = CursorStyle.Block,
        DisableStdin = false,
        Theme = new XtermBlazor.Theme
        {
            Background = "#000000",
            Foreground = "#00ff00",
            Cursor = "#00ff00",
            CursorAccent = "#00ff00",
            SelectionBackground = "#264f78",
            Black = "#000000",
            Red = "#ff5555",
            Green = "#50fa7b",
            Yellow = "#f1fa8c",
            Blue = "#8be9fd",
            Magenta = "#ff79c6",
            Cyan = "#8be9fd",
            White = "#f8f8f2",
            BrightBlack = "#6272a4",
            BrightRed = "#ff6e6e",
            BrightGreen = "#69ff94",
            BrightYellow = "#ffffa5",
            BrightBlue = "#d6fcff",
            BrightMagenta = "#ff92df",
            BrightCyan = "#a4ffff",
            BrightWhite = "#ffffff"
        },
        FontSize = 14,
        FontFamily = "'Cascadia Code', 'Consolas', 'Monaco', 'Courier New', monospace",
        Scrollback = 5000,
        AllowTransparency = false
    };

    private bool isConnected = false;
    private bool isConnecting = false;
    private string? connectionErrorMessage;
    private bool isDisposed = false;
    private bool isJavaScriptAvailable = false;
    private string? sessionId;
    private CancellationTokenSource? cts;
    private IContainerTerminalClient? terminalClient;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isJavaScriptAvailable = true;

            try
            {
                await JSRuntime.InvokeVoidAsync("TerminalHelpers.ensureAddons");
            }
            catch
            {
                // Fallback gracefully
            }

            try
            {
                await JSRuntime.InvokeVoidAsync("TerminalHelpers.initAutoFit", _terminalWrapperRef);
            }
            catch
            {
                // Fallback gracefully
            }

            await FitTerminalAsync();

            if (AutoConnect && (!string.IsNullOrEmpty(ContainerId) || !string.IsNullOrEmpty(ServerId)))
            {
                await Task.Delay(500); // Wait for terminal to initialize
                await ConnectAsync();
            }
        }
    }

    private async Task FitTerminalAsync()
    {
        if (isJavaScriptAvailable && !isDisposed)
        {
            try
            {
                if (terminal is not null)
                {
                    await terminal.Addon("addon-fit").InvokeVoidAsync("fit");
                }
            }
            catch
            {
                // Fallback
            }

            try
            {
                await JSRuntime.InvokeVoidAsync("TerminalHelpers.fitAll");
            }
            catch
            {
                // Ignore if terminal is hidden/unmeasured
            }
        }
    }

    private async Task OnTerminalReady()
    {
        if (terminal == null || !isJavaScriptAvailable || isDisposed) return;

        try
        {
            await FitTerminalAsync();
            await terminal.WriteLine("\x1b[1;32m=== Container Interactive Terminal ===\x1b[0m");
            await terminal.WriteLine($"\x1b[36mShell: {Shell}\x1b[0m");
            await terminal.WriteLine($"\x1b[36mTarget: {ContainerId ?? ServerId ?? "Unknown"}\x1b[0m");
            await terminal.WriteLine("");
            
            if (!AutoConnect)
            {
                await terminal.WriteLine("\x1b[33mClick 'Connect' to start an interactive shell session\x1b[0m");
            }
            await FitTerminalAsync();
        }
        catch
        {
            // Ignore JS errors during terminal init
        }
    }

    private async Task ConnectAsync()
    {
        var targetId = !string.IsNullOrWhiteSpace(ContainerId) ? ContainerId : ServerId;
        if (string.IsNullOrEmpty(targetId))
        {
            connectionErrorMessage = "No server or container ID provided";
            await WriteError("Error: No server or container ID provided");
            return;
        }

        if (isConnected || isConnecting || isDisposed) return;

        isConnecting = true;
        connectionErrorMessage = null;
        StateHasChanged();

        try
        {
            await SafeCleanupClientAsync();

            var baseUri = ApiConfig.Value.BaseUri?.TrimEnd('/') ?? "http://localhost:5164";
            var hubUrl = $"{baseUri}/hubs/terminal";

            Logger.LogInformation("Connecting to terminal hub at {HubUrl} for target {TargetId}", hubUrl, targetId);

            cts = new CancellationTokenSource();

            terminalClient = new GameServer.API.Client.Services.ContainerTerminalClient(hubUrl);
            WireTerminalEvents();

            await terminalClient.ConnectAsync(cts.Token);
            var sessionStarted = await terminalClient.StartExecSessionAsync(targetId, Shell, cts.Token);

            if (!sessionStarted)
            {
                throw new InvalidOperationException("Server declined to start exec session");
            }

            isConnected = true;
            isConnecting = false;
            connectionErrorMessage = null;
            sessionId = terminalClient.ConnectionId;

            await WriteSuccess($"Connected! Shell session active.\n");

            NotificationService.NotifyTimed(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Terminal Connected",
                Detail = $"Interactive shell session started in container",
                Duration = 3000
            });

            StateHasChanged();
        }
        catch (Exception ex)
        {
            isConnecting = false;
            isConnected = false;
            connectionErrorMessage = ex.Message;
            Logger.LogError(ex, "Failed to connect to terminal");
            await WriteError($"Connection failed: {ex.Message}");

            NotificationService.NotifyTimed(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Connection Failed",
                Detail = ex.Message,
                Duration = 5000
            });

            StateHasChanged();
        }
    }

    private async Task OnTerminalData(string data)
    {
        if (!isConnected || terminalClient is null || !terminalClient.IsConnected || isDisposed)
            return;

        try
        {
            await terminalClient.SendInputAsync(data);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send terminal input");
        }
    }

    private async Task DisconnectAsync()
    {
        await SafeCleanupClientAsync();

        isConnected = false;
        isConnecting = false;
        connectionErrorMessage = null;
        sessionId = null;

        await WriteInfo("Disconnected from terminal");
        StateHasChanged();
    }

    private async Task SafeCleanupClientAsync()
    {
        if (terminalClient != null)
        {
            try
            {
                terminalClient.OutputReceived -= OnTerminalOutput;
                terminalClient.ErrorReceived -= OnTerminalError;
                terminalClient.SessionStarted -= OnTerminalSessionStarted;
                terminalClient.Disconnected -= OnTerminalDisconnected;

                await terminalClient.DisconnectAsync();

                if (terminalClient is IAsyncDisposable disposable)
                {
                    await disposable.DisposeAsync();
                }
            }
            catch
            {
                // Non-critical during cleanup
            }

            terminalClient = null;
        }

        cts?.Cancel();
        cts?.Dispose();
        cts = null;
    }

    private void WireTerminalEvents()
    {
        if (terminalClient is null) return;
        terminalClient.OutputReceived -= OnTerminalOutput;
        terminalClient.OutputReceived += OnTerminalOutput;

        terminalClient.ErrorReceived -= OnTerminalError;
        terminalClient.ErrorReceived += OnTerminalError;

        terminalClient.SessionStarted -= OnTerminalSessionStarted;
        terminalClient.SessionStarted += OnTerminalSessionStarted;

        terminalClient.Disconnected -= OnTerminalDisconnected;
        terminalClient.Disconnected += OnTerminalDisconnected;
    }

    private void OnTerminalOutput(object? sender, string data)
    {
        InvokeAsync(async () =>
        {
            if (isDisposed) return;
            try
            {
                if (terminal != null && isJavaScriptAvailable)
                {
                    var normalized = System.Text.RegularExpressions.Regex.Replace(data, @"(?<!\r)\n", "\r\n");
                    await terminal.Write(normalized);
                }
            }
            catch
            {
                // Suppress JS error to prevent circuit crash
            }
        });
    }

    private void OnTerminalError(object? sender, string error)
    {
        InvokeAsync(async () =>
        {
            if (isDisposed) return;
            connectionErrorMessage = error;
            try
            {
                await WriteError($"Error: {error}");
            }
            catch
            {
                // Suppress JS error
            }
            StateHasChanged();
        });
    }

    private void OnTerminalSessionStarted(object? sender, string sid)
    {
        InvokeAsync(() =>
        {
            if (isDisposed) return;
            sessionId = sid;
            connectionErrorMessage = null;
            Logger.LogInformation("Terminal session started: {SessionId}", sessionId);
            StateHasChanged();
        });
    }

    private void OnTerminalDisconnected(object? sender, string message)
    {
        InvokeAsync(async () =>
        {
            if (isDisposed) return;
            isConnected = false;
            isConnecting = false;
            if (!string.IsNullOrWhiteSpace(message) && message != "Session closed" && message != "Disconnected from terminal")
            {
                connectionErrorMessage = message;
            }
            try
            {
                await WriteInfo($"Disconnected: {message}");
            }
            catch
            {
                // Suppress JS error
            }
            StateHasChanged();
        });
    }

    private async Task ClearTerminal()
    {
        if (terminal != null && isJavaScriptAvailable && !isDisposed)
        {
            try
            {
                await terminal.Clear();
                await terminal.WriteLine("\x1b[1;32m=== Terminal Cleared ===\x1b[0m\n");
            }
            catch
            {
                // Suppress JS error
            }
        }
    }

    private async Task WriteSuccess(string message)
    {
        if (terminal != null && isJavaScriptAvailable && !isDisposed)
        {
            try
            {
                await terminal.WriteLine($"\x1b[1;32m{message}\x1b[0m");
            }
            catch { }
        }
    }

    private async Task WriteError(string message)
    {
        if (terminal != null && isJavaScriptAvailable && !isDisposed)
        {
            try
            {
                await terminal.WriteLine($"\x1b[1;31m{message}\x1b[0m");
            }
            catch { }
        }
    }

    private async Task WriteInfo(string message)
    {
        if (terminal != null && isJavaScriptAvailable && !isDisposed)
        {
            try
            {
                await terminal.WriteLine($"\x1b[1;36m{message}\x1b[0m");
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        isJavaScriptAvailable = false;
        await SafeCleanupClientAsync();
    }
}
