@code {
    [Parameter] public GameServer? Server { get; set; }
    [Parameter] public EventCallback<GameServer> OnChange { get; set; }


    string opsText = "";
    string whitelistText = "";

    int MaxPlayers
    {
        get => int.TryParse(Get("MAX_PLAYERS"), out var v) ? v : 20;
        set => Set("MAX_PLAYERS", value.ToString());
    }

    uint ServerPort
    {
        get => uint.TryParse(Get("SERVER_PORT"), out var v) ? v : 25565u;
        set => Set("SERVER_PORT", value.ToString());
    }

    int Memory
    {
        get
        {
            if(int.TryParse(Get("MEMORY").TrimEnd('M'), out var v)) return v;
            return 1024;
        }
        set
        {
            Set("MEMORY", $"{value}M");
        }
    }

    public string GetDifficulty()
    {
        var val = Get("DIFFICULTY");
        return val switch
        {
            "0" => "peaceful",
            "1" => "easy",
            "2" => "normal",
            "3" => "hard",
            _ => "easy"
        };
    }

    public void SetDifficulty(string difficulty)
    {
        var val = difficulty.ToLower() switch
        {
            "peaceful" => "0",
            "easy" => "1",
            "normal" => "2",
            "hard" => "3",
            _ => "1"
        };
        Set("DIFFICULTY", val);
    }

    public string GetGameMode()
    {
        var val = Get("MODE");
        return val switch
        {
            "0" => "survival",
            "1" => "creative",
            "2" => "adventure",
            "3" => "spectator",
            _ => "creative"
        };
    }

    public void SetGameMode(string gameMode)
    {
        var val = gameMode.ToLower() switch
        {
            "survival" => "0",
            "creative" => "1",
            "adventure" => "2",
            "spectator" => "3",
            _ => "1"
        };
        Set("MODE", val);
    }

    protected override void OnParametersSet()
    {
        Server ??= new GameServer();
        Server.Settings ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        // ensure common defaults
        // Ensure("IMAGE", "itzg/minecraft-server");
        Ensure("VERSION", "LATEST");
        Ensure("MEMORY", "1024M");
        Ensure("MAX_PLAYERS", "10");
        Ensure("MOTD", "(Message Of the Day) - Welcome to the Minecraft server.");
        Ensure("ENABLE_RCON", "true");
        Ensure("SNOOPER_ENABLED", "false");
        Ensure("EULA", "true");
        Ensure("LEVEL", Server.Name);
        // populate list textareas from settings
        opsText = GetListText("OPS");
        whitelistText = GetListText("WHITELIST");
    }

    void Ensure(string key, string defaultValue)
    {
        if (!Server!.Settings!.ContainsKey(key))
            Server.Settings[key] = defaultValue;
    }

    string Get(string key) => Server?.Settings != null && Server.Settings.TryGetValue(key, out var v) ? v ?? "" : "";
    void Set(string key, string value)
    {
        Server!.Settings ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        Server.Settings[key] = value ?? "";
        OnChange.InvokeAsync(Server);
    }

    bool GetBool(string key) => bool.TryParse(Get(key), out var v) && v;
    void SetBool(string key, bool v) => Set(key, v ? "true" : "false");

    // void AddEnv()
    // {
    //     if (string.IsNullOrWhiteSpace(newKey)) return;
    //     Set(newKey.Trim(), newValue ?? "");
    //     newKey = "";
    //     newValue = "";
    //     NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Env added", Duration = 2000 });
    // }

    void ApplyLists()
    {
        var whitelistNew = ToLines(whitelistText);

        Set("OPS", ToLines(opsText));
        Set("WHITELIST", ToLines(whitelistText));
        Set("ENABLE_WHITELIST", string.IsNullOrEmpty(whitelistNew) ? "false" : "true");
        //NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Lists applied", Duration = 2000 });
    }

    string ToLines(string text)
    {
        var lines = (text ?? "").Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
          .Select(s => s.Trim()).Where(s => s.Length > 0);
        return string.Join("\n", lines);
    }

    string GetListText(string key)
    {
        var raw = Get(key);
        if (string.IsNullOrEmpty(raw)) return "";
        // if JSON array, convert to lines
        if (raw.StartsWith("[") && raw.Contains("]"))
        {
            try
            {
                var arr = JsonSerializer.Deserialize<string[]>(raw);
                if (arr != null) return string.Join("\n", arr);
            }
            catch { }
        }
        return raw.Replace("\r", "");
    }


    void Change(string text)
    {
        Console.WriteLine($"{text}");
    }
    private void WhiteListChanged(string value)
    {
        var newWhiteList = ToLines(value);
        Set("WHITELIST", newWhiteList);
        SetBool("ENABLE_WHITELIST", newWhiteList.Length > 0);
    }
    private void OpsListChanged(string args)
    {
        Set("OPS", ToLines(args));
    }
}