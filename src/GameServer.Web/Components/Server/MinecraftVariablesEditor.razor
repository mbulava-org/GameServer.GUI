@using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using System.Text.Json
@inject NotificationService NotificationService

<RadzenPanel AllowCollapse="true" class="rz-my-10 rz-mx-auto" 
             Collapsed="false"
             Expand=@(() => Change("Panel expanded")) Collapse=@(() => Change("Panel collapsed"))>
    <HeaderTemplate>
        <RadzenText TextStyle="TextStyle.H6" class="rz-display-flex rz-align-items-center rz-m-0">
            <RadzenIcon Icon="settings" class="rz-me-1" /><h3>Minecraft Server Variables (itzg)</h3>
        </RadzenText>
    </HeaderTemplate>
    <ChildContent>
        <RadzenCard Variant="Variant.Outlined" class="rz-mt-4">
            <h4>General</h4>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Minecraft Version"/>
                </div>
                <div class="col align-content-center">
                    <RadzenDropDown Value='Get("VERSION")' Data='new[] { "LATEST", "PREVIOUS" }' Change='@(args => Set("VERSION", args?.ToString() ?? "LATEST"))' 
                        Style="width:100%" />
                </div>
            </div>
            <div class="row" style="margin:4px" >
                <div class="col align-content-center">
                    <RadzenLabel Text="Server Type:" />
                </div>
                <div class="col align-content-center">
                    <RadzenDropDown Value='Get("TYPE")' Data='new[] { "VANILLA", "SPIGOT", "PAPER", "FABRIC", "FORGE", "BUKKIT" }' 
                    Change='@(args => Set("TYPE", args?.ToString() ?? "VANILLA"))' Style="width:100%" />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Memory (MB):" />
                </div>
                <div class="col align-content-center">
                    <RadzenNumeric TValue="int" @bind-Value="@Memory" Step="512" Max="6144"/>
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Max Players" />
                </div>
                <div class="col align-content-center">
                    <RadzenNumeric @bind-Value="@MaxPlayers" TValue="int" Min="10" Max="100" />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Server Port" />
                </div>
                <div class="col align-content-center">
                    <RadzenNumeric TValue="uint" @bind-Value='ServerPort' Min="1" Max="65535" 
                    Change='@(v => Set("SERVER_PORT", v.ToString() ?? "25565"))' Style="width:100%" />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Message of the day" Style="margin-top:8px" />
                </div>
                <div class="col align-content-center">
                    <RadzenTextBox Value='@(Get("MOTD"))' Change='@(args => Set("MOTD", args.ToString() ?? ""))' Style="width:100%" />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Snooper Enabled"/>
                </div>
                <div class="col align-content-center">
                    <RadzenCheckBox TValue="bool" Value='GetBool("SNOOPER_ENABLED")' Change='@(v => Set("SNOOPER_ENABLED", v ? "true" : "false"))'/>
                </div>
            </div>
            @* <div class="row" style="margin:4px">
                <div class="col align-content-center">
                </div>
                <div class="col align-content-center">
                </div>
            </div> *@
        </RadzenCard>
        <RadzenCard Variant="Variant.Outlined" class="rz-mt-4">
            <h4>World</h4>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Difficulty:" />
                </div>
                <div class="col align-content-center">
                    <RadzenDropDown Value='GetDifficulty()' Data='new[] { "peaceful", "easy", "normal", "hard" }' Change='@(args => SetDifficulty((string)args))' Style="width:100%" />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Game Mode:" />
                </div>
                <div class="col align-content-center">
                    <RadzenDropDown Value='GetGameMode()' Data='new[] { "survival", "creative", "adventure", "spectator" }' Change='@(args =>SetGameMode((string)args))' Style="width:100%" />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="World Name (LEVEL):" />
                </div>
                <div class="col align-content-center">
                    <RadzenTextBox Value='@(Get("LEVEL"))' Change='@(args => Set("LEVEL", args?.ToString() ?? ""))' />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="World Generator Seed (SEED)"/>
                </div>
                <div class="col align-content-center">
                    <RadzenTextBox Value='@(Get("SEED"))' Change='@(args => Set("SEED", args?.ToString() ?? ""))' />
                </div>
            </div>
        </RadzenCard>
        <RadzenCard Variant="Variant.Outlined" class="rz-mt-4">
            <h4>RCON</h4>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="Enable RCON" />
                </div>
                <div class="col align-content-center">
                    <RadzenCheckBox TValue="bool" Value='GetBool("ENABLE_RCON")' Change='@(v => Set("ENABLE_RCON", v ? "true" : "false"))' />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="RCON Port" />
                </div>
                <div class="col align-content-center">
                    <RadzenNumeric TValue="int" Value="25575" Min="1" Max="65535" Change='@(v => Set("RCON_PORT", v.ToString() ?? "25575"))' />
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    <RadzenLabel Text="RCON Password" />
                </div>
                <div class="col align-content-center">
                    <RadzenTextBox Placeholder="RCON password"
                                   Value='@(Get("RCON_PASSWORD"))'
                                   Change='@(args => Set("RCON_PASSWORD", args?.ToString() ?? ""))' />
                </div>
            </div>
            @* <div class="row">
                <div class="col align-content-center">
                </div>
                <div class="col align-content-center">
                </div>
            </div> *@
            @* <div class="row">
                <div class="col align-content-center">
                </div>
                <div class="col align-content-center">
                </div>
            </div> *@
            @* <div class="row" style="margin:4px">
                <div class="col align-content-center">
                </div>
                <div class="col align-content-center">
                </div>
            </div> *@
        </RadzenCard>
        <RadzenCard Variant="Variant.Outlined" class="rz-mt-4">
            <h4>Players / Access Lists</h4>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    Allow List
                </div>
                <div class="col align-content-center">
                    <RadzenTextArea Style="width:100%;min-height:120px" Value='@GetListText("WHITELIST")'
                                    Change='WhiteListChanged'
                                    Placeholder="one value per line"/>
                </div>
            </div>
            <div class="row" style="margin:4px">
                <div class="col align-content-center">
                    Operators List
                </div>
                <div class="col align-content-center">
                    <RadzenTextArea Style="width:100%;min-height:120px" Value='@GetListText("OPS")'
                                    Change='OpsListChanged'
                                    Placeholder="one value per line"/>
                </div>
            </div>
        </RadzenCard>

    </ChildContent>
</RadzenPanel>

