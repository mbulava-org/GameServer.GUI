 @using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using System.Threading.Tasks

<RadzenCard>
  <ChildContent>
    @if (Server == null)
    {
        <div class="rz-text rz-alert rz-alert-warning">No server model provided.</div>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:12px">
            @if (Server.Ports == null || Server.Ports.Count == 0)
            {
                <div class="rz-text">No port mappings defined.</div>
            }
            else 
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="info" Style="font-size: 1rem;" />
                        <small>Mark one port as the <strong>Default Port</strong> - this will be used in connection strings.</small>
                    </div>
                </RadzenAlert>

                @foreach (var pm in Server.Ports)
                {
                    var isDefault = IsDefaultPort(pm);
                    <RadzenCard class="port-card" Style="@(isDefault ? "border: 2px solid var(--rz-primary);" : "")">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <RadzenFormField Text="Host Port" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenNumeric TValue="uint"
                                                   Value="@((uint)pm.PublishedPort)"
                                                   Change="@((uint val) => OnPublishedChanged(pm, val))"
                                                   Min="0" Max="65535"
                                                   Style="@GetPublishedStyle(pm)"
                                                   class="w-100" />
                                </RadzenFormField>
                                @if (publishedErrors.TryGetValue(pm, out var err) && !string.IsNullOrEmpty(err))
                                {
                                    <small class="text-danger d-block mt-1">@err</small>
                                }
                            </div>

                            <div class="col-md-3">
                                <RadzenFormField Text="Container Port" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenNumeric TValue="uint"
                                                   Value="@((uint)pm.ContainerPort)"
                                                   Min="1" Max="65535"
                                                   Disabled="true"
                                                   class="w-100" />
                                </RadzenFormField>
                            </div>

                            <div class="col-md-2">
                                <RadzenFormField Text="Protocol" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenDropDown Value="@pm.Protocol" 
                                                    Data="@(new[] { "tcp", "udp" })" 
                                                    Change="@(args => pm.Protocol = args.ToString())" 
                                                    Disabled="true"
                                                    class="w-100" />
                                </RadzenFormField>
                            </div>

                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2 pb-2">
                                    <RadzenRadioButtonList @bind-Value="@defaultPortKey" 
                                                          TValue="string"
                                                          Change="@((string value) => OnDefaultPortChanged(pm))">
                                        <Items>
                                            <RadzenRadioButtonListItem Text="Default Port" 
                                                                      Value="@GetPortKey(pm)" 
                                                                      TValue="string" />
                                        </Items>
                                    </RadzenRadioButtonList>
                                    @if (isDefault)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" 
                                                    Text="Primary" 
                                                    Size="BadzeSize.Small" 
                                                    Variant="Variant.Flat" />
                                    }
                                </div>
                            </div>

                            <div class="col-md-1 text-end">
                                <div class="pb-2">
                                    <RadzenIcon Icon="@(isDefault ? "star" : "star_border")" 
                                               Style="@(isDefault ? "color: var(--rz-warning); font-size: 1.5rem;" : "color: var(--rz-text-disabled-color); font-size: 1.5rem;")" 
                                               title="@(isDefault ? "Primary connection port" : "Not primary port")" />
                                </div>
                            </div>
                        </div>
                    </RadzenCard>
                }
            }
        </div>
    }
  </ChildContent>
</RadzenCard>

<style>
    .port-card {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .port-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
</style>

@code {
    [Inject] public required IPortApi PortApi { get; set; }
    [Parameter] public GameServer? Server { get; set; }
    [Parameter] public EventCallback<GameServer> OnChanged { get; set; }
    [Parameter] public EventCallback<bool> OnValidityChanged { get; set; }

    private bool paramertersSet = false;
    private string defaultPortKey = "";
    
    // Validation state: per-instance error message for PublishedPort
    Dictionary<PortMapping, string> publishedErrors = new();

    protected override void OnParametersSet()
    {
        if (Server != null)
        {
            // only run once
            if(paramertersSet)
                return;
                
            // Default published port to container port when 0, validate and sync settings
            foreach (var pm in Server.Ports)
            {
                if (pm.PublishedPort == 0 && pm.ContainerPort != 0)
                {
                    pm.PublishedPort = pm.ContainerPort;
                }
            }
            
            // Initialize defaultPortKey - first port is default if none set
            if (Server.Ports.Any())
            {
                var firstPort = Server.Ports.First();
                defaultPortKey = GetPortKey(firstPort);
            }
            
            // mark as set
            paramertersSet = true;
            _ = ValidateAllPublishedAsync();
        }
    }

    private string GetPortKey(PortMapping pm)
    {
        return $"{pm.ContainerPort}_{pm.Protocol}";
    }

    private bool IsDefaultPort(PortMapping pm)
    {
        return GetPortKey(pm) == defaultPortKey;
    }

    private void OnDefaultPortChanged(PortMapping selectedPort)
    {
        if (Server?.Ports == null) return;

        defaultPortKey = GetPortKey(selectedPort);

        StateHasChanged();
        _ = NotifyChangedAsync();
    }

    // -- Handlers --

    void OnPublishedChanged(PortMapping pm, uint value)
    {
        if (pm == null || Server?.Ports == null) return;

        // treat 0 as "default to container port"
        if (value == 0)
        {
            pm.PublishedPort = (int)(pm.ContainerPort != 0 ? pm.ContainerPort : 0);
        }
        else
        {
            pm.PublishedPort = (int)(value > 65535 ? 65535 : value);
        }

        _ = ValidateAllPublishedAsync();
        _ = NotifyChangedAsync();
    }


    // -- Validation --

    async Task ValidateAllPublishedAsync()
    {
        publishedErrors.Clear();
        if (Server == null) return;

        // compute effective published for duplicate detection (Published==0 treated as Container)
        var effective = Server.Ports.Select(p => new { 
            Instance = p, 
            Port = (p.PublishedPort == 0 ? p.ContainerPort : p.PublishedPort),
            Protocol = p.Protocol
        }).ToList();

        foreach (var e in effective)
        {
            // Range check
            if (e.Port < 1 || e.Port > 65535)
            {
                publishedErrors[e.Instance] = "Published port must be between 1 and 65535.";
                continue;
            }

            // Duplicates - same port AND same protocol
            var duplicates = effective.Count(x => x.Port == e.Port && x.Protocol == e.Protocol);
            if (duplicates > 1)
            {
                publishedErrors[e.Instance] = $"Port {e.Port}/{e.Protocol} is used by multiple mappings.";
                continue;
            }

            // Already allocated - check with protocol
            var isFree = await PortApi.CheckAsync(e.Protocol, e.Port);
            if (!isFree)
            {
                publishedErrors[e.Instance] = $"Port {e.Port}/{e.Protocol} is already in use!";
                continue;
            }
            // valid -> no error
            // ensure key removed
            if (publishedErrors.ContainsKey(e.Instance)) publishedErrors.Remove(e.Instance);
        }
        // Notify validity change
        await OnValidityChanged.InvokeAsync(publishedErrors.Count == 0);  
    }

    string GetPublishedStyle(PortMapping pm)
    {
        return publishedErrors.ContainsKey(pm) ? "border-color:#b91c1c" : "";
    }

    public string GetDefaultPortConnectionString()
    {
        if (Server?.Ports == null || !Server.Ports.Any()) return "";
        
        var defaultPort = Server.Ports.FirstOrDefault(pm => IsDefaultPort(pm));
        if (defaultPort == null) return "";
        
        var effectivePort = defaultPort.PublishedPort == 0 ? defaultPort.ContainerPort : defaultPort.PublishedPort;
        return $"{effectivePort}/{defaultPort.Protocol}";
    }

    // -- Notify changed upstream --

    Task NotifyChangedAsync()
    {
        if (Server == null) return Task.CompletedTask;
        return OnChanged.HasDelegate ? OnChanged.InvokeAsync(Server) : Task.CompletedTask;
    }
}