 @using Radzen
@using Radzen.Blazor
@attribute [Obsolete("Legacy pre-V2 port mapping editor. Migrate to the V2 server flow before removing the old repository chain.")]
@using global::GameServer.Docker.Client
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using System.Threading.Tasks

<RadzenCard>
<ChildContent>
  @if (Server == null)
  {
      <div class="rz-text rz-alert rz-alert-warning">No server model provided.</div>
  }
  else
  {
      @if (HasDefaultPort())
      {
          <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
              <div class="d-flex align-items-start gap-2">
                  <RadzenIcon Icon="info" Style="font-size: 1.25rem;" />
                  <div>
                      <strong>Port Configuration:</strong> The default port is editable and can be changed here or via Environment Variables. 
                      Related ports are automatically calculated based on port relationships defined in the game type.
                      All ports (including auto-calculated ones) are validated for availability.
                  </div>
              </div>
          </RadzenAlert>
      }
      else
      {
          <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-2">
              <div class="d-flex align-items-center gap-2">
                  <RadzenIcon Icon="info" Style="font-size: 1rem;" />
                  <small>Mark one port as the <strong>Default Port</strong> - this will be used in connection strings.</small>
              </div>
          </RadzenAlert>
      }

      <div style="display:flex;flex-direction:column;gap:12px">
            @if (Server.Ports == null || Server.Ports.Count == 0)
            {
                <div class="rz-text">No port mappings defined.</div>
            }
            else 
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="info" Style="font-size: 1rem;" />
                        <small>Mark one port as the <strong>Default Port</strong> - this will be used in connection strings.</small>
                    </div>
                </RadzenAlert>

                @foreach (var pm in Server.Ports)
                {
                    var isDefault = IsDefaultPort(pm);
                    var isReadOnly = !isDefault; // Only default port is editable

                    <RadzenCard class="port-card" Style="@(isDefault ? "border: 2px solid var(--rz-primary);" : "")">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <RadzenFormField Text="Host Port" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenNumeric TValue="uint"
                                                   Value="@((uint)pm.PublishedPort)"
                                                   Change="@((uint val) => OnPublishedChanged(pm, val))"
                                                   Min="0" Max="65535"
                                                   Style="@GetPublishedStyle(pm)"
                                                   Disabled="@isReadOnly"
                                                   class="w-100" />
                                </RadzenFormField>
                                @if (publishedErrors.TryGetValue(pm, out var err) && !string.IsNullOrEmpty(err))
                                {
                                    <small class="text-danger d-block mt-1">@err</small>
                                }
                                <small class="text-muted d-block mt-1">
                                    Container Port: @pm.ContainerPort
                                    @if (isReadOnly)
                                    {
                                        <span> • Auto-calculated from port relationships</span>
                                    }
                                    else if (isDefault)
                                    {
                                        <span> • Primary connection port (editable)</span>
                                    }
                                </small>
                            </div>

                            <div class="col-md-3">
                                <RadzenFormField Text="Protocol" Variant="@Variant.Outlined" class="w-100">
                                    <RadzenTextBox Value="@pm.Protocol" 
                                                    Disabled="true"
                                                    class="w-100" />
                                </RadzenFormField>
                            </div>

                            <div class="col-md-4">
                                <div class="d-flex align-items-center gap-2 pb-2">
                                    <RadzenRadioButtonList @bind-Value="@defaultPortKey" 
                                                          TValue="string"
                                                          Change="@((string value) => OnDefaultPortChanged(pm))"
                                                          Disabled="true">
                                        <Items>
                                            <RadzenRadioButtonListItem Text="Default Port" 
                                                                      Value="@GetPortKey(pm)" 
                                                                      TValue="string" />
                                        </Items>
                                    </RadzenRadioButtonList>
                                    @if (isDefault)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" 
                                                    Text="Primary" 
                                                    Size="BadzeSize.Small" 
                                                    Variant="Variant.Flat" />
                                    }
                                </div>
                            </div>

                            <div class="col-md-1 text-end">
                                <div class="pb-2">
                                    <RadzenIcon Icon="@(isDefault ? "star" : "star_border")" 
                                               Style="@(isDefault ? "color: var(--rz-warning); font-size: 1.5rem;" : "color: var(--rz-text-disabled-color); font-size: 1.5rem;")" 
                                               title="@(isDefault ? "Primary connection port" : "Not primary port")" />
                                </div>
                            </div>
                        </div>
                    </RadzenCard>
                }
            }
        </div>
    }
  </ChildContent>
</RadzenCard>

<style>
    .port-card {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .port-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
</style>

@code {
    [Inject] public required IPortApi PortApi { get; set; }
    [Inject] public required IGameTypeExtendedMetadataApi ExtendedMetadataApi { get; set; }
    [Parameter] public GameServer? Server { get; set; }
    [Parameter] public GameTypeDefinition? GameTypeDefinition { get; set; }
    [Parameter] public EventCallback<GameServer> OnChanged { get; set; }
    [Parameter] public EventCallback<bool> OnValidityChanged { get; set; }

    private bool parametersSet = false;
    private string defaultPortKey = "";
    private int defaultPortIndex = 0; // Track by index instead of content
    private GameTypeExtendedMetadata? extendedMetadata;
    
    // Validation state: per-instance error message for PublishedPort
    Dictionary<PortMapping, string> publishedErrors = new();

    protected override void OnParametersSet()
    {
        if (Server != null)
        {
            // Default published port to container port when 0, validate and sync settings
            foreach (var pm in Server.Ports)
            {
                if (pm.PublishedPort == 0 && pm.ContainerPort != 0)
                {
                    pm.PublishedPort = pm.ContainerPort;
                }
            }
            
            if (!parametersSet)
            {
                // Load extended metadata for port relationships
                _ = LoadExtendedMetadataAsync();

                // First time initialization - find the default port from GameTypeDefinition
                if (Server.Ports.Any())
                {
                    // Try to find the port marked as default in the GameTypeDefinition
                    var defaultPortDef = GameTypeDefinition?.Ports?.FirstOrDefault(p => p.IsDefaultPort);
                    
                    if (defaultPortDef != null && GameTypeDefinition?.Ports != null)
                    {
                        // Find the index of the default port in GameTypeDefinition.Ports
                        var portDefsList = GameTypeDefinition.Ports.ToList();
                        var defaultPortDefIndex = portDefsList.IndexOf(defaultPortDef);
                        
                        if (defaultPortDefIndex >= 0)
                        {
                            // Use the same index in Server.Ports (ports are created in the same order)
                            var portsList = Server.Ports.ToList();
                            if (defaultPortDefIndex < portsList.Count)
                            {
                                var matchingPort = portsList[defaultPortDefIndex];
                                defaultPortIndex = defaultPortDefIndex;
                                defaultPortKey = GetPortKey(matchingPort);
                            }
                            else
                            {
                                // Fallback to first port
                                defaultPortIndex = 0;
                                defaultPortKey = GetPortKey(portsList[0]);
                            }
                        }
                        else
                        {
                            // Fallback to first port
                            defaultPortIndex = 0;
                            defaultPortKey = GetPortKey(Server.Ports.First());
                        }
                    }
                    else
                    {
                        // No default defined in GameType, use first port
                        defaultPortIndex = 0;
                        defaultPortKey = GetPortKey(Server.Ports.First());
                    }
                }
                
                parametersSet = true;
            }
            else
            {
                // Ports may have changed externally (via port relationships)
                // Preserve the default port by index
                var portsList = Server.Ports.ToList();
                if (portsList.Any() && defaultPortIndex < portsList.Count)
                {
                    var defaultPort = portsList[defaultPortIndex];
                    defaultPortKey = GetPortKey(defaultPort);
                }
                else if (portsList.Any())
                {
                    // Default index is out of range, reset to first port
                    defaultPortIndex = 0;
                    defaultPortKey = GetPortKey(portsList[0]);
                }
            }
            
            // Always validate when parameters change
            _ = ValidateAllPublishedAsync();
        }
    }

    private string GetPortKey(PortMapping pm)
    {
        return $"{pm.ContainerPort}_{pm.Protocol}";
    }

    private bool IsDefaultPort(PortMapping pm)
    {
        return GetPortKey(pm) == defaultPortKey;
    }

    private bool HasDefaultPort()
    {
        return GameTypeDefinition?.Ports?.Any(p => p.IsDefaultPort) == true;
    }

    private void OnDefaultPortChanged(PortMapping selectedPort)
    {
        if (Server?.Ports == null) return;

        defaultPortKey = GetPortKey(selectedPort);
        
        // Find the index of the selected port
        var portsList = Server.Ports.ToList();
        defaultPortIndex = portsList.IndexOf(selectedPort);
        if (defaultPortIndex < 0) defaultPortIndex = 0;

        StateHasChanged();
        _ = NotifyChangedAsync();
    }

    // -- Handlers --

    void OnPublishedChanged(PortMapping pm, uint value)
    {
        if (pm == null || Server?.Ports == null) return;

        // treat 0 as "default to container port"
        if (value == 0)
        {
            pm.PublishedPort = (int)(pm.ContainerPort != 0 ? pm.ContainerPort : 0);
        }
        else
        {
            pm.PublishedPort = (int)(value > 65535 ? 65535 : value);
        }

        // If this is the default port and it maps to a setting, update related ports
        if (IsDefaultPort(pm))
        {
            _ = UpdateRelatedPortsAsync(pm);
        }

        _ = ValidateAllPublishedAsync();
        _ = NotifyChangedAsync();
    }

    private async Task UpdateRelatedPortsAsync(PortMapping defaultPort)
    {
        if (extendedMetadata?.SettingsMetadata == null || Server?.Ports == null)
            return;

        // Find the setting that maps to this default port
        var portSetting = extendedMetadata.SettingsMetadata.Values
            .FirstOrDefault(s => s.MapsToContainerPort && 
                               s.LinkedContainerPort == defaultPort.ContainerPort &&
                               s.PortProtocol?.Equals(defaultPort.Protocol, StringComparison.OrdinalIgnoreCase) == true);

        if (portSetting?.PortRelationships?.Any() != true)
            return;

        var newPort = defaultPort.PublishedPort;

        // Process port relationships
        foreach (var relationship in portSetting.PortRelationships)
        {
            var relatedPort = Server.Ports.FirstOrDefault(p =>
                p.ContainerPort == relationship.TargetContainerPort &&
                p.Protocol.Equals(relationship.TargetProtocol, StringComparison.OrdinalIgnoreCase));

            if (relatedPort != null)
            {
                int calculatedPort = relationship.RelationType switch
                {
                    PortRelationshipType.Offset => newPort + relationship.Offset,
                    PortRelationshipType.Fixed => (int)(relationship.FixedValue ?? relationship.TargetContainerPort),
                    PortRelationshipType.Multiplier => newPort * relationship.Offset,
                    _ => relatedPort.PublishedPort
                };

                if (calculatedPort > 0 && calculatedPort <= 65535)
                {
                    relatedPort.ContainerPort = calculatedPort;
                    relatedPort.PublishedPort = calculatedPort;
                }
            }
        }

        StateHasChanged();
    }


    // -- Validation --

    public async Task RevalidateAsync()
    {
        await ValidateAllPublishedAsync();
        StateHasChanged();
    }

    async Task ValidateAllPublishedAsync()
    {
        publishedErrors.Clear();
        if (Server == null) return;

        // compute effective published for duplicate detection (Published==0 treated as Container)
        var effective = Server.Ports.Select(p => new { 
            Instance = p, 
            Port = (p.PublishedPort == 0 ? p.ContainerPort : p.PublishedPort),
            Protocol = p.Protocol
        }).ToList();

        foreach (var e in effective)
        {
            // Range check
            if (e.Port < 1 || e.Port > 65535)
            {
                publishedErrors[e.Instance] = "Published port must be between 1 and 65535.";
                continue;
            }

            // Duplicates - same port AND same protocol
            var duplicates = effective.Count(x => x.Port == e.Port && x.Protocol == e.Protocol);
            if (duplicates > 1)
            {
                publishedErrors[e.Instance] = $"Port {e.Port}/{e.Protocol} is used by multiple mappings.";
                continue;
            }

            // Already allocated - check with protocol
            var isFree = await PortApi.CheckAsync(e.Protocol, e.Port);
            if (!isFree)
            {
                publishedErrors[e.Instance] = $"Port {e.Port}/{e.Protocol} is already in use!";
                continue;
            }
            // valid -> no error
            // ensure key removed
            if (publishedErrors.ContainsKey(e.Instance)) publishedErrors.Remove(e.Instance);
        }
        // Notify validity change
        await OnValidityChanged.InvokeAsync(publishedErrors.Count == 0);  
    }

    string GetPublishedStyle(PortMapping pm)
    {
        return publishedErrors.ContainsKey(pm) ? "border-color:#b91c1c" : "";
    }

    public string GetDefaultPortConnectionString()
    {
        if (Server?.Ports == null || !Server.Ports.Any()) return "";
        
        var defaultPort = Server.Ports.FirstOrDefault(pm => IsDefaultPort(pm));
        if (defaultPort == null) return "";
        
        var effectivePort = defaultPort.PublishedPort == 0 ? defaultPort.ContainerPort : defaultPort.PublishedPort;
        return $"{effectivePort}/{defaultPort.Protocol}";
    }

    // -- Notify changed upstream --

    Task NotifyChangedAsync()
    {
        if (Server == null) return Task.CompletedTask;
        return OnChanged.HasDelegate ? OnChanged.InvokeAsync(Server) : Task.CompletedTask;
    }

    private async Task LoadExtendedMetadataAsync()
    {
        if (GameTypeDefinition == null || string.IsNullOrEmpty(GameTypeDefinition.Key))
            return;

        try
        {
            extendedMetadata = await ExtendedMetadataApi.GetAsync(GameTypeDefinition.Key);
        }
        catch
        {
            // Extended metadata is optional
            extendedMetadata = null;
        }
    }
}