@using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using System.Linq
@using Microsoft.AspNetCore.Components.Rendering
@inject NotificationService NotificationService
@inject IGameTypeExtendedMetadataApi ExtendedMetadataApi

<RadzenCard>
    <h4>@(Definition?.DisplayName ?? "Game") Settings</h4>
    
    @if (isLoadingMetadata)
    {
        <div class="text-center py-4">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <p class="text-muted mt-2">Loading settings...</p>
        </div>
    }
    else
    {
        <EditForm Model="Server">
            <DataAnnotationsValidator/>
            
            @if (Definition?.DefaultSettings == null || !Definition.DefaultSettings.Any())
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="mb-3">
                    No predefined settings for this game type. You can configure settings after deployment.
                </RadzenAlert>
            }
            else if (extendedMetadata != null && extendedMetadata.SettingsMetadata.Any())
            {
                @* Render settings grouped by category using Extended Metadata *@
                var categories = extendedMetadata.SettingsMetadata.Values
                    .GroupBy(s => s.Category ?? "General")
                    .OrderBy(g => g.Key == "General" ? 0 : 1)
                    .ThenBy(g => g.Key);

                @foreach (var category in categories)
                {
                    <div class="settings-category mb-4">
                        <h5 class="category-title">
                            <RadzenIcon Icon="settings" Style="font-size: 1.25rem;" />
                            @category.Key
                        </h5>
                        
                        <div class="settings-grid">
                            @foreach (var settingMeta in category.OrderBy(s => s.DisplayOrder))
                            {
                                <div class="setting-item">
                                    @RenderSettingControl(settingMeta)
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                @* Fallback: Render basic settings without metadata *@
                <div class="settings-grid">
                    @foreach (var setting in Definition.DefaultSettings.OrderBy(s => s.Key))
                    {
                        <div class="setting-item">
                            <RadzenFormField Text="@setting.Key" Variant="@Variant.Outlined" class="w-100">
                                <RadzenTextBox @bind-Value="@Server.Settings[setting.Key]" 
                                               Placeholder="@setting.Value"
                                               class="w-100" />
                            </RadzenFormField>
                            <small class="text-muted">Default: @setting.Value</small>
                        </div>
                    }
                </div>
            }
        </EditForm>
    }
    
    <div class="wizard-actions">
        <RadzenButton Text="Back" 
                      ButtonStyle="ButtonStyle.Secondary" 
                      Click="@BackAsync" 
                      Disabled="@isLoadingMetadata" />
        <RadzenButton Text="Next" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@NextAsync" 
                      Disabled="@isLoadingMetadata" />
    </div>
</RadzenCard>

<style>
    .settings-category {
        border: 1px solid var(--rz-border-color);
        border-radius: 8px;
        padding: 1rem;
        background: var(--rz-base-50);
    }

    .category-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--rz-primary);
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
    }

    .setting-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .setting-label {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .required-indicator {
        color: var(--rz-danger);
        font-weight: bold;
    }

    .setting-description {
        font-size: 0.75rem;
        color: var(--rz-text-secondary-color);
        line-height: 1.4;
        margin-top: 0.25rem;
    }

    .wizard-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rz-border-color);
    }

    @@media (max-width: 768px) {
        .settings-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


@code {
    [Parameter] public GameTypeDefinition Definition { get; set; } = new();
    [Parameter] public GameServer Server { get; set; } = new();
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private GameTypeExtendedMetadata? extendedMetadata;
    private bool isLoadingMetadata = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Definition != null && !string.IsNullOrEmpty(Definition.Key))
        {
            await LoadExtendedMetadataAsync();
        }
    }

    private async Task LoadExtendedMetadataAsync()
    {
        isLoadingMetadata = true;
        StateHasChanged();

        try
        {
            extendedMetadata = await ExtendedMetadataApi.GetAsync(Definition.Key);
            
            // Initialize settings in Server.Settings if not already present
            if (extendedMetadata?.SettingsMetadata != null)
            {
                foreach (var settingMeta in extendedMetadata.SettingsMetadata.Values)
                {
                    if (!Server.Settings.ContainsKey(settingMeta.Key))
                    {
                        // Set default value from Definition if available
                        if (Definition.DefaultSettings?.TryGetValue(settingMeta.Key, out var defaultValue) == true)
                        {
                            Server.Settings[settingMeta.Key] = defaultValue;
                        }
                        else
                        {
                            Server.Settings[settingMeta.Key] = settingMeta.Placeholder ?? "";
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
            // Extended metadata is optional - if not found, fall back to basic rendering
            extendedMetadata = null;
        }
        finally
        {
            isLoadingMetadata = false;
            StateHasChanged();
        }
    }

    private RenderFragment RenderSettingControl(SettingMetadata settingMeta)
    {
        return builder =>
        {
            var sequence = 0;
            
            // Ensure setting exists in Server.Settings
            if (!Server.Settings.ContainsKey(settingMeta.Key))
            {
                Server.Settings[settingMeta.Key] = settingMeta.Placeholder ?? "";
            }

            // Label with required indicator
            builder.OpenElement(sequence++, "label");
            builder.AddAttribute(sequence++, "class", "setting-label");
            builder.AddContent(sequence++, settingMeta.Key);
            if (settingMeta.IsRequired)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "required-indicator");
                builder.AddContent(sequence++, " *");
                builder.CloseElement();
            }
            builder.CloseElement();

            // Render appropriate control based on DataType
            var dataType = settingMeta.DataType?.ToLowerInvariant() ?? "string";
            
            if (dataType == "boolean")
            {
                RenderBooleanControl(builder, ref sequence, settingMeta);
            }
            else if (dataType == "number" || dataType == "port")
            {
                RenderNumberControl(builder, ref sequence, settingMeta);
            }
            else if (dataType == "enum" && settingMeta.AllowedValues?.Any() == true)
            {
                RenderEnumControl(builder, ref sequence, settingMeta);
            }
            else
            {
                RenderTextControl(builder, ref sequence, settingMeta);
            }

            // Description
            if (!string.IsNullOrWhiteSpace(settingMeta.Description))
            {
                builder.OpenElement(sequence++, "small");
                builder.AddAttribute(sequence++, "class", "setting-description");
                builder.AddContent(sequence++, settingMeta.Description);
                builder.CloseElement();
            }
        };
    }

    private void RenderTextControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenTextBox>(s2++);
            b2.AddAttribute(s2++, "Value", Server.Settings[settingMeta.Key]);
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<string>(this, value =>
            {
                Server.Settings[settingMeta.Key] = value;
                StateHasChanged();
            }));
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? "");
            b2.AddAttribute(s2++, "class", "w-100");
            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void RenderNumberControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenNumeric<int>>(s2++);
            
            // Parse current value
            int currentValue = 0;
            if (Server.Settings.TryGetValue(settingMeta.Key, out var strValue))
            {
                int.TryParse(strValue, out currentValue);
            }
            
            b2.AddAttribute(s2++, "Value", currentValue);
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<int>(this, value =>
            {
                Server.Settings[settingMeta.Key] = value.ToString();
                StateHasChanged();
            }));
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? "");
            b2.AddAttribute(s2++, "class", "w-100");
            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    private void RenderBooleanControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        builder.OpenComponent<RadzenSwitch>(sequence++);
        
        // Parse current value
        bool currentValue = false;
        if (Server.Settings.TryGetValue(settingMeta.Key, out var strValue))
        {
            bool.TryParse(strValue, out currentValue);
        }
        
        builder.AddAttribute(sequence++, "Value", currentValue);
        builder.AddAttribute(sequence++, "ValueChanged", EventCallback.Factory.Create<bool>(this, value =>
        {
            Server.Settings[settingMeta.Key] = value.ToString().ToLower();
            StateHasChanged();
        }));
        builder.CloseComponent();
    }

    private void RenderEnumControl(RenderTreeBuilder builder, ref int sequence, SettingMetadata settingMeta)
    {
        builder.OpenComponent<RadzenFormField>(sequence++);
        builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
        builder.AddAttribute(sequence++, "class", "w-100");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b2 =>
        {
            var s2 = 0;
            b2.OpenComponent<RadzenDropDown<string>>(s2++);
            b2.AddAttribute(s2++, "Data", settingMeta.AllowedValues);
            
            // Get current value or empty string
            var currentValue = "";
            if (Server.Settings.TryGetValue(settingMeta.Key, out var val))
            {
                currentValue = val;
            }
            
            b2.AddAttribute(s2++, "Value", currentValue);
            b2.AddAttribute(s2++, "ValueChanged", EventCallback.Factory.Create<string>(this, value =>
            {
                Server.Settings[settingMeta.Key] = value;
                StateHasChanged();
            }));
            b2.AddAttribute(s2++, "Placeholder", settingMeta.Placeholder ?? "Select an option");
            b2.AddAttribute(s2++, "class", "w-100");
            
            // Use ValueMappings for display text if available
            if (settingMeta.ValueMappings?.Any() == true)
            {
                b2.AddAttribute(s2++, "Template", (RenderFragment<string>)(item =>
                {
                    return (RenderFragment)(b3 =>
                    {
                        var description = settingMeta.ValueMappings.TryGetValue(item, out var desc) ? desc : item;
                        b3.AddContent(0, description);
                    });
                }));
            }
            
            b2.CloseComponent();
        }));
        builder.CloseComponent();
    }

    async Task NextAsync()
    {
        // Validate required fields
        if (extendedMetadata?.SettingsMetadata != null)
        {
            var missingRequired = extendedMetadata.SettingsMetadata.Values
                .Where(s => s.IsRequired)
                .Where(s => !Server.Settings.ContainsKey(s.Key) || 
                           string.IsNullOrWhiteSpace(Server.Settings[s.Key]))
                .ToList();

            if (missingRequired.Any())
            {
                var missingNames = string.Join(", ", missingRequired.Select(s => s.Key));
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Required Settings Missing",
                    Detail = $"Please provide values for: {missingNames}",
                    Duration = 5000
                });
                return;
            }

            // Validate patterns
            var invalidSettings = new List<string>();
            foreach (var settingMeta in extendedMetadata.SettingsMetadata.Values)
            {
                if (!string.IsNullOrWhiteSpace(settingMeta.ValidationPattern) &&
                    Server.Settings.TryGetValue(settingMeta.Key, out var value) &&
                    !string.IsNullOrWhiteSpace(value))
                {
                    if (!System.Text.RegularExpressions.Regex.IsMatch(value, settingMeta.ValidationPattern))
                    {
                        invalidSettings.Add($"{settingMeta.Key}: {settingMeta.ValidationMessage ?? "Invalid format"}");
                    }
                }
            }

            if (invalidSettings.Any())
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Validation Failed",
                    Detail = string.Join("\n", invalidSettings),
                    Duration = 7000
                });
                return;
            }
        }

        // Remove settings that match default values or are empty
        var remove = new List<string>();
        foreach (var s in Server.Settings.ToList())
        {
            if (Definition.DefaultSettings?.TryGetValue(s.Key, out var val) == true)
            {
                if (s.Value == val || string.IsNullOrWhiteSpace(s.Value))
                {
                    remove.Add(s.Key);
                }
            }
        }

        foreach (var r in remove)
        {
            Server.Settings.Remove(r);
        }

        await OnNext.InvokeAsync(null);
    }

    Task BackAsync() => OnBack.InvokeAsync(null);
}
