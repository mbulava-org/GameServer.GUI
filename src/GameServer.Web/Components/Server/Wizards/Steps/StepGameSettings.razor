@using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using System.Linq
@inject NotificationService NotificationService

<RadzenCard>
    <h4>@(Definition?.DisplayName ?? "Game") Settings</h4>
    
    <EditForm Model="Server">
        <DataAnnotationsValidator/>
        
        <GameSettingsEditor GameTypeDefinition="@Definition" 
                           Server="@Server" 
                           ServerChanged="@OnServerChanged"
                           OnValidationChanged="@OnValidationChanged"
                           @ref="settingsEditor" />
    </EditForm>
    
    <div class="wizard-actions">
        <RadzenButton Text="Back" 
                      ButtonStyle="ButtonStyle.Secondary" 
                      Click="@BackAsync" />
        <RadzenButton Text="Next" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@NextAsync" />
    </div>
</RadzenCard>

<style>
    .wizard-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rz-border-color);
    }
</style>

@code {
    [Parameter] public GameTypeDefinition Definition { get; set; } = new();
    [Parameter] public GameServer Server { get; set; } = new();
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private GameSettingsEditor? settingsEditor;
    private bool isValid = true;

    private async Task OnServerChanged(GameServer server)
    {
        Server = server;
        StateHasChanged();
    }

    private async Task OnValidationChanged(bool valid)
    {
        isValid = valid;
        StateHasChanged();
    }

    async Task NextAsync()
    {
        // Validate using the editor component
        if (settingsEditor != null)
        {
            var valid = await settingsEditor.ValidateAsync();
            if (!valid)
            {
                var errors = settingsEditor.GetValidationErrors();
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Validation Failed",
                    Detail = string.Join("\n", errors),
                    Duration = 5000
                });
                return;
            }
        }

        // Remove settings that match default values or are empty
        var remove = new List<string>();
        foreach (var s in Server.Settings.ToList())
        {
            if (Definition.DefaultSettings?.TryGetValue(s.Key, out var val) == true)
            {
                if (s.Value == val || string.IsNullOrWhiteSpace(s.Value))
                {
                    remove.Add(s.Key);
                }
            }
        }

        foreach (var r in remove)
        {
            Server.Settings.Remove(r);
        }

        await OnNext.InvokeAsync(null);
    }

    Task BackAsync() => OnBack.InvokeAsync(null);
}

