@using Radzen
@using Radzen.Blazor
@attribute [Obsolete("Legacy pre-V2 create-server wizard step. Migrate to the V2 server flow before removing the old repository chain.")]
@using global::GameServer.Docker.Client
@using System.Net.Http
@using System.Text.Json
@inject HttpClient Http
@inject NotificationService NotificationService
@inject IGameTypeExtendedMetadataApi ExtendedMetadataApi

<RadzenCard class="review-card">
  
  <ChildContent>
      <h3>Review Server Configuration</h3>
    <div class="review-grid">
      <div class="review-section">
        <RadzenCard>
          
          <ChildContent>
              <p>Basic Information</p>
            <div class="info-row">
              <span class="info-label">Name:</span>
              <span class="info-value">@Server.Name</span>
            </div>
            <div class="info-row">
              <span class="info-label">Game Type:</span>
              <span class="info-value">@Definition?.DisplayName</span>
            </div>
            <div class="info-row">
              <span class="info-label">Description:</span>
              <span class="info-value">@Server.Description</span>
            </div>
          </ChildContent>
        </RadzenCard>

        <RadzenCard class="mt-3">
          
          <ChildContent>
              <p>Network Information</p>
            <div class="info-row">
              <span class="info-label">Host IP:</span>
              <span class="info-value">
                @if (loadingIp)
                {
                  <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
                }
                else
                {
                  @publicIp
                }
              </span>
            </div>
            <div class="info-row">
              <span class="info-label">Published Port:</span>
              <span class="info-value">
                @GetDefaultPublishedPort()
                @if (HasDefaultPort())
                {
                  <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Default" Size="BadgeSize.Small" class="ms-2" />
                }
              </span>
            </div>
            <div class="info-row">
              <span class="info-label">Connection:</span>
              <span class="info-value connection-string">@GetConnectionString()</span>
            </div>
          </ChildContent>
        </RadzenCard>

        <RadzenCard class="mt-3">
          
          <ChildContent>
              <p>Settings Summary</p>
            @if (isLoadingMetadata)
            {
              <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            }
            else if (GetDisplaySettings().Any())
            {
              <div class="settings-list">
                @foreach (var setting in GetDisplaySettings())
                {
                  <div class="info-row">
                    <span class="info-label">
                      @setting.Key
                      @if (setting.IsRequired)
                      {
                        <span class="required-indicator">*</span>
                      }:
                    </span>
                    <span class="info-value">
                      @if (string.IsNullOrWhiteSpace(setting.Value))
                      {
                        <span class="text-muted">(default: @setting.DefaultValue)</span>
                      }
                      else
                      {
                        @setting.Value
                      }
                    </span>
                  </div>
                }
              </div>
            }
            else
            {
              <div class="no-data">No settings configured.</div>
            }
          </ChildContent>
        </RadzenCard>
      </div>

      <div class="review-section">
        <RadzenCard>
          
          <ChildContent>
              <p>Port Mappings</p>
            @if (Server.Ports?.Any() == true)
            {
              <div class="ports-list">
                @foreach (var port in Server.Ports)
                {
                  var isDefault = IsDefaultPort(port);
                  <div class="port-item">
                    <div class="d-flex align-items-center gap-2">
                      <RadzenBadge BadgeStyle="@(isDefault ? BadgeStyle.Success : BadgeStyle.Info)" 
                                   Text='@($"{port.PublishedPort} → {port.ContainerPort} ({port.Protocol})")' />
                      @if (isDefault)
                      {
                        <RadzenIcon Icon="star" Style="color: var(--rz-warning); font-size: 1rem;" title="Default connection port" />
                      }
                    </div>
                  </div>
                }
              </div>
            }
            else
            {
              <div class="no-data">No port mappings configured.</div>
            }
          </ChildContent>
        </RadzenCard>

        <RadzenCard class="mt-3">
          <ChildContent>
              <p>Volumes</p>
            @if (Server.Volumes?.Any() == true)
            {
              <div class="volumes-list">
                @foreach (var vol in Server.Volumes)
                {
                  <div class="info-row">
                    <span class="info-label">
                      @if (string.IsNullOrWhiteSpace(vol.Source))
                      {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Create New" Size="BadgeSize.Small" />
                      }
                      else
                      {
                        @vol.Source
                      }
                    </span>
                    <span class="info-value">→ @vol.Target</span>
                  </div>
                }
              </div>
            }
            else
            {
              <div class="no-data">No volumes configured.</div>
            }
          </ChildContent>
        </RadzenCard>
      </div>
    </div>
    <div class="review-footer">
      <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Secondary" Click="BackAsync" />
      <RadzenButton Text="Create Server" ButtonStyle="ButtonStyle.Success" Click="CreateAsync" Icon="check" />
    </div>
  </ChildContent>

  
</RadzenCard>

@code {
[Parameter] public GameTypeDefinition? Definition { get; set; }
[Parameter] public GameServer Server { get; set; } = new();
[Parameter] public EventCallback OnCreate { get; set; }
[Parameter] public EventCallback OnBack { get; set; }

string publicIp = "Loading...";
bool loadingIp = true;
bool isLoadingMetadata = false;
GameTypeExtendedMetadata? extendedMetadata;

  protected override async Task OnInitializedAsync()
  {
      await Task.WhenAll(
          LoadPublicIpAsync(),
          LoadExtendedMetadataAsync()
      );
  }

  async Task LoadExtendedMetadataAsync()
  {
      if (Definition == null || string.IsNullOrEmpty(Definition.Key))
          return;

      isLoadingMetadata = true;
      try
      {
          extendedMetadata = await ExtendedMetadataApi.GetAsync(Definition.Key);
      }
      catch
      {
          // Extended metadata is optional
          extendedMetadata = null;
      }
      finally
      {
          isLoadingMetadata = false;
          StateHasChanged();
      }
  }

  class DisplaySetting
  {
      public string Key { get; set; } = "";
      public string Value { get; set; } = "";
      public string DefaultValue { get; set; } = "";
      public bool IsRequired { get; set; }
      public int DisplayOrder { get; set; }
  }

  List<DisplaySetting> GetDisplaySettings()
  {
      var displaySettings = new List<DisplaySetting>();

      // If we have extended metadata, use it to determine which settings to show
      if (extendedMetadata?.SettingsMetadata != null)
      {
          foreach (var meta in extendedMetadata.SettingsMetadata.Values)
          {
              var currentValue = Server.Settings?.TryGetValue(meta.Key, out var val) == true ? val : "";
              var defaultValue = Definition?.DefaultSettings?.TryGetValue(meta.Key, out var defVal) == true ? defVal : "";

              // Show setting if:
              // 1. It's required (always show)
              // 2. It has a non-default value
              if (meta.IsRequired || (!string.IsNullOrWhiteSpace(currentValue) && currentValue != defaultValue))
              {
                  displaySettings.Add(new DisplaySetting
                  {
                      Key = meta.Key,
                      Value = currentValue,
                      DefaultValue = defaultValue,
                      IsRequired = meta.IsRequired,
                      DisplayOrder = meta.DisplayOrder
                  });
              }
          }
      }
      else
      {
          // Fallback: show all settings that have values
          if (Server.Settings != null)
          {
              foreach (var kvp in Server.Settings)
              {
                  var defaultValue = Definition?.DefaultSettings?.TryGetValue(kvp.Key, out var defVal) == true ? defVal : "";
                    
                  displaySettings.Add(new DisplaySetting
                  {
                      Key = kvp.Key,
                      Value = kvp.Value,
                      DefaultValue = defaultValue,
                      IsRequired = false,
                      DisplayOrder = 999
                  });
              }
          }
      }

      return displaySettings.OrderBy(s => s.DisplayOrder).ThenBy(s => s.Key).ToList();
  }

    async Task LoadPublicIpAsync()
    {
        loadingIp = true;
        try
        {
            // Try multiple public IP services for reliability
            publicIp = await GetPublicIpFromService("https://api.ipify.org?format=json")
                       ?? await GetPublicIpFromService("https://ifconfig.me/ip")
                       ?? "Unable to determine";
        }
        catch
        {
            publicIp = "Unable to determine";
        }
        finally
        {
            loadingIp = false;
            StateHasChanged();
        }
    }

    async Task<string?> GetPublicIpFromService(string url)
    {
        try
        {
            var response = await Http.GetStringAsync(url);
            if (url.Contains("json"))
            {
                var json = JsonSerializer.Deserialize<JsonElement>(response);
                if (json.TryGetProperty("ip", out var ipProp))
                    return ipProp.GetString();
            }
            return response.Trim();
        }
        catch
        {
            return null;
        }
    }

    string GetDefaultPublishedPort()
    {
        var defaultPort = GetDefaultPort();
        return defaultPort?.PublishedPort.ToString() ?? "Not configured";
    }

    bool HasDefaultPort()
    {
        return Definition?.Ports?.Any(p => p.IsDefaultPort) == true;
    }

    bool IsDefaultPort(PortMapping port)
    {
        if (!HasDefaultPort() || Definition?.Ports == null)
            return false;

        // Find the default port definition
        var defaultPortDef = Definition.Ports.FirstOrDefault(p => p.IsDefaultPort);
        if (defaultPortDef == null)
            return false;

        // Find the index of the default port in the definition
        var portDefsList = Definition.Ports.ToList();
        var defaultIndex = portDefsList.IndexOf(defaultPortDef);

        if (defaultIndex < 0)
            return false;

        // Check if this port is at the same index in Server.Ports
        var serverPortsList = Server.Ports?.ToList();
        if (serverPortsList == null || defaultIndex >= serverPortsList.Count)
            return false;

        return serverPortsList[defaultIndex] == port;
    }

    PortMapping? GetDefaultPort()
    {
        if (!HasDefaultPort() || Definition?.Ports == null || Server.Ports == null)
            return Server.Ports?.FirstOrDefault();

        // Find the default port definition
        var defaultPortDef = Definition.Ports.FirstOrDefault(p => p.IsDefaultPort);
        if (defaultPortDef == null)
            return Server.Ports.FirstOrDefault();

        // Find the index of the default port in the definition
        var portDefsList = Definition.Ports.ToList();
        var defaultIndex = portDefsList.IndexOf(defaultPortDef);

        if (defaultIndex < 0)
            return Server.Ports.FirstOrDefault();

        // Get the port at the same index in Server.Ports
        var serverPortsList = Server.Ports.ToList();
        if (defaultIndex < serverPortsList.Count)
            return serverPortsList[defaultIndex];

        return Server.Ports.FirstOrDefault();
    }

    string GetConnectionString()
    {
        var defaultPort = GetDefaultPort();
        var port = defaultPort?.PublishedPort ?? 0;
        
        if (port > 0 && !string.IsNullOrEmpty(publicIp) && publicIp != "Loading..." && publicIp != "Unable to determine")
        {
            return $"{publicIp}:{port}";
        }
        return "N/A";
    }

    Task BackAsync() => OnBack.InvokeAsync(null);
    Task CreateAsync() => OnCreate.InvokeAsync(null);
}
