@using Radzen
@using Radzen.Blazor
@using global::GameServer.Docker.Client
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text
@using Microsoft.Extensions.Options
@using GameServer.Web.Configurations
@inject IGameServerApi ServerApi
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IOptions<GameServerDockerApi> ApiConfig
@implements IAsyncDisposable

<div class="logs-viewer">
  <div class="logs-toolbar">
    <div class="toolbar-left">
      <RadzenButton Icon='@(isStreaming ? "pause" : "play_arrow")' 
                    Text='@(isStreaming ? "Stop" : "Stream Logs")' 
                    Click="ToggleStreaming" 
                    ButtonStyle='@(isStreaming ? ButtonStyle.Warning : ButtonStyle.Success)' />
      <RadzenButton Icon="refresh" Text="Refresh" Click="RefreshLogs" Disabled="@isStreaming" />
      <RadzenButton Icon="delete_sweep" Text="Clear" Click="ClearLogs" ButtonStyle="ButtonStyle.Secondary" />
      @if (hubConnection?.State != HubConnectionState.Connected && !string.IsNullOrEmpty(connectionStatus))
      {
        <RadzenBadge BadgeStyle="@GetConnectionBadgeStyle()" Text="@connectionStatus" class="ms-2" />
      }
    </div>
    <div class="toolbar-right">
      <RadzenCheckBox @bind-Value="autoScroll" />
      <RadzenLabel Text="Auto-scroll" class="ml-2" />
      <RadzenNumeric @bind-Value="maxLines" Min="100" Max="10000" Step="100" class="ml-3" Style="width:120px" />
      <RadzenLabel Text="Max Lines" class="ml-2" />
      <RadzenNumeric @bind-Value="tailLines" Min="10" Max="1000" Step="10" class="ml-3" Style="width:120px" />
      <RadzenLabel Text="Tail Lines" class="ml-2" />
      <RadzenButton Icon="download" Text="Download" Click="DownloadLogs" ButtonStyle="ButtonStyle.Light" />
    </div>
  </div>

  <div class="logs-filter">
    <RadzenTextBox @bind-Value="filterText" Placeholder="Filter logs..." class="filter-input" />
    <RadzenDropDown Data="logLevels" @bind-Value="selectedLogLevel" AllowClear="true" Placeholder="All Levels" class="ml-2" Style="width:150px" />
  </div>

  <div class="logs-content" @ref="logsContentRef">
    @if (loadingLogs)   
    {
      <div class="loading-indicator">
        <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
        <span>Loading logs...</span>
      </div>
    }
    else if (!logLines.Any())
    {
      <div class="no-logs">No logs available</div>
    }
    else
    {
      <div class="log-lines">
        @foreach (var line in GetFilteredLogs())
        {
          <div class='@GetLogLineClass(line)'>
            <span class="log-timestamp">@line.Timestamp.ToString("HH:mm:ss.fff")</span>
            <span class="log-level">[@line.Level]</span>
            <span class="log-message">@line.Message</span>
          </div>
        }
      </div>
    }
  </div>

  <div class="logs-footer">
    <span>Total: @logLines.Count lines | Filtered: @GetFilteredLogs().Count() lines</span>
    @if (isStreaming)
    {
      <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="? Live Streaming" />
      @if (hubConnection?.State == HubConnectionState.Connected)
      {
        <span class="ms-2 text-success">Connected via WebSocket</span>
      }
    }
    else
    {
      <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="? Stopped" />
    }
  </div>
</div>

@code {
[Parameter] public string ServerId { get; set; } = "";
[Parameter] public GameServer Server { get; set; } = new();

[Inject] private ILogger<ServerLogsViewer>? _logger { get; set; }

class LogLine
{
  public DateTime Timestamp { get; set; }
  public string Level { get; set; } = "INFO";
  public string Message { get; set; } = "";
}

private HubConnection? hubConnection;
  private List<LogLine> logLines = new();
  private bool loadingLogs = false;
  private bool isStreaming = false;
  private bool autoScroll = true;
  private int maxLines = 10000;
  private int tailLines = 100;
  private string filterText = "";
  private string? selectedLogLevel;
  private string[] logLevels = new[] { "DEBUG", "INFO", "WARN", "ERROR", "FATAL" };
  private ElementReference logsContentRef;
  private string connectionStatus = "";
  private CancellationTokenSource? streamCts;

  protected override async Task OnInitializedAsync()
  {
    // Initialize SignalR connection
    await InitializeHubConnectionAsync();

    // Auto-start if server ID is provided
    if (!string.IsNullOrWhiteSpace(ServerId))
    {
      await StartStreaming();
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    // Restart streaming if server ID changes
    if (isStreaming)
    {
      await StopStreaming();
      logLines.Clear();
      await StartStreaming();
    }
  }

  private async Task InitializeHubConnectionAsync()
  {
    try
    {
      connectionStatus = "Connecting...";
      StateHasChanged();

      // Build the hub URL using the API base URI from configuration
      var apiBaseUri = ApiConfig.Value.BaseUri.TrimEnd('/');
      var hubUrl = $"{apiBaseUri}/hubs/serverlogs";
      
      _logger?.LogInformation("Connecting to ServerLogs hub at {HubUrl}", hubUrl);

      hubConnection = new HubConnectionBuilder()
        .WithUrl(hubUrl)
        .WithAutomaticReconnect(new[] 
        { 
          TimeSpan.Zero, 
          TimeSpan.FromSeconds(2), 
          TimeSpan.FromSeconds(5), 
          TimeSpan.FromSeconds(10) 
        })
        .Build();

      // Handle reconnection events
      hubConnection.Reconnecting += error =>
      {
        connectionStatus = "Reconnecting...";
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
      };

      hubConnection.Reconnected += connectionId =>
      {
        connectionStatus = "Connected";
        NotificationService?.Notify(new NotificationMessage
        {
          Severity = NotificationSeverity.Success,
          Summary = "Reconnected",
          Detail = "Log stream reconnected successfully",
          Duration = 2000
        });
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
      };

      hubConnection.Closed += error =>
      {
        connectionStatus = error != null ? "Disconnected (error)" : "Disconnected";
        if (error != null && isStreaming)
        {
          NotificationService?.Notify(new NotificationMessage
          {
            Severity = NotificationSeverity.Error,
            Summary = "Connection Lost",
            Detail = "Log stream connection lost. Attempting to reconnect...",
            Duration = 4000
          });
        }
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
      };

      await hubConnection.StartAsync();
      connectionStatus = "Connected";
    }
    catch (Exception ex)
    {
      connectionStatus = $"Connection failed: {ex.Message}";
      NotificationService?.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Connection Error",
        Detail = $"Failed to connect to log stream: {ex.Message}",
        Duration = 5000
      });
    }
  }

  private async Task ToggleStreaming()
  {
    if (isStreaming)
    {
      await StopStreaming();
    }
    else
    {
      await StartStreaming();
    }
  }

  private async Task StartStreaming()
  {
    if (string.IsNullOrWhiteSpace(ServerId))
    {
      return;
    }

    if (hubConnection?.State != HubConnectionState.Connected)
    {
      NotificationService?.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Warning,
        Summary = "Not Connected",
        Detail = "Attempting to reconnect to log stream...",
        Duration = 3000
      });

      try
      {
        await InitializeHubConnectionAsync();
      }
      catch
      {
        return;
      }
    }

    isStreaming = true;
    loadingLogs = true;
    streamCts = new CancellationTokenSource();

    try
    {
      // Stream logs from SignalR hub
      await foreach (var logLine in hubConnection!.StreamAsync<string>(
        "StreamServerLogs",
        ServerId,
        true,      // follow
        tailLines, // tailLines
        true,      // timestamps
        streamCts.Token))
      {
        // Parse and add log line
        var parsedLine = ParseLogLine(logLine);
        logLines.Add(parsedLine);

        // Trim to max lines
        while (logLines.Count > maxLines)
        {
          logLines.RemoveAt(0);
        }

        // Auto-scroll if enabled
        if (autoScroll)
        {
          await ScrollToBottomAsync();
        }

        await InvokeAsync(StateHasChanged);
      }
    }
    catch (OperationCanceledException)
    {
      // Expected when stopping
    }
    catch (Exception ex)
    {
      var errorMessage = ex.Message;
      var userFriendlyMessage = errorMessage;
      
      // Check for container not found - common when server is stopped
      if (ex is HubException && ex.Message.Contains("An error occurred on the server"))
      {
        userFriendlyMessage = "Container not found. The server may be stopped or not yet started.";
        errorMessage = "Container not found or not running";
        
        _logger?.LogWarning("Failed to stream logs for server {ServerId}: Container not found or not running", ServerId);
      }
      else
      {
        _logger?.LogError(ex, "Failed to stream logs for server {ServerId}", ServerId);
      }
      
      NotificationService?.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Stream Error",
        Detail = userFriendlyMessage,
        Duration = 5000
      });

      // Add error message to logs
      logLines.Add(new LogLine
      {
        Timestamp = DateTime.Now,
        Level = "ERROR",
        Message = $"[STREAM ERROR] {errorMessage}"
      });
      
      logLines.Add(new LogLine
      {
        Timestamp = DateTime.Now,
        Level = "INFO",
        Message = "Tip: Check if the server container is running in Docker."
      });
    }
    finally
    {
      loadingLogs = false;
      isStreaming = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task StopStreaming()
  {
    isStreaming = false;
    streamCts?.Cancel();
    await Task.CompletedTask;
  }

  private async Task RefreshLogs()
  {
    if (isStreaming)
    {
      return;
    }

    loadingLogs = true;
    try
    {
      var logs = await ServerApi.GetServiceLogsAsync(ServerId, tailLines);

      if (logs != null && logs.Any())
      {
        logLines.Clear();

        foreach (var log in logs)
        {
          logLines.Add(ParseLogLine(log));
        }
      }
    }
    catch (Exception ex)
    {
      NotificationService?.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Error,
        Summary = "Refresh Failed",
        Detail = $"Failed to refresh logs: {ex.Message}",
        Duration = 5000
      });
    }
    finally
    {
      loadingLogs = false;
    }
  }

  private void ClearLogs()
  {
    logLines.Clear();
  }

  private Task DownloadLogs()
  {
    var content = string.Join(Environment.NewLine, logLines.Select(l =>
      $"[{l.Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{l.Level}] {l.Message}"));
    
    var fileName = $"server-{ServerId}-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";

    // TODO: Implement actual download using JS Interop

    return Task.CompletedTask;
  }

  private LogLine ParseLogLine(string message)
  {
    var line = new LogLine { Timestamp = DateTime.Now, Message = message };
    var lower = message.ToLowerInvariant();

    line.Level = lower switch
    {
      _ when lower.Contains("[error]") || lower.Contains("error:") || lower.Contains("[stderr]") => "ERROR",
      _ when lower.Contains("[warn]") || lower.Contains("warning:") => "WARN",
      _ when lower.Contains("[debug]") => "DEBUG",
      _ when lower.Contains("[fatal]") => "FATAL",
      _ when lower.Contains("[stdout]") => "INFO",
      _ => "INFO"
    };

    return line;
  }

  private IEnumerable<LogLine> GetFilteredLogs()
  {
    var filtered = logLines.AsEnumerable();

    if (!string.IsNullOrWhiteSpace(filterText))
      filtered = filtered.Where(l => l.Message.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    if (!string.IsNullOrWhiteSpace(selectedLogLevel))
      filtered = filtered.Where(l => l.Level == selectedLogLevel);

    return filtered;
  }

  private string GetLogLineClass(LogLine line) => line.Level.ToLowerInvariant() switch
  {
    "error" or "fatal" => "log-line log-line-error",
    "warn" => "log-line log-line-warning",
    "debug" => "log-line log-line-debug",
    _ => "log-line log-line-info"
  };

  private BadgeStyle GetConnectionBadgeStyle() => connectionStatus switch
  {
    "Connected" => BadgeStyle.Success,
    "Connecting..." or "Reconnecting..." => BadgeStyle.Warning,
    _ => BadgeStyle.Danger
  };

  private async Task ScrollToBottomAsync()
  {
    // TODO: Implement JS Interop for smooth scrolling to bottom
    await Task.CompletedTask;
  }

  public async ValueTask DisposeAsync()
  {
    await StopStreaming();
    
    if (hubConnection != null)
    {
      await hubConnection.StopAsync();
      await hubConnection.DisposeAsync();
    }
    
    streamCts?.Dispose();
  }
}
