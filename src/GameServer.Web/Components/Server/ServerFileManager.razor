@using Microsoft.JSInterop
@using GameServer.Web.Models.V2
@using GameServer.Web.Services.V2
@using Radzen
@using Radzen.Blazor
@inject IGameServerFilesApiService FilesApi
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IJSRuntime JSRuntime

<div class="file-manager-container">
    @if (Volumes is null || !Volumes.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
            No storage volumes are configured for this server. Ensure the game type revision defines storage volumes.
        </RadzenAlert>
    }
    else
    {
        <!-- Toolbar -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <RadzenFormField Text="Storage Volume" Variant="Variant.Outlined" Style="min-width: 220px;">
                    <RadzenDropDown TValue="string"
                                    Data="@Volumes"
                                    TextProperty="ContainerPath"
                                    ValueProperty="ContainerPath"
                                    Value="@selectedVolumePath"
                                    ValueChanged="@OnVolumeChanged" />
                </RadzenFormField>

                <div class="d-flex gap-2">
                    <RadzenButton Icon="create_new_folder"
                                  Text="New Folder"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.Small"
                                  Click="@ShowNewFolderDialogAsync"
                                  Disabled="@(isLoading || string.IsNullOrEmpty(selectedVolumePath))" />
                    <RadzenButton Icon="upload_file"
                                  Text="Upload"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="@ShowUploadDialogAsync"
                                  Disabled="@(isLoading || string.IsNullOrEmpty(selectedVolumePath))" />
                    <RadzenButton Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@LoadFilesAsync"
                                  Disabled="@isLoading"
                                  title="Refresh files" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(selectedVolumePath))
            {
                <span class="badge bg-secondary">
                    @CurrentVolumeInfo
                </span>
            }
        </div>

        <!-- Breadcrumb Navigation -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb bg-light p-2 rounded border mb-0">
                <li class="breadcrumb-item">
                    <a href="javascript:void(0)" @onclick='() => NavigateToPath("")'>
                        <RadzenIcon Icon="home" Style="font-size: 1rem; vertical-align: middle;" />
                        <span>root</span>
                    </a>
                </li>
                @foreach (var crumb in Breadcrumbs)
                {
                    @if (crumb.IsLast)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@crumb.Name</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item">
                            <a href="javascript:void(0)" @onclick="() => NavigateToPath(crumb.Path)">@crumb.Name</a>
                        </li>
                    }
                }
            </ol>
        </nav>

        <!-- Files Data Grid -->
        @if (isLoading)
        {
            <div class="text-center py-5">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
                <p class="mt-3 text-muted">Loading files...</p>
            </div>
        }
        else if (loadError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                @loadError
            </RadzenAlert>
        }
        else if (!files.Any())
        {
            <div class="text-center py-5 border rounded bg-light">
                <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                <p class="text-muted mt-2 mb-0">This directory is empty.</p>
            </div>
        }
        else
        {
            <RadzenDataGrid Data="@files"
                            TItem="FileItem"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Simple"
                            class="border rounded">
                <Columns>
                    <RadzenDataGridColumn TItem="FileItem" Title="Name" SortProperty="Name" FilterProperty="Name">
                        <Template Context="file">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="@GetFileIcon(file)"
                                            Style="@(file.IsDirectory ? "color: var(--rz-warning);" : "color: var(--rz-info);")" />
                                @if (file.IsDirectory)
                                {
                                    <a href="javascript:void(0)" class="fw-bold text-decoration-none" @onclick="() => NavigateToDirectory(file)">
                                        @file.Name
                                    </a>
                                }
                                else
                                {
                                    <span>@file.Name</span>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FileItem" Property="Size" Title="Size" Width="120px">
                        <Template Context="file">
                            @(file.IsDirectory ? "—" : FormatFileSize(file.Size))
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FileItem" Property="LastModified" Title="Modified" Width="180px">
                        <Template Context="file">
                            @file.LastModified.ToLocalTime().ToString("g")
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FileItem" Title="Actions" Width="160px" Sortable="false" Filterable="false">
                        <Template Context="file">
                            <div class="d-flex gap-1">
                                @if (!file.IsDirectory)
                                {
                                    <RadzenButton Icon="download"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Click="@(() => DownloadFileAsync(file))"
                                                  title="Download file" />
                                    @if (IsEditable(file))
                                    {
                                        <RadzenButton Icon="edit"
                                                      ButtonStyle="ButtonStyle.Secondary"
                                                      Size="ButtonSize.ExtraSmall"
                                                      Click="@(() => EditFileAsync(file))"
                                                      title="Edit file" />
                                    }
                                }
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.ExtraSmall"
                                              Click="@(() => DeleteItemAsync(file))"
                                              title="Delete" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</div>

@code {
    [Parameter] public string? ServerId { get; set; }
    [Parameter] public IReadOnlyList<GameServerResolvedVolume>? Volumes { get; set; }

    private string? selectedVolumePath;
    private string currentSubPath = string.Empty;
    private List<FileItem> files = [];
    private bool isLoading;
    private string? loadError;

    private string CurrentVolumeInfo =>
        Volumes?.FirstOrDefault(v => v.ContainerPath == selectedVolumePath)?.Usage ?? "Volume";

    private sealed record Crumb(string Name, string Path, bool IsLast);

    private List<Crumb> Breadcrumbs
    {
        get
        {
            var segments = currentSubPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            var crumbs = new List<Crumb>();
            var accumulated = "";

            for (int i = 0; i < segments.Length; i++)
            {
                accumulated = string.IsNullOrEmpty(accumulated) ? segments[i] : $"{accumulated}/{segments[i]}";
                crumbs.Add(new Crumb(segments[i], accumulated, i == segments.Length - 1));
            }

            return crumbs;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Volumes?.Any() == true && string.IsNullOrEmpty(selectedVolumePath))
        {
            selectedVolumePath = Volumes.First().ContainerPath;
            currentSubPath = string.Empty;
            await LoadFilesAsync();
        }
    }

    private async Task OnVolumeChanged(string newVolume)
    {
        selectedVolumePath = newVolume;
        currentSubPath = string.Empty;
        await LoadFilesAsync();
    }

    private async Task LoadFilesAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId) || string.IsNullOrWhiteSpace(selectedVolumePath))
        {
            return;
        }

        try
        {
            isLoading = true;
            loadError = null;
            var result = await FilesApi.ListFilesAsync(ServerId, selectedVolumePath, currentSubPath);
            files = [.. result];
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            files = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task NavigateToDirectory(FileItem dir)
    {
        currentSubPath = dir.Path.TrimStart('/');
        await LoadFilesAsync();
    }

    private async Task NavigateToPath(string path)
    {
        currentSubPath = path.TrimStart('/');
        await LoadFilesAsync();
    }

    private async Task DownloadFileAsync(FileItem file)
    {
        if (string.IsNullOrWhiteSpace(ServerId) || string.IsNullOrWhiteSpace(selectedVolumePath))
        {
            return;
        }

        try
        {
            NotificationService.NotifyTimed(NotificationSeverity.Info, "Downloading...", file.Name);
            var bytes = await FilesApi.DownloadAsync(ServerId, selectedVolumePath, file.Path);
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("eval", $"{{ let a = document.createElement('a'); a.href = 'data:application/octet-stream;base64,{base64}'; a.download = '{file.Name}'; a.click(); }}");
        }
        catch (Exception ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Download Failed", ex.Message);
        }
    }

    private async Task EditFileAsync(FileItem file)
    {
        if (string.IsNullOrWhiteSpace(ServerId) || string.IsNullOrWhiteSpace(selectedVolumePath))
        {
            return;
        }

        var result = await DialogService.OpenAsync<FileEditorDialog>(
            $"Edit File: {file.Name}",
            new Dictionary<string, object?>
            {
                { "ServerId", ServerId },
                { "VolumePath", selectedVolumePath },
                { "FilePath", file.Path },
                { "FileName", file.Name }
            },
            new DialogOptions
            {
                Width = "85vw",
                Height = "80vh",
                Resizable = true,
                Draggable = true
            });

        if (result is true)
        {
            await LoadFilesAsync();
        }
    }

    private async Task DeleteItemAsync(FileItem file)
    {
        if (string.IsNullOrWhiteSpace(ServerId) || string.IsNullOrWhiteSpace(selectedVolumePath))
        {
            return;
        }

        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{file.Name}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await FilesApi.DeleteAsync(ServerId, selectedVolumePath, file.Path, recursive: file.IsDirectory);
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Deleted", $"{file.Name} was deleted.");
                await LoadFilesAsync();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyTimed(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
    }

    private async Task ShowNewFolderDialogAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId) || string.IsNullOrWhiteSpace(selectedVolumePath))
        {
            return;
        }

        string folderName = "";
        var result = await DialogService.OpenAsync("Create New Folder", ds =>
            @<div>
                <RadzenFormField Text="Folder Name" Variant="Variant.Outlined" class="w-100 mb-3">
                    <RadzenTextBox @oninput="@((ChangeEventArgs e) => folderName = e.Value?.ToString() ?? "")" class="w-100" />
                </RadzenFormField>
                <div class="d-flex justify-content-end gap-2">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="() => ds.Close(false)" />
                    <RadzenButton Text="Create" ButtonStyle="ButtonStyle.Primary" Click="() => ds.Close(true)" />
                </div>
            </div>
        , new DialogOptions { Width = "400px" });

        if (result is true && !string.IsNullOrWhiteSpace(folderName))
        {
            try
            {
                var targetPath = string.IsNullOrEmpty(currentSubPath) ? folderName : $"{currentSubPath}/{folderName}";
                await FilesApi.CreateDirectoryAsync(ServerId, selectedVolumePath, targetPath);
                NotificationService.NotifyTimed(NotificationSeverity.Success, "Created", $"Folder '{folderName}' created.");
                await LoadFilesAsync();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyTimed(NotificationSeverity.Error, "Create Failed", ex.Message);
            }
        }
    }

    private async Task ShowUploadDialogAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId) || string.IsNullOrWhiteSpace(selectedVolumePath))
        {
            return;
        }

        var uploadList = new List<UploadProgress>();
        var isUploading = false;

        await DialogService.OpenAsync("Upload Files", ds =>
            @<div>
                <div class="mb-3">
                    <InputFile OnChange="@(async e => {
                        isUploading = true;
                        foreach (var file in e.GetMultipleFiles(10))
                        {
                            var progress = new UploadProgress { FileName = file.Name, TotalBytes = file.Size };
                            uploadList.Add(progress);
                            try
                            {
                                using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                                await FilesApi.UploadAsync(ServerId!, selectedVolumePath!, currentSubPath, file.Name, stream);
                                progress.UploadedBytes = file.Size;
                                progress.IsComplete = true;
                            }
                            catch (Exception ex)
                            {
                                progress.Error = ex.Message;
                            }
                        }
                        isUploading = false;
                        await LoadFilesAsync();
                    })" multiple />
                </div>

                @if (uploadList.Any())
                {
                    <div class="mb-3" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var prog in uploadList)
                        {
                            <div class="mb-2 p-2 border rounded">
                                <div class="d-flex justify-content-between small">
                                    <span>@prog.FileName</span>
                                    <span>@(prog.IsComplete ? "Done" : prog.Error ?? "Uploading...")</span>
                                </div>
                                <RadzenProgressBar Value="@(prog.IsComplete ? 100 : 50)" Max="100" ShowValue="false" Style="height: 4px;" />
                            </div>
                        }
                    </div>
                }

                <div class="d-flex justify-content-end">
                    <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="() => ds.Close(true)" />
                </div>
            </div>
        , new DialogOptions { Width = "500px" });

        await LoadFilesAsync();
    }

    private static string GetFileIcon(FileItem file)
    {
        if (file.IsDirectory) return "folder";
        var ext = (file.Extension ?? Path.GetExtension(file.Name)).ToLowerInvariant();
        return ext switch
        {
            ".txt" or ".log" or ".md" => "description",
            ".json" or ".xml" or ".yml" or ".yaml" or ".properties" or ".toml" or ".cfg" => "code",
            ".zip" or ".tar" or ".gz" or ".jar" => "archive",
            ".png" or ".jpg" or ".jpeg" or ".gif" => "image",
            ".sh" or ".bat" or ".cmd" => "terminal",
            _ => "insert_drive_file"
        };
    }

    private static bool IsEditable(FileItem file)
    {
        if (file.IsDirectory || file.Size > 5 * 1024 * 1024) return false;
        var ext = (file.Extension ?? Path.GetExtension(file.Name)).ToLowerInvariant();
        return ext is ".txt" or ".log" or ".json" or ".xml" or ".yml" or ".yaml" or ".properties"
            or ".cfg" or ".toml" or ".sh" or ".bat" or ".cmd" or ".md" or ".ini" or ".env";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
