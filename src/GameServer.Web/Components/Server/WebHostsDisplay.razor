@using GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor

@if (WebHosts == null || !WebHosts.Any())
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small">
        <RadzenIcon Icon="info" />
        No web interfaces configured for this game type.
    </RadzenAlert>
}
else
{
    <div class="web-hosts-display">
        @foreach (var host in WebHosts.Select((h, i) => new { Host = h, Index = i }))
        {
            var isEnabled = IsHostEnabled(host.Host);
            var resolvedPort = GetResolvedPort(host.Host);
            var url = GetFullUrl(host.Host, host.Index);

            <RadzenCard class="web-host-display-card mb-3" Variant="Variant.Outlined">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <RadzenIcon Icon="@(isEnabled ? "language" : "language_off")" 
                                        Style="@($"font-size: 1.5rem; color: {(isEnabled ? "var(--rz-success)" : "var(--rz-text-disabled-color)")}")" />
                            <h6 class="mb-0">@host.Host.Name</h6>
                            @if (host.Index == 0)
                            {
                                <RadzenBadge Text="Primary" 
                                             BadgeStyle="BadgeStyle.Success" 
                                             IsPill="true"
                                             Size="BadgeSize.Small" />
                            }
                            @if (isEnabled)
                            {
                                <RadzenBadge Text="Active" 
                                             BadgeStyle="BadgeStyle.Success" 
                                             IsPill="true"
                                             Size="BadgeSize.Small" />
                            }
                            else
                            {
                                <RadzenBadge Text="Disabled" 
                                             BadgeStyle="BadgeStyle.Secondary" 
                                             IsPill="true"
                                             Size="BadgeSize.Small" />
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(host.Host.Description))
                        {
                            <p class="text-muted mb-2">@host.Host.Description</p>
                        }

                        <div class="host-details mb-2">
                            @if (resolvedPort.HasValue)
                            {
                                <RadzenBadge Text="@($"Port: {resolvedPort.Value}")" 
                                             BadgeStyle="BadgeStyle.Info"
                                             Variant="Variant.Flat" />
                                
                                @if (!string.IsNullOrWhiteSpace(host.Host.ContainerPortVariable))
                                {
                                    <small class="text-muted ms-1">(from ${@host.Host.ContainerPortVariable})</small>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(host.Host.ContainerPortVariable))
                            {
                                <RadzenBadge Text="@($"Port: ${{{host.Host.ContainerPortVariable}}} (not set)")" 
                                             BadgeStyle="BadgeStyle.Warning"
                                             Variant="Variant.Flat" />
                            }
                            else
                            {
                                <RadzenBadge Text="@($"Port: {host.Host.ContainerPort}")" 
                                             BadgeStyle="BadgeStyle.Secondary"
                                             Variant="Variant.Flat" />
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(host.Host.EnabledWhen))
                        {
                            <div class="condition-info mb-2">
                                <RadzenIcon Icon="@(isEnabled ? "check_circle" : "cancel")" 
                                            Style="@($"font-size: 0.9rem; color: {(isEnabled ? "var(--rz-success)" : "var(--rz-danger)")}")" />
                                <small class="text-muted">
                                    Condition: <code>@host.Host.EnabledWhen</code>
                                    @if (!isEnabled)
                                    {
                                        <span class="text-danger"> (not met)</span>
                                    }
                                </small>
                            </div>
                        }

                        @if (isEnabled && !string.IsNullOrWhiteSpace(url))
                        {
                            <div class="url-display">
                                <RadzenIcon Icon="link" Style="font-size: 0.9rem; vertical-align: middle;" />
                                <a href="@url" target="_blank" rel="noopener noreferrer" class="web-host-link">
                                    @url
                                    <RadzenIcon Icon="open_in_new" Style="font-size: 0.75rem; margin-left: 0.25rem;" />
                                </a>
                            </div>
                        }
                        else if (!isEnabled)
                        {
                            <div class="url-display">
                                <RadzenIcon Icon="link_off" Style="font-size: 0.9rem; vertical-align: middle; color: var(--rz-text-disabled-color);" />
                                <span class="text-muted">Not accessible (conditions not met)</span>
                            </div>
                        }
                    </div>

                    @if (isEnabled && !string.IsNullOrWhiteSpace(url))
                    {
                        <div class="host-actions">
                            <RadzenButton Icon="open_in_new" 
                                          Text="Open"
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => OpenUrl(url))" />
                            <RadzenButton Icon="content_copy" 
                                          Size="ButtonSize.Small" 
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => CopyToClipboard(url))"
                                          title="Copy URL" />
                        </div>
                    }
                </div>

                @if (!isEnabled && !string.IsNullOrWhiteSpace(host.Host.EnabledWhen))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Size="AlertSize.Small" class="mt-2">
                        <RadzenIcon Icon="info" />
                        <strong>To enable this interface:</strong> Set the required environment variable to meet the condition <code>@host.Host.EnabledWhen</code>
                    </RadzenAlert>
                }
            </RadzenCard>
        }
    </div>

    @if (WebHosts.Any(h => IsHostEnabled(h)))
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" class="mt-3">
            <RadzenIcon Icon="info" />
            <strong>Note:</strong> These URLs are routed through your load balancer. 
            Ensure your load balancer domain is correctly configured and the service is attached to the load balancer network.
        </RadzenAlert>
    }
}

<style>
    .web-hosts-display {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .web-host-display-card {
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .web-host-display-card:hover {
        border-color: var(--rz-primary);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .host-details {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .host-actions {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .condition-info {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.5rem;
        background: var(--rz-base-100);
        border-radius: 4px;
    }

    .url-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: var(--rz-base-50);
        border-radius: 4px;
        margin-top: 0.5rem;
    }

    .web-host-link {
        color: var(--rz-primary);
        text-decoration: none;
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
    }

    .web-host-link:hover {
        text-decoration: underline;
    }

    @@media (max-width: 768px) {
        .web-host-display-card > div {
            flex-direction: column;
        }

        .host-actions {
            flex-direction: row;
            width: 100%;
            justify-content: flex-end;
        }
    }
</style>

@code {
    [Parameter] public ICollection<WebHostDefinition>? WebHosts { get; set; }
    [Parameter] public IDictionary<string, string>? ServerSettings { get; set; }
    [Parameter] public string? ServerId { get; set; }
    [Parameter] public string? LoadBalancerDomain { get; set; } = "yourdomain.com";

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NotificationService NotificationService { get; set; } = default!;

    private bool IsHostEnabled(WebHostDefinition host)
    {
        if (string.IsNullOrWhiteSpace(host.EnabledWhen))
            return true;

        if (ServerSettings == null)
            return false;

        var condition = host.EnabledWhen.Trim();

        // Parse condition: "VAR=value" or "VAR!=value"
        string varName, expectedValue;
        bool isNegated = false;

        if (condition.Contains("!="))
        {
            var parts = condition.Split("!=", 2);
            if (parts.Length != 2) return false;
            varName = parts[0].Trim();
            expectedValue = parts[1].Trim();
            isNegated = true;
        }
        else if (condition.Contains("="))
        {
            var parts = condition.Split("=", 2);
            if (parts.Length != 2) return false;
            varName = parts[0].Trim();
            expectedValue = parts[1].Trim();
        }
        else
        {
            return false;
        }

        if (!ServerSettings.TryGetValue(varName, out var actualValue))
        {
            actualValue = "";
        }

        var matches = string.Equals(actualValue, expectedValue, StringComparison.OrdinalIgnoreCase);
        return isNegated ? !matches : matches;
    }

    private int? GetResolvedPort(WebHostDefinition host)
    {
        if (!string.IsNullOrWhiteSpace(host.ContainerPortVariable))
        {
            if (ServerSettings?.TryGetValue(host.ContainerPortVariable, out var portString) == true)
            {
                if (int.TryParse(portString, out var port) && port > 0 && port <= 65535)
                {
                    return port;
                }
            }
            return null;
        }

        return host.ContainerPort > 0 ? host.ContainerPort : null;
    }

    private string GetFullUrl(WebHostDefinition host, int index)
    {
        if (string.IsNullOrWhiteSpace(ServerId))
            return "";

        var basePath = $"/game-{ServerId}";
        
        if (index == 0)
        {
            return $"https://{LoadBalancerDomain}{basePath}/";
        }

        var segment = host.PathSegment ?? host.Name.ToLower().Replace(" ", "-");
        return $"https://{LoadBalancerDomain}{basePath}/{segment}/";
    }

    private void OpenUrl(string url)
    {
        JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Copied",
                Detail = "URL copied to clipboard",
                Duration = 2000
            });
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Copy Failed",
                Detail = "Could not copy to clipboard",
                Duration = 3000
            });
        }
    }
}
