@using Microsoft.Extensions.Options
@using GameServer.Web.Configurations
@using GameServer.Web.Models.V2
@using GameServer.Web.Services.V2
@using GameServer.API.Client.Interfaces
@using Radzen
@using Radzen.Blazor
@inject IOptions<GameServerDockerApi> ApiConfig
@inject IGameServerV2ApiService GameServerApiV2
@inject NotificationService NotificationService
@inject ILogger<ResourceHistoryTab> Logger
@inject GameServer.Web.Services.IUserTimeZoneService TimeZoneService
@implements IAsyncDisposable

<div class="resource-history-container">
    <RadzenCard class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <RadzenIcon Icon="show_chart" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                <h5 class="mb-0">Resource Usage History</h5>
                @if (chartPoints.Any())
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@($"{chartPoints.Count} points")" Variant="Variant.Flat" />
                }
                @if (isConnected)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Live Stream Active" Variant="Variant.Flat" />
                }
                else if (isConnecting)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Connecting Stream..." Variant="Variant.Flat" />
                }
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap @(isHistoryLoading ? "resource-history-controls-loading" : string.Empty)">
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small">Time Range:</span>
                    <RadzenDropDown TValue="string"
                                    Data="@TimeRangeOptions"
                                    TextProperty="Text"
                                    ValueProperty="Value"
                                    @bind-Value="@selectedRangeKey"
                                    Change="@(args => OnRangeOptionChanged((string)args))"
                                    Style="min-width: 160px;"
                                    Disabled="@isHistoryLoading" />
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small">Point Cap:</span>
                    <RadzenDropDown TValue="int"
                                    Data="@PointCapOptions"
                                    @bind-Value="@selectedPointCap"
                                    Change="@(async _ => await LoadHistoryAsync())"
                                    Style="min-width: 110px;"
                                    Disabled="@isHistoryLoading" />
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small">Calc:</span>
                    <RadzenDropDown TValue="string"
                                    Data="@CalculationOptions"
                                    @bind-Value="@selectedCalculation"
                                    Change="@(async _ => await LoadHistoryAsync())"
                                    Style="min-width: 110px;"
                                    Disabled="@isHistoryLoading" />
                </div>

                @if (selectedRangeKey == "custom")
                {
                    <div class="d-flex align-items-center gap-1 flex-wrap">
                        <RadzenDatePicker @bind-Value="@customFrom"
                                          ShowTime="true"
                                          DateFormat="yyyy-MM-dd HH:mm"
                                          Placeholder="Start Date/Time"
                                          Style="width: 175px;"
                                          Disabled="@isHistoryLoading" />
                        <span class="text-muted small">to</span>
                        <RadzenDatePicker @bind-Value="@customTo"
                                          ShowTime="true"
                                          DateFormat="yyyy-MM-dd HH:mm"
                                          Placeholder="End Date/Time"
                                          Style="width: 175px;"
                                          Disabled="@isHistoryLoading" />
                        <RadzenButton Icon="check"
                                      Text="Apply"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@ApplyCustomRangeAsync"
                                      Disabled="@isHistoryLoading" />
                    </div>
                }

                <RadzenButton Icon="refresh"
                              Text="Refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Click="@LoadHistoryAsync"
                              Disabled="@isHistoryLoading" />
            </div>
        </div>

        @if (isHistoryLoading && !chartPoints.Any())
        {
            <div class="text-center py-4">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <p class="mt-2 text-muted small">Loading historical resource points...</p>
            </div>
        }
        else if (!chartPoints.Any())
        {
            <div class="text-center py-4 border rounded bg-light">
                <RadzenIcon Icon="analytics" Style="font-size: 2.5rem; color: var(--rz-text-disabled-color);" />
                <p class="text-muted mt-2 mb-0">No historical resource points are available for this game server in the selected time range.</p>
            </div>
        }
        else
        {
            <div class="resource-history-content-wrapper">
                <div class="resource-history-content @(isHistoryLoading ? "resource-history-content-loading" : string.Empty)">
                    <div class="row g-3 mb-2">
                @* CPU Usage - Task-Manager-style line chart *@
                <div class="col-lg-6">
                    <TaskManagerChartCard Title="CPU Usage"
                                          HeaderColor="var(--rz-primary)"
                                          RightBadge="@GetLatestCpuBadge()"
                                          RightBadgeCss="bg-primary-subtle text-primary"
                                          MaxAxisLabel="@GetCpuMaxAxisLabel()"
                                          RangeLabel="@GetRangeLabel()">
                        <RadzenChart Style="height: 220px;">
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="CpuPercent"
                                              Title="CPU %"
                                              Smooth="true"
                                              Stroke="var(--rz-primary)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="fw-bold text-primary">@(data.CpuPercent is double cpu ? $"{cpu:F1}% CPU" : "CPU unavailable")</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="0" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0" Max="@GetCpuAxisMax()" Step="@GetCpuAxisStep()" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    </TaskManagerChartCard>
                </div>

                @* Memory Usage *@
                <div class="col-lg-6">
                    <TaskManagerChartCard Title="Memory Usage"
                                          HeaderColor="var(--rz-info)"
                                          RightBadge="@GetLatestMemoryBadge()"
                                          RightBadgeCss="bg-info-subtle text-info"
                                          MaxAxisLabel="100%"
                                          RangeLabel="@GetRangeLabel()">
                        <RadzenChart Style="height: 220px;">
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="MemoryPercent"
                                              Title="Memory %"
                                              Smooth="true"
                                              Stroke="var(--rz-info)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="fw-bold text-info">@(data.MemoryPercent is double memoryPercent && data.MemoryMB is double memoryMb ? $"{memoryPercent:F1}% ({memoryMb:F1} MB)" : "Memory unavailable")</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="0" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0" Max="100" Step="25" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    </TaskManagerChartCard>
                </div>

                @* Network Throughput *@
                <div class="col-lg-6">
                    <TaskManagerChartCard Title="Network Throughput"
                                          HeaderColor="var(--rz-success)"
                                          RightBadge="@GetNetThroughputBadge()"
                                          RightBadgeCss="bg-success-subtle text-success"
                                          MaxAxisLabel="KB/s"
                                          RangeLabel="@GetRangeLabel()">
                        <RadzenChart Style="height: 220px;">
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="NetworkRxKBps"
                                              Title="Rx In (KB/s)"
                                              Smooth="true"
                                              Stroke="var(--rz-success)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-success small">Rx In: @(data.NetworkRxKBps?.ToString("F2") ?? "n/a") KB/s</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="NetworkTxKBps"
                                              Title="Tx Out (KB/s)"
                                              Smooth="true"
                                              Stroke="var(--rz-info)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-info small">Tx Out: @(data.NetworkTxKBps?.ToString("F2") ?? "n/a") KB/s</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="0" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    </TaskManagerChartCard>
                </div>

                @* Disk Throughput *@
                <div class="col-lg-6">
                    <TaskManagerChartCard Title="Disk Throughput"
                                          HeaderColor="var(--rz-warning)"
                                          RightBadge="@GetDiskThroughputBadge()"
                                          RightBadgeCss="bg-warning-subtle text-warning"
                                          MaxAxisLabel="KB/s"
                                          RangeLabel="@GetRangeLabel()">
                        <RadzenChart Style="height: 220px;">
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="BlockReadKBps"
                                              Title="Read (KB/s)"
                                              Smooth="true"
                                              Stroke="var(--rz-warning)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-warning small">Read: @(data.BlockReadKBps?.ToString("F2") ?? "n/a") KB/s</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="BlockWriteKBps"
                                              Title="Write (KB/s)"
                                              Smooth="true"
                                              Stroke="var(--rz-danger)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-danger small">Write: @(data.BlockWriteKBps?.ToString("F2") ?? "n/a") KB/s</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="0" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    </TaskManagerChartCard>
                </div>

                @* Network Aggregate *@
                <div class="col-lg-6">
                    <TaskManagerChartCard Title="Network Aggregate"
                                          HeaderColor="var(--rz-success)"
                                          RightBadge="@GetNetAggregateBadge()"
                                          RightBadgeCss="bg-success-subtle text-success"
                                          MaxAxisLabel="MB"
                                          RangeLabel="@GetRangeLabel()">
                        <RadzenChart Style="height: 220px;">
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="NetworkRxMB"
                                              Title="Rx In (MB)"
                                              Smooth="true"
                                              Stroke="var(--rz-success)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-success small">Rx In total: @(data.NetworkRxMB?.ToString("F2") ?? "n/a") MB</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="NetworkTxMB"
                                              Title="Tx Out (MB)"
                                              Smooth="true"
                                              Stroke="var(--rz-info)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-info small">Tx Out total: @(data.NetworkTxMB?.ToString("F2") ?? "n/a") MB</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="0" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    </TaskManagerChartCard>
                </div>

                @* Disk Aggregate *@
                <div class="col-lg-6">
                    <TaskManagerChartCard Title="Disk Aggregate"
                                          HeaderColor="var(--rz-warning)"
                                          RightBadge="@GetDiskAggregateBadge()"
                                          RightBadgeCss="bg-warning-subtle text-warning"
                                          MaxAxisLabel="MB"
                                          RangeLabel="@GetRangeLabel()">
                        <RadzenChart Style="height: 220px;">
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="BlockReadMB"
                                              Title="Read (MB)"
                                              Smooth="true"
                                              Stroke="var(--rz-warning)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-warning small">Read total: @(data.BlockReadMB?.ToString("F2") ?? "n/a") MB</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenLineSeries Data="@chartPoints"
                                              CategoryProperty="AxisLabel"
                                              ValueProperty="BlockWriteMB"
                                              Title="Write (MB)"
                                              Smooth="true"
                                              Stroke="var(--rz-danger)"
                                              LineType="LineType.Solid">
                                <TooltipTemplate Context="data">
                                    <div class="p-1">
                                        <div class="text-muted small">@data.FullTimestamp</div>
                                        <div class="text-danger small">Write total: @(data.BlockWriteMB?.ToString("F2") ?? "n/a") MB</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="0" Formatter="@FormatBlank">
                                <RadzenGridLines Visible="true" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenLegend Position="LegendPosition.Top" />
                        </RadzenChart>
                    </TaskManagerChartCard>
                </div>
                    </div>
                </div>
                @if (isHistoryLoading)
                { 
                    <div class="resource-history-loading-overlay" aria-live="polite" aria-busy="true">
                        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                        <span class="small text-muted mt-2">Refreshing history...</span>
                    </div>
                }
            </div>
        }
    </RadzenCard>
</div>

<style>
    .resource-history-controls-loading {
        opacity: 0.65;
    }

    .resource-history-content-wrapper {
        position: relative;
    }

    .resource-history-content-loading {
        opacity: 0.35;
        filter: grayscale(100%);
        pointer-events: none;
        user-select: none;
    }

    .resource-history-loading-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        background: rgba(255, 255, 255, 0.45);
        border-radius: 0.5rem;
        z-index: 5;
    }
</style>

@code {
    [Parameter]
    public string? ServerId { get; set; }

    [Parameter]
    public bool AutoConnect { get; set; } = true;

    [Parameter]
    public IResourceMonitoringClient? Client { get; set; }

    private IResourceMonitoringClient? client;
    private bool isConnected;
    private bool isConnecting;
    private List<ResourceHistoryChartPoint> chartPoints = [];
    private bool isHistoryLoading;
    private int selectedPointCap = 5000;
    private string selectedCalculation = "avg";
    private static readonly IReadOnlyList<int> PointCapOptions = [5000, 10000];
    private static readonly IReadOnlyList<string> CalculationOptions = ["min", "max", "avg", "median"];

    public sealed record TimeRangeOption(string Value, string Text, TimeSpan? Duration);

    private static readonly IReadOnlyList<TimeRangeOption> TimeRangeOptions =
    [
        new TimeRangeOption("15m", "Last 15 Minutes", TimeSpan.FromMinutes(15)),
        new TimeRangeOption("30m", "Last 30 Minutes", TimeSpan.FromMinutes(30)),
        new TimeRangeOption("1h", "Last 1 Hour", TimeSpan.FromHours(1)),
        new TimeRangeOption("3h", "Last 3 Hours", TimeSpan.FromHours(3)),
        new TimeRangeOption("6h", "Last 6 Hours", TimeSpan.FromHours(6)),
        new TimeRangeOption("12h", "Last 12 Hours", TimeSpan.FromHours(12)),
        new TimeRangeOption("24h", "Last 24 Hours", TimeSpan.FromHours(24)),
        new TimeRangeOption("25h", "Last 25 Hours", TimeSpan.FromHours(25)),
        new TimeRangeOption("3d", "Last 3 Days", TimeSpan.FromDays(3)),
        new TimeRangeOption("7d", "Last 7 Days", TimeSpan.FromDays(7)),
        new TimeRangeOption("30d", "Last 30 Days", TimeSpan.FromDays(30)),
        new TimeRangeOption("custom", "Custom Range...", null)
    ];

    private string selectedRangeKey = "1h";
    private DateTime? customFrom;
    private DateTime? customTo;

    public sealed class ResourceHistoryChartPoint
    {
        public DateTime Timestamp { get; init; }
        public string AxisLabel { get; set; } = string.Empty;
        public string FullTimestamp { get; set; } = string.Empty;
        public double? CpuPercent { get; init; }
        public double? MemoryPercent { get; init; }
        public double? MemoryMB { get; init; }

        // Raw cumulative counter values (bytes) used to compute per-second throughput
        public long? NetworkRxBytesRaw { get; init; }
        public long? NetworkTxBytesRaw { get; init; }
        public long? BlockReadBytesRaw { get; init; }
        public long? BlockWriteBytesRaw { get; init; }

        // Absolute container counters are only available for live SignalR samples.
        public long? NetworkRxCounterBytes { get; init; }
        public long? NetworkTxCounterBytes { get; init; }
        public long? BlockReadCounterBytes { get; init; }
        public long? BlockWriteCounterBytes { get; init; }

        // Cumulative totals converted to MB (for aggregate charts)
        public double? NetworkRxMB => NetworkRxBytesRaw.HasValue ? Math.Round(NetworkRxBytesRaw.Value / 1024.0 / 1024.0, 2) : null;
        public double? NetworkTxMB => NetworkTxBytesRaw.HasValue ? Math.Round(NetworkTxBytesRaw.Value / 1024.0 / 1024.0, 2) : null;
        public double? BlockReadMB => BlockReadBytesRaw.HasValue ? Math.Round(BlockReadBytesRaw.Value / 1024.0 / 1024.0, 2) : null;
        public double? BlockWriteMB => BlockWriteBytesRaw.HasValue ? Math.Round(BlockWriteBytesRaw.Value / 1024.0 / 1024.0, 2) : null;

        // Computed instantaneous throughput between this and the previous sample (KB/s)
        public double? NetworkRxKBps { get; set; }
        public double? NetworkTxKBps { get; set; }
        public double? BlockReadKBps { get; set; }
        public double? BlockWriteKBps { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadHistoryAsync();

        if (AutoConnect)
        {
            await ConnectAndSubscribeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var initialized = await TimeZoneService.InitializeAsync();
            if (initialized)
            {
                foreach (var p in chartPoints)
                {
                    p.FullTimestamp = TimeZoneService.FormatLocalDateTime(p.Timestamp, "yyyy-MM-dd HH:mm:ss");
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnRangeOptionChanged(string newKey)
    {
        selectedRangeKey = newKey;
        if (selectedRangeKey == "custom")
        {
            customFrom ??= DateTime.Now.AddHours(-25);
            customTo ??= DateTime.Now;
        }
        else
        {
            await LoadHistoryAsync();
        }
    }

    private async Task ApplyCustomRangeAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId) || GameServerApiV2 is null)
        {
            return;
        }

        try
        {
            isHistoryLoading = true;

            DateTime? fromUtc = null;
            DateTime? toUtc = null;

            if (selectedRangeKey == "custom")
            {
                fromUtc = customFrom?.ToUniversalTime();
                toUtc = customTo?.ToUniversalTime();
            }
            else
            {
                var preset = TimeRangeOptions.FirstOrDefault(o => o.Value == selectedRangeKey);
                if (preset?.Duration != null)
                {
                    fromUtc = DateTime.UtcNow.Subtract(preset.Duration.Value);
                    toUtc = DateTime.UtcNow;
                }
            }

            var result = await GameServerApiV2.GetResourceHistoryAsync(
                ServerId,
                from: fromUtc,
                to: toUtc,
                maxDataPoints: selectedPointCap,
                calculation: selectedCalculation);

            chartPoints = result.Points.OrderBy(r => r.Timestamp).Select(r => new ResourceHistoryChartPoint
            {
                Timestamp = r.Timestamp,
                FullTimestamp = TimeZoneService.FormatLocalDateTime(r.Timestamp, "yyyy-MM-dd HH:mm:ss"),
                CpuPercent = r.CpuUsagePercent is double cpu ? Math.Round(cpu, 1) : null,
                MemoryPercent = r.MemoryUsagePercent is double memoryPercent ? Math.Round(memoryPercent, 1) : null,
                MemoryMB = r.MemoryUsageBytes is long memoryBytes ? Math.Round(memoryBytes / (1024.0 * 1024.0), 2) : null,
                NetworkRxBytesRaw = r.NetworkRxTotalBytes,
                NetworkTxBytesRaw = r.NetworkTxTotalBytes,
                BlockReadBytesRaw = r.BlockReadTotalBytes,
                BlockWriteBytesRaw = r.BlockWriteTotalBytes,
                NetworkRxKBps = r.NetworkRxKBps,
                NetworkTxKBps = r.NetworkTxKBps,
                BlockReadKBps = r.BlockReadKBps,
                BlockWriteKBps = r.BlockWriteKBps
            }).ToList();
            ComputeAxisLabels(chartPoints);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load resource history for server {ServerId}", ServerId);
            chartPoints = [];
        }
        finally
        {
            isHistoryLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static void ComputeAxisLabels(List<ResourceHistoryChartPoint> points)
    {
        if (points.Count == 0) return;

        var minTime = points[0].Timestamp;
        var maxTime = points[^1].Timestamp;
        var totalSpan = maxTime - minTime;

        TimeSpan step;
        string format;
        if (totalSpan <= TimeSpan.FromHours(1))
        {
            step = TimeSpan.FromMinutes(5);
            format = "HH:mm";
        }
        else if (totalSpan <= TimeSpan.FromHours(6))
        {
            step = TimeSpan.FromMinutes(30);
            format = "HH:mm";
        }
        else if (totalSpan <= TimeSpan.FromHours(48))
        {
            step = TimeSpan.FromHours(1);
            format = "HH:00";
        }
        else if (totalSpan <= TimeSpan.FromDays(7))
        {
            step = TimeSpan.FromHours(6);
            format = "MM/dd HH:mm";
        }
        else
        {
            step = TimeSpan.FromDays(1);
            format = "MM/dd";
        }

        // Every point MUST have a unique category value, otherwise
        // RadzenCategoryAxis collapses points that share a label onto
        // the same x-position, producing overlapping "sweeps" back to 0.
        // Tick labels are hidden by FormatBlank; the range is shown by the card footer instead.
        for (int i = 0; i < points.Count; i++)
        {
            points[i].AxisLabel = i.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private string GetAvgCpu()
    {
        var cpuValues = chartPoints.Where(c => c.CpuPercent.HasValue).Select(c => c.CpuPercent!.Value).ToList();
        if (cpuValues.Count == 0) return "n/a";
        return cpuValues.Average().ToString("F1");
    }

    private string GetLatestMemoryBadge()
    {
        var latestMemory = chartPoints.LastOrDefault()?.MemoryMB;
        return latestMemory.HasValue ? $"{latestMemory.Value:0.##} MB" : "n/a";
    }

    private string GetLatestCpuBadge()
    {
        var latestCpu = chartPoints.LastOrDefault()?.CpuPercent;
        return latestCpu.HasValue ? $"{latestCpu.Value:F1}%" : "n/a";
    }

    private double GetCpuAxisMax()
    {
        if (!chartPoints.Any()) return 100.0;
        var maxCpu = chartPoints.Max(c => c.CpuPercent) ?? 0;
        if (maxCpu <= 100.0) return 100.0;
        return Math.Ceiling(maxCpu / 100.0) * 100.0;
    }

    private double GetCpuAxisStep() => GetCpuAxisMax() / 4.0;

    private string GetCpuMaxAxisLabel() => $"{GetCpuAxisMax():0}%";

    private string GetLatestNetRxKBps() => chartPoints.LastOrDefault(p => p.NetworkRxKBps.HasValue)?.NetworkRxKBps?.ToString("F1") ?? "n/a";
    private string GetLatestNetTxKBps() => chartPoints.LastOrDefault(p => p.NetworkTxKBps.HasValue)?.NetworkTxKBps?.ToString("F1") ?? "n/a";
    private string GetLatestDiskReadKBps() => chartPoints.LastOrDefault(p => p.BlockReadKBps.HasValue)?.BlockReadKBps?.ToString("F1") ?? "n/a";
    private string GetLatestDiskWriteKBps() => chartPoints.LastOrDefault(p => p.BlockWriteKBps.HasValue)?.BlockWriteKBps?.ToString("F1") ?? "n/a";
    private string GetLatestNetRxMB() => chartPoints.LastOrDefault(p => p.NetworkRxMB.HasValue)?.NetworkRxMB?.ToString("F1") ?? "n/a";
    private string GetLatestNetTxMB() => chartPoints.LastOrDefault(p => p.NetworkTxMB.HasValue)?.NetworkTxMB?.ToString("F1") ?? "n/a";
    private string GetLatestDiskReadMB() => chartPoints.LastOrDefault(p => p.BlockReadMB.HasValue)?.BlockReadMB?.ToString("F1") ?? "n/a";
    private string GetLatestDiskWriteMB() => chartPoints.LastOrDefault(p => p.BlockWriteMB.HasValue)?.BlockWriteMB?.ToString("F1") ?? "n/a";

    private string GetNetThroughputBadge() => $"Rx {GetLatestNetRxKBps()} / Tx {GetLatestNetTxKBps()} KB/s";
    private string GetDiskThroughputBadge() => $"R {GetLatestDiskReadKBps()} / W {GetLatestDiskWriteKBps()} KB/s";
    private string GetNetAggregateBadge() => $"Rx {GetLatestNetRxMB()} / Tx {GetLatestNetTxMB()} MB";
    private string GetDiskAggregateBadge() => $"R {GetLatestDiskReadMB()} / W {GetLatestDiskWriteMB()} MB";

    private static string FormatBlank(object value) => string.Empty;

    private string GetRangeLabel()
    {
        var preset = TimeRangeOptions.FirstOrDefault(o => o.Value == selectedRangeKey);
        return preset?.Text ?? string.Empty;
    }

    private async Task ConnectAndSubscribeAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerId))
        {
            return;
        }

        try
        {
            isConnecting = true;
            await DisconnectAsync();

            if (Client != null)
            {
                client = Client;
            }
            else
            {
                var baseUri = ApiConfig.Value.BaseUri?.TrimEnd('/') ?? "http://localhost:5164";
                var hubUrl = $"{baseUri}/hubs/resources";
                client = new GameServer.API.Client.Services.ResourceMonitoringClient(hubUrl);
            }

            client.ResourceUpdateReceived += OnResourceUpdate;
            client.ErrorReceived += OnError;

            await client.ConnectAsync(CancellationToken.None);
            isConnected = true;

            await client.SubscribeToServerAsync(ServerId, intervalSeconds: 2, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to connect to ResourceMonitoringHub for server {ServerId}", ServerId);
            isConnected = false;
        }
        finally
        {
            isConnecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnResourceUpdate(object? sender, ServerResourceUsage usage)
    {
        InvokeAsync(() =>
        {
            if (AppendLiveUsage(usage))
            {
                StateHasChanged();
            }
        });
    }

    private bool AppendLiveUsage(ServerResourceUsage usage)
    {
        var previousPoint = chartPoints.LastOrDefault();
        var point = new ResourceHistoryChartPoint
        {
            Timestamp = usage.Timestamp,
            FullTimestamp = TimeZoneService.FormatLocalDateTime(usage.Timestamp, "yyyy-MM-dd HH:mm:ss"),
            CpuPercent = usage.CpuUsagePercent is double cpu ? Math.Round(cpu, 1) : null,
            MemoryPercent = usage.MemoryUsagePercent is double memoryPercent ? Math.Round(memoryPercent, 1) : null,
            MemoryMB = usage.MemoryUsageBytes is long memoryBytes ? Math.Round(memoryBytes / (1024.0 * 1024.0), 2) : null,
            NetworkRxBytesRaw = GetLiveRelativeTotal(previousPoint?.NetworkRxBytesRaw, previousPoint?.NetworkRxCounterBytes, usage.NetworkRxBytes),
            NetworkTxBytesRaw = GetLiveRelativeTotal(previousPoint?.NetworkTxBytesRaw, previousPoint?.NetworkTxCounterBytes, usage.NetworkTxBytes),
            BlockReadBytesRaw = GetLiveRelativeTotal(previousPoint?.BlockReadBytesRaw, previousPoint?.BlockReadCounterBytes, usage.BlockReadBytes),
            BlockWriteBytesRaw = GetLiveRelativeTotal(previousPoint?.BlockWriteBytesRaw, previousPoint?.BlockWriteCounterBytes, usage.BlockWriteBytes),
            NetworkRxCounterBytes = usage.NetworkRxBytes,
            NetworkTxCounterBytes = usage.NetworkTxBytes,
            BlockReadCounterBytes = usage.BlockReadBytes,
            BlockWriteCounterBytes = usage.BlockWriteBytes,
            NetworkRxKBps = CalculateLiveRate(previousPoint?.NetworkRxCounterBytes, usage.NetworkRxBytes, previousPoint?.Timestamp, usage.Timestamp),
            NetworkTxKBps = CalculateLiveRate(previousPoint?.NetworkTxCounterBytes, usage.NetworkTxBytes, previousPoint?.Timestamp, usage.Timestamp),
            BlockReadKBps = CalculateLiveRate(previousPoint?.BlockReadCounterBytes, usage.BlockReadBytes, previousPoint?.Timestamp, usage.Timestamp),
            BlockWriteKBps = CalculateLiveRate(previousPoint?.BlockWriteCounterBytes, usage.BlockWriteBytes, previousPoint?.Timestamp, usage.Timestamp)
        };

        // If not already in the collection (within 1 second)
        if (chartPoints.Any(p => Math.Abs((p.Timestamp - point.Timestamp).TotalSeconds) < 1.0))
        {
            return false;
        }

        chartPoints.Add(point);

        // Prune records older than active preset duration
        var preset = TimeRangeOptions.FirstOrDefault(o => o.Value == selectedRangeKey);
        if (preset?.Duration != null)
        {
            var cutoff = DateTime.UtcNow.Subtract(preset.Duration.Value);
            chartPoints.RemoveAll(p => p.Timestamp < cutoff);
        }

        ComputeAxisLabels(chartPoints);
        return true;
    }

    private static long? GetLiveRelativeTotal(long? previousRelativeTotal, long? previousAbsoluteCounter, long? currentAbsoluteCounter)
    {
        if (!currentAbsoluteCounter.HasValue)
        {
            return null;
        }

        if (!previousAbsoluteCounter.HasValue || !previousRelativeTotal.HasValue)
        {
            return previousRelativeTotal;
        }

        var delta = currentAbsoluteCounter.Value - previousAbsoluteCounter.Value;
        if (delta < 0)
        {
            return null;
        }

        return previousRelativeTotal.Value + delta;
    }

    private static double? CalculateLiveRate(long? previousAbsoluteCounter, long? currentAbsoluteCounter, DateTime? previousTimestamp, DateTime currentTimestamp)
    {
        if (!previousAbsoluteCounter.HasValue || !currentAbsoluteCounter.HasValue || !previousTimestamp.HasValue)
        {
            return null;
        }

        var seconds = (currentTimestamp - previousTimestamp.Value).TotalSeconds;
        if (seconds <= 0)
        {
            return null;
        }

        var delta = currentAbsoluteCounter.Value - previousAbsoluteCounter.Value;
        if (delta < 0)
        {
            return null;
        }

        return Math.Round(delta / 1024d / seconds, 2);
    }

    private void OnError(object? sender, string error)
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task DisconnectAsync()
    {
        if (client is not null)
        {
            try
            {
                client.ResourceUpdateReceived -= OnResourceUpdate;
                client.ErrorReceived -= OnError;
                await client.UnsubscribeAsync(CancellationToken.None);
                await client.StopAsync(CancellationToken.None);
                await client.DisposeAsync();
            }
            catch
            {
                // Best effort disconnect
            }
            finally
            {
                client = null;
                isConnected = false;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DisconnectAsync();
    }
}
