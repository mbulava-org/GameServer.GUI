@using global::GameServer.Docker.Client
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable
@inject IGameServerApi ServerApi
@inject NotificationService NotificationService

<RadzenCard class="resource-monitor">
    <div class="monitor-header">
        <h4>Service Status</h4>
        <div class="d-flex align-items-center gap-2">
            @if (isMonitoring)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="? Monitoring" />
                <span class="text-muted small">Next: @nextUpdateIn s</span>
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="? Stopped" />
            }
        </div>
    </div>

    @if (currentUsage != null)
    {
        <div class="resource-stats">
            <div class="stat-group">
                <div class="stat-header">
                    <span class="stat-label">Service Health</span>
                    <RadzenBadge BadgeStyle='@(currentUsage.IsHealthy ? BadgeStyle.Success : BadgeStyle.Danger)' 
                                 Text='@(currentUsage.IsHealthy ? "Healthy" : "Unhealthy")' />
                </div>
                <RadzenProgressBar Value="@currentUsage.ReplicaHealthPercent" Max="100" 
                                   ProgressBarStyle='@GetHealthProgressBarStyle(currentUsage.IsHealthy)' 
                                   ShowValue="false" />
                <div class="stat-detail">@($"{currentUsage.ReplicaHealthPercent:F1}%")</div>
            </div>

            <div class="stat-group">
                <div class="stat-label">Replicas</div>
                <div class="replica-info">
                    <RadzenBadge Text="@($"{currentUsage.RunningReplicas} / {currentUsage.DesiredReplicas} Running")" 
                                 BadgeStyle='@(currentUsage.RunningReplicas == currentUsage.DesiredReplicas ? BadgeStyle.Success : BadgeStyle.Warning)' />
                    @if (currentUsage.PendingTasks > 0)
                    {
                        <RadzenBadge Text="@($"{currentUsage.PendingTasks} Pending")" BadgeStyle="BadgeStyle.Info" />
                    }
                    @if (currentUsage.FailedTasks > 0)
                    {
                        <RadzenBadge Text="@($"{currentUsage.FailedTasks} Failed")" BadgeStyle="BadgeStyle.Danger" />
                    }
                </div>
            </div>

            @if (currentUsage.ServiceMemoryLimitPerReplica.HasValue || currentUsage.ServiceMemoryReservationPerReplica.HasValue)
            {
                <div class="stat-group">
                    <div class="stat-label">Memory (Per Replica)</div>
                    <div class="memory-info">
                        @if (currentUsage.ServiceMemoryReservationPerReplica.HasValue)
                        {
                            <span class="text-muted small">Reserved: @FormatBytes(currentUsage.ServiceMemoryReservationPerReplica.Value)</span>
                        }
                        @if (currentUsage.ServiceMemoryLimitPerReplica.HasValue)
                        {
                            <span class="text-muted small">Limit: @FormatBytes(currentUsage.ServiceMemoryLimitPerReplica.Value)</span>
                        }
                    </div>
                </div>
            }

            @if (currentUsage.ServiceCpuLimitPerReplica.HasValue || currentUsage.ServiceCpuReservationPerReplica.HasValue)
            {
                <div class="stat-group">
                    <div class="stat-label">CPU (Per Replica)</div>
                    <div class="cpu-info">
                        @if (currentUsage.ServiceCpuReservationPerReplica.HasValue)
                        {
                            <span class="text-muted small">Reserved: @FormatCpu(currentUsage.ServiceCpuReservationPerReplica.Value)</span>
                        }
                        @if (currentUsage.ServiceCpuLimitPerReplica.HasValue)
                        {
                            <span class="text-muted small">Limit: @FormatCpu(currentUsage.ServiceCpuLimitPerReplica.Value)</span>
                        }
                    </div>
                </div>
            }

            <div class="stat-group">
                <div class="stat-label">Service Status</div>
                <RadzenBadge Text="@currentUsage.ServiceStatus" BadgeStyle="BadgeStyle.Info" />
            </div>

            @if (!string.IsNullOrEmpty(currentUsage.UpdateState))
            {
                <div class="stat-group">
                    <div class="stat-label">Update State</div>
                    <RadzenBadge Text="@currentUsage.UpdateState" BadgeStyle="BadgeStyle.Warning" />
                </div>
            }

            <div class="last-update">
                Service version: @currentUsage.ServiceVersion | 
                Updated: @currentUsage.Timestamp.ToLocalTime().ToString("HH:mm:ss")
            </div>
        </div>
    }
    else if (isMonitoring)
    {
        <div class="no-data">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <p>Fetching resource data...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-data">
            <RadzenIcon Icon="error" />
            <p>@errorMessage</p>
            <RadzenButton Text="Retry" Click="StartMonitoring" Size="ButtonSize.Small" />
        </div>
    }
    else
    {
        <div class="no-data">
            <p>Resource monitoring not active</p>
            @if (!string.IsNullOrEmpty(ServerId))
            {
                <RadzenButton Text="Start Monitoring" Click="StartMonitoring" Size="ButtonSize.Small" />
            }
        </div>
    }

    @if (isMonitoring && !string.IsNullOrEmpty(ServerId))
    {
        <div class="monitor-controls mt-3 pt-3 border-top">
            <div class="d-flex align-items-center gap-2">
                <RadzenLabel Text="Refresh Interval:" class="mb-0" />
                <RadzenNumeric @bind-Value="refreshInterval" Min="2" Max="60" Step="1" Style="width:80px" />
                <RadzenLabel Text="seconds" class="mb-0" />
                <RadzenButton Icon="stop" 
                              Text="Stop" 
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Danger" 
                              Click="StopMonitoring" 
                              class="ms-auto" />
            </div>
        </div>
    }
</RadzenCard>

<style>
    .resource-monitor {
        margin-top: 1rem;
    }

    .monitor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .monitor-header h4 {
        margin: 0;
    }

    .resource-stats {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .stat-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--rz-text-secondary-color);
    }

    .stat-detail {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--rz-text-color);
        text-align: right;
    }

    .replica-info, .memory-info, .cpu-info {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .last-update {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--rz-text-secondary-color);
        text-align: right;
    }

    .no-data, .error-data {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem;
        color: var(--rz-text-secondary-color);
    }

    .error-data {
        color: var(--rz-danger);
    }

    .monitor-controls {
        font-size: 0.875rem;
    }
</style>

@code {
    [Parameter] public string? ServerId { get; set; }
    [Parameter] public bool AutoStart { get; set; } = true;

    private ServerResourceUsage? currentUsage;
    private bool isMonitoring = false;
    private string? errorMessage;
    private int refreshInterval = 5; // seconds
    private int nextUpdateIn = 0;

    private CancellationTokenSource? pollingCts;
    private Task? pollingTask;

    protected override async Task OnInitializedAsync()
    {
        // Auto-start monitoring if enabled and server ID is provided
        if (AutoStart && !string.IsNullOrEmpty(ServerId))
        {
            await StartMonitoring();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Restart monitoring if server ID changes
        if (isMonitoring)
        {
            await StopMonitoring();
            
            if (!string.IsNullOrEmpty(ServerId))
            {
                await StartMonitoring();
            }
        }
    }

    private async Task StartMonitoring()
    {
        if (string.IsNullOrEmpty(ServerId))
        {
            errorMessage = "Server ID is required";
            return;
        }

        isMonitoring = true;
        errorMessage = null;
        pollingCts = new CancellationTokenSource();

        // Start the polling loop
        pollingTask = PollResourcesAsync(pollingCts.Token);

        await InvokeAsync(StateHasChanged);
    }

    private async Task PollResourcesAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                // Fetch resource usage from REST API
                currentUsage = await ServerApi.GetResourceUsageAsync(ServerId!, cancellationToken);
                errorMessage = null;

                await InvokeAsync(StateHasChanged);

                // Countdown timer for UI feedback
                for (int i = refreshInterval; i > 0; i--)
                {
                    if (cancellationToken.IsCancellationRequested)
                        break;

                    nextUpdateIn = i;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000, cancellationToken);
                }
            }
            catch (OperationCanceledException)
            {
                // Expected when stopping
                break;
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to fetch resource data: {ex.Message}";
                currentUsage = null;
                
                await InvokeAsync(() =>
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Resource Monitoring Error",
                        Detail = errorMessage,
                        Duration = 5000
                    });
                    StateHasChanged();
                });

                // Wait before retrying on error
                try
                {
                    await Task.Delay(refreshInterval * 1000, cancellationToken);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        }
    }

    private async Task StopMonitoring()
    {
        isMonitoring = false;
        
        if (pollingCts != null)
        {
            pollingCts.Cancel();
            
            if (pollingTask != null)
            {
                try
                {
                    await pollingTask;
                }
                catch (OperationCanceledException)
                {
                    // Expected
                }
            }
            
            pollingCts.Dispose();
            pollingCts = null;
            pollingTask = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private ProgressBarStyle GetHealthProgressBarStyle(bool isHealthy)
    {
        return isHealthy ? ProgressBarStyle.Success : ProgressBarStyle.Danger;
    }

    private string FormatBytes(long bytes)
    {
        if (bytes == 0) return "0 B";

        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string FormatCpu(ulong nanoCpus)
    {
        // Docker reports CPU in nano-CPUs (1e9 = 1 CPU core)
        double cpus = nanoCpus / 1_000_000_000.0;
        return $"{cpus:0.##} CPUs";
    }

    public async ValueTask DisposeAsync()
    {
        await StopMonitoring();
    }
}
