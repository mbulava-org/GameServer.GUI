@using GameServer.Web.Services.V2
@using Radzen
@using Radzen.Blazor
@inject IGameServerFilesApiService FilesApi
@inject DialogService DialogService
@inject NotificationService NotificationService

<div class="p-2 d-flex flex-column h-100">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <strong>@FileName</strong>
            <span class="text-muted small ms-2">(@FilePath)</span>
        </div>
        <div class="d-flex gap-2">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveFileAsync" Disabled="@isSaving" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />
            <p class="mt-3 text-muted">Loading file content...</p>
        </div>
    }
    else
    {
        <div class="flex-grow-1">
            <RadzenTextArea @bind-Value="fileContent"
                            class="w-100 font-monospace"
                            Style="height: 60vh; resize: vertical; background-color: var(--rz-base-background-color); color: var(--rz-text-color);" />
        </div>
    }
</div>

@code {
    [Parameter] public string ServerId { get; set; } = string.Empty;
    [Parameter] public string VolumePath { get; set; } = string.Empty;
    [Parameter] public string FilePath { get; set; } = string.Empty;
    [Parameter] public string FileName { get; set; } = string.Empty;

    private string fileContent = string.Empty;
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadContentAsync();
    }

    private async Task LoadContentAsync()
    {
        try
        {
            isLoading = true;
            fileContent = await FilesApi.GetContentAsync(ServerId, VolumePath, FilePath);
        }
        catch (Exception ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Load Failed", ex.Message);
            DialogService.Close(false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveFileAsync()
    {
        try
        {
            isSaving = true;
            await FilesApi.SaveContentAsync(ServerId, VolumePath, FilePath, fileContent);
            NotificationService.NotifyTimed(NotificationSeverity.Success, "File Saved", $"{FileName} was saved successfully.");
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.NotifyTimed(NotificationSeverity.Error, "Save Failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }
}
