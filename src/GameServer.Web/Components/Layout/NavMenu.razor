@using System.Reflection
@inject NavigationManager NavigationManager

<div class="nav-container">
    <div class="nav-header">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="px-3 py-3">
            <RadzenIcon Icon="dns" Style="font-size: 2rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H6" class="mb-0" Style="color: #212529; font-weight: 600;">Game Server Manager</RadzenText>
        </RadzenStack>
    </div>

    <div class="nav-scrollable">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />
            @* V1 Dashboard removed — use the V2 server manager below *@
            <RadzenPanelMenuItem Text="Servers" Icon="dns" Path="/gameservers-v2" />
            @* <RadzenPanelMenuItem Text="Game Types" Icon="sports_esports" Path="/gametypes" /> *@
            <RadzenPanelMenuItem Text="Game Types" Icon="inventory_2" Path="/gametypes-v2" />
            <RadzenPanelMenuItem Text="Mount Types" Icon="storage" Path="/settings/mount-types" />
        </RadzenPanelMenu>
    </div>

    <div class="nav-footer">
        <RadzenStack Gap="0.25rem" class="px-3 py-3">
            <RadzenText TextStyle="TextStyle.Caption" class="mb-0" Style="color: #6c757d;">
                @AssemblyName @AssemblyVersion
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="mb-0" Style="color: #6c757d;">
                &copy; @DateTime.Now.Year. All rights reserved.
            </RadzenText>
        </RadzenStack>
    </div>
</div>

@code {
    private string AssemblyName => Assembly.GetExecutingAssembly().GetName().Name ?? "GameServer";
    private string AssemblyVersion => Assembly.GetExecutingAssembly().GetName().Version?.ToString(4) ?? "0.0.0.0";
}

