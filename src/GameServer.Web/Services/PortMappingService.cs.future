using GameServer.Docker.Client;
using Microsoft.Extensions.Logging;

namespace GameServer.Web.Services
{
    /// <summary>
    /// Service for validating and managing port mappings with automatic relationship handling
    /// </summary>
    public class PortMappingService
    {
        private readonly IPortApi _portApi;
        private readonly ILogger<PortMappingService> _logger;

        public PortMappingService(IPortApi portApi, ILogger<PortMappingService> logger)
        {
            _portApi = portApi;
            _logger = logger;
        }

        /// <summary>
        /// Validates a port setting value and returns any validation errors
        /// </summary>
        public async Task<PortValidationResult> ValidatePortSettingAsync(
            uint portValue,
            SettingMetadata settingMetadata,
            GameTypeDefinition gameType,
            Dictionary<string, string> currentSettings)
        {
            var result = new PortValidationResult { IsValid = true };

            // Check if port validation rules are defined
            var validation = settingMetadata.PortValidation ?? new PortValidationRule();

            // Validate port range
            if (portValue < validation.MinPort || portValue > validation.MaxPort)
            {
                result.IsValid = false;
                result.Errors.Add($"Port must be between {validation.MinPort} and {validation.MaxPort}");
                return result;
            }

            // Check reserved ports
            if (validation.ReservedPorts?.Contains(portValue) == true)
            {
                result.IsValid = false;
                result.Errors.Add($"Port {portValue} is reserved and cannot be used");
                return result;
            }

            // Check port availability if required
            if (validation.CheckAvailability)
            {
                var protocol = settingMetadata.PortProtocol ?? "tcp";
                var isAvailable = await IsPortAvailableAsync(portValue, protocol);
                if (!isAvailable)
                {
                    result.IsValid = false;
                    result.Errors.Add($"Port {portValue} ({protocol}) is already in use");
                    result.UnavailablePorts.Add(portValue);
                }
            }

            // Validate related ports
            if (settingMetadata.ValidateRelatedPortsAvailability && 
                settingMetadata.PortRelationships?.Any() == true)
            {
                foreach (var relationship in settingMetadata.PortRelationships.Where(r => r.IsRequired))
                {
                    var relatedPort = CalculateRelatedPort(portValue, relationship);
                    if (relatedPort.HasValue)
                    {
                        var isAvailable = await IsPortAvailableAsync(relatedPort.Value, relationship.TargetProtocol);
                        if (!isAvailable)
                        {
                            result.IsValid = false;
                            result.Errors.Add($"Related port {relatedPort.Value} ({relationship.Description ?? "Unnamed"}) is not available");
                            result.UnavailablePorts.Add(relatedPort.Value);
                        }
                        else
                        {
                            result.RelatedPortsToUpdate.Add(new PortUpdateInfo
                            {
                                ContainerPort = relationship.TargetContainerPort,
                                Protocol = relationship.TargetProtocol,
                                NewPort = relatedPort.Value,
                                Description = relationship.Description
                            });
                        }
                    }
                }
            }

            return result;
        }

        /// <summary>
        /// Applies port changes to a game type, including all related port updates
        /// </summary>
        public PortApplicationResult ApplyPortChanges(
            GameTypeDefinition gameType,
            Dictionary<string, string> settings,
            SettingMetadata settingMetadata,
            uint newPortValue)
        {
            var result = new PortApplicationResult { Success = true };

            if (!settingMetadata.MapsToContainerPort || !settingMetadata.LinkedContainerPort.HasValue)
            {
                result.Success = false;
                result.ErrorMessage = "Setting does not map to a container port";
                return result;
            }

            // Find and update the primary port
            var primaryPort = gameType.Ports?.FirstOrDefault(p => 
                p.Port == settingMetadata.LinkedContainerPort.Value &&
                p.Protocol.Equals(settingMetadata.PortProtocol, StringComparison.OrdinalIgnoreCase));

            if (primaryPort == null)
            {
                result.Success = false;
                result.ErrorMessage = $"Container port {settingMetadata.LinkedContainerPort} ({settingMetadata.PortProtocol}) not found in game type definition";
                return result;
            }

            // Update the primary port
            var oldPort = (uint)primaryPort.Port;
            primaryPort.Port = (int)newPortValue;
            result.UpdatedPorts.Add(new PortUpdateInfo
            {
                ContainerPort = settingMetadata.LinkedContainerPort.Value,
                Protocol = settingMetadata.PortProtocol,
                NewPort = newPortValue,
                OldPort = (uint)oldPort,
                Description = $"Primary port ({settingMetadata.Key})"
            });

            // Update related ports
            if (settingMetadata.PortRelationships?.Any() == true)
            {
                foreach (var relationship in settingMetadata.PortRelationships)
                {
                    var relatedPort = gameType.Ports?.FirstOrDefault(p =>
                        p.Port == (int)relationship.TargetContainerPort &&
                        p.Protocol.Equals(relationship.TargetProtocol, StringComparison.OrdinalIgnoreCase));

                    if (relatedPort != null)
                    {
                        var newRelatedPortValue = CalculateRelatedPort(newPortValue, relationship);
                        if (newRelatedPortValue.HasValue)
                        {
                            var oldRelatedPort = (uint)relatedPort.Port;
                            relatedPort.Port = (int)newRelatedPortValue.Value;
                            
                            result.UpdatedPorts.Add(new PortUpdateInfo
                            {
                                ContainerPort = relationship.TargetContainerPort,
                                Protocol = relationship.TargetProtocol,
                                NewPort = newRelatedPortValue.Value,
                                OldPort = oldRelatedPort,
                                Description = relationship.Description ?? "Related port"
                            });

                            _logger.LogInformation(
                                "Updated related port {OldPort} -> {NewPort} ({Protocol}) based on {Relationship}",
                                oldRelatedPort, newRelatedPortValue.Value, relationship.TargetProtocol,
                                relationship.RelationType);
                        }
                    }
                    else if (relationship.IsRequired)
                    {
                        // Add the required related port if it doesn't exist
                        var newRelatedPortValue = CalculateRelatedPort(newPortValue, relationship);
                        if (newRelatedPortValue.HasValue)
                        {
                            gameType.Ports ??= new List<PortDefinition>();
                            gameType.Ports.Add(new PortDefinition
                            {
                                Port = (int)newRelatedPortValue.Value,
                                Protocol = relationship.TargetProtocol
                            });

                            result.UpdatedPorts.Add(new PortUpdateInfo
                            {
                                ContainerPort = relationship.TargetContainerPort,
                                Protocol = relationship.TargetProtocol,
                                NewPort = newRelatedPortValue.Value,
                                Description = relationship.Description ?? "Related port",
                                IsNew = true
                            });
                        }
                    }
                }
            }

            return result;
        }

        /// <summary>
        /// Calculates a related port value based on the relationship type
        /// </summary>
        private uint? CalculateRelatedPort(uint sourcePort, PortRelationship relationship)
        {
            return relationship.RelationType switch
            {
                PortRelationshipType.Offset => (uint)(sourcePort + relationship.Offset),
                PortRelationshipType.Fixed => relationship.FixedValue,
                PortRelationshipType.Multiplier => (uint)(sourcePort * Math.Abs(relationship.Offset)),
                _ => null
            };
        }

        /// <summary>
        /// Checks if a port is available (not in use)
        /// </summary>
        private async Task<bool> IsPortAvailableAsync(uint port, string protocol)
        {
            try
            {
                // Try to allocate the port - if it succeeds, it's available
                // Note: In production, this should check against a port registry
                // rather than actually allocating/deallocating
                var allocatedPort = await _portApi.AllocateAsync(protocol, (int)port);
                if (allocatedPort == (int)port)
                {
                    // Immediately release it since we were just checking
                    await _portApi.ReleaseAsync((int)port, protocol);
                    return true;
                }
                return false;
            }
            catch
            {
                // Port is already allocated or unavailable
                return false;
            }
        }

        /// <summary>
        /// Gets suggested ports based on the validation rules
        /// </summary>
        public List<uint> GetSuggestedPorts(SettingMetadata settingMetadata)
        {
            var validation = settingMetadata.PortValidation;
            if (validation?.SuggestedPorts?.Any() == true)
            {
                return validation.SuggestedPorts;
            }

            // Return common game server ports as defaults
            return new List<uint> { 25565, 27015, 7777, 28000, 30000 };
        }
    }

    /// <summary>
    /// Result of port validation
    /// </summary>
    public class PortValidationResult
    {
        public bool IsValid { get; set; }
        public List<string> Errors { get; set; } = new();
        public List<uint> UnavailablePorts { get; set; } = new();
        public List<PortUpdateInfo> RelatedPortsToUpdate { get; set; } = new();
    }

    /// <summary>
    /// Result of applying port changes
    /// </summary>
    public class PortApplicationResult
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
        public List<PortUpdateInfo> UpdatedPorts { get; set; } = new();
    }

    /// <summary>
    /// Information about a port update
    /// </summary>
    public class PortUpdateInfo
    {
        public uint ContainerPort { get; set; }
        public string Protocol { get; set; } = "tcp";
        public uint NewPort { get; set; }
        public uint? OldPort { get; set; }
        public string? Description { get; set; }
        public bool IsNew { get; set; }
    }
}
