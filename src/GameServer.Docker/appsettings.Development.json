{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "PortAllocation": {
    "StartPort": 2000,
    "EndPort": 90000
  },
  "ConnectionStrings": {
    "GameServerDb": "Data Source=./data/gameserver.db",
    "DevMySqlDb": "Server=192.168.12.5;Database=dev-game-server;User=dev-game-server-user;Password=P@ssw0rd;",
    "DevMySqlDb2": "Server=192.168.192.178;Database=dev-game-server;User=dev-game-server-user;Password=P@ssw0rd;"

  },
  "V2Database": {
    "Provider": "MySql",
    "ConnectionStringName": "DevMySqlDb"
  },

  "VolumeDriverConfigOptions": {
    "Name": "local",
    "Options": {
      "type": "nfs",
      "o": "addr=192.168.53.235,rw,nfsvers=3,soft,sync,noatime",
      "device": ":{RootStoragePath}/{gameTypeKey}_{serverId}/{Source}"
    },
    "RootStoragePath": "/volume1/newdev-docker/gameservers",
    "SubPathFormat": "{gameTypeKey}_{serverId}/{Source}",
    "LocalStoragePath": "./data"
  },
  "NetworkOptions": {
    "NetworkName": "gameserver-docker-test"
  },
  "NodeAgentOptions": {
    "ServiceName": "gameserver-agent",
    "NetworkName": "gameserver-network-test"
  },
  "UdpAgentDiscovery": {
    "Enabled": true,
    "BindAddress": "0.0.0.0",
    "MulticastGroup": "239.1.1.1",
    "Port": 19090,
    "AnnouncementTtlSeconds": 90,
    "CleanupIntervalSeconds": 30
  },
  "ServiceOperations": {
    "Mode": "Agent"
  }
}