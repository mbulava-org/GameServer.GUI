{
"Logging": {
  "LogLevel": {
    "Default": "Trace",
    "Microsoft.AspNetCore": "Warning"
  }
},
"Serilog": {
  "MinimumLevel": {
    "Default": "Verbose",
    "Override": {
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "System": "Warning"
    }
  },
  "WriteTo": [
    {
      "Name": "Console",
      "Args": {
        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
      }
    }
  ],
  "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
},
  
  "PortAllocation": {
    "StartPort": 2000,
    "EndPort": 90000
  },
  "ConnectionStrings": {
    "GameServerDb": "Data Source=./data/gameserver.db"
  },
  
  "VolumeDriverConfigOptions": {
    "Name": "local",
    "Options": {
      "type": "nfs",
      "o": "addr=192.168.53.235,rw,nfsvers=3,soft,sync,noatime",
      "device": ":{RootStoragePath}/{gameTypeKey}_{serverId}/{Source}"
    },
    "RootStoragePath": "/volume1/newdev-docker/gameservers",
    "SubPathFormat": "{gameTypeKey}_{serverId}/{Source}",
    "LocalStoragePath": "./data"
  },
  "NetworkOptions": {
    "NetworkName": "gameserver-docker-test"
  },
  "NodeAgentOptions": {
    "ServiceName": "gameserver-agent",
    "NetworkName": "gameserver-network-test",
  },
  "ServiceOperations": {
    "Mode": "Agent"
  }
}