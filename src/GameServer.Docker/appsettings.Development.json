{
"Logging": {
  "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning"
  }
},
"Serilog": {
  "MinimumLevel": {
    "Default": "Debug",
    "Override": {
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "System": "Warning"
    }
  },
  "WriteTo": [
    {
      "Name": "Console",
      "Args": {
        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
      }
    }
  ],
  "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
},
  "DockerConnection": {
    "Uri": "http://192.168.10.50:6666/"
    //"Uri": "http://192.168.54.168:6666/"
  },
  "PortAllocation": {
    "StartPort": 2000,
    "EndPort": 90000
  },
  "ConnectionStrings": {
    "GameServerDb": "Data Source=/data/gameserver.db"
  },
  "GameTypeStorage": {
    "DataDirectory": "/data",
    "UseDatabase": true,
    "BackupEnabled": true,
    "BackupDirectory": "/data/backups"
  },
  "GameTypeRegistryData": {
    "FilePath": "/data/game-types.json"
  },
  "GameTypeExtendedMetadataRegistryData": {
    "DirectoryPath": "/data"
  },
  "VolumeDriverConfigOptions": {
    "Name": "local",
    "Options": {
      "type": "nfs",
      "o": "addr=192.168.53.235,rw,nfsvers=3,soft,sync,noatime",
      "device": ":{RootStoragePath}/{gameTypeKey}_{serverId}/{Source}"
    },
    "RootStoragePath": "/volume1/newdev-docker/gameservers",
    "SubPathFormat": "{gameTypeKey}_{serverId}/{Source}",
    "LocalStoragePath": "/data"
  },
  "NetworkOptions": {
    "NetworkName": "external-2"
  },
  "NodeAgentOptions": {
    "ServiceName": "gameserver-agent",
    "NetworkName": "gameserver-network",
    "Port": 8080,
    "TimeoutSeconds": 45,
    "BackgroundRefreshIntervalSeconds": 15,
    "ActiveTaskStates": [ "running", "starting", "ready" ]
  }
}