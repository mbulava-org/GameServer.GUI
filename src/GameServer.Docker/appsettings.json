{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GameServerDb": "Data Source=./data/gameserver.db"
  },
  "PortAllocation": {
    "StartPort": 25565,
    "EndPort": 35565
  },
  "VolumeDriverConfigOptions": {
    "Name": "local",
    "LocalStoragePath": "/data",
    "SubPathFormat": "{gameTypeKey}/{serverId}/{Source}"
  },
  "NetworkOptions": {
    "LoadBalancerNetwork": "traefik-public",
    "LoadBalancerProvider": "traefik"
  },
  "ServiceOperations": {
    "Mode": "Agent",
    "Enabled": true
  },
  "NodeAgentOptions": {
    "ServiceName": "gameserver-agent",
    "NetworkName": "gameserver-network",
    "Port": 8080,
    "TimeoutSeconds": 45
  }
}
